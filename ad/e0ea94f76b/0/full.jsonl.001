{"timestamp":"2026-07-18T17:44:02.753Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7653-f9c1-7313-9713-ab5497f04699","call_id":"call_6Q3gJzEDrX0sYogetBJKHuvP","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"        return parsed if type(parsed) is dict else None\n    return None\n\n\ndef _parse_agent_stream(data: bytes) -> dict[str, Any]:\n    parsed = runtime.parse_stream(data)\n    tools_by_id = {\n        str(row.get(\"id\")): row for row in parsed[\"tools\"] if row.get(\"id\") is not None\n    }\n    for raw in data.decode(\"utf-8\", \"replace\").splitlines():\n        try:\n            event = json.loads(raw)\n        except json.JSONDecodeError:\n            continue\n        message = event.get(\"message\") if type(event) is dict else None\n        content = message.get(\"content\") if type(message) is dict else None\n        if type(content) is not list:\n            continue\n        for block in content:\n            if type(block) is not dict or block.get(\"type\") != \"tool_result\":\n                continue\n            tool = tools_by_id.get(str(block.get(\"tool_use_id\")))\n            if tool is None or type(tool.get(\"result\")) is not dict:\n                continue\n            for field in (\"duration_ms\", \"elapsed_ms\"):\n                value = block.get(field)\n                if type(value) is int and value >= 0:\n                    tool[\"result\"][\"duration_ms\"] = value\n                    break\n    return parsed\n\n\ndef _tool_result_text(tool: dict[str, Any]) -> str:\n    result = tool.get(\"result\")\n    if type(result) is not dict:\n        return \"\"\n    content = result.get(\"content\")\n    if isinstance(content, str):\n        return content\n    try:\n        return json.dumps(content, sort_keys=True, separators=(\",\", \":\"))\n    except (TypeError, ValueError):\n        return str(content)\n\n\ndef _safe_tool_path(value: Any, checkout: Path) -> bool:\n    if value in (None, \"\", \".\"):\n        return True\n    if (\n        not isinstance(value, str)\n        or \"\\x00\" in value\n        or value.startswith(\"~\")\n        or \"$\" in value\n        or \"\\\\\" in value\n    ):\n        return False\n    path = Path(value)\n    candidate = path.resolve(strict=False) if path.is_absolute() else (checkout / path).resolve(\n        strict=False\n    )\n    return candidate == checkout or candidate.is_relative_to(checkout)\n\n\ndef _graph_command_tokens(command: str) -> list[str] | None:\n    if (\n        not command\n        or any(marker in command for marker in (\"`\", \"$(\", \"\\n\", \"\\r\", \">\", \"<\"))\n        or len(runtime.shell_segments(command)) != 1\n    ):\n        return None\n    try:\n        tokens = shlex.split(command, posix=True)\n    except ValueError:\n        return None\n    return tokens if tokens and not any(token in {\">\", \">>\", \"<\"} for token in tokens) else None\n\n\ndef _flag_values(tokens: list[str]) -> dict[str, str | None] | None:\n    values: dict[str, str | None] = {}\n    index = 2\n    boolean_flags = {\"--head\", \"--index-all-files\"}\n    while index < len(tokens):\n        token = tokens[index]\n        if not token.startswith(\"--\"):\n            return None\n        if \"=\" in token:\n            flag, value = token.split(\"=\", 1)\n        elif token in boolean_flags:\n            flag, value = token, None\n        elif index + 1 < len(tokens):\n            flag, value = token, tokens[index + 1]\n            index += 1\n        else:\n            return None\n        if flag in values:\n            return None\n        values[flag] = value\n        index += 1\n    return values\n\n\ndef _audit_graph_command(\n    command: str, graph_binary: Path, graph_cache: Path, checkout: Path,\n) -> bool:\n    tokens = _graph_command_tokens(command)\n    if tokens is None or len(tokens) < 3 or tokens[0] != str(graph_binary):\n        return False\n    subcommand = tokens[1]\n    flags = _flag_values(tokens)\n    if flags is None or subcommand not in {\"search\", \"neighbors\"}:\n        return False\n    common = {\"--repo\", \"--format\", \"--head\", \"--profile\", \"--cache-dir\"}\n    allowed = common | (\n        {\"--query\", \"--index-all-files\"}\n        if subcommand == \"search\"\n        else {\"--symbol\", \"--file\", \"--depth\"}\n    )\n    if set(flags) - allowed:\n        return False\n    cache_value = flags.get(\"--cache-dir\")\n    if (\n        flags.get(\"--repo\") != \".\"\n        or flags.get(\"--format\") != \"agent\"\n        or \"--head\" not in flags\n        or flags.get(\"--profile\") != \"full\"\n        or cache_value not in {str(graph_cache), \"$ENTIRE_GRAPH_CACHE_DIR\"}\n    ):\n        return False\n    if subcommand == \"search\":\n        return (\n            isinstance(flags.get(\"--query\"), str)\n            and bool(flags[\"--query\"])\n            and \"--index-all-files\" in flags\n        )\n    return (\n        isinstance(flags.get(\"--symbol\"), str)\n        and bool(flags[\"--symbol\"])\n        and isinstance(flags.get(\"--file\"), str)\n        and bool(flags[\"--file\"])\n        and _safe_tool_path(flags[\"--file\"], checkout)\n        and flags.get(\"--depth\") == \"2\"\n    )\n\n\ndef _audit_tools(\n    system: str, tools: list[dict[str, Any]], *, checkout: Path,\n    graph_binary: Path, graph_cache: Path, cbm_project: str | None,\n    task_wall_time_ms: int,\n) -> tuple[dict[str, Any], dict[str, Any]]:\n    violations: set[str] = set()\n    graph_tools: list[dict[str, Any]] = []\n    file_discovery_calls = 0\n    cbm_retrieval_calls = 0\n    retrieval_count = 0\n    controller_latency_ms = 0\n    for tool in tools:\n        name = str(tool.get(\"name\") or \"\")\n        tool_input = tool.get(\"input\") if type(tool.get(\"input\")) is dict else {}\n        if name == \"Read\":\n            retrieval_count += 1\n            path_values = [\n                tool_input.get(field)\n                for field in (\"file_path\", \"path\")\n                if field in tool_input\n            ]\n            if any(not _safe_tool_path(value, checkout) for value in path_values):\n                violations.add(\"tool_path_outside_checkout\")\n        elif name in {\"Grep\", \"Glob\"} and system == \"file-tools\":\n            retrieval_count += 1\n            file_discovery_calls += 1\n            path_values = [\n                tool_input.get(field)\n                for field in (\"path\",)\n                if field in tool_input\n            ]\n            if name == \"Glob\" and \"pattern\" in tool_input:\n                path_values.append(tool_input.get(\"pattern\"))\n            if name == \"Grep\" and \"glob\" in tool_input:\n                path_values.append(tool_input.get(\"glob\"))\n            if any(not _safe_tool_path(value, checkout) for value in path_values):\n                violations.add(\"tool_path_outside_checkout\")\n        elif name == \"Bash\" and system == \"entire-graph\":\n            command = tool_input.get(\"command\")\n            if not isinstance(command, str) or not _audit_graph_command(\n                command, graph_binary, graph_cache, checkout,\n            ):\n                violations.add(\"forbidden_bash_command\")\n            else:\n                graph_tools.append(tool)\n                retrieval_count += 1\n        elif name in CBM_RETRIEVAL_TOOLS and system == \"cbm\":\n            retrieval_count += 1\n            cbm_retrieval_calls += 1\n            if not cbm_project or tool_input.get(\"project\") != cbm_project:\n                violations.add(\"cbm_wrong_project\")\n            if any(\n                not _safe_tool_path(value, checkout)\n                for key, value in tool_input.items()\n                if key in {\"path\", \"file_path\"} or key.endswith(\"_path\")\n            ):\n                violations.add(\"tool_path_outside_checkout\")\n            result = tool.get(\"result\")\n            if type(result) is not dict or result.get(\"is_error\") is True:\n                violations.add(\"cbm_retrieval_error\")\n            else:\n                content = _tool_result_text(tool)\n                try:\n                    response = json.loads(content) if content else None\n                except json.JSONDecodeError:\n                    response = None\n                if type(response) is dict and (\n                    response.get(\"error\")\n                    or response.get(\"status\") in {\n                        \"degraded\", \"missing\", \"corrupt\", \"failed\",\n                    }\n                ):\n                    violations.add(\"cbm_retrieval_error\")\n        else:\n            violations.add(\"forbidden_tool\")\n        result = tool.get(\"result\")\n        if type(result) is dict:\n            duration = result.get(\"duration_ms\")\n            if type(duration) is int and duration >= 0:\n                controller_latency_ms += duration\n\n    if system == \"file-tools\" and file_discovery_calls == 0:\n        violations.add(\"missing_file_discovery\")\n    elif system == \"entire-graph\" and not graph_tools:\n        violations.add(\"missing_graph_retrieval\")\n    elif system == \"cbm\" and cbm_retrieval_calls == 0:\n        violations.add(\"missing_cbm_retrieval\")\n\n    graph_latency_ms: int | None = None\n    all_cache_hits: bool | None = None\n    if graph_tools:\n        graph_latency_ms = 0\n        all_cache_hits = True\n        header = re.compile(\n            r\"Index: cache-(hit|miss) \\(\\d+ms\\) \\| Query: \\d+ms \"\n            r\"\\| (?:Preselect: \\d+ms \\| )?Total: (\\d+)ms\"\n        )\n        for tool in graph_tools:\n            match = header.search(_tool_result_text(tool))\n            if match is None:\n                violations.add(\"graph_telemetry_missing\")\n                all_cache_hits = False\n                continue\n            graph_latency_ms += int(match.group(2))\n            if match.group(1) != \"hit\":\n                violations.add(\"graph_cache_miss\")\n                all_cache_hits = False\n    policy = {\n        \"tool_call_count\": len(tools),\n        \"trace_sha256\": _document_sha256(tools),\n        \"policy_compliant\": not violations,\n        \"violation_codes\": sorted(violations),\n    }\n    telemetry = {\n        \"retrieval_call_count\": retrieval_count,\n        \"controller_observed_latency_ms\": min(\n            controller_latency_ms, task_wall_time_ms,\n        ),\n        \"entire_graph_call_count\": len(graph_tools),\n        \"product_reported_total_latency_ms\": graph_latency_ms,\n        \"entire_graph_all_index_cache_hits\": all_cache_hits,\n    }\n    return policy, telemetry\n\n\ndef _usage_and_cost(\n    result: dict[str, Any] | None, prices: dict[str, str],\n) -> tuple[dict[str, int], str, bool]:\n    raw = result.get(\"usage\") if type(result) is dict else None\n    valid = type(raw) is dict\n    fields = (\n        \"input_tokens\", \"output_tokens\", \"cache_creation_input_tokens\",\n        \"cache_read_input_tokens\",\n    )\n    usage: dict[str, int] = {}\n    for field in fields:\n        value = raw.get(field) if type(raw) is dict else 0\n        if type(value) is not int or value < 0:\n            valid = False\n            value = 0\n        usage[field] = value\n    usage[\"total_model_tokens\"] = sum(usage.values())\n    cost = sum(\n        Decimal(usage[field]) * Decimal(prices[price_field]) / Decimal(1_000_000)\n        for field, price_field in zip(fields, PRICE_FIELDS, strict=True)\n    )\n    return usage, _decimal_string(cost, \"attempt cost\", positive=False), valid\n\n\ndef _validate_attempt_row(\n    row: dict[str, Any], expected_identity: dict[str, Any], *,\n    task_wall_time_ms: int,\n) -> None:\n    scorer._require_fields(row, scorer.ATTEMPT_FIELDS, \"attempt\")\n    if any(row.get(field) != value for field, value in expected_identity.items()):\n        raise IssueAnalysisError(\"attempt result identity differs from the frozen schedule\")\n    status = row.get(\"terminal_status\")\n    if status == \"success\":\n        if (\n            row.get(\"failure_code\") is not None\n            or row.get(\"return_code\") != 0\n            or row.get(\"timed_out\") is not False\n        ):\n            raise IssueAnalysisError(\"successful attempt has inconsistent terminal fields\")\n        scorer._validate_final_answer(row.get(\"final_answer\"), \"attempt.final_answer\")\n    elif status == \"failure\":\n        if (\n            not isinstance(row.get(\"failure_code\"), str)\n            or scorer.SAFE_CODE_RE.fullmatch(row[\"failure_code\"]) is None\n            or row.get(\"final_answer\") is not None\n        ):\n            raise IssueAnalysisError(\"failed attempt has inconsistent terminal fields\")\n    else:\n        raise IssueAnalysisError(\"attempt result terminal status is malformed\")\n    if row.get(\"timed_out\") is True and row.get(\"return_code\") is not None:\n        raise IssueAnalysisError(\"timed-out attempt may not retain a return code\")\n    scorer._validate_usage(row.get(\"usage\"), \"attempt.usage\")\n    scorer._validate_timing(row.get(\"timing\"), \"attempt.timing\")\n    scorer._validate_setup_reference(row.get(\"setup_reference\"), \"attempt.setup_reference\")\n    tool = scorer._validate_tool_policy(row.get(\"tool_evidence\"), \"attempt.tool_evidence\")\n    scorer._validate_retrieval_telemetry(\n        row.get(\"retrieval_telemetry\"),\n        system=row[\"system\"],\n        tool_call_count=tool[\"tool_call_count\"],\n        task_wall_time_ms=task_wall_time_ms,\n        label=\"attempt.retrieval_telemetry\",\n    )\n    for field in (\"transcript_sha256\", \"stderr_sha256\"):\n        if not _is_sha256(row.get(field)):\n            raise IssueAnalysisError(f\"attempt {field} is malformed\")\n    if _decimal_string(\n        row.get(\"cost_usd\"), \"attempt cost\", positive=False,\ndef _attempt_identity(\n    attempt: dict[str, Any], checkout: dict[str, Any],\n) -> dict[str, Any]:\n    return {\n        \"pair_index\": attempt[\"pair_index\"],\n        \"repository_id\": attempt[\"repository_id\"],\n        \"repetition_index\": attempt[\"repetition_index\"],\n        \"system\": attempt[\"system\"],\n        \"system_position\": attempt[\"system_position\"],\n        \"case_id\": checkout[\"id\"],\n    }\n\n\ndef _attempt_output_root(output: Path, attempt: dict[str, Any]) -> Path:\n    return (\n        output / \"attempts\"\n        / f\"pair-{attempt['pair_index']:04d}-repeat-{attempt['repetition_index']:03d}\"\n        / attempt[\"system\"]\n    )\n\n\ndef _validate_output_root(output: Path, freeze: dict[str, Any]) -> Path:\n    if output.exists() and (output.is_symlink() or not output.is_dir()):\n        raise IssueAnalysisError(\"run output must be a real directory, not a symlink\")\n    output.mkdir(parents=True, exist_ok=True)\n    root = output.resolve(strict=True)\n    protected = [\n        Path(freeze[\"cache_policy\"][\"root\"]).resolve(strict=True),\n        Path(freeze[\"product_source\"][\"path\"]).resolve(strict=True),\n        Path(freeze[\"materialized_root\"]).resolve(strict=True),\n        *(Path(row[\"path\"]).resolve(strict=True) for row in freeze[\"checkouts\"]),\n    ]\n    if any(_paths_overlap(root, path) for path in protected):\n        raise IssueAnalysisError(\"run output must be disjoint from caches and source checkouts\")\n    return root\n\n\ndef _reset_isolated_runtime_directory(path: Path, cache_root: Path) -> None:\n    candidate = path.resolve(strict=False)\n    if not candidate.is_relative_to(cache_root):\n        raise IssueAnalysisError(\"attempt runtime path escaped the frozen cache root\")\n    if path.exists() and path.is_symlink():\n        raise IssueAnalysisError(\"attempt runtime path may not be a symlink\")\n    if path.exists():\n        shutil.rmtree(path)\n    path.mkdir(parents=True, mode=0o700)\n\n\ndef _agent_environment(\n    freeze: dict[str, Any], attempt: dict[str, Any], claude_config: Path,\n) -> dict[str, str]:\n    prefix = freeze[\"protocol\"][\"runtime_path_prefix\"]\n    path = os.defpath if not prefix else prefix + os.pathsep + os.defpath\n    return {\n        \"PATH\": path,\n        \"HOME\": attempt[\"home\"],\n        \"CLAUDE_CONFIG_DIR\": str(claude_config),\n        \"XDG_CACHE_HOME\": str(Path(attempt[\"home\"]) / \".cache\"),\n        \"XDG_CONFIG_HOME\": str(Path(attempt[\"home\"]) / \".config\"),\n        \"XDG_DATA_HOME\": str(Path(attempt[\"home\"]) / \".local\" / \"share\"),\n        \"TMPDIR\": attempt[\"temp\"],\n        \"CLAUDE_CODE_TMPDIR\": attempt[\"temp\"],\n        \"CLAUDE_TMPDIR\": attempt[\"temp\"],\n        \"ENTIRE_GRAPH_CACHE_DIR\": attempt[\"graph_cache\"],\n        \"CBM_CACHE_DIR\": attempt[\"cbm_cache\"],\n        \"CI\": \"1\",\n        \"NO_COLOR\": \"1\",\n        \"TERM\": \"dumb\",\n        \"LANG\": \"C\",\n        \"LC_ALL\": \"C\",\n        \"TZ\": \"UTC\",\n        \"GIT_TERMINAL_PROMPT\": \"0\",\n        \"GIT_CONFIG_GLOBAL\": \"/dev/null\",\n        \"GIT_CONFIG_NOSYSTEM\": \"1\",\n        \"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC\": \"1\",\n        \"DISABLE_AUTOUPDATER\": \"1\",\n        \"BASH_ENV\": \"/dev/null\",\n        \"ENV\": \"/dev/null\",\n    }\n\n\ndef _start_document(\n    *, identity: dict[str, Any], checkout: dict[str, Any], setup_sha256: str,\n    freeze_sha256: str, authorization_sha256: str, preflight_sha256: str,\n    project_instructions_sha256: str, prompt_sha256: str,\n    mcp_config_sha256: str, command_sha256: str | None,\n    sandbox_profile_sha256: str | None, environment_sha256: str | None,\n    allocated_budget_usd: str, paid_call_may_have_started: bool,\n) -> dict[str, Any]:\n    return {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": ATTEMPT_START_STAGE,\n        \"development_only\": True,\n        \"execution_freeze_sha256\": freeze_sha256,\n        \"execution_authorization_sha256\": authorization_sha256,\n        \"preflight_sha256\": preflight_sha256,\n        **identity,\n        \"commit\": checkout[\"commit\"],\n        \"tree\": checkout[\"tree\"],\n        \"setup_record_sha256\": setup_sha256,\n        \"project_claude_md_sha256\": project_instructions_sha256,\n        \"prompt_sha256\": prompt_sha256,\n        \"mcp_config_sha256\": mcp_config_sha256,\n        \"command_sha256\": command_sha256,\n        \"sandbox_profile_sha256\": sandbox_profile_sha256,\n        \"environment_sha256\": environment_sha256,\n        \"allocated_budget_usd\": allocated_budget_usd,\n        \"paid_call_may_have_started\": paid_call_may_have_started,\n    }\n\n\ndef _complete_document(\n    *, row: dict[str, Any], start_sha256: str, freeze_sha256: str,\n    authorization_sha256: str, preflight_sha256: str,\n) -> dict[str, Any]:\n    return {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": ATTEMPT_COMPLETE_STAGE,\n        \"development_only\": True,\n        \"execution_freeze_sha256\": freeze_sha256,\n        \"execution_authorization_sha256\": authorization_sha256,\n        \"preflight_sha256\": preflight_sha256,\n        \"attempt_start_sha256\": start_sha256,\n        \"attempt\": row,\n    }\n\n\ndef _load_completed_attempt(\n    *, start_path: Path, complete_path: Path, expected_start: dict[str, Any],\n    identity: dict[str, Any], setup: dict[str, Any], freeze_sha256: str,\n    authorization_sha256: str, preflight_sha256: str,\n) -> tuple[dict[str, Any], str] | None:\n    if not start_path.exists() and not complete_path.exists():\n        return None\n    if not start_path.is_file():\n        raise IssueAnalysisError(\"attempt result exists without its atomic start marker\")\n    start = artifacts.read_canonical_json(start_path, expected_type=dict).document\n    if start != expected_start:\n        raise IssueAnalysisError(\"existing attempt start differs from its exact command binding\")\n    start_sha256 = artifacts.sha256_file(start_path)\n    if not complete_path.is_file():\n        raise IssueAnalysisError(\n            \"attempt may already have launched but has no complete record; refusing a duplicate call\"\n        )\n    complete = artifacts.read_canonical_json(complete_path, expected_type=dict).document\n    expected_fields = {\n        \"schema_version\", \"suite\", \"stage\", \"development_only\",\n        \"execution_freeze_sha256\", \"execution_authorization_sha256\",\n        \"preflight_sha256\", \"attempt_start_sha256\", \"attempt\",\n    }\n    if (\n        set(complete) != expected_fields\n        or complete.get(\"schema_version\") != 1\n        or complete.get(\"suite\") != SUITE\n        or complete.get(\"stage\") != ATTEMPT_COMPLETE_STAGE\n        or complete.get(\"development_only\") is not True\n        or complete.get(\"execution_freeze_sha256\") != freeze_sha256\n        or complete.get(\"execution_authorization_sha256\") != authorization_sha256\n        or complete.get(\"preflight_sha256\") != preflight_sha256\n        or complete.get(\"attempt_start_sha256\") != start_sha256\n    ):\n        raise IssueAnalysisError(\"existing complete attempt binding is malformed\")\n    row = complete.get(\"attempt\")\n    if type(row) is not dict:\n        raise IssueAnalysisError(\"existing complete attempt row is malformed\")\n    _validate_attempt_row(\n        row, identity, task_wall_time_ms=row.get(\"timing\", {}).get(\"task_wall_time_ms\", -1),\n    )\n    setup_reference = row[\"setup_reference\"]\n    if setup_reference != {\n        \"setup_record_sha256\": start[\"setup_record_sha256\"],\n        \"setup_index_wall_time_ms\": setup[\"setup_wall_time_ms\"],\n        \"setup_excluded_from_task_timing\": True,\n    }:\n        raise IssueAnalysisError(\"existing attempt setup reference differs from preflight\")\n    return row, artifacts.sha256_file(complete_path)\n\n\ndef _zero_usage() -> dict[str, int]:\n    return {\n        \"input_tokens\": 0,\n        \"output_tokens\": 0,\n        \"cache_creation_input_tokens\": 0,\n        \"cache_read_input_tokens\": 0,\n        \"total_model_tokens\": 0,\n    }\n\n\ndef _budget_exhausted_row(\n    identity: dict[str, Any], setup: dict[str, Any], setup_sha256: str,\n) -> dict[str, Any]:\n    empty_trace = _document_sha256([])\n    return {\n        **identity,\n        \"terminal_status\": \"failure\",\n        \"failure_code\": \"total_budget_exhausted\",\n        \"final_answer\": None,\n        \"usage\": _zero_usage(),\n        \"cost_usd\": \"0\",\n        \"timing\": {\"task_wall_time_ms\": 0},\n        \"setup_reference\": {\n            \"setup_record_sha256\": setup_sha256,\n            \"setup_index_wall_time_ms\": setup[\"setup_wall_time_ms\"],\n            \"setup_excluded_from_task_timing\": True,\n        },\n        \"tool_evidence\": {\n            \"tool_call_count\": 0,\n            \"trace_sha256\": empty_trace,\n            \"policy_compliant\": False,\n            \"violation_codes\": [\"total_budget_exhausted\"],\n        },\n        \"retrieval_telemetry\": {\n            \"retrieval_call_count\": 0,\n            \"controller_observed_latency_ms\": 0,\n            \"entire_graph_call_count\": 0,\n            \"product_reported_total_latency_ms\": None,\n            \"entire_graph_all_index_cache_hits\": None,\n        },\n        \"transcript_sha256\": artifacts.sha256_bytes(b\"\"),\n        \"stderr_sha256\": artifacts.sha256_bytes(b\"\"),\n        \"return_code\": None,\n        \"timed_out\": False,\n    }\n\n\ndef _attempt_result_row(\n    *, identity: dict[str, Any], setup: dict[str, Any], setup_sha256: str,\n    system: str, checkout: Path, graph_binary: Path, graph_cache: Path,\n    cbm_project: str | None, stdout: bytes, stderr: bytes,\n    return_code: int | None, timed_out: bool, task_wall_time_ms: int,\n    prices: dict[str, str], allocated_budget_usd: str,\n    max_turns: int,\n    checkout_changed: bool, graph_cache_changed: bool,\n) -> dict[str, Any]:\n    failure_code: str | None = None\n    try:\n        parsed = _parse_agent_stream(stdout)\n    except Exception:\n        parsed = {\"parse_errors\": [{\"line\": 0}], \"tools\": [], \"result\": None}\n        failure_code = \"stream_parse_error\"\n    result = parsed.get(\"result\") if type(parsed) is dict else None\n    tools = parsed.get(\"tools\") if type(parsed) is dict else []\n    if type(tools) is not list:\n        tools = []\n        failure_code = failure_code or \"stream_parse_error\"\n    tool_evidence, telemetry = _audit_tools(\n        system, tools, checkout=checkout, graph_binary=graph_binary,\n        graph_cache=graph_cache, cbm_project=cbm_project,\n        task_wall_time_ms=task_wall_time_ms,\n    )\n    violations = set(tool_evidence[\"violation_codes\"])\n    if checkout_changed:\n        violations.add(\"checkout_changed\")\n    if graph_cache_changed:\n        violations.add(\"graph_cache_changed\")\n    tool_evidence[\"violation_codes\"] = sorted(violations)\n    tool_evidence[\"policy_compliant\"] = not violations\n    usage, cost_usd, usage_valid = _usage_and_cost(result, prices)\n    final_answer = _structured_agent_result(result)\n\n    if timed_out:\n        failure_code = \"timeout\"\n    elif return_code is None:\n        failure_code = failure_code or \"runtime_launch_failed\"\n    elif return_code != 0:\n        failure_code = failure_code or \"agent_process_failed\"\n    elif parsed.get(\"parse_errors\"):\n        failure_code = failure_code or \"stream_parse_error\"\n    elif type(result) is not dict:\n        failure_code = failure_code or \"missing_result_event\"\n    elif result.get(\"is_error\") is True:\n        failure_code = failure_code or \"agent_result_error\"\n    elif not usage_valid:\n        failure_code = failure_code or \"invalid_usage\"\n    elif type(result.get(\"num_turns\")) is not int or result[\"num_turns\"] < 0:\n        failure_code = failure_code or \"invalid_turn_count\"\n    elif result[\"num_turns\"] > max_turns:\n        failure_code = failure_code or \"turn_limit_exceeded\"\n    elif Decimal(cost_usd) > Decimal(allocated_budget_usd):\n        failure_code = failure_code or \"budget_limit_exceeded\"\n    elif not tool_evidence[\"policy_compliant\"]:\n        failure_code = failure_code or \"tool_policy_violation\"\n    else:\n        try:\n            scorer._validate_final_answer(final_answer, \"agent final answer\")\n        except (scorer.ScoringError, TypeError, ValueError):\n            failure_code = \"invalid_final_answer\"\n\n    reported_cost = result.get(\"total_cost_usd\") if type(result) is dict else None\n    if failure_code is None and reported_cost is not None:\n        try:\n            if _decimal_string(\n                reported_cost, \"agent-reported cost\", positive=False,\n            ) != cost_usd:\n                failure_code = \"reported_cost_mismatch\"\n        except IssueAnalysisError:\n            failure_code = \"reported_cost_mismatch\"\n    row = {\n        **identity,\n        \"terminal_status\": \"failure\" if failure_code else \"success\",\n        \"failure_code\": failure_code,\n        \"final_answer\": None if failure_code else final_answer,\n        \"usage\": usage,\n        \"cost_usd\": cost_usd,\n        \"timing\": {\"task_wall_time_ms\": task_wall_time_ms},\n        \"setup_reference\": {\n            \"setup_record_sha256\": setup_sha256,\n            \"setup_index_wall_time_ms\": setup[\"setup_wall_time_ms\"],\n            \"setup_excluded_from_task_timing\": True,\n        },\n        \"tool_evidence\": tool_evidence,\n        \"retrieval_telemetry\": telemetry,\n        \"transcript_sha256\": artifacts.sha256_bytes(stdout),\n        \"stderr_sha256\": artifacts.sha256_bytes(stderr),\n        \"return_code\": return_code,\n        \"timed_out\": timed_out,\n    }\n    return row\n\n\ndef run_authorized(\n    freeze_path: Path, authorization_path: Path, preflight_path: Path,\n    output: Path, *, expected_authorization_sha256: str,\n    expected_preflight_sha256: str,\n    process_runner: AgentProcessRunner = runtime.run_command,\n    credential_copier: CredentialCopier = runtime.copy_claude_credentials,\n    sandbox_builder: SandboxBuilder = _sandbox_agent_command,\n) -> dict[str, Any]:\n    \"\"\"Run the exact sequential adapter after both independent hashes authorize it.\"\"\"\n    if not expected_authorization_sha256:\n        raise IssueAnalysisError(\"run requires the separately supplied exact authorization SHA-256\")\n    authorization = validate_execution_authorization(\n        freeze_path, authorization_path,\n        expected_authorization_sha256=expected_authorization_sha256,\n    )\n    if authorization[\"paid_execution_authorized\"] is not True:\n        raise IssueAnalysisError(\"paid execution is not authorized by the exact authorization artifact\")\n    freeze = validate_execution_freeze(freeze_path)\n    preflight_report = validate_preflight_report(\n        freeze_path, authorization_path, preflight_path,\n        expected_preflight_sha256=expected_preflight_sha256,\n    )\n    if preflight_report[\"paid_execution_authorized\"] is not True:\n        raise IssueAnalysisError(\"exact preflight does not carry paid authorization\")\n    freeze_sha256 = artifacts.sha256_file(freeze_path)\n    authorization_sha256 = artifacts.sha256_file(authorization_path)\n    preflight_sha256 = artifacts.sha256_file(preflight_path)\n    result_root = _validate_output_root(output, freeze)\n    result_path = result_root / \"attempt-results.json\"\n    attestation_path = result_root / \"run-attestation.json\"\n    checkouts = {row[\"repository_id\"]: row for row in freeze[\"checkouts\"]}\n    prompts = {\n        (row[\"repository_id\"], row[\"system\"]): row\n        for row in freeze[\"prompt_bindings\"]\n    }\n    setups = validate_completed_setup(freeze, freeze_sha256)\n    setup_by_key = {\n        (attempt[\"pair_index\"], attempt[\"repetition_index\"], attempt[\"system\"]): setup\n        for attempt, setup in zip(freeze[\"cache_policy\"][\"attempts\"], setups, strict=True)\n    }\n    setup_binding_by_key = {\n        (row[\"pair_index\"], row[\"repetition_index\"], row[\"system\"]): row\n        for row in preflight_report[\"setup_record_bindings\"]\n    }\n    attempts: list[dict[str, Any]] = []\n    complete_bindings: list[dict[str, Any]] = []\n    observed_cost = Decimal(0)\n    total_budget = Decimal(freeze[\"protocol\"][\"max_total_budget_usd\"])\n    per_attempt_budget = Decimal(freeze[\"protocol\"][\"max_budget_usd_per_attempt\"])\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
