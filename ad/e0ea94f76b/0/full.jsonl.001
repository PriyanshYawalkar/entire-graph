_readerIndex: Int = 0\ninternal/sem/search.go:104:\tIndexLatencyMS     int64 `json:\"index_latency_ms\"`\ninternal/sem/search.go:105:\tSearchLatencyMS    int64 `json:\"search_latency_ms\"`\ninternal/sem/search.go:106:\tPreselectLatencyMS int64 `json:\"preselect_latency_ms\"`\ninternal/sem/search.go:1605:\t\t\t\tdiscovered = append(discovered, indexedUsage{candidate: candidate, seedIndex: seedIndex})\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
