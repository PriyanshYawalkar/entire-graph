{"timestamp":"2026-07-18T16:30:20.153Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5baa1c278c8191a2da22ed2db9d63e","status":"completed","call_id":"call_nowFWaSB7xdEXfPZszn865ri","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '900,1060p' competitive-eval/tools/materialize_agentic_issue_analysis_smoke.py && sed -n '270,350p' competitive-eval/tools/materialize_agentic_issue_analysis_smoke.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 24000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:30:20.351Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7610-7ebf-74c3-8757-c080d954a029","call_id":"call_nowFWaSB7xdEXfPZszn865ri","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"        if row.get(\"judgment_count\") != len(judgments):\n            raise MaterializationError(\"sealed controller judgment count mismatch\")\n    _assert_no_host_paths(sealed, \"sealed controller\")\n\n\ndef validate_attestation_contract(\n    attestation: dict[str, Any], public: dict[str, Any], sealed: dict[str, Any]\n) -> None:\n    if (\n        attestation.get(\"suite\") != SUITE\n        or attestation.get(\"stage\") != ATTESTATION_STAGE\n        or attestation.get(\"development_only\") is not True\n        or attestation.get(\"model_or_paid_process_used\") is not False\n        or attestation.get(\"system_output_data_consulted\") is not False\n        or attestation.get(\"rank_data_consulted\") is not False\n        or attestation.get(\"score_data_consulted\") is not False\n        or attestation.get(\"controller_judgments_agent_visible\") is not False\n    ):\n        raise MaterializationError(\"materialization attestation contract mismatch\")\n    if any(attestation.get(field) is not False for field in AUTHORITY_FIELDS):\n        raise MaterializationError(\"materialization attestation grants authority\")\n    expected_generator = artifacts.sha256_file(Path(__file__))\n    expected_dependencies = {\n        \"artifact_contract_sha256\": artifacts.sha256_file(Path(artifacts.__file__))\n    }\n    if (\n        attestation.get(\"generator_sha256\") != expected_generator\n        or attestation.get(\"producer_dependency_bindings\") != expected_dependencies\n        or attestation.get(\"public_tasks_sha256\") != _sha256_json(public)\n        or attestation.get(\"sealed_controller_sha256\") != _sha256_json(sealed)\n        or attestation.get(\"cohort_sha256\") != public.get(\"cohort_sha256\")\n        or attestation.get(\"cohort_sha256\") != sealed.get(\"cohort_sha256\")\n        or attestation.get(\"source\") != {\n            **public.get(\"source\", {}),\n            \"source_row_count\": attestation.get(\"source\", {}).get(\"source_row_count\"),\n        }\n        or public.get(\"source\") != sealed.get(\"source\")\n    ):\n        raise MaterializationError(\"materialization attestation hash binding mismatch\")\n    public_bindings = _case_bindings(public)\n    checkout_projection = sorted(\n        (\n            {\n                field: row[field]\n                for field in (\n                    \"id\",\n                    \"repo\",\n                    \"normalized_repo\",\n                    \"base_commit\",\n                    \"base_tree\",\n                    \"checkout_relative_path\",\n                    \"source_record_sha256\",\n                    \"query_record_sha256\",\n                )\n            }\n            for row in public_bindings.values()\n        ),\n        key=lambda row: row[\"id\"],\n    )\n    if attestation.get(\"checkout_binding_sha256\") != _sha256_json(checkout_projection):\n        raise MaterializationError(\"materialization checkout binding mismatch\")\n    if attestation.get(\"source_record_binding_sha256\") != _sha256_json(\n        sorted(row[\"source_record_sha256\"] for row in public_bindings.values())\n    ):\n        raise MaterializationError(\"materialization source record binding mismatch\")\n    _assert_no_host_paths(attestation, \"materialization attestation\")\n\n\ndef publish_artifacts(\n    public_path: Path,\n    sealed_path: Path,\n    attestation_path: Path,\n    public: dict[str, Any],\n    sealed: dict[str, Any],\n    attestation: dict[str, Any],\n) -> None:\n    paths = [Path(public_path), Path(sealed_path), Path(attestation_path)]\n    documents = [public, sealed, attestation]\n    if len({path.absolute() for path in paths}) != 3:\n        raise MaterializationError(\"output paths must be distinct\")\n    validate_public_contract(public)\n    validate_sealed_contract(sealed, public)\n    validate_attestation_contract(attestation, public, sealed)\n\n    existing = [path.exists() or path.is_symlink() for path in paths]\n    if all(existing):\n        raise MaterializationError(\"refusing to overwrite a complete materialization trio\")\n    # A prior publication can be interrupted after one or two atomic renames.\n    # Recover only when every present byte is exactly the intended artifact;\n    # unknown or tampered partial output remains a hard no-overwrite failure.\n    for path, document, present in zip(paths, documents, existing, strict=True):\n        if not present:\n            continue\n        opened = artifacts.read_canonical_json(path, expected_type=dict)\n        artifacts.validate_exact_document(opened.document, document, f\"partial artifact {path.name}\")\n    for path, document, present in zip(paths, documents, existing, strict=True):\n        if not present:\n            artifacts.write_new_canonical_json(path, document)\n\n\ndef validate_artifacts(\n    public_path: Path,\n    sealed_path: Path,\n    attestation_path: Path,\n    expected: tuple[dict[str, Any], dict[str, Any], dict[str, Any]],\n) -> None:\n    observed: list[dict[str, Any]] = []\n    for path, document, label in zip(\n        (public_path, sealed_path, attestation_path),\n        expected,\n        (\"public tasks\", \"sealed controller\", \"materialization attestation\"),\n        strict=True,\n    ):\n        opened = artifacts.read_canonical_json(Path(path), expected_type=dict)\n        artifacts.validate_exact_document(opened.document, document, label)\n        observed.append(opened.document)\n    validate_public_contract(observed[0])\n    validate_sealed_contract(observed[1], observed[0])\n    validate_attestation_contract(observed[2], observed[0], observed[1])\n\n\ndef _load_inputs(args: argparse.Namespace, *, allow_checkout_creation: bool) -> tuple[\n    dict[str, Any], str, list[dict[str, Any]], int, CheckoutProvider\n]:\n    cohort_opened = artifacts.read_canonical_json(\n        Path(args.cohort), expected_sha256=args.cohort_sha256, expected_type=dict\n    )\n    repositories = _validate_cohort(cohort_opened.document)\n    parquet_path = Path(args.parquet)\n    source_observation = artifacts.observe_regular_file(\n        parquet_path, maximum_bytes=512 * 1024 * 1024\n    )\n    if (\n        source_observation.sha256 != PARQUET_SHA256\n        or source_observation.byte_count != PARQUET_BYTES\n    ):\n        raise MaterializationError(\"pinned SWE-rebench V2 parquet hash mismatch\")\n    rows, row_count = _read_selected_parquet_rows(parquet_path, repositories)\n    artifacts.assert_file_stat_identity(\n        parquet_path, source_observation.stat_identity, \"source parquet\"\n    )\n    if row_count != SOURCE_ROW_COUNT:\n        raise MaterializationError(\"pinned SWE-rebench V2 row count mismatch\")\n    if allow_checkout_creation:\n        provider = ensure_checkout\n    else:\n        def provider(root: Path, case: dict[str, Any]) -> dict[str, Any]:\n            checkout = root / \"cases\" / case[\"id\"]\n            inspected = _inspect_checkout(checkout, case)\n            return {\n                **inspected,\n                \"checkout_relative_path\": f\"cases/{case['id']}\",\n            }\n    return cohort_opened.document, cohort_opened.sha256, rows, row_count, provider\n\n\ndef _build_from_args(\n    args: argparse.Namespace, *, allow_checkout_creation: bool\n) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:\n    cohort, cohort_sha, rows, row_count, provider = _load_inputs(\n        args, allow_checkout_creation=allow_checkout_creation\n    )\n    return \"egias-\" + hashlib.sha256(material).hexdigest()[:24]\n\n\ndef _authority_flags() -> dict[str, bool]:\n    return {field: False for field in AUTHORITY_FIELDS}\n\n\ndef _source_descriptor() -> dict[str, Any]:\n    return {\n        \"dataset\": DATASET,\n        \"dataset_revision\": DATASET_REVISION,\n        \"dataset_api_metadata_sha256\": DATASET_API_METADATA_SHA256,\n        \"parquet_revision\": PARQUET_REVISION,\n        \"parquet_sha256\": PARQUET_SHA256,\n        \"parquet_byte_count\": PARQUET_BYTES,\n        \"source_row_count\": SOURCE_ROW_COUNT,\n        \"logical_path\": SOURCE_LOGICAL_PATH,\n    }\n\n\ndef _validate_cohort(document: Any) -> list[dict[str, Any]]:\n    if type(document) is not dict:\n        raise MaterializationError(\"cohort is not an object\")\n    if (\n        document.get(\"schema_version\") != 1\n        or document.get(\"suite\") != SUITE\n        or document.get(\"stage\") != COHORT_STAGE\n        or document.get(\"development_only\") is not True\n        or document.get(\"repository_count\") != REPOSITORY_COUNT\n    ):\n        raise MaterializationError(\"cohort contract mismatch\")\n    for field in AUTHORITY_FIELDS:\n        if document.get(field) is not False:\n            raise MaterializationError(f\"cohort grants authority: {field}\")\n    claim = document.get(\"claim_boundary\")\n    if type(claim) is not dict or any(\n        claim.get(field) is not False\n        for field in (\n            \"code_repair_claim_allowed\",\n            \"broad_superiority_claim_allowed\",\n            \"confirmatory_claim_allowed\",\n        )\n    ):\n        raise MaterializationError(\"cohort claim boundary mismatch\")\n    source_binding = (document.get(\"source_bindings\") or {}).get(\n        \"swe_rebench_v2_metadata\"\n    )\n    expected_source = {\n        \"dataset\": DATASET,\n        \"dataset_revision\": DATASET_REVISION,\n        \"dataset_api_metadata_sha256\": DATASET_API_METADATA_SHA256,\n        \"parquet_revision\": PARQUET_REVISION,\n        \"logical_path\": SOURCE_LOGICAL_PATH,\n        \"sha256\": PARQUET_SHA256,\n        \"byte_count\": PARQUET_BYTES,\n        \"row_count\": SOURCE_ROW_COUNT,\n    }\n    if type(source_binding) is not dict or any(\n        source_binding.get(field) != value for field, value in expected_source.items()\n    ):\n        raise MaterializationError(\"cohort pinned source binding mismatch\")\n    rows = document.get(\"repositories\")\n    if type(rows) is not list or len(rows) != REPOSITORY_COUNT:\n        raise MaterializationError(\"cohort repository collection mismatch\")\n    result: list[dict[str, Any]] = []\n    seen: set[str] = set()\n    for row in rows:\n        if type(row) is not dict:\n            raise MaterializationError(\"cohort repository row is malformed\")\n        repo = canonical_repo(row.get(\"repo\"))\n        normalized = normalize_repo(repo)\n        if row.get(\"normalized_repo\") != normalized:\n            raise MaterializationError(\"cohort normalized repository mismatch\")\n        if normalized in seen:\n            raise MaterializationError(\"cohort contains duplicate repository\")\n        seen.add(normalized)\n        language = _require_string(row.get(\"language\"), \"cohort language\").casefold()\n        projected: dict[str, Any] = {\n            \"repo\": repo,\n            # The freezer copies this spelling byte-for-byte from its source\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
