{"timestamp":"2026-07-18T18:32:47.410Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7680-9a32-7cb1-a347-06a4062636c2","call_id":"call_oVmg8AYl8oXsDwC8oR1vJXtV","output":[{"type":"input_text","text":"Script completed\nWall time 0.4 seconds\nOutput:\n"},{"type":"input_text","text":"        \"attempt_result_schema_sha256\": freeze[\"attempt_result_schema_sha256\"],\n        \"checkouts_sha256\": _document_sha256(freeze[\"checkouts\"]),\n        \"prompt_bindings_sha256\": _document_sha256(freeze[\"prompt_bindings\"]),\n        \"allowed_tool_policy_sha256\": _document_sha256(freeze[\"allowed_tool_policy\"]),\n        \"schedule_sha256\": freeze[\"schedule\"][\"schedule_sha256\"],\n        \"protocol_sha256\": _document_sha256(freeze[\"protocol\"]),\n        \"pricing_provenance_sha256\": _document_sha256(\n            freeze[\"protocol\"][\"pricing_provenance\"]\n        ),\n        \"cache_policy_sha256\": _document_sha256(freeze[\"cache_policy\"]),\n        \"timing_policy_sha256\": _document_sha256(freeze[\"timing_policy\"]),\n        \"network_policy_sha256\": _document_sha256(freeze[\"network_policy\"]),\n        \"graph_phase_telemetry_definitions_sha256\": _document_sha256(\n            freeze[\"graph_phase_telemetry_field_definitions\"]\n        ),\n    }\n\n\ndef create_execution_authorization(\n    freeze_path: Path, output: Path, *,\n    authorization_note: str = \"unpaid freeze only; no paid/model execution authorized\",\n) -> dict[str, Any]:\n    \"\"\"Write only the safe false default; true authority is external user input.\"\"\"\n    if not isinstance(authorization_note, str) or not authorization_note.strip():\n        raise IssueAnalysisError(\"authorization_note must be non-empty\")\n    freeze = validate_execution_freeze(freeze_path)\n    freeze_sha256 = artifacts.sha256_file(freeze_path)\n    document = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": AUTHORIZATION_STAGE,\n        \"development_only\": True,\n        \"authority_source\": \"local_safe_false_default\",\n        \"external_user_authorization\": None,\n        \"paid_execution_authorized\": False,\n        \"model_execution_authorized\": False,\n        **{field: False for field in AUTHORITY_FALSE_FIELDS},\n        \"authorization_note\": authorization_note.strip(),\n        \"bindings\": _authorization_bindings(freeze, freeze_sha256),\n    }\n    _write_once_or_match(output, document, \"execution authorization\")\n    return document\n\n\ndef validate_execution_authorization(\n    freeze_path: Path, authorization_path: Path, *, expected_authorization_sha256: str | None = None,\n) -> dict[str, Any]:\n    freeze = validate_execution_freeze(freeze_path)\n    if expected_authorization_sha256 is not None and re.fullmatch(\n        r\"[0-9a-f]{64}\", expected_authorization_sha256,\n    ) is None:\n        raise IssueAnalysisError(\"expected authorization SHA-256 is malformed\")\n    artifact = artifacts.read_canonical_json(\n        authorization_path, expected_type=dict,\n        expected_sha256=expected_authorization_sha256,\n    )\n    authorization = artifact.document\n    expected_fields = {\n        \"schema_version\", \"suite\", \"stage\", \"development_only\",\n        \"authority_source\", \"external_user_authorization\",\n        \"paid_execution_authorized\", \"model_execution_authorized\",\n        *AUTHORITY_FALSE_FIELDS, \"authorization_note\", \"bindings\",\n    }\n    if (\n        set(authorization) != expected_fields\n        or authorization.get(\"schema_version\") != 1\n        or authorization.get(\"suite\") != SUITE\n        or authorization.get(\"stage\") != AUTHORIZATION_STAGE\n        or authorization.get(\"development_only\") is not True\n        or type(authorization.get(\"paid_execution_authorized\")) is not bool\n    ):\n        raise IssueAnalysisError(\"execution authorization identity is malformed\")\n    _validate_false_authority(authorization, separate_paid_authorization=True)\n    if authorization[\"paid_execution_authorized\"]:\n        if expected_authorization_sha256 is None:\n            raise IssueAnalysisError(\n                \"true execution authority requires its externally supplied exact SHA-256\"\n            )\n        if (\n            authorization.get(\"authority_source\") != \"external_user_supplied\"\n            or authorization.get(\"external_user_authorization\") != {\n                \"kind\": \"exact_hash_paid_model_execution_authorization\",\n                \"exact_bindings_reviewed\": True,\n                \"model_and_budget_reviewed\": True,\n            }\n        ):\n            raise IssueAnalysisError(\n                \"true execution authority must be an external user authorization record\"\n            )\n    elif (\n        authorization.get(\"authority_source\") != \"local_safe_false_default\"\n        or authorization.get(\"external_user_authorization\") is not None\n    ):\n        raise IssueAnalysisError(\"false execution authority has an invalid origin\")\n    if not isinstance(authorization.get(\"authorization_note\"), str) or not authorization[\n        \"authorization_note\"\n    ].strip():\n        raise IssueAnalysisError(\"execution authorization note is malformed\")\n    expected = _authorization_bindings(freeze, artifacts.sha256_file(freeze_path))\n    if authorization.get(\"bindings\") != expected:\n        raise IssueAnalysisError(\"execution authorization does not match every frozen binding\")\n    return authorization\n\n\ndef _materialize_isolated_cache_paths(cache_policy: dict[str, Any]) -> None:\n    root = Path(cache_policy[\"root\"])\n"},{"type":"input_text","text":"            prices=freeze[\"protocol\"][\"prices_usd_per_million_tokens\"],\n            allocated_budget_usd=allocated_budget,\n            max_turns=freeze[\"protocol\"][\"max_turns_per_attempt\"],\n            checkout_changed=checkout_changed,\n            graph_cache_changed=graph_cache_changed,\n        )\n        if (\n            row[\"retrieval_telemetry\"][\"entire_graph_call_count\"] > 0\n            and row[\"retrieval_telemetry\"][\"entire_graph_all_index_cache_hits\"] is not True\n        ):\n            raise IssueAnalysisError(\n                \"Graph attempt did not prove a prepared-index cache hit; start marker retained\"\n            )\n        _validate_attempt_row(row, identity, task_wall_time_ms=task_wall_time_ms)\n        complete = _complete_document(\n            row=row, start_sha256=start_sha256,\n            freeze_sha256=freeze_sha256,\n            authorization_sha256=authorization_sha256,\n            preflight_sha256=preflight_sha256,\n            post_task_validation=post_task_validation,\n        )\n        complete_sha256 = _publish_canonical_once_or_match(\n            complete_path, complete, \"attempt result\",\n        )\n        attempts.append(row)\n        observed_cost += Decimal(row[\"cost_usd\"])\n        complete_bindings.append({\n            **identity, \"path\": str(complete_path.resolve(strict=True)),\n            \"sha256\": complete_sha256,\n        })\n\n    aggregate = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": scorer.ATTEMPT_RESULTS_STAGE,\n        \"development_only\": True,\n        \"synthetic_fixture\": False,\n        \"execution_freeze_sha256\": freeze_sha256,\n        \"execution_authorization_sha256\": authorization_sha256,\n        \"sealed_oracle_sha256\": freeze[\"inputs\"][\"sealed_oracle\"][\"sha256\"],\n        \"paid_execution_authorized\": True,\n        \"model_execution_authorized\": True,\n        \"controller_scoring_authorized\": False,\n        \"score_production_authorized\": False,\n        \"scores_present\": False,\n        \"outcomes_present\": False,\n        \"attempt_count\": len(attempts),\n        \"attempts\": attempts,\n    }\n    scorer.validate_attempt_results(\n        aggregate, freeze, execution_freeze_sha256=freeze_sha256,\n        sealed_oracle_sha256=freeze[\"inputs\"][\"sealed_oracle\"][\"sha256\"],\n        require_synthetic=False,\n    )\n    aggregate_sha256 = _publish_canonical_once_or_match(\n        result_path, aggregate, \"canonical attempt-results aggregate\",\n    )\n    observed_total_cost = sum(\n        (Decimal(row[\"cost_usd\"]) for row in attempts), Decimal(0)\n    )\n    attestation = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": RUN_ATTESTATION_STAGE,\n        \"development_only\": True,\n        \"execution_freeze_sha256\": freeze_sha256,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
