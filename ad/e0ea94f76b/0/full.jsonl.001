{"timestamp":"2026-07-18T18:16:55.094Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7672-1236-7cc3-83e9-2f15246fadb9","call_id":"call_tz3jzeylS6uLQq191SSppGtd","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"            or validation[\"nodes\"] <= 0\n            or smoke.cache_inventory(Path(attempt[\"cbm_cache\"]))\n            != validation.get(\"cache_inventory\")\n        ):\n            raise IssueAnalysisError(\"existing CBM cache differs from setup evidence\")\n    return record\n\n\ndef _setup_attempt(\n    freeze: dict[str, Any], attempt: dict[str, Any], checkout_binding: dict[str, Any],\n    *, freeze_sha256: str,\n) -> dict[str, Any]:\n    checkout = _assert_checkout_binding(checkout_binding)\n    attempt_root = Path(attempt[\"home\"]).parent\n    setup_path = attempt_root / \"setup.json\"\n    existing = _load_existing_setup(\n        setup_path, attempt=attempt, checkout=checkout_binding,\n        freeze_sha256=freeze_sha256,\n    )\n    if existing is not None:\n        return existing\n\n    graph_cache = Path(attempt[\"graph_cache\"])\n    cbm_cache = Path(attempt[\"cbm_cache\"])\n    if smoke.cache_inventory(graph_cache) or smoke.cache_inventory(cbm_cache):\n        raise IssueAnalysisError(\"uncommitted product cache state exists before setup\")\n    environment = runtime.runtime_environment(freeze[\"protocol\"][\"runtime_path_prefix\"])\n    environment.update({\n        \"HOME\": attempt[\"home\"],\n        \"TMPDIR\": attempt[\"temp\"],\n        \"GIT_CONFIG_GLOBAL\": \"/dev/null\",\n        \"GIT_CONFIG_NOSYSTEM\": \"1\",\n        \"CBM_CACHE_DIR\": attempt[\"cbm_cache\"],\n        \"ENTIRE_GRAPH_CACHE_DIR\": attempt[\"graph_cache\"],\n    })\n    timeout = freeze[\"protocol\"][\"timeout_seconds_per_attempt\"]\n    system = attempt[\"system\"]\n    commands: list[list[str]] = []\n    stdout = b\"\"\n    stderr = b\"\"\n    graph_search_validation_wall_time_ms: int | None = None\n    started = time.monotonic()\n    if system == \"file-tools\":\n        validation: dict[str, Any] = {\"status\": \"not_required\"}\n    elif system == \"entire-graph\":\n        graph = Path(freeze[\"binaries\"][\"entire_graph\"][\"path\"])\n        command = [\n            str(graph), \"index\", \"--repo\", str(checkout), \"--head\",\n            \"--profile\", \"full\", \"--cache-dir\", str(graph_cache), \"--format\", \"json\",\n        ]\n        search_command = [\n            str(graph), \"search\", \"--repo\", str(checkout),\n            \"--query\", \"__entire_graph_preflight_cache_validation__\",\n            \"--format\", \"json\", \"--head\", \"--profile\", \"full\",\n            \"--index-all-files\", \"--cache-dir\", str(graph_cache),\n        ]\n        commands = [command, command, search_command]\n        first_process = runtime.run_command(\n            command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        second_process = runtime.run_command(\n            command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        stdout = first_process.stdout + second_process.stdout\n        stderr = first_process.stderr + second_process.stderr\n        first = _parse_setup_response(first_process, \"Entire Graph fresh preindex\")\n        second = _parse_setup_response(second_process, \"Entire Graph cache validation\")\n        for response in (first, second):\n            counts = response.get(\"counts\")\n            if (\n                response.get(\"format_version\") != 1\n                or response.get(\"provider\") != \"entire-graph\"\n                or not isinstance(response.get(\"provider_version\"), str)\n                or not response[\"provider_version\"]\n                or response.get(\"commit\") != checkout_binding[\"commit\"]\n                or response.get(\"tree\") != checkout_binding[\"tree\"]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
