{"timestamp":"2026-07-18T16:12:22.509Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5ba5e685688191bef03c3caebf0a90","status":"completed","call_id":"call_MiGXPYMN0fdMsU2RFKDWhX7l","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '1,380p' competitive-eval/tools/construct_graph_holdout_v8.py && sed -n '1070,1230p' competitive-eval/tools/freeze_sem_holdout.py && sed -n '1,430p' competitive-eval/tools/analyze_sem_v7_capacity.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 60000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:12:22.719Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7600-0d3f-71f3-8f5c-f065907341dc","call_id":"call_MiGXPYMN0fdMsU2RFKDWhX7l","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"#!/usr/bin/env python3\n\"\"\"Construct and finalize the Graph V8 holdout after explicit authorization.\n\nThe module is deliberately inert before a reviewed pre-catalog decision exists.\nIt never runs retrieval.  ``prepare`` deterministically selects the candidate\ncohort and writes a public catalog plus a sealed construction plan. ``finalize``\naccepts only a complete qrel-blind screen and emits the materializer manifest,\npublic case manifest, and sealed qrels.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport hmac\nimport itertools\nimport json\nimport math\nimport re\nimport sys\nimport stat\nfrom collections import Counter, defaultdict\nfrom pathlib import Path, PurePosixPath\nfrom typing import Any, Iterable\n\nimport sem_v7_artifacts as artifacts\n\n\nSUITE = \"entire_graph_confirmatory_v8\"\nCONSTRUCTION_SEED = \"20260715-graph-confirmatory-v8\"\nPRECATALOG_ARTIFACT_PATHS = {\n    \"exclusion_freeze_sha256\": \"competitive-eval/graph-v8/graph-exclusion-freeze.json\",\n    \"toolchain_sha256\": \"competitive-eval/graph-v8/graph-toolchain-closure.json\",\n    \"design_freeze_sha256\": \"competitive-eval/graph-v8/graph-design-freeze.json\",\n    \"product_freeze_sha256\": \"competitive-eval/graph-v8/graph-product-freeze.json\",\n    \"comparator_products_sha256\": \"competitive-eval/graph-v8/graph-comparator-products.json\",\n    \"synthetic_rehearsal_sha256\": \"competitive-eval/graph-v8/graph-synthetic-execution-rehearsal-v8r3.json\",\n    \"core_bench_prior_inventory_sha256\": \"competitive-eval/graph-v8/core_bench_development_pinned_snapshots.json\",\n    \"graph_v7_burned_prior_inventory_sha256\": \"competitive-eval/graph-v8/graph_v7_burned_candidate_snapshots.json\",\n    \"sem_hybrid_prior_inventory_sha256\": \"competitive-eval/graph-v8/sem_hybrid_development_pilot_v1.json\",\n    \"sem_v2_prior_inventory_sha256\": \"competitive-eval/graph-v8/sem_v2_burned_selected_cohort.json\",\n    \"sem_v6_prior_inventory_sha256\": \"competitive-eval/graph-v8/sem_v6_selected_cohort.json\",\n}\nPOLICY_SHA256 = \"ed05f6bc8bf07174bf3fe6c9b4d4a284973950044f0e4b72fa959577f427f4ee\"\nTARGET_LANGUAGES = 5\nTARGET_REPOSITORIES = 30\nMIN_REPOSITORIES_PER_LANGUAGE = 4\nMAX_REPOSITORIES_PER_LANGUAGE = 8\nCANDIDATES_PER_LANGUAGE = 36\nCASES_PER_REPOSITORY = 6\nMIN_LARGE_REPOSITORIES = 10\nMIN_QUERY_TERMS = 3\nMAX_QUERY_TERMS = 1000\nSHORT_QUERY_MAX_TERMS = 8\nMIN_SHORT_QUERY_FRACTION = 0.15\nMIN_CONCEPTUAL_QUERY_FRACTION = 0.20\nMAX_CHANGED_FILES = 8\nMAX_CHANGED_LINES = 300\nMAX_REGIONS = 20\nTERM_RE = re.compile(r\"[A-Za-z0-9_./:+-]+\")\nHUNK_RE = re.compile(r\"^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@\")\nEXCLUDED_PARTS = {\".git\", \"node_modules\", \"vendor\", \"dist\", \"build\", \"target\"}\nEXCLUDED_NAMES = {\"package-lock.json\", \"yarn.lock\", \"pnpm-lock.yaml\"}\n\n\ndef canonical_repo(value: str) -> str:\n    value = value.strip().removesuffix(\".git\").strip(\"/\")\n    prefix = \"https://github.com/\"\n    if value.casefold().startswith(prefix):\n        value = value[len(prefix):]\n    if len(value.split(\"/\")) != 2 or any(not part for part in value.split(\"/\")):\n        raise ValueError(\"repository identity must be owner/name\")\n    return value\n\n\ndef normalize_repo(value: str) -> str:\n    return canonical_repo(value).casefold()\n\n\ndef rank_key(namespace: str, value: str) -> str:\n    return hashlib.sha256(\n        f\"{CONSTRUCTION_SEED}\\0{namespace}\\0{value}\".encode(\"utf-8\")\n    ).hexdigest()\n\n\ndef public_case_id(instance_id: str) -> str:\n    return \"gr8-\" + hashlib.sha256(\n        f\"{CONSTRUCTION_SEED}\\0case-id\\0{instance_id}\".encode(\"utf-8\")\n    ).hexdigest()[:20]\n\n\ndef query_terms(query: str) -> list[str]:\n    return [term.casefold() for term in TERM_RE.findall(query)]\n\n\ndef issue_title(problem_statement: str) -> str | None:\n    for line in problem_statement.splitlines():\n        title = re.sub(r\"^#{1,6}\\s*\", \"\", line.strip()).strip()\n        if not title:\n            continue\n        count = len(query_terms(title))\n        return title if MIN_QUERY_TERMS <= count <= SHORT_QUERY_MAX_TERMS else None\n    return None\n\n\ndef _line_regions(lines: Iterable[int]) -> list[dict[str, int]]:\n    ordered = sorted(set(lines))\n    if not ordered:\n        return []\n    regions: list[dict[str, int]] = []\n    start = previous = ordered[0]\n    for line in ordered[1:]:\n        if line != previous + 1:\n            regions.append({\"start_line\": start, \"end_line\": previous})\n            start = line\n        previous = line\n    regions.append({\"start_line\": start, \"end_line\": previous})\n    return regions\n\n\ndef patch_judgments(patch: str) -> list[dict[str, Any]]:\n    current_path: str | None = None\n    old_line = 0\n    changed: dict[str, set[int]] = defaultdict(set)\n    for line in patch.splitlines():\n        if line.startswith(\"--- \"):\n            raw = line[4:].split(\"\\t\", 1)[0]\n            current_path = raw[2:] if raw.startswith(\"a/\") else raw\n            if current_path == \"/dev/null\":\n                current_path = None\n            continue\n        match = HUNK_RE.match(line)\n        if match:\n            old_line = int(match.group(1))\n            continue\n        if current_path is None or line.startswith((\"+++ \", \"diff --git \")):\n            continue\n        if line.startswith(\"-\") and not line.startswith(\"---\"):\n            changed[current_path].add(old_line)\n            old_line += 1\n        elif line.startswith(\" \"):\n            old_line += 1\n        elif not line.startswith(\"+\") and line != \"\\\\ No newline at end of file\":\n            old_line += 1\n    judgments = []\n    for path, lines in sorted(changed.items()):\n        pure = PurePosixPath(path)\n        if (\n            path.startswith(\"/\")\n            or \"..\" in pure.parts\n            or set(part.casefold() for part in pure.parts) & EXCLUDED_PARTS\n            or pure.name.casefold() in EXCLUDED_NAMES\n        ):\n            continue\n        for region in _line_regions(lines):\n            judgments.append({\"file_path\": path, **region})\n    return judgments\n\n\ndef conceptual_query(query: str, judgments: list[dict[str, Any]]) -> bool:\n    terms = set(query_terms(query))\n    answer_tokens: set[str] = set()\n    for judgment in judgments:\n        path = PurePosixPath(judgment[\"file_path\"])\n        answer_tokens.update(part.casefold() for part in path.parts if len(part) >= 3)\n        answer_tokens.add(path.stem.casefold())\n    return not bool(terms & answer_tokens)\n\n\ndef eligible_case(row: dict[str, Any]) -> tuple[dict[str, Any] | None, str | None]:\n    required = {\n        \"instance_id\", \"repo\", \"language\", \"created_at\", \"base_commit\",\n        \"problem_statement\", \"patch\",\n    }\n    if not required <= set(row):\n        return None, \"missing_field\"\n    query = str(row[\"problem_statement\"]).strip()\n    if not MIN_QUERY_TERMS <= len(query_terms(query)) <= MAX_QUERY_TERMS:\n        return None, \"query_length\"\n    judgments = patch_judgments(str(row[\"patch\"]))\n    files = {item[\"file_path\"] for item in judgments}\n    changed_lines = sum(item[\"end_line\"] - item[\"start_line\"] + 1 for item in judgments)\n    if not judgments:\n        return None, \"no_base_snapshot_judgments\"\n    if len(files) > MAX_CHANGED_FILES or changed_lines > MAX_CHANGED_LINES or len(judgments) > MAX_REGIONS:\n        return None, \"patch_scope\"\n    repo = canonical_repo(str(row[\"repo\"]))\n    case_id = public_case_id(str(row[\"instance_id\"]))\n    return {\n        \"id\": case_id,\n        \"repo\": repo,\n        \"language\": str(row[\"language\"]).casefold(),\n        \"created_at\": str(row[\"created_at\"]),\n        \"base_commit\": str(row[\"base_commit\"]),\n        \"_full_query\": query,\n        \"_title_query\": issue_title(query),\n        \"_qrels\": {\n            \"case_id\": case_id,\n            \"source_instance_id\": str(row[\"instance_id\"]),\n            \"repo\": repo,\n            \"base_commit\": str(row[\"base_commit\"]),\n            \"locations\": judgments,\n        },\n    }, None\n\n\ndef _validate_policy(path: Path) -> dict[str, Any]:\n    document = artifacts.read_canonical_json(path, expected_type=dict)\n    if document.sha256 != POLICY_SHA256:\n        raise ValueError(\"Graph V8 policy hash mismatch\")\n    policy = document.document\n    expected = {\n        \"final_languages\": TARGET_LANGUAGES,\n        \"target_repositories\": TARGET_REPOSITORIES,\n        \"minimum_repositories_per_language\": MIN_REPOSITORIES_PER_LANGUAGE,\n        \"maximum_repositories_per_language\": MAX_REPOSITORIES_PER_LANGUAGE,\n        \"candidate_repositories_per_language\": CANDIDATES_PER_LANGUAGE,\n        \"cases_per_repository\": CASES_PER_REPOSITORY,\n        \"minimum_large_repositories\": MIN_LARGE_REPOSITORIES,\n        \"manual_backfill_permitted\": False,\n        \"post_screen_resampling_permitted\": False,\n    }\n    if policy.get(\"suite\") != SUITE or any(\n        policy.get(\"composition\", {}).get(key) != value for key, value in expected.items()\n    ):\n        raise ValueError(\"Graph V8 policy composition mismatch\")\n    if policy.get(\"construction_seed\") != CONSTRUCTION_SEED:\n        raise ValueError(\"Graph V8 construction seed mismatch\")\n    return policy\n\n\ndef _expected_precatalog_bindings() -> dict[str, str]:\n    repository_root = Path(__file__).resolve().parents[2]\n    return {\n        field: artifacts.sha256_file(repository_root / relative_path)\n        for field, relative_path in PRECATALOG_ARTIFACT_PATHS.items()\n    }\n\n\ndef _validate_authorization(path: Path, policy_sha256: str) -> dict[str, Any]:\n    decision = artifacts.read_canonical_json(path, expected_type=dict).document\n    required = {\n        \"schema_version\", \"suite\", \"stage\", \"catalog_construction_authorized\",\n        \"rank_production_authorized\", \"policy_sha256\", \"toolchain_sha256\",\n        \"exclusion_freeze_sha256\",\n        \"design_freeze_sha256\", \"product_freeze_sha256\",\n        \"comparator_products_sha256\", \"synthetic_rehearsal_sha256\",\n        \"core_bench_prior_inventory_sha256\",\n        \"graph_v7_burned_prior_inventory_sha256\",\n        \"sem_hybrid_prior_inventory_sha256\", \"sem_v2_prior_inventory_sha256\",\n        \"sem_v6_prior_inventory_sha256\",\n        \"exact_head_ci\", \"independent_review\",\n    }\n    if set(decision) != required:\n        raise ValueError(\"pre-catalog decision fields mismatch\")\n    if (\n        decision[\"schema_version\"] != 1\n        or decision[\"suite\"] != SUITE\n        or decision[\"stage\"] != \"reviewed_graph_v8_precatalog_decision\"\n        or decision[\"catalog_construction_authorized\"] is not True\n        or decision[\"rank_production_authorized\"] is not False\n        or decision[\"policy_sha256\"] != policy_sha256\n        or decision[\"exact_head_ci\"] != \"pass\"\n        or decision[\"independent_review\"] != \"no_findings\"\n        or any(\n            decision[field] != expected\n            for field, expected in _expected_precatalog_bindings().items()\n        )\n    ):\n        raise ValueError(\"pre-catalog decision does not authorize construction\")\n    for field in required - {\n        \"schema_version\", \"suite\", \"stage\", \"catalog_construction_authorized\",\n        \"rank_production_authorized\", \"exact_head_ci\", \"independent_review\",\n    }:\n        artifacts.require_sha256(decision[field], f\"pre-catalog decision.{field}\")\n    return decision\n\n\ndef _read_source(path: Path) -> tuple[list[dict[str, Any]], int]:\n    if path.suffix == \".json\":\n        rows = artifacts.read_canonical_json(path, expected_type=list).document\n        return rows, len(rows)\n    import pyarrow.parquet as pq\n    columns = [\n        \"instance_id\", \"repo\", \"language\", \"created_at\", \"base_commit\",\n        \"problem_statement\", \"patch\",\n    ]\n    parquet = pq.ParquetFile(path)\n    rows = [row for batch in parquet.iter_batches(batch_size=256, columns=columns) for row in batch.to_pylist()]\n    return rows, parquet.metadata.num_rows\n\n\ndef _excluded_repositories(\n    path: Path, key_path: Path, expected_sha256: str, policy_sha256: str,\n) -> tuple[set[str], bytes, list[dict[str, str]]]:\n    opened = artifacts.read_canonical_json(path, expected_type=dict)\n    document = opened.document\n    required = {\n        \"schema_version\", \"suite\", \"stage\", \"policy_sha256\",\n        \"catalog_construction_authorized\", \"rank_production_authorized\",\n        \"identity_representation\", \"identity_hmac_key_sha256\", \"generator_sha256\", \"producer_dependency_bindings\",\n        \"source_bindings\", \"repository_count\", \"repository_identity_hmac_sha256\",\n    }\n    if (\n        opened.sha256 != expected_sha256\n        or set(document) != required\n        or document[\"schema_version\"] != 1\n        or document[\"suite\"] != SUITE\n        or document[\"stage\"] != \"frozen_graph_v8_repository_exclusions_before_catalog\"\n        or document[\"policy_sha256\"] != policy_sha256\n        or document[\"catalog_construction_authorized\"] is not False\n        or document[\"rank_production_authorized\"] is not False\n        or type(document[\"source_bindings\"]) is not dict\n        or document[\"identity_representation\"] != \"hmac_sha256_of_normalized_owner_slash_repository_utf8\"\n        or document[\"producer_dependency_bindings\"] != {\n            \"artifact_contract_sha256\": artifacts.sha256_file(Path(artifacts.__file__)),\n            \"normalization_source_sha256\": artifacts.sha256_file(Path(__file__)),\n        }\n        or type(document[\"repository_identity_hmac_sha256\"]) is not list\n    ):\n        raise ValueError(\"mandatory exclusion freeze mismatch\")\n    artifacts.require_sha256(document[\"generator_sha256\"], \"exclusion freeze.generator_sha256\")\n    if key_path.is_symlink() or not key_path.is_file() or stat.S_IMODE(key_path.stat().st_mode) != 0o600:\n        raise ValueError(\"mandatory exclusion HMAC key mismatch\")\n    identity_key = key_path.read_bytes()\n    if len(identity_key) != 32 or hashlib.sha256(identity_key).hexdigest() != document[\"identity_hmac_key_sha256\"]:\n        raise ValueError(\"mandatory exclusion HMAC key mismatch\")\n    excluded = {\n        artifacts.require_sha256(value, \"excluded repository identity hash\")\n        for value in document[\"repository_identity_hmac_sha256\"]\n    }\n    if len(excluded) != len(document[\"repository_identity_hmac_sha256\"]) or document[\"repository_count\"] != len(excluded):\n        raise ValueError(\"mandatory exclusion freeze repository count mismatch\")\n    return excluded, identity_key, [{\"path\": path.name, \"sha256\": opened.sha256}]\n\n\ndef select_candidates(cases: list[dict[str, Any]], excluded: set[str], identity_key: bytes) -> list[dict[str, Any]]:\n    by_repo: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for case in cases:\n        identity_hash = hmac.new(identity_key, normalize_repo(case[\"repo\"]).encode(), hashlib.sha256).hexdigest()\n        if identity_hash not in excluded:\n            by_repo[canonical_repo(case[\"repo\"])].append(case)\n    eligible = {repo: rows for repo, rows in by_repo.items() if len(rows) >= CASES_PER_REPOSITORY}\n    by_language: dict[str, list[str]] = defaultdict(list)\n    for repo, rows in eligible.items():\n        languages = {row[\"language\"] for row in rows}\n        if len(languages) == 1:\n            by_language[next(iter(languages))].append(repo)\n    languages = [language for language, repos in by_language.items() if len(repos) >= MIN_REPOSITORIES_PER_LANGUAGE]\n    languages.sort(key=lambda value: rank_key(\"language\", value))\n    selected_languages = languages[:TARGET_LANGUAGES]\n    if len(selected_languages) != TARGET_LANGUAGES:\n        raise ValueError(\"fewer than five languages can satisfy the V8 floor\")\n    candidates = []\n    for language_rank, language in enumerate(selected_languages):\n        repos = sorted(by_language[language], key=lambda repo: rank_key(f\"repo:{language}\", normalize_repo(repo)))\n        for repository_rank, repo in enumerate(repos[:CANDIDATES_PER_LANGUAGE]):\n            rows = sorted(eligible[repo], key=lambda row: rank_key(f\"case:{normalize_repo(repo)}\", row[\"id\"]))\n            selected = rows[:CASES_PER_REPOSITORY]\n            candidates.append({\n                \"repo\": repo,\n                \"language\": language,\n                \"language_rank\": language_rank,\n                \"repository_rank\": repository_rank,\n                \"repository_selection_key\": rank_key(f\"repo:{language}\", normalize_repo(repo)),\n                \"eligible_cases\": len(rows),\n                \"cases\": selected,\n            })\n    return candidates\n\n\ndef _public_candidates(candidates: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    return [{\n        \"repo\": row[\"repo\"], \"language\": row[\"language\"],\n        \"language_rank\": row[\"language_rank\"], \"repository_rank\": row[\"repository_rank\"],\n        \"repository_selection_key\": row[\"repository_selection_key\"],\n        \"eligible_cases\": row[\"eligible_cases\"],\n        \"selected_case_ids\": [case[\"id\"] for case in row[\"cases\"]],\n        \"snapshots\": sorted({case[\"base_commit\"] for case in row[\"cases\"]}),\n    } for row in candidates]\n        \"source_instance_id\": source_instance_id,\n        \"repo\": str(row[\"repo\"]),\n        \"base_commit\": str(row[\"base_commit\"]),\n        \"locations\": judgments,\n    }\n    case = {\n        \"id\": case_id,\n        \"repo\": str(row[\"repo\"]),\n        \"language\": str(row[\"language\"]).casefold(),\n        \"created_at\": str(row[\"created_at\"]),\n        \"base_commit\": str(row[\"base_commit\"]),\n        \"_full_query\": query,\n        \"_title_query\": issue_title(query),\n        \"_relevant_files\": len(files),\n        \"_relevant_regions\": len(judgments),\n        \"_qrels\": qrels,\n    }\n    return case, None\n\n\ndef read_cases(parquet_path: Path) -> tuple[list[dict[str, Any]], dict[str, int], int]:\n    import pyarrow.parquet as pq\n\n    columns = [\"instance_id\", \"repo\", \"language\", \"created_at\", \"base_commit\", \"problem_statement\", \"patch\"]\n    parquet = pq.ParquetFile(parquet_path)\n    cases = []\n    exclusions: dict[str, int] = defaultdict(int)\n    for batch in parquet.iter_batches(batch_size=256, columns=columns):\n        for row in batch.to_pylist():\n            case, reason = eligible_case(row)\n            if case is None:\n                exclusions[reason or \"unknown\"] += 1\n            else:\n                cases.append(case)\n    return cases, dict(sorted(exclusions.items())), parquet.metadata.num_rows\n\n\ndef repository_candidates(\n    cases: list[dict[str, Any]], excluded: set[str]\n) -> tuple[list[dict[str, Any]], dict[str, Any]]:\n    by_normalized_repo: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for case in cases:\n        normalized = normalize_repo(case[\"repo\"])\n        if normalized not in excluded:\n            by_normalized_repo[normalized].append(case)\n    by_repo: dict[str, list[dict[str, Any]]] = {}\n    for normalized, rows in by_normalized_repo.items():\n        display_repo = min(\n            {canonical_repo(str(row[\"repo\"])) for row in rows},\n            key=lambda value: (value.casefold(), value),\n        )\n        if normalize_repo(display_repo) != normalized:\n            raise ValueError(\"canonical repository identity normalization mismatch\")\n        canonical_rows = []\n        for row in rows:\n            canonical = dict(row)\n            canonical[\"repo\"] = display_repo\n            canonical[\"_qrels\"] = {**row[\"_qrels\"], \"repo\": display_repo}\n            canonical_rows.append(canonical)\n        by_repo[display_repo] = canonical_rows\n    eligible_repos = {\n        repo: rows for repo, rows in by_repo.items() if len(rows) >= QUERIES_PER_REPOSITORY\n    }\n    by_language: dict[str, list[str]] = defaultdict(list)\n    for repo, rows in eligible_repos.items():\n        languages = {row[\"language\"] for row in rows}\n        if len(languages) == 1:\n            by_language[next(iter(languages))].append(repo)\n    eligible_languages = [\n        language for language, repos in by_language.items()\n        if len(repos) >= MIN_CANDIDATE_REPOSITORIES_PER_LANGUAGE\n    ]\n    eligible_languages.sort(key=lambda language: rank_key(\"language\", language))\n    selected_languages = eligible_languages[:LANGUAGE_CANDIDATE_COUNT]\n    if len(selected_languages) < MIN_LANGUAGE_COUNT:\n        raise ValueError(\n            f\"only {len(selected_languages)} languages have \"\n            f\"{MIN_CANDIDATE_REPOSITORIES_PER_LANGUAGE} eligible repositories\"\n        )\n\n    candidates = []\n    for language_rank, language in enumerate(selected_languages):\n        repos = sorted(\n            by_language[language],\n            key=lambda repo: rank_key(f\"repo:{language}\", normalize_repo(repo)),\n        )\n        for repository_rank, repo in enumerate(repos[:REPOSITORY_CANDIDATES_PER_LANGUAGE]):\n            normalized_repo = normalize_repo(repo)\n            rows = sorted(\n                eligible_repos[repo],\n                key=lambda row: rank_key(f\"case:{normalized_repo}\", row[\"id\"]),\n            )\n            selected_cases = rows[:QUERIES_PER_REPOSITORY]\n            candidates.append({\n                \"repo\": repo,\n                \"language\": language,\n                \"language_rank\": language_rank,\n                \"repository_rank\": repository_rank,\n                \"repository_selection_key\": rank_key(\n                    f\"repo:{language}\", normalized_repo\n                ),\n                \"eligible_cases\": len(rows),\n                \"cases\": selected_cases,\n            })\n    summary = {\n        \"eligible_repositories\": len(eligible_repos),\n        \"eligible_languages\": {language: len(repos) for language, repos in sorted(by_language.items())},\n        \"candidate_languages\": selected_languages,\n        \"candidate_repositories\": len(candidates),\n    }\n    return candidates, summary\n\n\ndef public_candidate_projection(\n    candidates: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    return [\n        {\n            \"repo\": candidate[\"repo\"],\n            \"language\": candidate[\"language\"],\n            \"language_rank\": candidate[\"language_rank\"],\n            \"repository_rank\": candidate[\"repository_rank\"],\n            \"repository_selection_key\": candidate[\"repository_selection_key\"],\n            \"eligible_cases\": candidate[\"eligible_cases\"],\n            \"selected_case_ids\": [row[\"id\"] for row in candidate[\"cases\"]],\n            \"snapshots\": sorted(\n                {row[\"base_commit\"] for row in candidate[\"cases\"]}\n            ),\n        }\n        for candidate in candidates\n    ]\n\n\ndef source_descriptor(parquet_path: Path) -> dict[str, Any]:\n    parquet_sha256 = sha256_file(parquet_path)\n    if parquet_sha256 != PARQUET_LINKED_ETAG:\n        raise ValueError(\"source parquet hash mismatch\")\n    return {\n        \"dataset\": DATASET_ID,\n        \"dataset_revision\": DATASET_REVISION,\n        \"parquet_revision\": PARQUET_REVISION,\n        \"parquet_linked_etag\": PARQUET_LINKED_ETAG,\n        \"parquet_sha256\": parquet_sha256,\n    }\n\n\ndef load_validated_success_gates(path: Path) -> tuple[dict[str, Any], str]:\n    gates, gates_sha256 = load_json_with_sha256(path)\n    if gates.get(\"schema_version\") != 9:\n        raise ValueError(\"success-gates schema mismatch\")\n    expected_statistics = {\n        \"statistical_unit\": \"repository\",\n        \"confidence_level\": 0.95,\n        \"bootstrap_repetitions\": 10000,\n        \"bootstrap_seed\": 20260718,\n        \"bootstrap_interval_method\": \"paired_repository_cluster_percentile\",\n        \"superiority_p_value_method\": (\n            \"paired_repository_sign_flip_monte_carlo_with_same_repetition_count_and_seed_stream\"\n        ),\n        \"multiple_comparison_method\": \"holm_for_superiority_endpoints_only\",\n        \"missing_measurement_policy\": \"fail\",\n#!/usr/bin/env python3\n\"\"\"Emit identity-free successor capacity after the burned V6 attempt.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport math\nimport random\nimport sys\nfrom collections import Counter\nfrom pathlib import Path\nfrom typing import Any\n\nsys.dont_write_bytecode = True\n\nimport analyze_sem_precatalog_capacity as aggregate\nimport analyze_sem_v5_burn_capacity as v5_capacity\nimport freeze_sem_holdout as holdout\nimport freeze_sem_v6_burn as v6_burn\n\n\nOUTPUT_PATH = (\n    \"competitive-eval/product-optimization-v7/sem-aggregate-capacity-v7.json\"\n)\nV6_BURN_SHA256 = \"a91cf1d8c690310584ea69f3543451488dd47eaca50f184080485af67958c479\"\nV6_BURN_GENERATOR_SHA256 = (\n    \"02089da4b8c478ce76b358e37828430a2248be3d870412950aeb7f612920aee1\"\n)\nTARGET_REPOSITORIES = 30\nMINIMUM_LANGUAGES = 6\nMAXIMUM_LANGUAGES = 7\nMINIMUM_REPOSITORIES_PER_LANGUAGE = 2\nMAXIMUM_REPOSITORIES_PER_LANGUAGE = 5\nCANDIDATE_REPOSITORIES_PER_LANGUAGE = 24\nSIMULATION_REPETITIONS = 100_000\nSIMULATION_SEED = 2026071207\n\n\ndef successor_design_feasibility(counts: list[int]) -> list[dict[str, Any]]:\n    rows = []\n    for languages in range(MINIMUM_LANGUAGES, MAXIMUM_LANGUAGES + 1):\n        qualifying = sorted(\n            (\n                count\n                for count in counts\n                if count >= MINIMUM_REPOSITORIES_PER_LANGUAGE\n            ),\n            reverse=True,\n        )\n        capacity = sum(\n            min(count, MAXIMUM_REPOSITORIES_PER_LANGUAGE)\n            for count in qualifying[:languages]\n        )\n        rows.append(\n            {\n                \"languages\": languages,\n                \"minimum_repositories_per_language\": (\n                    MINIMUM_REPOSITORIES_PER_LANGUAGE\n                ),\n                \"maximum_repositories_per_language\": (\n                    MAXIMUM_REPOSITORIES_PER_LANGUAGE\n                ),\n                \"target_repositories\": TARGET_REPOSITORIES,\n                \"qualifying_languages\": len(qualifying),\n                \"maximum_repositories_after_per_language_cap\": capacity,\n                \"feasible\": bool(\n                    len(qualifying) >= languages\n                    and languages * MINIMUM_REPOSITORIES_PER_LANGUAGE\n                    <= TARGET_REPOSITORIES\n                    <= capacity\n                ),\n            }\n        )\n    return rows\n\n\ndef simulate_successor_screen(\n    candidate_capacities: list[int], historical_language_rates: list[float]\n) -> dict[str, Any]:\n    if not candidate_capacities or not historical_language_rates:\n        raise ValueError(\"V7 capacity simulation inputs are empty\")\n    if any(\n        isinstance(capacity, bool)\n        or not isinstance(capacity, int)\n        or capacity < 0\n        for capacity in candidate_capacities\n    ) or any(\n        isinstance(rate, bool)\n        or not isinstance(rate, (int, float))\n        or not math.isfinite(rate)\n        or not 0 <= rate <= 1\n        for rate in historical_language_rates\n    ):\n        raise ValueError(\"V7 capacity simulation inputs are malformed\")\n    rng = random.Random(SIMULATION_SEED)\n    outcomes: Counter[str] = Counter()\n    for _ in range(SIMULATION_REPETITIONS):\n        retained = []\n        for capacity in candidate_capacities:\n            rate = historical_language_rates[\n                rng.randrange(len(historical_language_rates))\n            ]\n            retained.append(sum(rng.random() < rate for _ in range(capacity)))\n        final_languages = None\n        for languages in range(MAXIMUM_LANGUAGES, MINIMUM_LANGUAGES - 1, -1):\n            qualifying = sorted(\n                (\n                    count\n                    for count in retained\n                    if count >= MINIMUM_REPOSITORIES_PER_LANGUAGE\n                ),\n                reverse=True,\n            )\n            if (\n                len(qualifying) >= languages\n                and sum(\n                    min(count, MAXIMUM_REPOSITORIES_PER_LANGUAGE)\n                    for count in qualifying[:languages]\n                )\n                >= TARGET_REPOSITORIES\n            ):\n                final_languages = languages\n                break\n        outcomes[\n            str(final_languages) if final_languages is not None else \"infeasible\"\n        ] += 1\n    return {\n        \"method\": \"language_cluster_parametric_bootstrap_from_anonymous_v6_retention_rates\",\n        \"repetitions\": SIMULATION_REPETITIONS,\n        \"seed\": SIMULATION_SEED,\n        \"candidate_language_capacities\": sorted(\n            candidate_capacities, reverse=True\n        ),\n        \"allocation_rule\": (\n            \"maximize_languages_6_through_7_then_require_30_repositories_\"\n            \"with_2_to_5_per_language\"\n        ),\n        \"outcome_counts\": dict(sorted(outcomes.items())),\n        \"outcome_probabilities\": {\n            outcome: count / SIMULATION_REPETITIONS\n            for outcome, count in sorted(outcomes.items())\n        },\n        \"scope_limit\": \"construction_risk_only_not_quality_or_scale_gate_prediction\",\n    }\n\n\ndef validate_v6_boundary(\n    catalog_path: Path,\n    screening_path: Path,\n    manifest_path: Path,\n    score_path: Path,\n    result_witness_path: Path,\n    success_gates_path: Path,\n    burn_path: Path,\n) -> tuple[set[str], dict[str, Any], dict[str, Any], list[float]]:\n    holdout.require_repository_artifact_path(\n        burn_path, v6_burn.OUTPUT_PATH, \"V6 burn\"\n    )\n    burn, burn_sha256 = holdout.load_json_with_sha256(burn_path)\n    if burn_sha256 != V6_BURN_SHA256:\n        raise ValueError(\"V6 burn hash mismatch\")\n    inputs = v6_burn.validated_v6_inputs(\n        catalog_path,\n        screening_path,\n        manifest_path,\n        score_path,\n        result_witness_path,\n        success_gates_path,\n    )\n    screening, screening_sha256 = holdout.load_json_with_sha256(screening_path)\n    if screening_sha256 != v6_burn.SCREENING_SHA256:\n        raise ValueError(\"V6 screening changed after boundary validation\")\n    historical_screen, historical_rates = aggregate.historical_screen_summary(\n        screening\n    )\n    policy = burn.get(\"replacement_policy\", {})\n    frozen = burn.get(\"frozen_inputs\", {})\n    if (\n        burn.get(\"suite\") != v6_burn.SUITE\n        or burn.get(\"status\")\n        != \"burned_after_scoring_common_mode_infrastructure_failure\"\n        or burn.get(\"invalid_for_confirmatory_quality_claims\") is not True\n        or burn.get(\"invalid_for_system_comparison\") is not True\n        or frozen.get(\"generator_sha256\") != V6_BURN_GENERATOR_SHA256\n        or policy.get(\"successor_suite\") != v6_burn.SUCCESSOR_SUITE\n        or policy.get(\"successor_seed\") != v6_burn.SUCCESSOR_SEED\n        or policy.get(\"fresh_seed_required\") is not True\n        or policy.get(\"v6_candidate_reuse_permitted\") is not False\n        or policy.get(\"exclude_all_v6_normalized_candidate_repositories\")\n        is not True\n        or policy.get(\"v6_normalized_candidate_repositories_to_exclude\")\n        != v6_burn.CANDIDATE_REPOSITORIES\n        or policy.get(\"v6_normalized_candidate_repository_set_sha256\")\n        != inputs[\"candidate_repository_set_sha256\"]\n        or len(inputs[\"candidate_repositories\"])\n        != v6_burn.CANDIDATE_REPOSITORIES\n    ):\n        raise ValueError(\"V6 burn replacement boundary mismatch\")\n    return inputs[\"candidate_repositories\"], {\n        \"v6_catalog_sha256\": v6_burn.CATALOG_SHA256,\n        \"v6_screening_sha256\": v6_burn.SCREENING_SHA256,\n        \"v6_manifest_sha256\": v6_burn.MANIFEST_SHA256,\n        \"v6_score_sha256\": v6_burn.SCORE_SHA256,\n        \"v6_score_result_witness_sha256\": v6_burn.RESULT_WITNESS_SHA256,\n        \"v6_burn_record_sha256\": burn_sha256,\n        \"v6_candidate_repository_set_sha256\": inputs[\n            \"candidate_repository_set_sha256\"\n        ],\n        \"v6_excluded_repositories\": len(inputs[\"candidate_repositories\"]),\n    }, historical_screen, historical_rates\n\n\ndef validate_burned_cohort_disjointness(\n    burned_v2: set[str],\n    burned_v3: set[str],\n    burned_v5: set[str],\n    burned_v6: set[str],\n) -> None:\n    if burned_v2 & burned_v6 or burned_v3 & burned_v6 or burned_v5 & burned_v6:\n        raise ValueError(\"V6 candidate set overlaps a previously burned cohort\")\n\n\ndef validate_identity_free_artifact(\n    artifact: dict[str, Any], cases: list[dict[str, Any]]\n) -> None:\n    forbidden = set()\n    for case in cases:\n        forbidden.update(\n            str(value)\n            for value in (\n                case.get(\"repo\"),\n                case.get(\"id\"),\n                case.get(\"language\"),\n                case.get(\"_full_query\"),\n                case.get(\"_title_query\"),\n            )\n            if value\n        )\n        for location in case.get(\"_qrels\", {}).get(\"locations\", []):\n            path = location.get(\"file_path\") if isinstance(location, dict) else None\n            if path:\n                forbidden.add(str(path))\n\n    def strings(value: Any):\n        if isinstance(value, str):\n            yield value\n        elif isinstance(value, dict):\n            for key, item in value.items():\n                yield str(key)\n                yield from strings(item)\n        elif isinstance(value, list):\n            for item in value:\n                yield from strings(item)\n\n    leaked = sorted(set(strings(artifact)) & forbidden)\n    if leaked:\n        raise ValueError(\"V7 capacity artifact leaks source identity\")\n\n\ndef analyze(args: argparse.Namespace) -> None:\n    output = Path(args.output)\n    holdout.require_repository_artifact_path(\n        output, OUTPUT_PATH, \"V7 aggregate capacity\"\n    )\n    if output.exists():\n        raise ValueError(\"refusing to overwrite V7 aggregate capacity\")\n\n    burned_v2, v2_binding, _ = holdout.validate_burned_holdout_with_cases(\n        Path(args.burned_manifest), Path(args.burn_record), Path(args.burn_log)\n    )\n    burned_v3, v3_binding = holdout.validate_v3_screen_burn(\n        Path(args.v3_catalog),\n        Path(args.v3_screening_report),\n        Path(args.v3_burn_record),\n    )\n    burned_v5, v5_binding = v5_capacity.validate_v5_artifacts(\n        Path(args.v5_catalog),\n        Path(args.v5_screening_report),\n        Path(args.v5_burn_record),\n    )\n    burned_v6, v6_binding, historical_screen, historical_rates = (\n        validate_v6_boundary(\n        Path(args.v6_catalog),\n        Path(args.v6_screening_report),\n        Path(args.v6_manifest),\n        Path(args.v6_score),\n        Path(args.v6_result_witness),\n        Path(args.v6_success_gates),\n        Path(args.v6_burn_record),\n        )\n    )\n    validate_burned_cohort_disjointness(\n        burned_v2, burned_v3, burned_v5, burned_v6\n    )\n\n    exclusions_path = Path(args.exclusions)\n    multi_swe_path = Path(args.multi_swe_metadata)\n    excluded = holdout.exclusion_repositories(\n        holdout.load_json(exclusions_path), holdout.load_json(multi_swe_path)\n    )\n    baseline_exclusions = len(excluded)\n    excluded.update(burned_v2)\n    excluded.update(burned_v3)\n    excluded.update(burned_v5)\n    excluded.update(burned_v6)\n\n    parquet_path = Path(args.parquet)\n    cases, case_exclusions, source_rows = holdout.read_cases(parquet_path)\n    summary = aggregate.capacity_summary(cases, excluded)\n    language_counts = []\n    for count, languages in summary[\n        \"eligible_repository_count_per_language_histogram\"\n    ].items():\n        language_counts.extend([int(count)] * int(languages))\n    summary[\"thirty_repository_successor_design_feasibility\"] = (\n        successor_design_feasibility(language_counts)\n    )\n    candidate_capacities = [\n        min(count, CANDIDATE_REPOSITORIES_PER_LANGUAGE)\n        for count in language_counts\n        if count >= MINIMUM_REPOSITORIES_PER_LANGUAGE\n    ]\n    simulation = simulate_successor_screen(\n        candidate_capacities, historical_rates\n    )\n    artifact = {\n        \"schema_version\": 1,\n        \"status\": \"development_only_identity_free_capacity_after_v6_burn\",\n        \"successor_suite\": v6_burn.SUCCESSOR_SUITE,\n        \"successor_seed\": v6_burn.SUCCESSOR_SEED,\n        \"invalid_for_confirmatory_quality_claims\": True,\n        \"inputs\": {\n            \"analyzer_sha256\": holdout.sha256_file(Path(__file__).resolve()),\n            \"source_parquet_sha256\": holdout.sha256_file(parquet_path),\n            \"overlap_exclusions_sha256\": holdout.sha256_file(exclusions_path),\n            \"multi_swe_metadata_sha256\": holdout.sha256_file(multi_swe_path),\n            **v2_binding,\n            **v3_binding,\n            **v5_binding,\n            **v6_binding,\n        },\n        \"analysis_boundary\": {\n            \"mechanical_patch_structure_used_for_case_eligibility\": True,\n            \"repository_names_emitted\": False,\n            \"case_ids_emitted\": False,\n            \"queries_emitted\": False,\n            \"patch_text_emitted\": False,\n            \"judgment_paths_or_locations_emitted\": False,\n            \"retrieval_run\": False,\n            \"rank_outputs_used\": False,\n            \"qrel_or_quality_statistics_emitted\": False,\n            \"product_or_ranker_changed_after_analysis\": False,\n        },\n        \"source_rows\": source_rows,\n        \"eligible_cases_before_repository_exclusions\": len(cases),\n        \"case_exclusions\": case_exclusions,\n        \"repository_exclusions\": {\n            \"baseline_repository_exclusions\": baseline_exclusions,\n            \"burned_v2_repositories\": len(burned_v2),\n            \"v3_candidate_repositories\": len(burned_v3),\n            \"v5_candidate_repositories\": len(burned_v5),\n            \"v6_candidate_repositories\": len(burned_v6),\n            \"unique_excluded_repositories\": len(excluded),\n        },\n        \"capacity\": summary,\n        \"historical_snapshot_screen\": historical_screen,\n        \"construction_rehearsal\": simulation,\n    }\n    validate_identity_free_artifact(artifact, cases)\n    holdout.write_new_jsons([(output, artifact)])\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--parquet\", required=True)\n    parser.add_argument(\"--exclusions\", required=True)\n    parser.add_argument(\"--multi-swe-metadata\", required=True)\n    parser.add_argument(\"--burned-manifest\", required=True)\n    parser.add_argument(\"--burn-record\", required=True)\n    parser.add_argument(\"--burn-log\", required=True)\n    parser.add_argument(\"--v3-catalog\", required=True)\n    parser.add_argument(\"--v3-screening-report\", required=True)\n    parser.add_argument(\"--v3-burn-record\", required=True)\n    parser.add_argument(\"--v5-catalog\", required=True)\n    parser.add_argument(\"--v5-screening-report\", required=True)\n    parser.add_argument(\"--v5-burn-record\", required=True)\n    parser.add_argument(\"--v6-catalog\", required=True)\n    parser.add_argument(\"--v6-screening-report\", required=True)\n    parser.add_argument(\"--v6-manifest\", required=True)\n    parser.add_argument(\"--v6-score\", required=True)\n    parser.add_argument(\"--v6-result-witness\", required=True)\n    parser.add_argument(\"--v6-success-gates\", required=True)\n    parser.add_argument(\"--v6-burn-record\", required=True)\n    parser.add_argument(\"--output\", required=True)\n    return parser\n\n\ndef main() -> int:\n    try:\n        analyze(build_parser().parse_args())\n    except (OSError, ValueError, TypeError, KeyError) as error:\n        print(f\"error: {error}\", file=sys.stderr)\n        return 1\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
