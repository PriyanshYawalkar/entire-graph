{"timestamp":"2026-07-18T17:12:59.344Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7637-8ad0-7c72-a58d-92cd7e9001d7","call_id":"call_YpyIPimFBndyVR6M6fqDoCBJ","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"package cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/entireio/entire-graph/internal/sem\"\n)\n\ntype searchFlags struct {\n\tRepo              string\n\tQuery             string\n\tFormat            string\n\tProfile           string\n\tWorktree          bool\n\tTopK              int\n\tContextLines      int\n\tMaxRegionLines    int\n\tMaxSnippetLines   int\n\tMaxRegionsPerFile int\n\tIgnoreFiles       []string\n\tIncludeFiles      []string\n\tCacheDir          string\n\tDisableCache      bool\n\tMaxIndexedFiles   int\n\tIndexAllFiles     bool\n\tMaxContextBytes   int\n}\n\nfunc runSearch(ctx context.Context, opts Options, args []string) error {\n\tflags, rest, err := parseSearchFlags(args)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif len(rest) != 0 {\n\t\treturn fmt.Errorf(\"search received unexpected arguments: %s\", strings.Join(rest, \" \"))\n\t}\n\tif strings.TrimSpace(flags.Query) == \"\" {\n\t\treturn errors.New(\"search requires --query\")\n\t}\n\tprofile, err := parseProfile(flags.Profile)\n\tif err != nil {\n\t\treturn err\n\t}\n\trepo, err := resolveRepo(ctx, opts.Env, flags.Repo)\n\tif err != nil {\n\t\treturn err\n\t}\n\tcacheDir := flags.CacheDir\n\tif cacheDir == \"\" {\n\t\tcacheDir = opts.Env.PluginDataDir\n\t}\n\tcontextBudget := flags.MaxContextBytes\n\t// Agent output has a much smaller wire representation than the public JSON\n\t// response. Keep full snippets until that representation is budgeted below.\n\tif flags.Format == \"agent\" {\n\t\tflags.MaxContextBytes = 0\n\t}\n\tresponse, err := sem.SearchRepository(ctx, repo, opts.Version, flags.Query, sem.SearchOptions{\n\t\tWorktree:          flags.Worktree,\n\t\tIgnoreFiles:       flags.IgnoreFiles,\n\t\tIncludeFiles:      flags.IncludeFiles,\n\t\tProfile:           profile,\n\t\tTopK:              flags.TopK,\n\t\tContextLines:      flags.ContextLines,\n\t\tMaxRegionLines:    flags.MaxRegionLines,\n\t\tMaxSnippetLines:   flags.MaxSnippetLines,\n\t\tMaxRegionsPerFile: flags.MaxRegionsPerFile,\n\t\tCacheDir:          cacheDir,\n\t\tDisableCache:      flags.DisableCache,\n\t\tMaxIndexedFiles:   flags.MaxIndexedFiles,\n\t\tIndexAllFiles:     flags.IndexAllFiles,\n\t\tMaxContextBytes:   flags.MaxContextBytes,\n\t})\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := response.Validate(); err != nil {\n\t\treturn err\n\t}\n\tswitch flags.Format {\n\tcase \"json\":\n\t\tencoder := json.NewEncoder(opts.Stdout)\n\t\tencoder.SetEscapeHTML(false)\n\t\treturn encoder.Encode(response)\n\tcase \"ndjson\":\n\t\tencoder := json.NewEncoder(opts.Stdout)\n\t\tencoder.SetEscapeHTML(false)\n\t\tif err := encoder.Encode(map[string]any{\n\t\t\t\"record_type\": \"search_header\",\n\t\t\t\"query\":       response.Query,\n\t\t\t\"repo_root\":   response.RepoRoot,\n\t\t\t\"commit\":      response.Commit,\n\t\t\t\"tree\":        response.Tree,\n\t\t\t\"profile\":     response.Profile,\n\t\t}); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tfor _, result := range response.Results {\n\t\t\tif err := encoder.Encode(struct {\n\t\t\t\tRecordType string `json:\"record_type\"`\n\t\t\t\tsem.SearchResult\n\t\t\t}{RecordType: \"search_result\", SearchResult: result}); err != nil {\n\t\t\t\treturn err\n\t\t\t}\ninternal/cli/search.go:46:\tprofile, err := parseProfile(flags.Profile)\ninternal/cli/search.go:68:\t\tProfile:           profile,\ninternal/cli/search.go:100:\t\t\t\"profile\":     response.Profile,\ninternal/cli/search.go:488:\t\tcase \"--profile\":\ninternal/cli/search.go:550:\t\tcase \"--index-all-files\":\ninternal/cli/root.go:105:  entire graph index --repo . [--profile syntax-only|fast|full] [--cache-dir path] [--format json] [--head] [--ignore-file path] [--include-file path]\ninternal/cli/root.go:106:  entire graph search --query \"issue or concept\" --repo . [--format json|ndjson|text|agent] [--top-k 20] [--max-context-bytes 16384] [--head] [--profile syntax-only|fast|full] [--max-indexed-files n|--index-all-files] [--cache-dir path|--no-cache]\ninternal/cli/root.go:205:\tprofile, err := parseProfile(flags.Profile)\ninternal/cli/root.go:214:\t\tProfile:      profile,\ninternal/cli/root.go:273:// parseProfile validates the --profile value. Empty defaults to full.\ninternal/cli/root.go:283:\t\treturn \"\", fmt.Errorf(\"unknown --profile %q (want full, fast, or syntax-only)\", value)\ninternal/cli/root.go:304:\t\tcase \"--profile\":\ninternal/cli/root.go:307:\t\t\t\treturn flags, nil, errors.New(\"--profile requires a value\")\nREADME.md:117:| `entire graph index --head --profile full` | Prebuild a durable, query-independent index for committed `HEAD` |\nREADME.md:152:entire graph index --repo . --head --profile full --cache-dir /path/to/cache --format json\nREADME.md:156:`full` profile. Repeatable `--ignore-file` and `--include-file` flags let setup\nREADME.md:159:binds the artifact to the exact repository root, commit, tree, profile, and\nREADME.md:168:entire graph search --repo . --query \"retry logic for webhook delivery\" --top-k 20 --format agent --head --profile full --index-all-files --cache-dir /path/to/cache\nREADME.md:172:Omit `--index-all-files` to retain a bounded selective view (derived without\nREADME.md:181:- graph-neighbor expansion (in the `fast` profile) so related regions surface together\nREADME.md:191:- **Cold search** scans files without parsing, then indexes an adaptive pool of 96–256 query-relevant files based on the requested `--top-k`. Shallow searches of up to 20 results retain the 96-file interactive latency bound. Deeper rankings add a corpus-wide sparse pass over eligible files up to 2 MiB, while syntax parsing remains bounded to the adaptive pool; this deliberately spends more time for region recall inside large files. Override the parsing pool with `--max-indexed-files`, or force exhaustive parsing with `--index-all-files`.\nREADME.md:192:- **Profiles.** The default `syntax-only` profile avoids synchronous whole-repository graph construction; `--profile fast` adds local relation expansion when deeper semantic indexing is worth the cost.\nREADME.md:214:of repeating every path. The default full profile favors\nREADME.md:215:relationship correctness; use `--profile fast` when shallow call resolution is\nREADME.md:241:**Schema 1.1 defines 30 relation types**, emitted in profile-scoped subsets:\nREADME.md:252:**Indexing profiles** trade depth for speed: `syntax-only` emits `DEFINES` and `CONTAINS`; `fast` adds imports, shallow calls, boundary relations, and infrastructure-as-code edges; `full` (default) emits every relation type with evidence fields. `capabilities --json` reports the supported relation types per language.\nREADME.md:311:### ⚡ Throughput (full profile)\nREADME.md:350:- **Explicit preindex:** `index --head` builds and verifies that same query-independent artifact before latency-sensitive agent work; cached `search` and `neighbors` calls then report the hit directly.\nREADME.md:408:| `--profile syntax-only\\|fast\\|full` | Relation depth (structure only → shallow → complete) |\nREADME.md:410:| `--max-indexed-files` / `--index-all-files` | Bound or exhaust cold-search parsing |\nREADME.md:450:go run ./cmd/graph-bench -profile syntax-only -languages Go -limit 1\nREADME.md:453:Read speed and throughput from the `fast` profile (and `syntax-only` for the floor), and semantic depth and coverage from `full`. See [docs/benchmarks.md](docs/benchmarks.md) for the full harness layout, flags, and guardrails.\ndocs/benchmarks.md:29:go run ./cmd/graph-bench -profile syntax-only -languages Go -limit 1 \\\ndocs/benchmarks.md:33:### Per-profile examples\ndocs/benchmarks.md:3