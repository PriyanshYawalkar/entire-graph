{"timestamp":"2026-07-18T15:31:35.858Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5b9c57dbb88191ae127aacd7df1681","status":"completed","call_id":"call_BxKo8ZtoNZrBk4D9LbkP827T","name":"exec","input":"const r = await tools.exec_command({cmd:\"sed -n '660,910p' competitive-eval/tools/run_agentic_tasks_smoke.py && sed -n '1038,1110p' competitive-eval/tools/run_agentic_tasks_smoke.py\",\"workdir\":\"/private/tmp/brain-bench-graph-agentic-pilot\",\"yield_time_ms\":10000,\"max_output_tokens\":20000});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T15:31:36.051Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f75da-b7f3-7991-b96f-9a8a6a571532","call_id":"call_BxKo8ZtoNZrBk4D9LbkP827T","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"        or setup.get(\"commit\") != repository[\"commit\"]\n        or setup.get(\"tree\") != repository[\"tree\"]\n        or setup.get(\"execution_config_sha256\") != execution_config_sha256\n        or setup.get(\"product_binding\") != product_binding\n    ):\n        raise SmokeError(\"existing setup record does not match the preindexed protocol binding\")\n    if system == \"entire-graph\" and cache_inventory(graph_cache) != setup.get(\"validation\", {}).get(\"cache_inventory\"):\n        raise SmokeError(\"existing Entire Graph cache differs from its validated setup record\")\n    if system == \"cbm\" and cache_inventory(cbm_cache) != setup.get(\"validation\", {}).get(\"cache_inventory\"):\n        raise SmokeError(\"existing Codebase Memory cache differs from its validated setup record\")\n    setup[\"record_sha256\"] = artifacts.sha256_file(path)\n    return setup\n\n\ndef audit_smoke_treatment(\n    system: str, tools: list[dict[str, Any]], graph_binary: Path, *,\n    graph_cache: Path | None = None, cbm_project: str | None = None,\n    cbm_binary: Path | None = None,\n) -> dict[str, Any]:\n    audit = runtime.audit_treatment(system, tools, graph_binary)\n    executed = [\n        tool for tool in tools\n        if isinstance(tool.get(\"result\"), dict) and not tool[\"result\"].get(\"is_error\")\n    ]\n    commands = [runtime.bash_command(tool) for tool in executed if runtime.bash_command(tool)]\n    graph_search_commands = [\n        command for command in commands\n        if str(graph_binary) in command and \" search \" in f\" {command} \"\n    ]\n    graph_neighbor_commands = [\n        command for command in commands\n        if str(graph_binary) in command and \" neighbors \" in f\" {command} \"\n    ]\n    graph_retrieval_commands = graph_search_commands + graph_neighbor_commands\n    neighbor_calls = sum(\n        str(graph_binary) in command and \" neighbors \" in f\" {command} \"\n        for command in commands\n    )\n    violations = set(audit[\"violations\"])\n    if system == \"entire-graph\":\n        # The generic pilot audit historically required search specifically.\n        # This suite permits the agent to choose the appropriate Graph\n        # retrieval instead of forcing search + neighbors + verification.\n        violations.discard(\"missing_entire_graph_search\")\n        violations.discard(\"missing_entire_graph_agent_format\")\n        if not graph_retrieval_commands:\n            violations.add(\"missing_entire_graph_retrieval\")\n        accepted_cache_values = {\"$ENTIRE_GRAPH_CACHE_DIR\"}\n        if graph_cache is not None:\n            accepted_cache_values.add(str(graph_cache))\n        for command in graph_retrieval_commands:\n            if \"--head\" not in command or \"--worktree\" in command or \"--no-cache\" in command:\n                violations.add(\"entire_graph_retrieval_not_bound_to_preindexed_head\")\n            if \"--format agent\" not in command and \"--format=agent\" not in command:\n                violations.add(\"entire_graph_retrieval_not_agent_format\")\n            if not any(\n                f'--cache-dir \"{value}\"' in command\n                or f\"--cache-dir '{value}'\" in command\n                or f\"--cache-dir {value}\" in command\n                or f\"--cache-dir={value}\" in command\n                for value in accepted_cache_values\n            ):\n                violations.add(\"entire_graph_retrieval_wrong_cache\")\n        for command in graph_search_commands:\n            if \"--profile full\" not in command and \"--profile=full\" not in command:\n                violations.add(\"entire_graph_search_wrong_profile\")\n            if \"--index-all-files\" not in command:\n                violations.add(\"entire_graph_search_not_bound_to_complete_preindex\")\n        for command in graph_neighbor_commands:\n            if \"--profile full\" not in command and \"--profile=full\" not in command:\n                violations.add(\"entire_graph_neighbors_wrong_profile\")\n        for tool in executed:\n            command = runtime.bash_command(tool)\n            if command not in graph_retrieval_commands:\n                continue\n            result = tool.get(\"result\") if isinstance(tool.get(\"result\"), dict) else {}\n            if \"Index: cache-hit\" not in str(result.get(\"content\") or \"\"):\n                violations.add(\"entire_graph_retrieval_cache_miss\")\n    if system == \"cbm\":\n        cbm_tools = [\n            tool for tool in executed\n            if str(tool.get(\"name\") or \"\").startswith(\"mcp__codebase-memory-mcp\")\n        ]\n        retrieval_suffixes = {\n            \"search_graph\", \"query_graph\", \"trace_path\", \"get_code_snippet\",\n            \"get_architecture\", \"search_code\",\n        }\n        retrieval_tools = [\n            tool for tool in cbm_tools\n            if any(str(tool.get(\"name\") or \"\").endswith(suffix) for suffix in retrieval_suffixes)\n        ]\n        if any(\n            str(tool.get(\"name\") or \"\").endswith((\"index_repository\", \"delete_project\"))\n            for tool in cbm_tools\n        ):\n            violations.add(\"cbm_mutated_index_during_timed_task\")\n        if not retrieval_tools:\n            violations.add(\"missing_cbm_retrieval\")\n        if cbm_project and any(\n            (tool.get(\"input\") or {}).get(\"project\") != cbm_project\n            for tool in retrieval_tools\n        ):\n            violations.add(\"cbm_retrieval_used_wrong_project\")\n        for tool in retrieval_tools:\n            content = (tool.get(\"result\") or {}).get(\"content\")\n            try:\n                response = json.loads(content) if isinstance(content, str) else None\n            except json.JSONDecodeError:\n                response = None\n            if isinstance(response, dict) and (\n                response.get(\"error\")\n                or response.get(\"status\") in {\"degraded\", \"missing\", \"corrupt\", \"failed\"}\n            ):\n                violations.add(\"cbm_retrieval_returned_unhealthy_result\")\n    graph_commands = [command for command in commands if str(graph_binary) in command]\n    if system != \"entire-graph\" and graph_commands:\n        violations.add(\"unassigned_entire_graph_binary_used\")\n    if system == \"entire-graph\" and any(\n        command not in graph_retrieval_commands for command in graph_commands\n    ):\n        violations.add(\"entire_graph_nonretrieval_command_used\")\n    if cbm_binary is not None and any(str(cbm_binary) in command for command in commands):\n        violations.add(\"cbm_cli_used_during_timed_task\")\n    if system == \"file-tools\" and neighbor_calls:\n        violations.add(\"baseline_used_graph_product\")\n    audit[\"entire_graph_neighbor_calls\"] = neighbor_calls\n    audit[\"entire_graph_retrieval_calls\"] = len(graph_retrieval_commands)\n    audit[\"violations\"] = sorted(violations)\n    audit[\"passed\"] = not violations\n    return audit\n\n\ndef execute_one(\n    repository: dict[str, Any], system: str, output: Path, *, claude: Path,\n    graph: Path, cbm: Path, model: str, max_turns: int, max_budget_usd: float,\n    timeout_seconds: int, runtime_path_prefix: str, setup: dict[str, Any],\n) -> dict[str, Any]:\n    checkout = Path(repository[\"checkouts\"][system]).resolve(strict=True)\n    assert_pristine_checkout(checkout, repository)\n    record_root, graph_cache, cbm_cache, temp, home = treatment_paths(repository, system, output)\n    for path in (cbm_cache, graph_cache, temp, home / \".claude\"):\n        path.mkdir(parents=True, exist_ok=True)\n    runtime.copy_claude_credentials(home / \".claude\" / \".credentials.json\")\n    mcp = runtime.mcp_config(system, output, cbm, cbm_cache)\n    prompt = prompt_for(repository, system, graph, cbm_project=setup.get(\"project\"))\n    command = claude_command(\n        claude=claude, model=model, system=system,\n        prompt=prompt,\n        mcp=mcp, graph=graph,\n        max_turns=max_turns, max_budget_usd=max_budget_usd,\n    )\n    readable_files = [claude, mcp]\n    if system == \"entire-graph\":\n        readable_files.append(graph)\n    elif system == \"cbm\":\n        readable_files.append(cbm)\n    command, sandbox_sha = runtime.sandboxed_agent_command(\n        command, checkout=checkout, output=output,\n        source_repository=Path(repository[\"source_repository\"]),\n        readable_files=readable_files,\n        readable_paths=[Path(row).parent for row in runtime_path_prefix.split(os.pathsep) if row],\n        writable_paths=[cbm_cache, graph_cache, temp, home],\n        checkout_writable=False,\n    )\n    environment = runtime.runtime_environment(runtime_path_prefix)\n    environment.update({\n        \"HOME\": str(home), \"CLAUDE_CONFIG_DIR\": str(home / \".claude\"),\n        \"TMPDIR\": str(temp), \"CLAUDE_CODE_TMPDIR\": str(temp), \"CLAUDE_TMPDIR\": str(temp),\n        \"ENTIRE_GRAPH_CACHE_DIR\": str(graph_cache),\n        \"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC\": \"1\", \"DISABLE_AUTOUPDATER\": \"1\",\n        \"GIT_CONFIG_GLOBAL\": \"/dev/null\", \"GIT_CONFIG_NOSYSTEM\": \"1\",\n    })\n    attempt_start = {\n        \"schema_version\": 1, \"measurement_protocol\": MEASUREMENT_PROTOCOL,\n        \"suite\": repository[\"suite\"], \"repository\": repository[\"repository\"],\n        \"system\": system, \"commit\": repository[\"commit\"], \"tree\": repository[\"tree\"],\n        \"execution_config_sha256\": setup[\"execution_config_sha256\"],\n        \"setup_record_sha256\": setup[\"record_sha256\"],\n        \"product_binding\": setup[\"product_binding\"],\n        \"prompt_sha256\": artifacts.sha256_bytes(prompt.encode(\"utf-8\")),\n        \"command_sha256\": artifacts.sha256_bytes(artifacts.canonical_bytes(command)),\n        \"mcp_config_sha256\": artifacts.sha256_file(mcp),\n        \"sandbox_profile_sha256\": sandbox_sha,\n    }\n    attempt_start_sha = canonical_write(record_root / \"attempt-start.json\", attempt_start)\n    started = time.monotonic()\n    timed_out = False\n    try:\n        process = runtime.run_command(command, cwd=checkout, env=environment, timeout=timeout_seconds)\n        stdout, stderr, returncode = process.stdout, process.stderr, process.returncode\n    except subprocess.TimeoutExpired as error:\n        timed_out, stdout, stderr, returncode = True, error.stdout or b\"\", error.stderr or b\"\", 124\n    finally:\n        shutil.rmtree(home, ignore_errors=True)\n    task_wall_time_ms = max(1, round((time.monotonic() - started) * 1000))\n    assert_pristine_checkout(checkout, repository)\n    (record_root / \"transcript.jsonl\").write_bytes(stdout)\n    (record_root / \"stderr.txt\").write_bytes(stderr)\n    parsed = runtime.parse_stream(stdout)\n    response = structured_result(parsed[\"result\"])\n    scores = score_response(repository[\"cases\"], response)\n    audit = audit_smoke_treatment(\n        system, parsed[\"tools\"], graph, graph_cache=graph_cache,\n        cbm_project=setup.get(\"project\"), cbm_binary=cbm,\n    )\n    if system == \"entire-graph\":\n        before = setup.get(\"validation\", {}).get(\"cache_inventory\") or []\n        after = cache_inventory(graph_cache)\n        if after != before:\n            audit[\"violations\"] = sorted(set(audit[\"violations\"]) | {\"entire_graph_cache_changed_during_task\"})\n            audit[\"passed\"] = False\n    result = parsed.get(\"result\") or {}\n    record = {\n        \"schema_version\": 1, \"suite\": repository[\"suite\"], \"repository\": repository[\"repository\"],\n        \"system\": system, \"model\": model, \"returncode\": returncode, \"timed_out\": timed_out,\n        \"wall_time_ms\": task_wall_time_ms,\n        \"task_wall_time_ms\": task_wall_time_ms,\n        \"setup_wall_time_ms\": setup[\"setup_wall_time_ms\"],\n        \"setup_record_sha256\": setup[\"record_sha256\"],\n        \"execution_config_sha256\": setup[\"execution_config_sha256\"],\n        \"attempt_start_sha256\": attempt_start_sha,\n        \"measurement_protocol\": MEASUREMENT_PROTOCOL,\n        \"sandbox_profile_sha256\": sandbox_sha, \"treatment_audit\": audit,\n        \"tool_call_count\": len(parsed[\"tools\"]), \"scores\": scores,\n        \"exact_pass_rate\": sum(row[\"passed\"] for row in scores) / len(scores),\n        \"retained_assertion_pass_rate\": (\n            None if repository.get(\"oracle_complete\")\n            else sum(row[\"passed\"] for row in scores) / len(scores)\n        ),\n        \"mean_recall\": sum(row[\"recall\"] for row in scores) / len(scores),\n        \"mean_precision\": sum(row[\"precision\"] for row in scores) / len(scores),\n        \"usage\": result.get(\"usage\") if isinstance(result.get(\"usage\"), dict) else {},\n        \"num_turns\": result.get(\"num_turns\"), \"reported_total_cost_usd\": result.get(\"total_cost_usd\"),\n        \"structured_response_present\": response is not None,\n    }\n    canonical_write(record_root / \"record.json\", record)\n    if not audit[\"passed\"]:\n        raise SmokeError(\n            f\"timed treatment protocol violation for {repository['repository']} {system}: \"\n            f\"{audit['violations']}; invalid record preserved\"\n        )\n    return record\n\n\ndef recover_existing_attempt(\n    repository: dict[str, Any], system: str, output: Path, *, claude: Path,\n    graph: Path, cbm: Path, runtime_path_prefix: str,\n    execution_config_sha256: str, model: str, max_turns: int,\n    max_budget_usd: float,\n) -> dict[str, Any] | None:\n    \"\"\"Score an immutable transcript left by a post-execution controller failure.\"\"\"\n        \"recovered_after_controller_scoring_failure\": True,\n        \"source_transcript_sha256\": artifacts.sha256_file(transcript),\n    }\n    canonical_write(record_path, record)\n    if not audit[\"passed\"]:\n        raise SmokeError(\"recovered attempt contains a timed treatment protocol violation\")\n    return record\n\n\ndef summarize(\n    records: list[dict[str, Any]], output: Path, systems_to_report: tuple[str, ...] = SYSTEMS,\n) -> dict[str, Any]:\n    oracle_complete = bool(records) and all(row.get(\"suite\") == ORACLE_SUITE for row in records)\n    systems = {}\n    for system in systems_to_report:\n        rows = [row for row in records if row[\"system\"] == system]\n        scores = [score for row in rows for score in row[\"scores\"]]\n        provider_input_tokens = sum(\n            (row[\"usage\"].get(\"input_tokens\") or 0)\n            + (row[\"usage\"].get(\"cache_creation_input_tokens\") or 0)\n            + (row[\"usage\"].get(\"cache_read_input_tokens\") or 0)\n            for row in rows\n        )\n        systems[system] = {\n            \"attempts\": len(rows), \"questions\": len(scores),\n            \"exact_pass_rate\": sum(row[\"passed\"] for row in scores) / len(scores),\n            \"retained_assertion_pass_rate\": (\n                None if oracle_complete else sum(row[\"passed\"] for row in scores) / len(scores)\n            ),\n            \"mean_recall\": sum(row[\"recall\"] for row in scores) / len(scores),\n            \"mean_precision\": sum(row[\"precision\"] for row in scores) / len(scores),\n            \"micro_recall\": sum(row[\"matched_items\"] for row in scores) / sum(row[\"expected_items\"] for row in scores),\n            \"mean_tool_calls\": sum(row[\"tool_call_count\"] for row in rows) / len(rows),\n            \"mean_wall_time_ms\": sum(row.get(\"task_wall_time_ms\", row[\"wall_time_ms\"]) for row in rows) / len(rows),\n            \"mean_task_wall_time_ms\": sum(row.get(\"task_wall_time_ms\", row[\"wall_time_ms\"]) for row in rows) / len(rows),\n            \"mean_setup_wall_time_ms\": sum(row.get(\"setup_wall_time_ms\", 0) for row in rows) / len(rows),\n            \"input_tokens\": sum((row[\"usage\"].get(\"input_tokens\") or 0) for row in rows),\n            \"provider_input_tokens_including_cache\": provider_input_tokens,\n            \"output_tokens\": sum((row[\"usage\"].get(\"output_tokens\") or 0) for row in rows),\n            \"reported_cost_usd\": sum((row.get(\"reported_total_cost_usd\") or 0) for row in rows),\n            \"treatment_compliance_rate\": sum(row[\"treatment_audit\"][\"passed\"] for row in rows) / len(rows),\n        }\n    summary = {\n        \"schema_version\": 1,\n        \"measurement_protocol\": MEASUREMENT_PROTOCOL,\n        \"suite\": ORACLE_SUITE if oracle_complete else SUITE,\n        \"development_only\": True,\n        \"confirmatory_use_allowed\": False,\n        \"all_question_exact_claim_allowed\": oracle_complete,\n        \"callgraph_oracle_complete\": oracle_complete,\n        \"repository_count\": len({row[\"repository\"] for row in records if row.get(\"repository\")}) or 3,\n        \"attempt_count\": len(records),\n        \"systems\": systems,\n    }\n    canonical_write(output / \"summary.json\", summary)\n    if oracle_complete:\n        title = \"# Compiler-Oracle Agentic Smoke\"\n        scope = \"Development-only; predefined repositories; Claude Opus; exhaustive expectations for the selected compiler-oracle neighborhoods. Exactness is scoped to those compiled neighborhoods.\"\n        quality_label = \"Exact\"\n    else:\n        title = \"# Retained Tasks Agentic Smoke\"\n        scope = \"Development-only; predefined repositories; Claude Opus; one attempt per selected repository and treatment. Callgraph expectations are retained non-exhaustive assertions, so an all-question exact claim is disallowed.\"\n        quality_label = \"Retained assertions\"\n    lines = [title, \"\", scope, \"\", f\"| System | {quality_label} | Macro recall | Micro recall | Tool calls | Task wall time, preindexed (s) | Setup/index, excluded (s) | Provider input incl. cache | Output tokens | Cost (USD) | Compliance |\", \"| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\"]\n    for system in systems_to_report:\n        row = systems[system]\n        lines.append(f\"| {system} | {row['exact_pass_rate']:.3f} | {row['mean_recall']:.3f} | {row['micro_recall']:.3f} | {row['mean_tool_calls']:.1f} | {row['mean_task_wall_time_ms']/1000:.1f} | {row['mean_setup_wall_time_ms']/1000:.1f} | {row['provider_input_tokens_including_cache']} | {row['output_tokens']} | {row['reported_cost_usd']:.4f} | {row['treatment_compliance_rate']:.3f} |\")\n    (output / \"scoreboard.md\").write_text(\"\\n\".join(lines) + \"\\n\", encoding=\"utf-8\")\n    return summary\n\n\ndef rescore(prepared: dict[str, Any], output: Path) -> dict[str, Any]:\n    require_protocol_output_compatible(output)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
