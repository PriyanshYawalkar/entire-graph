\\": \\\"simdjson/simdjson/485.json\\\",\\n        \\\"sha256\\\": \\\"d88ffa5a6ebb8fac761da05e3414fdce51a9050d1f697d2114a7951e4a92077c\\\"\\n      },\\n      {\\n        \\\"path\\\": \\\"zeromicro/go-zero/1907.json\\\",\\n        \\\"sha256\\\": \\\"a2d478ab6f452ee86415260669f6d2ae47eff419266939a007108fc74195a6aa\\\"\\n      },\\n      {\\n        \\\"path\\\": \\\"zeromicro/go-zero/2537.json\\\",\\n        \\\"sha256\\\": \\\"bf27c98481414db1774f839e2530f435aa8e718730878d77e1db1b7ef69cea55\\\"\\n      },\\n      {\\n        \\\"path\\\": \\\"zeromicro/go-zero/2787.json\\\",\\n        \\\"sha256\\\": \\\"12b304ccdf7f242a2103c2e6102cb2021f380b81791e6a270f6c953c91254827\\\"\\n      }\\n    ]\\n  },\\n  \\\"multi_swe_bench\\\": {\\n    \\\"api_metadata_sha256\\\": \\\"220f918ae1d9f4a2a9567f54e18f0c99791b18aa7d7bd0f4cfa1a6c22e239f47\\\",\\n    \\\"dataset\\\": \\\"ByteDance-Seed/Multi-SWE-bench\\\",\\n    \\\"note\\\": \\\"Paths identify upstream repositories; embedded patch files are not downloaded.\\\",\\n    \\\"revision\\\": \\\"56ff018c04a38e27ada1e9d0a6d5839a51f88f0d\\\",\\n    \\\"selected_source_paths\\\": [\\n      \\\"c/facebook__zstd_dataset.jsonl\\\",\\n      \\\"cpp/simdjson__simdjson_dataset.jsonl\\\",\\n      \\\"go/grpc__grpc-go_dataset.jsonl\\\",\\n      \\\"go/zeromicro__go-zero_dataset.jsonl\\\",\\n      \\\"java/alibaba__fastjson2_dataset.jsonl\\\",\\n      \\\"js/anuraghazra__github-readme-stats_dataset.jsonl\\\",\\n      \\\"rust/sharkdp__fd_dataset.jsonl\\\",\\n      \\\"ts/mui__material-ui_dataset.jsonl\\\"\\n    ]\\n  }\\n}\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"bcf4aa\",\"wall_time_seconds\":0.00000275,\"exit_code\":0,\"original_token_count\":1361,\"output\":\"qrel or materialization argument and records `qrels_accessed=false` in every\\nrank artifact. It reads only the issue, unlabeled candidate corpus, exact\\nrepository snapshot, and frozen protocol. The `score` command opens qrels only\\nafter ranks have been written.\\n\\nThe systems are:\\n\\n- native Okapi BM25 over CORE-Bench candidate chunks;\\n- deterministic literal file search over the pinned source tree;\\n- `entire-graph symbols`, joined to the same qrel-blind source matches and\\n  reranked once by `gpt-5.4`;\\n- CBM `search_code`, reranked once by the same model and output schema.\\n\\nBoth mediated systems receive normalized file, span, symbol, and excerpt\\nfields, the same prompt and model, one turn, no filesystem tools, and at most\\n60 candidates. A location contributes at most the five candidate corpus chunks\\nnearest its focus line, so a broad symbol cannot consume Recall@100 merely by\\nspanning a large file. Model failure retains deterministic retrieval order and\\nis classified rather than silently retried.\\n\\n## Canary Result\\n\\nBefore freezing the sample, the location-recovery contract was checked on the\\noverlap-ineligible canary `BurntSushi/ripgrep` PR 1294 at base commit\\n`392682d35296bda5c0d0cccf43bae55be3d084df`. All five positive qrel chunks\\nmapped by exact text to one tracked location: three in `src/app.rs` and two in\\n`src/args.rs`. This canary is excluded by the breadth-corpus overlap rule and\\ncannot enter the spike sample.\\n\\nThe packaged CORE-Bench corpus contains opaque chunk IDs and text, but no file\\npaths or base commits. Pinned Multi-SWE filenames identify the upstream\\nrepository, and frozen GitHub pull-request metadata supplies its base commit;\\nexact-text mapping against tracked files supplies path and line provenance.\\nThis avoids downloading source rows that embed hundreds of megabytes of gold\\npatches. Missing or ambiguous mappings remain failures and are never resolved\\nby consulting the gold patch manually.\\n            )\\n            if not qrels:\\n                raise ValueError(f\\\"{query_id} has no qrels\\\")\\n            candidate_ids = set(filtered)\\n            missing_qrels = sorted({row[\\\"corpus_id\\\"] for row in qrels} - candidate_ids)\\n            if missing_qrels:\\n                raise ValueError(f\\\"{query_id} qrels outside candidate set: {missing_qrels[:5]}\\\")\\n            selected_cases.append(\\n                {\\n                    \\\"id\\\": query_id,\\n                    \\\"repo\\\": source_repo,\\n                    \\\"normalized_repo\\\": normalize_repo(source_repo),\\n                    \\\"language\\\": repo[\\\"language\\\"],\\n                    \\\"role\\\": repo[\\\"role\\\"],\\n                    \\\"base_commit\\\": base_commit.lower(),\\n                    \\\"pull_request_number\\\": pull_number,\\n                    \\\"pull_request_url\\\": pull.get(\\\"html_url\\\"),\\n                    \\\"issue_text\\\": query.get(\\\"text\\\", \\\"\\\"),\\n                    \\\"query_record_sha256\\\": canonical_row_hash(query),\\n                    \\\"pull_request_metadata_sha256\\\": canonical_row_hash(pull_projection),\\n                    \\\"candidate_corpus_count\\\": len(filtered),\\n                    \\\"candidate_corpus_ids_sha256\\\": sha256_bytes(canonical_json_bytes(sorted(filtered))),\\n                    \\\"qrel_row_count\\\": len(qrels),\\n                    \\\"relevant_corpus_count\\\": len({row[\\\"corpus_id\\\"] for row in qrels}),\\n                    \\\"qrels_sha256\\\": sha256_bytes(canonical_json_bytes(qrels)),\\n                    \\\"core_queries_path\\\": queries_path,\\n                    \\\"core_qrels_path\\\": qrels_path,\\n                    \\\"source_dataset_path\\\": source_path,\\n                }\\n            )\\n\\n    manifest = {\\n        \\\"schema_version\\\": 1,\\n        \\\"suite\\\": \\\"core_bench_level2_feasibility_spike\\\",\\n        \\\"freeze_status\\\": \\\"selected_before_system_adapter_implementation\\\",\\n        \\\"sources\\\": {\\n            \\\"core_bench\\\": {\\n                \\\"dataset\\\": CORE_DATASET,\\n                \\\"revision\\\": CORE_REVISION,\\n                \\\"api_metadata_sha256\\\": core_metadata_hash,\\n                \\\"files\\\": [\\n                    {\\\"path\\\": path, \\\"sha256\\\": digest} for path, digest in sorted(core_file_hashes.items())\\n                ],\\n            },\\n            \\\"multi_swe_bench\\\": {\\n                \\\"dataset\\\": SOURCE_DATASET,\\n                \\\"revision\\\": SOURCE_REVISION,\\n                \\\"api_metadata_sha256\\\": source_metadata_hash,\\n                \\\"selected_source_paths\\\": sorted(selected_source_paths),\\n                \\\"note\\\": \\\"Paths identify upstream repositories; embedded patch files are not downloaded.\\\",\\n            },\\n            \\\"github_pull_requests\\\": {\\n                \\\"api_version\\\": \\\"2022-11-28\\\",\\n                \\\"files\\\": [\\n                    {\\\"path\\\": path, \\\"sha256\\\": digest}\\n                    for path, digest in sorted(github_file_hashes.items())\\n                ],\\n            },\\n        },\\n        \\\"selection\\\": {\\n            \\\"algorithm\\\": \\\"sha256_language_stratified_v1\\\",\\n            \\\"seed\\\": SELECTION_SEED,\\n            \\\"source_level\\\": CORE_LEVEL,\\n            \\\"source_subdataset\\\": CORE_SUBDATASET,\\n            \\\"repository_count\\\": REPOSITORY_COUNT,\\n            \\\"queries_per_repository\\\": QUERIES_PER_REPOSITORY,\\n            \\\"development_repository_count\\\": DEVELOPMENT_REPOSITORIES,\\n            \\\"minimum_queries_per_repository\\\": MIN_QUERIES_PER_REPOSITORY,\\n            \\\"candidate_catalog_sha256\\\": sha256_bytes(canonical_json_bytes(catalog_doc)),\\n            \\\"exclusions_sha256\\\": sha256_file(exclusions_path),\\n            \\\"eligible_repository_count\\\": sum(row[\\\"eligible\\\"] for row in catalog),\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"0c693b\",\"wall_time_seconds\":1.003162416,\"session_id\":34614,\"original_token_count\":0,\"output\":\"\"}"}],"internal_chat_message_metadata_passthrough":{"