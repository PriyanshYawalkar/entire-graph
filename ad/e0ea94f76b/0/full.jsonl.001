{"timestamp":"2026-07-18T16:27:11.973Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5ba95ff4888191b4725ffcc87edbf8","status":"completed","call_id":"call_MDSAShd5juxbjcAKYpLX6wu0","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '1,400p' competitive-eval/tools/test_materialize_agentic_issue_analysis_smoke.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 50000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:27:12.179Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f760d-9fb3-7230-9e18-858e6f74abaf","call_id":"call_MDSAShd5juxbjcAKYpLX6wu0","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"from __future__ import annotations\n\nimport importlib.util\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\n\n\nTOOLS = Path(__file__).resolve().parent\nif str(TOOLS) not in sys.path:\n    sys.path.insert(0, str(TOOLS))\nSPEC = importlib.util.spec_from_file_location(\n    \"materialize_agentic_issue_analysis_smoke\",\n    TOOLS / \"materialize_agentic_issue_analysis_smoke.py\",\n)\nassert SPEC is not None and SPEC.loader is not None\nmaterializer = importlib.util.module_from_spec(SPEC)\nsys.modules[SPEC.name] = materializer\nSPEC.loader.exec_module(materializer)\n\nimport sem_v7_artifacts as artifacts\n\n\nREPOSITORIES = (\n    (\"Example/Alpha\", \"python\"),\n    (\"Example/Beta\", \"go\"),\n    (\"Example/Gamma\", \"rust\"),\n)\n\n\ndef git(cwd: Path, *arguments: str) -> str:\n    process = subprocess.run(\n        [\"git\", *arguments],\n        cwd=cwd,\n        text=True,\n        capture_output=True,\n        check=False,\n    )\n    assert process.returncode == 0, process.stderr\n    return process.stdout.strip()\n\n\ndef make_repository(root: Path, name: str) -> dict[str, Any]:\n    repository = root / name\n    (repository / \"src\").mkdir(parents=True)\n    (repository / \"src/code.py\").write_text(\n        \"old first line\\nold second line\\nunchanged third line\\n\", encoding=\"utf-8\"\n    )\n    git(repository, \"init\", \"--quiet\")\n    git(repository, \"config\", \"user.name\", \"Smoke Test\")\n    git(repository, \"config\", \"user.email\", \"smoke@example.invalid\")\n    git(repository, \"add\", \"src/code.py\")\n    git(repository, \"commit\", \"--quiet\", \"-m\", \"base\")\n    return {\n        \"path\": repository,\n        \"commit\": git(repository, \"rev-parse\", \"HEAD\"),\n        \"tree\": git(repository, \"rev-parse\", \"HEAD^{tree}\"),\n    }\n\n\ndef patch_for(line: int = 1, path: str = \"src/code.py\") -> str:\n    old = \"old first line\" if line == 1 else \"old second line\"\n    return (\n        f\"diff --git a/{path} b/{path}\\n\"\n        f\"--- a/{path}\\n\"\n        f\"+++ b/{path}\\n\"\n        f\"@@ -{line},1 +{line},1 @@\\n\"\n        f\"-{old}\\n\"\n        f\"+new line\\n\"\n    )\n\n\ndef cohort_document() -> dict[str, Any]:\n    claim = {\n        \"issue_analysis_development_smoke_only\": True,\n        \"code_repair_claim_allowed\": False,\n        \"broad_superiority_claim_allowed\": False,\n        \"confirmatory_claim_allowed\": False,\n    }\n    return {\n        \"schema_version\": 1,\n        \"suite\": materializer.SUITE,\n        \"stage\": materializer.COHORT_STAGE,\n        **{field: False for field in materializer.AUTHORITY_FIELDS},\n        \"development_only\": True,\n        \"claim_boundary\": claim,\n        \"repository_count\": 3,\n        \"repositories\": [\n            {\n                \"repo\": repo,\n                \"normalized_repo\": repo.casefold(),\n                \"language\": language,\n                \"instance_count\": 2,\n            }\n            for repo, language in REPOSITORIES\n        ],\n    }\n\n\ndef source_rows(repositories: dict[str, dict[str, Any]]) -> list[dict[str, Any]]:\n    rows: list[dict[str, Any]] = []\n    for repo, language in REPOSITORIES:\n        binding = repositories[repo.casefold()]\n        for index in (1, 2):\n            rows.append(\n                {\n                    \"instance_id\": f\"{repo.casefold()}-issue-{index}\",\n                    \"repo\": repo,\n                    \"language\": language,\n                    \"created_at\": f\"2026-01-0{index}T00:00:00Z\",\n                    \"base_commit\": binding[\"commit\"],\n                    \"problem_statement\": (\n                        f\"Investigate the request processing behavior for case {index} \"\n                        \"and identify where the implementation should change.\"\n                    ),\n                    \"patch\": patch_for(index),\n                }\n            )\n    return rows\n\n\ndef fixture(tmp_path: Path) -> tuple[\n    dict[str, Any], str, list[dict[str, Any]], materializer.CheckoutProvider\n]:\n    repositories = {\n        repo.casefold(): make_repository(tmp_path / \"repositories\", repo.split(\"/\")[1].lower())\n        for repo, _language in REPOSITORIES\n    }\n    cohort = cohort_document()\n    cohort_sha256 = artifacts.sha256_bytes(artifacts.canonical_bytes(cohort))\n\n    def checkout_provider(_root: Path, case: dict[str, Any]) -> dict[str, Any]:\n        binding = repositories[case[\"normalized_repo\"]]\n        return {\n            **binding,\n            \"tracked_files\": 1,\n            \"checkout_relative_path\": f\"cases/{case['id']}\",\n        }\n\n    return cohort, cohort_sha256, source_rows(repositories), checkout_provider\n\n\ndef build(tmp_path: Path, rows_order: str = \"forward\") -> tuple[\n    dict[str, Any], dict[str, Any], dict[str, Any]\n]:\n    cohort, cohort_sha256, rows, provider = fixture(tmp_path)\n    if rows_order == \"reverse\":\n        rows.reverse()\n    return materializer.build_artifacts(\n        cohort=cohort,\n        cohort_sha256=cohort_sha256,\n        source_rows=rows,\n        source_row_count=1234,\n        checkouts_dir=tmp_path / \"unused-checkouts\",\n        checkout_provider=provider,\n        parquet_file_name=\"synthetic.parquet\",\n    )\n\n\ndef walk_keys(value: Any) -> set[str]:\n    keys: set[str] = set()\n    if type(value) is dict:\n        keys.update(value)\n        for nested in value.values():\n            keys.update(walk_keys(nested))\n    elif type(value) is list:\n        for nested in value:\n            keys.update(walk_keys(nested))\n    return keys\n\n\ndef test_deterministic_public_sealed_split_and_authority_false(tmp_path: Path) -> None:\n    cohort, cohort_sha256, rows, provider = fixture(tmp_path)\n    first = materializer.build_artifacts(\n        cohort=cohort,\n        cohort_sha256=cohort_sha256,\n        source_rows=rows,\n        source_row_count=1234,\n        checkouts_dir=tmp_path / \"unused\",\n        checkout_provider=provider,\n        parquet_file_name=\"synthetic.parquet\",\n    )\n    with_irrelevant_outcome_fields = [\n        {**row, \"outcome\": \"ignored\", \"tests\": {\"status\": \"ignored\"}}\n        for row in reversed(rows)\n    ]\n    second = materializer.build_artifacts(\n        cohort=cohort,\n        cohort_sha256=cohort_sha256,\n        source_rows=with_irrelevant_outcome_fields,\n        source_row_count=1234,\n        checkouts_dir=tmp_path / \"unused\",\n        checkout_provider=provider,\n        parquet_file_name=\"synthetic.parquet\",\n    )\n    assert first == second\n    public, sealed, attestation = first\n\n    assert public[\"suite\"] == materializer.SUITE\n    assert public[\"stage\"] == materializer.PUBLIC_STAGE\n    assert public[\"queries_present\"] is True\n    assert public[\"qrels_present\"] is False\n    assert public[\"patches_present\"] is False\n    assert public[\"expected_outcomes_present\"] is False\n    assert public[\"outcomes_present\"] is False\n    assert len(public[\"cases\"]) == 3\n    assert len(sealed[\"cases\"]) == 3\n    assert sealed[\"agent_visible\"] is False\n    assert sealed[\"patch_content_present\"] is False\n    assert sealed[\"patch_derived_judgments_present\"] is True\n    assert all(case[\"judgments\"] for case in sealed[\"cases\"])\n\n    forbidden = {\n        \"source_instance_id\",\n        \"patch\",\n        \"patch_sha256\",\n        \"judgment_count\",\n        \"judgments\",\n        \"judgments_sha256\",\n        \"locations\",\n        \"expected_answer\",\n        \"touched_paths\",\n    }\n    assert not (walk_keys(public) & forbidden)\n    public_bytes = artifacts.canonical_bytes(public)\n    for source_row in rows:\n        assert source_row[\"patch\"].encode() not in public_bytes\n        assert source_row[\"instance_id\"].encode() not in public_bytes\n    assert b\"src/code.py\" not in public_bytes\n    for document in first:\n        assert all(document[field] is False for field in materializer.AUTHORITY_FIELDS)\n    assert attestation[\"model_or_paid_process_used\"] is False\n    assert attestation[\"mapping_counts\"][\"missing_base_snapshot_paths\"] == 0\n    assert attestation[\"mapping_counts\"][\"ambiguous_base_snapshot_paths\"] == 0\n\n    expected_projection = sorted(\n        (\n            {\n                field: case[field]\n                for field in (\n                    \"id\",\n                    \"repo\",\n                    \"normalized_repo\",\n                    \"base_commit\",\n                    \"base_tree\",\n                    \"checkout_relative_path\",\n                    \"source_record_sha256\",\n                    \"query_record_sha256\",\n                )\n            }\n            for case in public[\"cases\"]\n        ),\n        key=lambda row: row[\"id\"],\n    )\n    assert attestation[\"checkout_binding_sha256\"] == artifacts.sha256_bytes(\n        artifacts.canonical_bytes(expected_projection)\n    )\n\n\ndef test_added_structurally_ineligible_case_cannot_resample_selection(tmp_path: Path) -> None:\n    cohort, cohort_sha256, rows, provider = fixture(tmp_path)\n    base = materializer.build_artifacts(\n        cohort=cohort,\n        cohort_sha256=cohort_sha256,\n        source_rows=rows,\n        source_row_count=1234,\n        checkouts_dir=tmp_path / \"unused\",\n        checkout_provider=provider,\n    )\n    added = {\n        **rows[0],\n        \"instance_id\": \"would-rank-but-is-ineligible\",\n        \"problem_statement\": \"too short\",\n        \"patch\": \"not a patch\",\n    }\n    extended = materializer.build_artifacts(\n        cohort=cohort,\n        cohort_sha256=cohort_sha256,\n        source_rows=[added, *rows],\n        source_row_count=1235,\n        checkouts_dir=tmp_path / \"unused\",\n        checkout_provider=provider,\n    )\n    assert base[0][\"cases\"] == extended[0][\"cases\"]\n    assert base[1][\"cases\"] == extended[1][\"cases\"]\n\n\ndef test_atomic_no_overwrite_validation_and_tamper_failure(tmp_path: Path) -> None:\n    expected = build(tmp_path / \"fixture\")\n    public_path = tmp_path / \"out\" / \"public.json\"\n    sealed_path = tmp_path / \"out\" / \"sealed.json\"\n    attestation_path = tmp_path / \"out\" / \"attestation.json\"\n    materializer.publish_artifacts(\n        public_path, sealed_path, attestation_path, *expected\n    )\n    materializer.validate_artifacts(\n        public_path, sealed_path, attestation_path, expected\n    )\n    with pytest.raises(ValueError, match=\"overwrite\"):\n        materializer.publish_artifacts(\n            public_path, sealed_path, attestation_path, *expected\n        )\n\n    tampered = dict(expected[0])\n    tampered[\"case_count\"] = 2\n    public_path.write_bytes(artifacts.canonical_bytes(tampered))\n    with pytest.raises(ValueError):\n        materializer.validate_artifacts(\n            public_path, sealed_path, attestation_path, expected\n        )\n\n\ndef test_interrupted_publication_recovers_only_exact_partial(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    expected = build(tmp_path / \"fixture\")\n    paths = (\n        tmp_path / \"out\" / \"public.json\",\n        tmp_path / \"out\" / \"sealed.json\",\n        tmp_path / \"out\" / \"attestation.json\",\n    )\n    original = artifacts.write_new_canonical_json\n    calls = 0\n\n    def interrupted(path: Path, document: Any, **kwargs: Any) -> str:\n        nonlocal calls\n        calls += 1\n        if calls == 2:\n            raise OSError(\"synthetic interruption\")\n        return original(path, document, **kwargs)\n\n    monkeypatch.setattr(artifacts, \"write_new_canonical_json\", interrupted)\n    with pytest.raises(OSError, match=\"synthetic interruption\"):\n        materializer.publish_artifacts(*paths, *expected)\n    assert paths[0].exists() and not paths[1].exists() and not paths[2].exists()\n\n    monkeypatch.setattr(artifacts, \"write_new_canonical_json\", original)\n    materializer.publish_artifacts(*paths, *expected)\n    materializer.validate_artifacts(*paths, expected)\n\n\ndef test_mapping_failure_is_fail_closed_without_resampling(tmp_path: Path) -> None:\n    cohort, cohort_sha256, rows, provider = fixture(tmp_path)\n    # The selected case is deterministic but both candidates for Alpha now map\n    # to a nonexistent base path, so no alternate product/result-driven case can\n    # be substituted.\n    for row in rows:\n        if row[\"repo\"].casefold() == \"example/alpha\":\n            row[\"patch\"] = patch_for(1, \"src/missing.py\")\n    with pytest.raises(ValueError, match=\"not tracked\"):\n        materializer.build_artifacts(\n            cohort=cohort,\n            cohort_sha256=cohort_sha256,\n            source_rows=rows,\n            source_row_count=len(rows),\n            checkouts_dir=tmp_path / \"unused\",\n            checkout_provider=provider,\n        )\n\n\ndef test_no_eligible_case_and_cohort_hash_tamper_fail_closed(tmp_path: Path) -> None:\n    cohort, cohort_sha256, rows, provider = fixture(tmp_path)\n    for row in rows:\n        if row[\"repo\"].casefold() == \"example/beta\":\n            row[\"patch\"] = \"this is not a unified diff\"\n    with pytest.raises(ValueError, match=\"no structurally eligible case\"):\n        materializer.build_artifacts(\n            cohort=cohort,\n            cohort_sha256=cohort_sha256,\n            source_rows=rows,\n            source_row_count=len(rows),\n            checkouts_dir=tmp_path / \"unused\",\n            checkout_provider=provider,\n        )\n\n    with pytest.raises(ValueError, match=\"cohort document hash mismatch\"):\n        materializer.build_artifacts(\n            cohort=cohort,\n            cohort_sha256=\"0\" * 64,\n            source_rows=rows,\n            source_row_count=len(rows),\n            checkouts_dir=tmp_path / \"unused\",\n            checkout_provider=provider,\n        )\n\n\ndef test_patch_scope_parser_excludes_generated_and_unsafe_paths() -> None:\n    assert materializer.patch_judgments(patch_for(1)) == [\n        {\"file_path\": \"src/code.py\", \"start_line\": 1, \"end_line\": 1}\n    ]\n    assert materializer.patch_judgments(patch_for(1, \"../escape.py\")) == []\n    assert materializer.patch_judgments(patch_for(1, \"vendor/generated.py\")) == []\n    assert materializer.PARQUET_SHA256 == (\n        \"0e0bf9355f892ad74ae98d4e1c404f39fd6654a8e351ee3e6ab162e4a64cd3ad\"\n    )\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
