cted files need content hydration for this query.\n237:+\t\treturn SearchResponse{}, errors.New(\"repository HEAD changed during search; retry against a stable commit\")\n243:+\tread, closeSource, err := openSearchContentReader(\n253:+\tqueryReads := &searchContentReadTracker{read: read}\n254:+\tread = cachedContentReader(queryReads.Read)\n263:+\tgraphCandidates := expandGraphCandidates(candidates, q, snapshot.Relations, symbolsByID, read, fileLanguages, options)\n269:+\tusageFilesBefore := queryReads.files\n270:+\tusageBytesBefore := queryReads.bytes\n272:+\t\tctx, expansionSeeds, q, symbolsByID, symbolsByFile, read, fileLanguages, options,\n275:+\tusageFilesRead := queryReads.files - usageFilesBefore\n276:+\tusageBytesRead := queryReads.bytes - usageBytesBefore\n284:+\t// Query and usage counters are disjoint physical reads. Identifier lookups\n285:+\t// already satisfied by the shared content cache add zero usage bytes.\n286:+\tstats.QueryFilesRead = queryReads.files - usageFilesRead\n287:+\tstats.QueryBytesRead = queryReads.bytes - usageBytesRead\n288:+\tstats.UsageFilesRead = usageFilesRead\n289:+\tstats.UsageBytesRead = usageBytesRead\n308:+\t\tread := func(path string) (string, bool) {\n316:+\t\treturn read, batch.Close, nil\n318:+\t_, read, _, closeSource, err := openSource(ctx, repo, false, ignoreFiles, includeFiles)\n319:+\treturn read, closeSource, err\n349:+\tif !options.Worktree && options.TopK <= defaultSearchTopK && searchTermsSafeForGitGrep(q.terms) {\n352:+\t\t\texcludedPaths = searchGrepPartialFailureExclusions(preindexed.Header.PartialFailures)\n354:+\t\tmatches, grepErr := gitutil.GrepTreeMatchesExcluding(\n370:+func searchGrepPartialFailureExclusions(failures []PartialFailure) []string {\n388:+func searchTermsSafeForGitGrep(terms []string) bool {\n399:+func committedSearchFiles(paths []string, matches []gitutil.GrepMatch, q searchQuery) []string {\n450:+func expandGraphCandidates(seeds []searchCandidate, q searchQuery, relations []RelationRecord, symbolsByID map[string]SymbolRecord, read contentReader, languages map[string]string, options SearchOptions) []searchCandidate {\n470:+type usageFileSelector func(context.Context, []string) ([]string, bool)\n478:+) usageFileSelector {\n483:+\t\tif !searchTermsSafeForGitGrep(identifiers) {\n486:+\t\tmatches, err := gitutil.GrepTreeMatches(ctx, repo, treeish, identifiers, 1)\n513:+\tselectors ...usageFileSelector,\n572:+\tif searchDocumentationArtifactPath(lower) && !searchQuerySupplied(q, \"doc\", \"docs\", \"documentation\", \"readme\", \"guide\", \"example\") {\n591:+\t\tstrings.HasPrefix(base, \"readme\") || strings.HasPrefix(base, \"changelog\")\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
