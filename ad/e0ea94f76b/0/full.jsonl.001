{"timestamp":"2026-07-18T16:30:59.687Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5baa43ae3881919b33a3f2c9b691f9","status":"completed","call_id":"call_fnGWTeHpwAcAQGVLOBLfla4C","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"wc -l competitive-eval/tools/run_agentic_issue_analysis_smoke.py competitive-eval/tools/test_run_agentic_issue_analysis_smoke.py && sed -n '1,280p' competitive-eval/tools/run_agentic_issue_analysis_smoke.py && sed -n '280,700p' competitive-eval/tools/run_agentic_issue_analysis_smoke.py && sed -n '700,1160p' competitive-eval/tools/run_agentic_issue_analysis_smoke.py && sed -n '1160,1540p' competitive-eval/tools/run_agentic_issue_analysis_smoke.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 100000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:30:59.891Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7611-1933-72f3-bd29-59bf5fcb901e","call_id":"call_fnGWTeHpwAcAQGVLOBLfla4C","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 17947)\nTotal output lines: 1530\n\n    1524 competitive-eval/tools/run_agentic_issue_analysis_smoke.py\n     583 competitive-eval/tools/test_run_agentic_issue_analysis_smoke.py\n    2107 total\n#!/usr/bin/env python3\n\"\"\"Freeze and preflight the unpaid agentic issue-analysis smoke protocol.\n\nThis module deliberately does not implement a paid/model execution engine.  A\nfuture execution adapter may only be called through :func:`run_authorized`,\nafter an exact, separately hashed authorization passes every live binding.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom collections import Counter\nfrom decimal import Decimal, InvalidOperation\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nimport run_agentic_tasks_smoke as smoke\n\n\nartifacts = smoke.artifacts\nruntime = smoke.runtime\ncanonical_write = smoke.canonical_write\n\nSUITE = \"entire_graph_agentic_issue_analysis_smoke_v1\"\nFREEZE_STAGE = \"frozen_unpaid_agentic_issue_analysis_execution\"\nAUTHORIZATION_STAGE = \"exact_hash_agentic_issue_analysis_execution_authorization\"\nPREFLIGHT_STAGE = \"unpaid_agentic_issue_analysis_preflight\"\nCOHORT_STAGE = \"frozen_unpaid_agentic_issue_analysis_repository_cohort\"\nPUBLIC_TASK_STAGE = \"frozen_public_issue_analysis_tasks\"\nSEALED_ORACLE_STAGE = \"sealed_controller_issue_localization_judgments\"\nMATERIALIZATION_ATTESTATION_STAGE = \"issue_analysis_materialization_attestation\"\nSYSTEMS = (\"file-tools\", \"entire-graph\", \"cbm\")\nROTATIONS = (\n    SYSTEMS,\n    (\"entire-graph\", \"cbm\", \"file-tools\"),\n    (\"cbm\", \"file-tools\", \"entire-graph\"),\n)\nDEFAULT_REPETITION_COUNT = 1\nMIN_CONFIRMATORY_REPETITIONS = 3\n\nAUTHORITY_FALSE_FIELDS = (\n    \"repair_execution_authorized\",\n    \"confirmatory_execution_authorized\",\n    \"confirmatory_use_allowed\",\n    \"confirmatory_publication_authorized\",\n    \"rank_production_authorized\",\n    \"score_production_authorized\",\n    \"outcome_publication_authorized\",\n)\n\nCOHORT_FALSE_FIELDS = (\n    \"catalog_construction_authorized\",\n    \"issue_query_construction_authorized\",\n    \"controller_scoring_authorized\",\n    \"repair_execution_authorized\",\n    \"model_execution_authorized\",\n    \"paid_execution_authorized\",\n    \"confirmatory_execution_authorized\",\n    \"confirmatory_use_allowed\",\n    \"confirmatory_publication_authorized\",\n    \"rank_production_authorized\",\n    \"score_production_authorized\",\n    \"outcome_publication_authorized\",\n    \"queries_present\",\n    \"qrels_present\",\n    \"expected_outcomes_present\",\n    \"repair_oracles_present\",\n    \"ranks_present\",\n    \"scores_present\",\n    \"outcomes_present\",\n)\n\nPUBLIC_TASK_FALSE_FIELDS = (\n    \"qrels_present\",\n    \"expected_outcomes_present\",\n    \"patches_present\",\n    \"repair_oracles_present\",\n    \"ranks_present\",\n    \"scores_present\",\n    \"outcomes_present\",\n)\n\nPRICE_FIELDS = (\n    \"input_tokens_usd_per_million\",\n    \"output_tokens_usd_per_million\",\n    \"cache_creation_input_tokens_usd_per_million\",\n    \"cache_read_input_tokens_usd_per_million\",\n)\n\nTIMING_POLICY = {\n    \"setup_excluded_from_task_timing\": True,\n    \"all_product_setup_completed_before_paid_process\": True,\n    \"task_timer_starts_after_checkout_and_index_validation\": True,\n    \"task_timer_stops_after_model_process_completion\": True,\n    \"setup_wall_time_reported_separately\": True,\n    \"paired_attempts_execute_without_concurrent_setup\": True,\n}\n\nGRAPH_PHASE_TELEMETRY_FIELD_DEFINITIONS = {\n    \"search\": {\n        \"index_cache_hit\": {\n            \"json_path\": \"stats.index_cache_hit\",\n            \"type\": \"boolean\",\n            \"definition\": \"whether the exact committed-tree provider index was reused\",\n        },\n        \"preselect_latency_ms\": {\n            \"json_path\": \"stats.preselect_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"repository file discovery and query-dependent preselection\",\n        },\n        \"index_latency_ms\": {\n            \"json_path\": \"stats.index_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"load or construction of the selected provider index\",\n        },\n        \"query_latency_ms\": {\n            \"json_path\": \"stats.query_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"retrieval and ranking after the provider index is available\",\n        },\n        \"total_latency_ms\": {\n            \"json_path\": \"stats.total_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"end-to-end Graph retrieval latency including preselection, index, and query phases\",\n        },\n    },\n    \"neighbors\": {\n        \"index_cache_hit\": {\n            \"json_path\": \"index_cache_hit\",\n            \"type\": \"boolean\",\n            \"definition\": \"whether the exact committed-tree provider snapshot was reused\",\n        },\n        \"index_latency_ms\": {\n            \"json_path\": \"index_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"load or construction of the provider snapshot\",\n        },\n        \"query_latency_ms\": {\n            \"json_path\": \"query_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"focus matching, adjacency selection, ordering, and bounded path construction\",\n        },\n        \"total_latency_ms\": {\n            \"json_path\": \"total_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"end-to-end Graph retrieval latency including index and neighbor-query phases\",\n        },\n    },\n    \"measurement_rules\": {\n        \"phase_values_are_product_reported\": True,\n        \"setup_index_time_is_not_a_task_phase\": True,\n        \"controller_task_wall_time_is_reported_separately\": True,\n        \"cache_hit_is_required_for_timed_graph_retrieval\": True,\n    },\n}\n\nALLOWED_TOOL_POLICY = {\n    \"common_tools\": [\"Read\", \"Grep\", \"Glob\", \"Bash\"],\n    \"file-tools\": {\n        \"additional_tools\": [],\n        \"product_discovery\": \"native file tools only\",\n    },\n    \"entire-graph\": {\n        \"additional_tools\": [\"Bash(entire-graph search:*)\", \"Bash(entire-graph neighbors:*)\"],\n        \"product_discovery\": \"Entire Graph search and neighbors are available; choose either only when useful\",\n    },\n    \"cbm\": {\n        \"additional_tools\": [\"mcp__codebase-memory-mcp\"],\n        \"product_discovery\": \"Codebase Memory retrieval is available; choose operations only when useful\",\n    },\n    \"forced_retrieval_sequence\": False,\n    \"ordinary_targeted_file_reads_allowed\": True,\n    \"repository_claude_md_allowed\": True,\n    \"user_home_memory_allowed\": False,\n    \"network_allowed\": False,\n    \"repository_writes_allowed\": False,\n}\n\n\nclass IssueAnalysisError(ValueError):\n    \"\"\"Raised when an unpaid freeze or execution binding fails closed.\"\"\"\n\n\ndef _document_sha256(value: Any) -> str:\n    return artifacts.sha256_bytes(artifacts.canonical_bytes(value))\n\n\ndef _write_once_or_match(path: Path, value: dict[str, Any], label: str) -> str:\n    if path.exists():\n        existing = artifacts.read_canonical_json(path, expected_type=dict).document\n        if existing != value:\n            raise IssueAnalysisError(f\"existing {label} differs from the exact frozen document\")\n        return artifacts.sha256_file(path)\n    return canonical_write(path, value)\n\n\ndef _file_binding(path: Path, label: str) -> dict[str, Any]:\n    try:\n        resolved = path.resolve(strict=True)\n        digest = artifacts.sha256_file(resolved)\n    except (OSError, ValueError) as error:\n        raise IssueAnalysisError(f\"{label} is not a stable readable regular file: {path}\") from error\n    return {\"path\": str(resolved), \"sha256\": digest, \"bytes\": resolved.stat().st_size}\n\n\ndef _binary_binding(path: Path, label: str) -> dict[str, Any]:\n    binding = _file_binding(path, label)\n    if not os.access(binding[\"path\"], os.X_OK):\n        raise IssueAnalysisError(f\"{label} is not executable: {binding['path']}\")\n    return binding\n\n\ndef _product_source_binding(path: Path) -> dict[str, Any]:\n    try:\n        source = path.resolve(strict=True)\n    except OSError as error:\n        raise IssueAnalysisError(f\"product source is unavailable: {path}\") from error\n    head = runtime.checked_git([\"rev-parse\", \"HEAD\"], cwd=source).decode().strip()\n    tree = runtime.checked_git([\"rev-parse\", \"HEAD^{tree}\"], cwd=source).decode().strip()\n    status = runtime.checked_git(\n        [\"status\", \"--porcelain=v1\", \"--untracked-files=all\"], cwd=source,\n    )\n    if re.fullmatch(r\"[0-9a-f]{40}\", head) is None or re.fullmatch(r\"[0-9a-f]{40}\", tree) is None:\n        raise IssueAnalysisError(\"product source did not resolve to exact Git head and tree objects\")\n    if status.strip():\n        raise IssueAnalysisError(\"product source must be pristine before its head/tree are frozen\")\n    return {\"path\": str(source), \"head\": head, \"tree\": tree, \"pristine\": True}\n\n\ndef _repository_identity(row: dict[str, Any]) -> str:\n    for field in (\"normalized_repo\", \"repo\", \"repository\"):\n        value = row.get(field)\n        if isinstance(value, str) and value.strip():\n            return value.strip().casefold()\n    raise IssueAnalysisError(\"public manifest repository row lacks a public repository identity\")\n\n\ndef _require_no_authority(document: dict[str, Any], label: str) -> None:\n    for key, value in document.items():\n        if (\n            key.endswith(\"_authorized\")\n            or key in {\"confirmatory_use_allowed\"}\n        ) and value is not False:\n            raise IssueAnalysisError(f\"{label} grants forbidden authority through {key}\")\n\n\ndef _cohort_binding(path: Path) -> dict[str, Any]:\n    artifact = artifacts.read_canonical_json(path, expected_type=dict)\n    manifest = artifact.document\n    if (\n        manifest.get(\"suite\") != SUITE\n        or manifest.get(\"stage\") != COHORT_STAGE\n        or manifest.get(\"development_only\") is not True\n        or manifest.get(\"repository_count\") != 3\n        or type(manifest.get(\"repositories\")) is not list\n        or len(manifest[\"repositories\"]) != 3\n    ):\n        raise IssueAnalysisError(\"cohort is not the frozen three-repository HMAC-disjoint selection\")\n    for field in COHORT_FALSE_FIELDS:\n        if manifest.get(field) is not False:\n            raise IssueAnalysisError(f\"cohort must keep {field}=false\")\n    _require_no_authority(manifest, \"cohort\")\n    repositories = []\n    for row in manifest[\"repositories\"]:\n        if type(row) is not dict or set(row) != {\n            \"repo\", \"normalized_repo\", \"language\", \"selection_rank\",\n        }:\n            raise IssueAnalysisError(\"cohort repository projection changed\")\n            raise IssueAnalysisError(\"cohort repository projection changed\")\n        repositories.append(_repository_identity(row))\n    if len(set(repositories)) != 3:\n        raise IssueAnalysisError(\"cohort repositories must be three distinct identities\")\n    return {\n        \"path\": str(path.resolve(strict=True)),\n        \"sha256\": artifact.sha256,\n        \"bytes\": artifact.byte_count,\n        \"repository_ids\": repositories,\n    }\n\n\ndef _case_rows(document: dict[str, Any], label: str) -> list[dict[str, Any]]:\n    value = document.get(\"cases\")\n    if type(value) is list:\n        rows = value\n    elif type(value) is dict:\n        rows = []\n        for case_id, row in value.items():\n            if type(row) is not dict:\n                raise IssueAnalysisError(f\"{label} case mapping is malformed\")\n            nested = dict(row)\n            nested.setdefault(\"id\", case_id)\n            rows.append(nested)\n    else:\n        raise IssueAnalysisError(f\"{label} has no case collection\")\n    if len(rows) != 3 or any(type(row) is not dict for row in rows):\n        raise IssueAnalysisError(f\"{label} must contain exactly three case objects\")\n    return sorted(rows, key=lambda row: str(row.get(\"id\") or \"\"))\n\n\ndef _public_task_binding(path: Path) -> tuple[dict[str, Any], dict[str, Any]]:\n    artifact = artifacts.read_canonical_json(path, expected_type=dict)\n    manifest = artifact.document\n    if (\n        manifest.get(\"schema_version\") != 1\n        or manifest.get(\"suite\") != SUITE\n        or manifest.get(\"stage\") != PUBLIC_TASK_STAGE\n        or manifest.get(\"development_only\") is not True\n        or manifest.get(\"agent_visible\") is not True\n        or manifest.get(\"sealed\") is not False\n        or manifest.get(\"repository_count\") != 3\n        or manifest.get(\"case_count\") != 3\n        or manifest.get(\"queries_present\") is not True\n    ):\n        raise IssueAnalysisError(\"public task manifest identity or query boundary is malformed\")\n    for field in PUBLIC_TASK_FALSE_FIELDS:\n        if manifest.get(field) is not False:\n            raise IssueAnalysisError(f\"public task manifest must keep {field}=false\")\n    _require_no_authority(manifest, \"public task manifest\")\n    rows = _case_rows(manifest, \"public task manifest\")\n    case_ids: list[str] = []\n    repository_ids: list[str] = []\n    cases: list[dict[str, Any]] = []\n    for row in rows:\n        case_id = row.get(\"id\")\n        task = row.get(\"task\")\n        if (\n            not isinstance(case_id, str) or not case_id\n            or type(task) is not dict\n            or task.get(\"kind\") != \"read_only_issue_analysis\"\n            or not isinstance(task.get(\"prompt\"), str) or not task[\"prompt\"].strip()\n            or not isinstance(row.get(\"checkout_relative_path\"), str)\n            or re.fullmatch(r\"[0-9a-f]{40}\", str(row.get(\"base_commit\") or \"\")) is None\n            or re.fullmatch(r\"[0-9a-f]{40}\", str(row.get(\"base_tree\") or \"\")) is None\n        ):\n            raise IssueAnalysisError(\"public task case lacks its read-only prompt or checkout binding\")\n        repository_id = _repository_identity(row)\n        case_ids.append(case_id)\n        repository_ids.append(repository_id)\n        cases.append({\n            \"id\": case_id,\n            \"repository_id\": repository_id,\n            \"repo\": row.get(\"repo\"),\n            \"normalized_repo\": row.get(\"normalized_repo\"),\n            \"language\": row.get(\"language\"),\n            \"base_commit\": row[\"base_commit\"],\n            \"base_tree\": row[\"base_tree\"],\n            \"checkout_relative_path\": row[\"checkout_relative_path\"],\n            \"source_record_sha256\": row.get(\"source_record_sha256\"),\n            \"query_record_sha256\": row.get(\"query_record_sha256\"),\n            \"prompt\": task[\"prompt\"],\n        })\n    if len(set(case_ids)) != 3 or len(set(repository_ids)) != 3:\n        raise IssueAnalysisError(\"public task case/repository identities must be distinct\")\n    binding = {\n        \"path\": str(path.resolve(strict=True)),\n        \"sha256\": artifact.sha256,\n        \"bytes\": artifact.byte_count,\n        \"repository_ids\": repository_ids,\n        \"case_ids\": case_ids,\n    }\n    return binding, {\"document\": manifest, \"cases\": cases}\n\n\ndef _checkout_binding_projection(cases: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    return sorted(\n        [\n            {\n                \"id\": row[\"id\"],\n                \"repo\": row[\"repo\"],\n                \"normalized_repo\": row[\"normalized_repo\"],\n                \"base_commit\": row[\"base_commit\"],\n                \"base_tree\": row[\"base_tree\"],\n                \"checkout_relative_path\": row[\"checkout_relative_path\"],\n                \"source_record_sha256\": row[\"source_record_sha256\"],\n                \"query_record_sha256\": row[\"query_record_sha256\"],\n            }\n            for row in cases\n        ],\n        key=lambda row: row[\"id\"],\n    )\n\n\ndef _resolve_attested_path(value: Any, attestation_path: Path, label: str) -> Path:\n    if not isinstance(value, str) or not value:\n        raise IssueAnalysisError(f\"materialization attestation lacks {label} path\")\n    path = Path(value)\n    if not path.is_absolute():\n        path = attestation_path.parent / path\n    try:\n        return path.resolve(strict=True)\n    except OSError as error:\n        raise IssueAnalysisError(f\"attested {label} path is unavailable\") from error\n\n\ndef _materialized_input_bindings(\n    *, cohort_path: Path, public_path: Path, sealed_path: Path,\n    attestation_path: Path,\n) -> tuple[dict[str, Any], dict[str, Any]]:\n    cohort = _cohort_binding(cohort_path)\n    public, public_loaded = _public_task_binding(public_path)\n    sealed_artifact = artifacts.read_canonical_json(sealed_path, expected_type=dict)\n    sealed = sealed_artifact.document\n    if (\n        sealed.get(\"schema_version\") != 1\n        or sealed.get(\"suite\") != SUITE\n        or sealed.get(\"stage\") != SEALED_ORACLE_STAGE\n        or sealed.get(\"development_only\") is not True\n        or sealed.get(\"agent_visible\") is not False\n        or sealed.get(\"sealed\") is not True\n        or sealed.get(\"repository_count\") != 3\n        or sealed.get(\"case_count\") != 3\n        or sealed.get(\"qrels_present\") is not True\n    ):\n        raise IssueAnalysisError(\"sealed controller oracle identity is malformed\")\n    _require_no_authority(sealed, \"sealed controller oracle\")\n    sealed_rows = _case_rows(sealed, \"sealed controller oracle\")\n    public_by_id = {row[\"id\"]: row for row in public_loaded[\"cases\"]}\n    if {str(row.get(\"id\") or \"\") for row in sealed_rows} != set(public_by_id):\n        raise IssueAnalysisError(\"public and sealed case IDs differ\")\n    sealed_repository_ids = []\n    for row in sealed_rows:\n        case_id = row[\"id\"]\n        public_row = public_by_id[case_id]\n        repository_id = _repository_identity(row)\n        sealed_repository_ids.append(repository_id)\n        for field in (\n            \"repo\", \"normalized_repo\", \"base_commit\", \"base_tree\",\n            \"checkout_relative_path\", \"source_record_sha256\", \"query_record_sha256\",\n        ):\n            if row.get(field) != public_row.get(field):\n                raise IssueAnalysisError(f\"public/sealed case binding differs for {case_id}: {field}\")\n    if set(sealed_repository_ids) != set(public[\"repository_ids\"]):\n        raise IssueAnalysisError(\"public and sealed repository IDs differ\")\n    if set(public[\"repository_ids\"]) != set(cohort[\"repository_ids\"]):\n        raise IssueAnalysisError(\"materialized public repositories differ from the HMAC-disjoint cohort\")\n\n    attestation_artifact = artifacts.read_canonical_json(\n        attestation_path, expected_type=dict,\n    )\n    attestation = attestation_artifact.document\n    if (\n        attestation.get(\"schema_version\") != 1\n        or attestation.get(\"suite\") != SUITE\n        or attestation.get(\"stage\") != MATERIALIZATION_ATTESTATION_STAGE\n        or attestation.get(\"development_only\") is not True\n    ):\n        raise IssueAnalysisError(\"materialization attestation identity is malformed\")\n    _require_no_authority(attestation, \"materialization attestation\")\n    if attestation.get(\"cohort_sha256\") != cohort[\"sha256\"]:\n        raise IssueAnalysisError(\"materialization attestation does not bind the exact HMAC cohort\")\n    if attestation.get(\"public_tasks_sha256\") != public[\"sha256\"]:\n        raise IssueAnalysisError(\"materialization attestation public task hash mismatch\")\n    if attestation.get(\"sealed_controller_sha256\") != sealed_artifact.sha256:\n        raise IssueAnalysisError(\"materialization attestation sealed controller hash mismatch\")\n    public_document = public_loaded[\"document\"]\n    if (\n        public_document.get(\"cohort_sha256\") != cohort[\"sha256\"]\n        or sealed.get(\"cohort_sha256\") != cohort[\"sha256\"]\n    ):\n        raise IssueAnalysisError(\"public or sealed materialization lost its cohort binding\")\n    source = public_document.get(\"source\")\n    attested_source = attestation.get(\"source\")\n    if (\n        type(source) is not dict\n        or sealed.get(\"source\") != source\n        or type(attested_source) is not dict\n        or {key: attested_source.get(key) for key in source} != source\n        or set(attested_source) != {*source, \"source_row_count\"}\n        or type(attested_source.get(\"source_row_count\")) is not int\n        or attested_source[\"source_row_count\"] < 3\n    ):\n        raise IssueAnalysisError(\"public, sea…7947 tokens truncated…t path.is_file():\n        return None\n    record = artifacts.read_canonical_json(path, expected_type=dict).document\n    if (\n        record.get(\"schema_version\") != 1\n        or record.get(\"suite\") != SUITE\n        or record.get(\"stage\") != \"unpaid_product_setup\"\n        or record.get(\"execution_freeze_sha256\") != freeze_sha256\n        or record.get(\"case_id\") != checkout[\"id\"]\n        or record.get(\"repository_id\") != attempt[\"repository_id\"]\n        or record.get(\"system\") != attempt[\"system\"]\n        or record.get(\"commit\") != checkout[\"commit\"]\n        or record.get(\"tree\") != checkout[\"tree\"]\n        or record.get(\"setup_excluded_from_task_timing\") is not True\n    ):\n        raise IssueAnalysisError(\"existing unpaid setup record differs from its frozen attempt\")\n    validation = record.get(\"validation\")\n    if type(validation) is not dict or validation.get(\"status\") not in {\"not_required\", \"indexed\"}:\n        raise IssueAnalysisError(\"existing unpaid setup validation is malformed\")\n    if attempt[\"system\"] == \"entire-graph\" and smoke.cache_inventory(\n        Path(attempt[\"graph_cache\"])\n    ) != validation.get(\"cache_inventory\"):\n        raise IssueAnalysisError(\"existing Entire Graph cache differs from setup evidence\")\n    if attempt[\"system\"] == \"cbm\" and smoke.cache_inventory(\n        Path(attempt[\"cbm_cache\"])\n    ) != validation.get(\"cache_inventory\"):\n        raise IssueAnalysisError(\"existing CBM cache differs from setup evidence\")\n    return record\n\n\ndef _setup_attempt(\n    freeze: dict[str, Any], attempt: dict[str, Any], checkout_binding: dict[str, Any],\n    *, freeze_sha256: str,\n) -> dict[str, Any]:\n    checkout = _assert_checkout_binding(checkout_binding)\n    attempt_root = Path(attempt[\"home\"]).parent\n    setup_path = attempt_root / \"setup.json\"\n    existing = _load_existing_setup(\n        setup_path, attempt=attempt, checkout=checkout_binding,\n        freeze_sha256=freeze_sha256,\n    )\n    if existing is not None:\n        return existing\n\n    graph_cache = Path(attempt[\"graph_cache\"])\n    cbm_cache = Path(attempt[\"cbm_cache\"])\n    if smoke.cache_inventory(graph_cache) or smoke.cache_inventory(cbm_cache):\n        raise IssueAnalysisError(\"uncommitted product cache state exists before setup\")\n    environment = runtime.runtime_environment(freeze[\"protocol\"][\"runtime_path_prefix\"])\n    environment.update({\n        \"HOME\": attempt[\"home\"],\n        \"HOME\": attempt[\"home\"],\n        \"TMPDIR\": attempt[\"temp\"],\n        \"GIT_CONFIG_GLOBAL\": \"/dev/null\",\n        \"GIT_CONFIG_NOSYSTEM\": \"1\",\n        \"CBM_CACHE_DIR\": attempt[\"cbm_cache\"],\n        \"ENTIRE_GRAPH_CACHE_DIR\": attempt[\"graph_cache\"],\n    })\n    timeout = freeze[\"protocol\"][\"timeout_seconds_per_attempt\"]\n    system = attempt[\"system\"]\n    commands: list[list[str]] = []\n    stdout = b\"\"\n    stderr = b\"\"\n    started = time.monotonic()\n    if system == \"file-tools\":\n        validation: dict[str, Any] = {\"status\": \"not_required\"}\n    elif system == \"entire-graph\":\n        graph = Path(freeze[\"binaries\"][\"entire_graph\"][\"path\"])\n        command = [\n            str(graph), \"index\", \"--repo\", str(checkout), \"--head\",\n            \"--profile\", \"full\", \"--cache-dir\", str(graph_cache), \"--format\", \"json\",\n        ]\n        commands = [command, command]\n        first_process = runtime.run_command(\n            command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        second_process = runtime.run_command(\n            command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        stdout = first_process.stdout + second_process.stdout\n        stderr = first_process.stderr + second_process.stderr\n        first = _parse_setup_response(first_process, \"Entire Graph fresh preindex\")\n        second = _parse_setup_response(second_process, \"Entire Graph cache validation\")\n        for response in (first, second):\n            counts = response.get(\"counts\")\n            if (\n                response.get(\"format_version\") != 1\n                or response.get(\"provider\") != \"entire-graph\"\n                or not isinstance(response.get(\"provider_version\"), str)\n                or not response[\"provider_version\"]\n                or response.get(\"commit\") != checkout_binding[\"commit\"]\n                or response.get(\"tree\") != checkout_binding[\"tree\"]\n                or response.get(\"profile\") != \"full\"\n                or Path(str(response.get(\"repo_root\") or \"\")).resolve() != checkout\n                or type(counts) is not dict\n                or int(counts.get(\"files\") or 0) <= 0\n                or int(counts.get(\"parsed_files\") or 0) <= 0\n                or int(counts.get(\"symbols\") or 0) <= 0\n                or int(counts.get(\"partial_failures\") or 0) != 0\n                or counts.get(\"completeness_level\") != \"ok\"\n                or response.get(\"warnings\") != []\n                or response.get(\"partial_failures\") != []\n            ):\n                raise IssueAnalysisError(\"Entire Graph setup is partial or not bound to the checkout\")\n        if first.get(\"index_cache_hit\") is not False or second.get(\"index_cache_hit\") is not True:\n            raise IssueAnalysisError(\"Entire Graph setup did not prove fresh-miss then exact cache-hit\")\n        if first.get(\"counts\") != second.get(\"counts\") or first.get(\n            \"provider_version\"\n        ) != second.get(\"provider_version\"):\n            raise IssueAnalysisError(\"Entire Graph setup changed across cache validation\")\n        inventory = smoke.cache_inventory(graph_cache)\n        if not inventory:\n            raise IssueAnalysisError(\"Entire Graph setup produced no persistent cache\")\n        validation = {\n            \"status\": \"indexed\",\n            \"fresh_cache_hit\": False,\n            \"timed_retrieval_cache_hit_required\": True,\n            \"validation_cache_hit\": True,\n            \"provider\": first[\"provider\"],\n            \"provider_version\": first[\"provider_version\"],\n            \"counts\": first[\"counts\"],\n            \"cache_inventory\": inventory,\n        }\n    elif system == \"cbm\":\n        cbm = Path(freeze[\"binaries\"][\"cbm\"][\"path\"])\n        payload = json.dumps({\"repo_path\": str(checkout)}, separators=(\",\", \":\"), sort_keys=True)\n        index_command = [str(cbm), \"cli\", \"index_repository\", payload]\n        indexed_process = runtime.run_command(\n            index_command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        indexed = _parse_setup_response(indexed_process, \"CBM preindex\")\n        project = indexed.get(\"project\")\n        if (\n            indexed.get(\"status\") != \"indexed\"\n            or not isinstance(project, str) or not project\n            or int(indexed.get(\"nodes\") or 0) <= 0\n            or indexed.get(\"error\")\n        ):\n            raise IssueAnalysisError(\"CBM preindex is not healthy\")\n        status_payload = json.dumps({\"project\": project}, separators=(\",\", \":\"), sort_keys=True)\n        status_command = [str(cbm), \"cli\", \"index_status\", status_payload]\n        status_process = runtime.run_command(\n            status_command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        status = _parse_setup_response(status_process, \"CBM index validation\")\n        commands = [index_command, status_command]\n        stdout = indexed_process.stdout + status_process.stdout\n        stderr = indexed_process.stderr + status_process.stderr\n        if (\n            status.get(\"status\") != \"indexed\"\n            or status.get(\"project\") != project\n            or int(status.get(\"nodes\") or 0) <= 0\n            or status.get(\"error\")\n        ):\n            raise IssueAnalysisError(\"CBM validation is not ready\")\n        inventory = smoke.cache_inventory(cbm_cache)\n        if not inventory:\n            raise IssueAnalysisError(\"CBM setup produced no persistent cache\")\n        validation = {\n            \"status\": \"indexed\",\n            \"project\": project,\n            \"nodes\": status[\"nodes\"],\n            \"cache_inventory\": inventory,\n        }\n    else:\n        raise IssueAnalysisError(f\"unknown setup system: {system}\")\n    setup_wall_time_ms = max(1, round((time.monotonic() - started) * 1000))\n    _assert_checkout_binding(checkout_binding)\n    record = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": \"unpaid_product_setup\",\n        \"execution_freeze_sha256\": freeze_sha256,\n        \"case_id\": checkout_binding[\"id\"],\n        \"repository_id\": attempt[\"repository_id\"],\n        \"system\": system,\n        \"repetition_index\": attempt[\"repetition_index\"],\n        \"commit\": checkout_binding[\"commit\"],\n        \"tree\": checkout_binding[\"tree\"],\n        \"setup_wall_time_ms\": setup_wall_time_ms,\n        \"setup_excluded_from_task_timing\": True,\n        \"commands_sha256\": _document_sha256(commands),\n        \"stdout_sha256\": artifacts.sha256_bytes(stdout),\n        \"stderr_sha256\": artifacts.sha256_bytes(stderr),\n        \"environment_binding\": {\n            \"home\": attempt[\"home\"],\n            \"temp\": attempt[\"temp\"],\n            \"graph_cache\": attempt[\"graph_cache\"],\n            \"cbm_cache\": attempt[\"cbm_cache\"],\n        },\n        \"validation\": validation,\n    }\n    _write_once_or_match(setup_path, record, \"unpaid setup record\")\n    return record\n\n\ndef setup_all_products(freeze: dict[str, Any], freeze_sha256: str) -> list[dict[str, Any]]:\n    \"\"\"Sequentially prepare every treatment cache without launching the agent runtime.\"\"\"\n    checkouts = {row[\"repository_id\"]: row for row in freeze[\"checkouts\"]}\n    records = []\n    for attempt in freeze[\"cache_policy\"][\"attempts\"]:\n        checkout = checkouts.get(attempt[\"repository_id\"])\n        if checkout is None:\n            raise IssueAnalysisError(\"cache attempt has no frozen checkout\")\n        records.append(\n            _setup_attempt(freeze, attempt, checkout, freeze_sha256=freeze_sha256)\n        )\n    return records\n\n\ndef preflight(\n    freeze_path: Path, authorization_path: Path, *,\n    expected_authorization_sha256: str | None = None,\n    output: Path | None = None,\n) -> dict[str, Any]:\n    \"\"\"Validate bindings and sequentially prepare products; never launch a model.\"\"\"\n    freeze = validate_execution_freeze(freeze_path)\n    authorization = validate_execution_authorization(\n        freeze_path, authorization_path,\n        expected_authorization_sha256=expected_authorization_sha256,\n    )\n    _materialize_isolated_cache_paths(freeze[\"cache_policy\"])\n    freeze_sha256 = artifacts.sha256_file(freeze_path)\n    setup_records = setup_all_products(freeze, freeze_sha256)\n    if len(setup_records) != len(freeze[\"cache_policy\"][\"attempts\"]):\n        raise IssueAnalysisError(\"unpaid setup did not cover every frozen attempt\")\n    setup_counts = Counter(record[\"system\"] for record in setup_records)\n    if setup_counts != Counter({system: freeze[\"schedule\"][\"pair_count\"] for system in SYSTEMS}):\n        raise IssueAnalysisError(\"unpaid setup coverage differs from the balanced schedule\")\n    setup_wall_time_ms = sum(record[\"setup_wall_time_ms\"] for record in setup_records)\n    report = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": PREFLIGHT_STAGE,\n        \"development_only\": True,\n        \"execution_freeze_sha256\": freeze_sha256,\n        \"execution_authorization_sha256\": artifacts.sha256_file(authorization_path),\n        \"paid_execution_authorized\": authorization[\"paid_execution_authorized\"],\n        \"paid_processes_launched\": 0,\n        \"model_processes_launched\": 0,\n        \"product_setup_executed\": True,\n        \"product_setup_required_before_any_paid_attempt\": True,\n        \"product_setup_count\": len(setup_records),\n        \"product_setup_counts_by_system\": dict(sorted(setup_counts.items())),\n        \"setup_wall_time_ms\": setup_wall_time_ms,\n        \"setup_excluded_from_task_timing\": True,\n        \"isolated_attempt_namespaces\": len(freeze[\"cache_policy\"][\"attempts\"]),\n        \"planned_pair_count\": freeze[\"schedule\"][\"pair_count\"],\n        \"planned_attempt_count\": freeze[\"schedule\"][\"paid_attempt_count_if_separately_authorized\"],\n        \"run_gate_status\": (\n            \"authorization_true_but_paid_adapter_absent\"\n            if authorization[\"paid_execution_authorized\"]\n            else \"blocked_by_false_authorization\"\n        ),\n    }\n    if output is not None:\n        _write_once_or_match(output, report, \"preflight report\")\n    return report\n\n\nPaidExecutor = Callable[[dict[str, Any]], Any]\n\n\ndef run_authorized(\n    freeze_path: Path, authorization_path: Path, *,\n    expected_authorization_sha256: str, paid_executor: PaidExecutor | None = None,\n) -> Any:\n    \"\"\"Fail closed before a paid adapter unless the exact authorization is true.\"\"\"\n    if not expected_authorization_sha256:\n        raise IssueAnalysisError(\"run requires the separately supplied exact authorization SHA-256\")\n    authorization = validate_execution_authorization(\n        freeze_path, authorization_path,\n        expected_authorization_sha256=expected_authorization_sha256,\n    )\n    if authorization[\"paid_execution_authorized\"] is not True:\n        raise IssueAnalysisError(\"paid execution is not authorized by the exact authorization artifact\")\n    freeze = validate_execution_freeze(freeze_path)\n    if paid_executor is None:\n        raise IssueAnalysisError(\"paid execution adapter is intentionally absent from this unpaid runner surface\")\n    ticket = {\n        \"suite\": SUITE,\n        \"execution_freeze_sha256\": artifacts.sha256_file(freeze_path),\n        \"execution_authorization_sha256\": expected_authorization_sha256,\n        \"bindings\": _authorization_bindings(freeze, artifacts.sha256_file(freeze_path)),\n        \"schedule\": freeze[\"schedule\"],\n        \"cache_policy\": freeze[\"cache_policy\"],\n        \"timing_policy\": freeze[\"timing_policy\"],\n    }\n    return paid_executor(ticket)\n\n\ndef _prices_from_args(args: argparse.Namespace) -> dict[str, str]:\n    return {\n        \"input_tokens_usd_per_million\": args.input_price,\n        \"output_tokens_usd_per_million\": args.output_price,\n        \"cache_creation_input_tokens_usd_per_million\": args.cache_creation_price,\n        \"cache_read_input_tokens_usd_per_million\": args.cache_read_price,\n    }\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=__doc__)\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    freeze = subparsers.add_parser(\"freeze\", help=\"write the unpaid execution freeze and false authorization\")\n    freeze.add_argument(\"--public-manifest\", type=Path, required=True)\n    freeze.add_argument(\"--sealed-oracle\", type=Path, required=True)\n    freeze.add_argument(\"--hmac-disjointness-attestation\", type=Path, required=True)\n    freeze.add_argument(\"--materialization-attestation\", type=Path, required=True)\n    freeze.add_argument(\"--materialized-root\", type=Path, required=True)\n    freeze.add_argument(\"--product-source\", type=Path, required=True)\n    freeze.add_argument(\"--graph-binary\", type=Path, required=True)\n    freeze.add_argument(\"--cbm-binary\", type=Path, required=True)\n    freeze.add_argument(\"--agent-binary\", type=Path, required=True)\n    freeze.add_argument(\"--cache-root\", type=Path, required=True)\n    freeze.add_argument(\"--output\", type=Path, required=True)\n    freeze.add_argument(\"--authorization-output\", type=Path)\n    freeze.add_argument(\"--model\", required=True)\n    freeze.add_argument(\"--max-turns\", type=int, required=True)\n    freeze.add_argument(\"--timeout-seconds\", type=int, required=True)\n    freeze.add_argument(\"--repetition-count\", type=int, default=DEFAULT_REPETITION_COUNT)\n    freeze.add_argument(\"--max-budget-usd-per-attempt\", required=True)\n    freeze.add_argument(\"--max-total-budget-usd\", required=True)\n    freeze.add_argument(\"--input-price\", required=True)\n    freeze.add_argument(\"--output-price\", required=True)\n    freeze.add_argument(\"--cache-creation-price\", required=True)\n    freeze.add_argument(\"--cache-read-price\", required=True)\n    freeze.add_argument(\"--runtime-path-prefix\", default=\"\")\n\n    authorize = subparsers.add_parser(\"authorize\", help=\"write a separately reviewed exact-hash authorization\")\n    authorize.add_argument(\"--freeze\", type=Path, required=True)\n    authorize.add_argument(\"--output\", type=Path, required=True)\n    authorize.add_argument(\"--paid-execution-authorized\", action=\"store_true\")\n    authorize.add_argument(\"--authorization-note\", required=True)\n\n    validate = subparsers.add_parser(\"validate\", help=\"recompute all unpaid freeze bindings\")\n    validate.add_argument(\"--freeze\", type=Path, required=True)\n\n    check = subparsers.add_parser(\"preflight\", help=\"validate exact bindings and isolated namespaces\")\n    check.add_argument(\"--freeze\", type=Path, required=True)\n    check.add_argument(\"--authorization\", type=Path, required=True)\n    check.add_argument(\"--authorization-sha256\")\n    check.add_argument(\"--output\", type=Path)\n\n    run = subparsers.add_parser(\"run\", help=\"authorization gate; paid adapter intentionally absent\")\n    run.add_argument(\"--freeze\", type=Path, required=True)\n    run.add_argument(\"--authorization\", type=Path, required=True)\n    run.add_argument(\"--authorization-sha256\", required=True)\n    return parser\n\n\ndef main(argv: list[str] | None = None) -> int:\n    args = build_parser().parse_args(argv)\n    try:\n        if args.command == \"freeze\":\n            freeze_execution(\n                public_manifest=args.public_manifest,\n                sealed_oracle=args.sealed_oracle,\n                hmac_disjointness_attestation=args.hmac_disjointness_attestation,\n                materialization_attestation=args.materialization_attestation,\n                materialized_root=args.materialized_root,\n                product_source=args.product_source,\n                graph_binary=args.graph_binary,\n                cbm_binary=args.cbm_binary,\n                agent_binary=args.agent_binary,\n                cache_root=args.cache_root,\n                output=args.output,\n                model=args.model,\n                max_turns=args.max_turns,\n                timeout_seconds=args.timeout_seconds,\n                prices=_prices_from_args(args),\n                max_budget_usd_per_attempt=args.max_budget_usd_per_attempt,\n                max_total_budget_usd=args.max_total_budget_usd,\n                repetition_count=args.repetition_count,\n                runtime_path_prefix=args.runtime_path_prefix,\n            )\n            authorization_output = args.authorization_output or args.output.with_name(\n                \"execution-authorization.json\"\n            )\n            create_execution_authorization(args.output, authorization_output)\n        elif args.command == \"authorize\":\n            create_execution_authorization(\n                args.freeze,\n                args.output,\n                paid_execution_authorized=args.paid_execution_authorized,\n                authorization_note=args.authorization_note,\n            )\n        elif args.command == \"validate\":\n            document = validate_execution_freeze(args.freeze)\n            print(json.dumps({\n                \"status\": \"valid\",\n                \"execution_freeze_sha256\": artifacts.sha256_file(args.freeze),\n                \"planned_attempt_count\": document[\"schedule\"][\"paid_attempt_count_if_separately_authorized\"],\n            }, sort_keys=True))\n        elif args.command == \"preflight\":\n            report = preflight(\n                args.freeze,\n                args.authorization,\n                expected_authorization_sha256=args.authorization_sha256,\n                output=args.output,\n            )\n            print(json.dumps(report, sort_keys=True))\n        elif args.command == \"run\":\n            run_authorized(\n                args.freeze,\n                args.authorization,\n                expected_authorization_sha256=args.authorization_sha256,\n            )\n        return 0\n    except (IssueAnalysisError, artifacts.ArtifactValidationError, smoke.SmokeError) as error:\n        print(f\"error: {error}\", file=sys.stderr)\n        return 2\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
