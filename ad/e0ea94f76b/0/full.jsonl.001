{"timestamp":"2026-07-18T16:03:10.112Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5ba3be14b48191aad3b8f29742b553","status":"completed","call_id":"call_GJlw006nR8sVctG0ivSMdcbo","name":"exec","input":"const rs = await Promise.all([\n  tools.exec_command({cmd:\"rg -n \\\"def (download|fetch|materialize|map_|load_).*|add_parser\\\\(|subparsers|command ==|args.command\\\" competitive-eval/tools/core_bench_graph_spike.py competitive-eval/tools/core_bench_graph_eval.py | head -260\",workdir:\"/private/tmp/brain-bench-graph-agentic-pilot\",yield_time_ms:1000,max_output_tokens:16000}),\n  tools.exec_command({cmd:\"sed -n '1,140p' competitive-eval/tools/core_bench_graph_spike.py && sed -n '140,300p' competitive-eval/tools/core_bench_graph_spike.py\",workdir:\"/private/tmp/brain-bench-graph-agentic-pilot\",yield_time_ms:1000,max_output_tokens:20000}),\n  tools.exec_command({cmd:\"sed -n '760,880p' competitive-eval/tools/core_bench_graph_eval.py && sed -n '1180,1300p' competitive-eval/tools/core_bench_graph_eval.py\",workdir:\"/private/tmp/brain-bench-graph-agentic-pilot\",yield_time_ms:1000,max_output_tokens:20000}),\n  tools.exec_command({cmd:\"find competitive-eval/core-bench -maxdepth 2 -type f -print | sort\",workdir:\"/private/tmp/brain-bench-graph-agentic-pilot\",yield_time_ms:1000,max_output_tokens:8000})\n]);\nfor (const r of rs) text(r);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:03:10.355Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f75f7-9f93-7c21-a2b6-ff1659d6e246","call_id":"call_GJlw006nR8sVctG0ivSMdcbo","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"e1048c\",\"wall_time_seconds\":9.58e-7,\"exit_code\":0,\"original_token_count\":835,\"output\":\"competitive-eval/tools/core_bench_graph_spike.py:81:def load_json(path: Path) -> Any:\\ncompetitive-eval/tools/core_bench_graph_spike.py:85:def load_jsonl_bytes(data: bytes) -> list[dict[str, Any]]:\\ncompetitive-eval/tools/core_bench_graph_spike.py:126:    def fetch_path(\\ncompetitive-eval/tools/core_bench_graph_spike.py:146:    def fetch_bytes(self, label: str, revision: str, path: str, url: str) -> tuple[bytes, Path]:\\ncompetitive-eval/tools/core_bench_graph_spike.py:700:def map_chunks_to_locations(repo: Path, chunks: Iterable[dict[str, Any]]) -> list[dict[str, Any]]:\\ncompetitive-eval/tools/core_bench_graph_spike.py:806:def materialize_role(args: argparse.Namespace, role: str) -> dict[str, Any]:\\ncompetitive-eval/tools/core_bench_graph_spike.py:922:def materialize_development(args: argparse.Namespace) -> dict[str, Any]:\\ncompetitive-eval/tools/core_bench_graph_spike.py:926:def materialize_sealed(args: argparse.Namespace) -> dict[str, Any]:\\ncompetitive-eval/tools/core_bench_graph_spike.py:932:    subparsers = parser.add_subparsers(dest=\\\"command\\\", required=True)\\ncompetitive-eval/tools/core_bench_graph_spike.py:934:    exclusions = subparsers.add_parser(\\\"freeze-exclusions\\\", help=\\\"freeze repository overlap exclusions\\\")\\ncompetitive-eval/tools/core_bench_graph_spike.py:939:    freeze = subparsers.add_parser(\\\"freeze-manifest\\\", help=\\\"freeze the deterministic spike sample\\\")\\ncompetitive-eval/tools/core_bench_graph_spike.py:945:    validate = subparsers.add_parser(\\\"validate-manifest\\\", help=\\\"validate frozen local artifacts\\\")\\ncompetitive-eval/tools/core_bench_graph_spike.py:950:    materialize = subparsers.add_parser(\\ncompetitive-eval/tools/core_bench_graph_spike.py:958:    sealed = subparsers.add_parser(\\ncompetitive-eval/tools/core_bench_graph_spike.py:972:        if args.command == \\\"freeze-exclusions\\\":\\ncompetitive-eval/tools/core_bench_graph_spike.py:975:        elif args.command == \\\"freeze-manifest\\\":\\ncompetitive-eval/tools/core_bench_graph_spike.py:983:        elif args.command == \\\"validate-manifest\\\":\\ncompetitive-eval/tools/core_bench_graph_spike.py:985:        elif args.command == \\\"materialize-development\\\":\\ncompetitive-eval/tools/core_bench_graph_eval.py:95:def load_json(path: Path) -> Any:\\ncompetitive-eval/tools/core_bench_graph_eval.py:261:def load_cached_mapping(\\ncompetitive-eval/tools/core_bench_graph_eval.py:290:def map_candidate_corpus(\\ncompetitive-eval/tools/core_bench_graph_eval.py:1523:    subparsers = parser.add_subparsers(dest=\\\"command\\\", required=True)\\ncompetitive-eval/tools/core_bench_graph_eval.py:1525:    run = subparsers.add_parser(\\\"run\\\", help=\\\"produce qrel-blind ranks\\\")\\ncompetitive-eval/tools/core_bench_graph_eval.py:1535:    freeze = subparsers.add_parser(\\\"freeze-protocol\\\", help=\\\"freeze adapters after development\\\")\\ncompetitive-eval/tools/core_bench_graph_eval.py:1540:    score = subparsers.add_parser(\\\"score\\\", help=\\\"score previously sealed ranks against qrels\\\")\\ncompetitive-eval/tools/core_bench_graph_eval.py:1549:    report = subparsers.add_parser(\\\"report\\\", help=\\\"render the combined feasibility report\\\")\\ncompetitive-eval/tools/core_bench_graph_eval.py:1560:        if args.command == \\\"run\\\":\\ncompetitive-eval/tools/core_bench_graph_eval.py:1565:        elif args.command == \\\"freeze-protocol\\\":\\ncompetitive-eval/tools/core_bench_graph_eval.py:1568:        elif args.command == \\\"score\\\":\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"7317ba\",\"wall_time_seconds\":0.000002833,\"exit_code\":0,\"original_token_count\":2764,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Freeze and validate the CORE-Bench Level-2 feasibility spike.\\n\\nThe freezer is intentionally separate from system adapters. It selects the\\nsample and hashes its ground truth before any Entire, CBM, file-search, BM25, or\\nLLM result exists.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport hashlib\\nimport json\\nimport os\\nimport re\\nimport shutil\\nimport subprocess\\nimport sys\\nimport urllib.request\\nfrom collections import defaultdict\\nfrom pathlib import Path\\nfrom typing import Any, Iterable\\n\\n\\nROOT = Path(__file__).resolve().parents[2]\\nSPIKE_DIR = ROOT / \\\"competitive-eval\\\" / \\\"core-bench-graph\\\"\\nDEFAULT_CACHE = SPIKE_DIR / \\\".cache\\\"\\nDEFAULT_EXCLUSIONS = SPIKE_DIR / \\\"overlap-exclusions.json\\\"\\nDEFAULT_CATALOG = SPIKE_DIR / \\\"candidate-catalog.json\\\"\\nDEFAULT_MANIFEST = SPIKE_DIR / \\\"spike-manifest.json\\\"\\nDEFAULT_MATERIALIZATION = SPIKE_DIR / \\\"development-materialization.json\\\"\\nDEFAULT_SEALED_MATERIALIZATION = SPIKE_DIR / \\\"sealed-materialization.json\\\"\\nDEFAULT_PROTOCOL = SPIKE_DIR / \\\"evaluation-protocol.json\\\"\\nDEFAULT_CHECKOUTS = SPIKE_DIR / \\\"checkouts\\\"\\n\\nCORE_DATASET = \\\"zhangfw123/CORE-Bench\\\"\\nCORE_REVISION = \\\"682c1e668692a1f28a3351511d88e71fce2809ef\\\"\\nSOURCE_DATASET = \\\"ByteDance-Seed/Multi-SWE-bench\\\"\\nSOURCE_REVISION = \\\"56ff018c04a38e27ada1e9d0a6d5839a51f88f0d\\\"\\nCORE_LEVEL = \\\"LEVEL-2\\\"\\nCORE_SUBDATASET = \\\"Multi-SWE-bench\\\"\\n\\nSELECTION_SEED = 20260711\\nREPOSITORY_COUNT = 8\\nQUERIES_PER_REPOSITORY = 3\\nDEVELOPMENT_REPOSITORIES = 2\\nMIN_QUERIES_PER_REPOSITORY = 3\\n\\nSOURCE_LANGUAGE = {\\n    \\\"c\\\": \\\"C\\\",\\n    \\\"cpp\\\": \\\"C++\\\",\\n    \\\"go\\\": \\\"Go\\\",\\n    \\\"java\\\": \\\"Java\\\",\\n    \\\"js\\\": \\\"JavaScript\\\",\\n    \\\"rust\\\": \\\"Rust\\\",\\n    \\\"ts\\\": \\\"TypeScript\\\",\\n}\\n\\n\\ndef canonical_json_bytes(value: Any) -> bytes:\\n    return (json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(\\\",\\\", \\\":\\\")) + \\\"\\\\n\\\").encode()\\n\\n\\ndef sha256_bytes(data: bytes) -> str:\\n    return hashlib.sha256(data).hexdigest()\\n\\n\\ndef sha256_file(path: Path) -> str:\\n    digest = hashlib.sha256()\\n    with path.open(\\\"rb\\\") as handle:\\n        for block in iter(lambda: handle.read(1024 * 1024), b\\\"\\\"):\\n            digest.update(block)\\n    return digest.hexdigest()\\n\\n\\ndef write_json(path: Path, value: Any) -> None:\\n    path.parent.mkdir(parents=True, exist_ok=True)\\n    path.write_bytes(json.dumps(value, indent=2, sort_keys=True).encode() + b\\\"\\\\n\\\")\\n\\n\\ndef load_json(path: Path) -> Any:\\n    return json.loads(path.read_text(encoding=\\\"utf-8\\\"))\\n\\n\\ndef load_jsonl_bytes(data: bytes) -> list[dict[str, Any]]:\\n    rows = []\\n    for line_number, line in enumerate(data.decode(\\\"utf-8\\\").splitlines(), 1):\\n        if not line.strip():\\n            continue\\n        row = json.loads(line)\\n        if not isinstance(row, dict):\\n            raise ValueError(f\\\"JSONL row {line_number} is not an object\\\")\\n        rows.append(row)\\n    return rows\\n\\n\\ndef normalize_repo(value: str) -> str:\\n    repo = value.strip().replace(\\\"\\\\\\\\\\\", \\\"/\\\")\\n    repo = re.sub(r\\\"^git@github\\\\.com:\\\", \\\"\\\", repo, flags=re.IGNORECASE)\\n    repo = re.sub(r\\\"^(?:https?://)?github\\\\.com/\\\", \\\"\\\", repo, flags=re.IGNORECASE)\\n    repo = repo.removesuffix(\\\".git\\\").strip(\\\"/\\\")\\n    if \\\"@\\\" in repo and repo.count(\\\"/\\\") == 1:\\n        repo = repo.split(\\\"@\\\", 1)[0]\\n    if repo.count(\\\"/\\\") != 1:\\n        raise ValueError(f\\\"not a GitHub owner/repository identifier: {value!r}\\\")\\n    return repo.casefold()\\n\\n\\ndef rank_key(namespace: str, value: str, seed: int = SELECTION_SEED) -> tuple[str, str]:\\n    material = f\\\"core-bench-spike-v1\\\\0{seed}\\\\0{namespace}\\\\0{value}\\\".encode()\\n    return hashlib.sha256(material).hexdigest(), value.casefold()\\n\\n\\ndef dataset_api_url(dataset: str, revision: str) -> str:\\n    return f\\\"https://huggingface.co/api/datasets/{dataset}/revision/{revision}\\\"\\n\\n\\ndef dataset_file_url(dataset: str, revision: str, path: str) -> str:\\n    return f\\\"https://huggingface.co/datasets/{dataset}/resolve/{revision}/{path}\\\"\\n\\n\\nclass PinnedFetcher:\\n    def __init__(self, cache_dir: Path) -> None:\\n        self.cache_dir = cache_dir\\n\\n    def fetch_path(\\n        self,\\n        label: str,\\n        revision: str,\\n        path: str,\\n        url: str,\\n        headers: dict[str, str] | None = None,\\n    ) -> Path:\\n        cache_path = self.cache_dir / label / revision / path\\n        if not cache_path.exists():\\n            cache_path.parent.mkdir(parents=True, exist_ok=True)\\n            request_headers = {\\\"User-Agent\\\": \\\"brain-bench-core-spike/1\\\", **(headers or {})}\\n            request = urllib.request.Request(url, headers=request_headers)\\n            temporary = cache_path.with_suffix(cache_path.suffix + \\\".tmp\\\")\\n            with urllib.request.urlopen(request, timeout=120) as response:\\n            with urllib.request.urlopen(request, timeout=120) as response:\\n                with temporary.open(\\\"wb\\\") as handle:\\n                    shutil.copyfileobj(response, handle, length=1024 * 1024)\\n            temporary.replace(cache_path)\\n        return cache_path\\n\\n    def fetch_bytes(self, label: str, revision: str, path: str, url: str) -> tuple[bytes, Path]:\\n        cache_path = self.fetch_path(label, revision, path, url)\\n        return cache_path.read_bytes(), cache_path\\n\\n    def metadata(self, label: str, dataset: str, revision: str) -> tuple[dict[str, Any], str]:\\n        data, _ = self.fetch_bytes(label, revision, \\\"api-metadata.json\\\", dataset_api_url(dataset, revision))\\n        metadata = json.loads(data)\\n        if metadata.get(\\\"sha\\\") != revision:\\n            raise ValueError(f\\\"{dataset} resolved to {metadata.get('sha')}, expected {revision}\\\")\\n        return metadata, sha256_bytes(data)\\n\\n    def dataset_file(self, label: str, dataset: str, revision: str, path: str) -> Path:\\n        return self.fetch_path(label, revision, path, dataset_file_url(dataset, revision, path))\\n\\n    def github_pull_request(self, repo: str, number: int) -> tuple[dict[str, Any], Path]:\\n        path = f\\\"{repo}/{number}.json\\\"\\n        headers = {\\\"Accept\\\": \\\"application/vnd.github+json\\\", \\\"X-GitHub-Api-Version\\\": \\\"2022-11-28\\\"}\\n        if os.environ.get(\\\"GITHUB_TOKEN\\\"):\\n            headers[\\\"Authorization\\\"] = f\\\"Bearer {os.environ['GITHUB_TOKEN']}\\\"\\n        cache_path = self.fetch_path(\\n            \\\"github-pull-request\\\",\\n            \\\"api-2022-11-28\\\",\\n            path,\\n            f\\\"https://api.github.com/repos/{repo}/pulls/{number}\\\",\\n            headers,\\n        )\\n        return load_json(cache_path), cache_path\\n\\n\\ndef iter_jsonl_path(path: Path) -> Iterable[dict[str, Any]]:\\n    with path.open(encoding=\\\"utf-8\\\") as handle:\\n        for line_number, line in enumerate(handle, 1):\\n            if not line.strip():\\n                continue\\n            row = json.loads(line)\\n            if not isinstance(row, dict):\\n                raise ValueError(f\\\"{path}: JSONL row {line_number} is not an object\\\")\\n            yield row\\n\\n\\ndef select_query_rows(path: Path, repo: str, count: int) -> tuple[int, list[dict[str, Any]]]:\\n    selected: list[tuple[tuple[str, str], dict[str, Any]]] = []\\n    total = 0\\n    for row in iter_jsonl_path(path):\\n        total += 1\\n        query_id = row.get(\\\"_id\\\")\\n        if not query_id:\\n            raise ValueError(f\\\"{path}: query row has no _id\\\")\\n        selected.append((rank_key(f\\\"query:{repo}\\\", query_id), row))\\n        selected.sort(key=lambda item: item[0])\\n        del selected[count:]\\n    return total, [row for _, row in selected]\\n\\n\\ndef digest_file_set(paths: Iterable[Path], root: Path) -> str:\\n    digest = hashlib.sha256()\\n    for path in sorted(paths):\\n        digest.update(str(path.relative_to(root)).encode())\\n        digest.update(b\\\"\\\\0\\\")\\n        digest.update(path.read_bytes())\\n        digest.update(b\\\"\\\\0\\\")\\n    return digest.hexdigest()\\n\\n\\ndef add_exclusion(reasons: dict[str, set[str]], repo: str, reason: str) -> None:\\n    reasons[normalize_repo(repo)].add(reason)\\n\\n\\ndef freeze_exclusions(args: argparse.Namespace) -> dict[str, Any]:\\n    sibling_root = ROOT.parent\\n    entire_plan = Path(args.entire_plan or sibling_root / \\\"entire-plan\\\")\\n    entire_graph = Path(args.entire_graph or sibling_root / \\\"entire-graph\\\")\\n    fixed_path = entire_plan / \\\"paper/entire-toolchain/artifacts/fixed-answer-2026-07-11/repositories.json\\\"\\n    breadth_path = entire_graph / \\\"bench/repos.json\\\"\\n    tasks_dir = ROOT / \\\"competitive-eval/tasks\\\"\\n    fidelity_paths = [ROOT / name for name in (\\\"repos.json\\\", \\\"repos-heldout.json\\\", \\\"repos-ts.json\\\", \\\"repos-py.json\\\", \\\"repos-rust.json\\\")]\\n\\n    required = [fixed_path, breadth_path, *fidelity_paths]\\n    missing = [str(path) for path in required if not path.exists()]\\n    if missing:\\n        raise FileNotFoundError(\\\"missing exclusion inputs: \\\" + \\\", \\\".join(missing))\\n\\n    reasons: dict[str, set[str]] = defaultdict(set)\\n    for row in load_json(fixed_path):\\n        add_exclusion(reasons, row[\\\"repo\\\"], \\\"fixed_answer_81\\\")\\n\\n    task_paths = sorted(tasks_dir.glob(\\\"*/*.json\\\"))\\n    for path in task_paths:\\n        row = load_json(path)\\n        if row.get(\\\"repo\\\"):\\n            add_exclusion(reasons, row[\\\"repo\\\"], \\\"tasks_81\\\")\\n\\n    for path in fidelity_paths:\\n        for row in load_json(path).get(\\\"repos\\\", []):\\n            add_exclusion(reasons, row[\\\"url\\\"], \\\"fidelity_corpus\\\")\\n\\n    breadth = load_json(breadth_path)\\n    for repos in breadth[\\\"languages\\\"].values():\\n        for repo in repos:\\n            add_exclusion(reasons, repo, \\\"entire_graph_breadth_240\\\")\\n\\n    implementation_repos = [\\n        \\\"ashtom/entire-brain\\\",\\n        \\\"ashtom/entire-plan\\\",\\n        \\\"entirehq/brain-bench\\\",\\n        \\\"entireio/entire-brain\\\",\\n        \\\"entireio/entire-graph\\\",\\n    ]\\n    for repo in implementation_repos:\\n        add_exclusion(reasons, repo, \\\"entire_implementation\\\")\\n\\n    source_files = [\\n        {\\n            \\\"id\\\": \\\"fixed_answer_81\\\",\\n            \\\"path\\\": \\\"entire-plan/paper/entire-toolchain/artifacts/fixed-answer-2026-07-11/repositories.json\\\",\\n            \\\"sha256\\\": sha256_file(fixed_path),\\n        },\\n        {\\n            \\\"id\\\": \\\"tasks_81\\\",\\n            \\\"path\\\": \\\"brain-bench/competitive-eval/tasks/*/*.json\\\",\\n            \\\"file_count\\\": len(task_paths),\\n            \\\"sha256\\\": digest_file_set(task_paths, ROOT),\\n        },\\n        {\\n            \\\"id\\\": \\\"fidelity_corpus\\\",\\n            \\\"path\\\": \\\"brain-bench/repos*.json\\\",\\n            \\\"file_count\\\": len(fidelity_paths),\\n            \\\"sha256\\\": digest_file_set(fidelity_paths, ROOT),\\n        },\\n        {\\n            \\\"id\\\": \\\"entire_graph_breadth_240\\\",\\n            \\\"path\\\": \\\"entire-graph/bench/repos.json\\\",\\n            \\\"sha256\\\": sha256_file(breadth_path),\\n        },\\n        {\\n            \\\"id\\\": \\\"entire_implementation\\\",\\n            \\\"repositories\\\": sorted(implementation_repos, key=str.casefold),\\n            \\\"sha256\\\": sha256_bytes(canonical_json_bytes(sorted(implementation_repos, key=str.casefold))),\\n        },\\n    ]\\n    result = {\\n        \\\"schema_version\\\": 1,\\n        \\\"normalization\\\": \\\"github_owner_repo_casefold_v1\\\",\\n        \\\"repository_count\\\": len(reasons),\\n        \\\"sources\\\": source_files,\\n        \\\"repositories\\\": [\\n            {\\\"normalized_repo\\\": repo, \\\"reasons\\\": sorted(repo_reasons)}\\n            for repo, repo_reasons in sorted(reasons.items())\\n        ],\\n    }\\n    write_json(Path(args.output), result)\\n    return result\\n\\n\\ndef source_file_descriptor(path: str) -> dict[str, str]:\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"ca1413\",\"wall_time_seconds\":9.59e-7,\"exit_code\":0,\"original_token_count\":2686,\"output\":\"            file_path = row.get(\\\"file\\\") or row.get(\\\"file_path\\\")\\n            if not file_path:\\n                continue\\n            start_line = int(row.get(\\\"start_line\\\") or 1)\\n            end_line = int(row.get(\\\"end_line\\\") or start_line)\\n            match_lines = [int(value) for value in row.get(\\\"match_lines\\\") or []]\\n            focus = match_lines[0] if match_lines else start_line\\n            key = (file_path, start_line, end_line, row.get(\\\"node\\\") or row.get(\\\"name\\\"))\\n            reciprocal = 1.0 / ((1 + term_index * 0.1) * (rank + 1))\\n            if key not in scored:\\n                scored[key] = normalize_location_candidate(\\n                    repo, file_path, start_line, end_line, focus,\\n                    str(row.get(\\\"node\\\") or row.get(\\\"name\\\") or \\\"\\\"),\\n                    str(row.get(\\\"label\\\") or \\\"symbol\\\"), reciprocal,\\n                    {\\\"matched_terms\\\": [term], \\\"match_lines\\\": match_lines},\\n                )\\n            else:\\n                scored[key][\\\"retrieval_score\\\"] += reciprocal\\n                scored[key][\\\"evidence\\\"][\\\"matched_terms\\\"].append(term)\\n    candidates = sorted(\\n        scored.values(),\\n        key=lambda row: (-row[\\\"retrieval_score\\\"], row[\\\"file_path\\\"], row[\\\"focus_line\\\"], row[\\\"name\\\"]),\\n    )[:RETRIEVAL_CANDIDATES]\\n    error = \\\";\\\".join(sorted(set(errors))) if errors and not candidates else None\\n    provenance = {\\n        \\\"tool_calls\\\": len(traces),\\n        \\\"index_status\\\": \\\"ready\\\",\\n        \\\"index_ms\\\": index_ms,\\n        \\\"latency_ms\\\": round((time.monotonic() - start) * 1000),\\n        \\\"project_sha256\\\": sha256_bytes(project.encode()),\\n        \\\"status\\\": {key: status.get(key) for key in (\\\"status\\\", \\\"nodes\\\", \\\"edges\\\")},\\n        \\\"traces\\\": traces,\\n        \\\"raw_responses\\\": raw_responses,\\n        \\\"candidate_count\\\": len(candidates),\\n    }\\n    return candidates, provenance, error\\n\\n\\nMEDIATOR_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"properties\\\": {\\n        \\\"ranked_candidate_ids\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\\"type\\\": \\\"string\\\"},\\n            \\\"maxItems\\\": RETRIEVAL_CANDIDATES,\\n        }\\n    },\\n    \\\"required\\\": [\\\"ranked_candidate_ids\\\"],\\n    \\\"additionalProperties\\\": False,\\n}\\n\\n\\ndef mediator_prompt(issue_text: str, candidates: list[dict[str, Any]]) -> tuple[str, dict[str, dict[str, Any]]]:\\n    normalized = []\\n    by_id = {}\\n    for index, candidate in enumerate(candidates[:RETRIEVAL_CANDIDATES]):\\n        candidate_id = f\\\"c{index:03d}\\\"\\n        by_id[candidate_id] = candidate\\n        normalized.append(\\n            {\\n                \\\"candidate_id\\\": candidate_id,\\n                \\\"file_path\\\": candidate[\\\"file_path\\\"],\\n                \\\"start_line\\\": candidate[\\\"start_line\\\"],\\n                \\\"end_line\\\": candidate[\\\"end_line\\\"],\\n                \\\"name\\\": candidate[\\\"name\\\"],\\n                \\\"kind\\\": candidate[\\\"kind\\\"],\\n                \\\"excerpt\\\": candidate[\\\"excerpt\\\"][:800],\\n            }\\n        )\\n    prompt = (\\n        \\\"Rank the supplied retrieval candidates by how likely they are to contain code that must \\\"\\n        \\\"be edited for the development request. Use only the supplied evidence. Do not inspect the \\\"\\n        \\\"filesystem, call tools, or infer nonexistent candidates. Return JSON matching the schema. \\\"\\n        \\\"Include every supplied candidate ID exactly once, ordered best first.\\\\n\\\\n\\\"\\n        f\\\"Development request:\\\\n{issue_text}\\\\n\\\\n\\\"\\n        f\\\"Candidates:\\\\n{json.dumps(normalized, ensure_ascii=True, sort_keys=True)}\\\"\\n    )\\n    return prompt, by_id\\n\\n\\ndef parse_codex_events(stdout: str) -> dict[str, Any]:\\n    final = \\\"\\\"\\n    usage = Counter()\\n    turns = 0\\n    tool_calls = 0\\n    errors = []\\n    for line in stdout.splitlines():\\n        if not line.lstrip().startswith(\\\"{\\\"):\\n            continue\\n        try:\\n            event = json.loads(line)\\n        except json.JSONDecodeError:\\n            continue\\n        if event.get(\\\"type\\\") == \\\"item.completed\\\":\\n            item = event.get(\\\"item\\\") or {}\\n            if item.get(\\\"type\\\") == \\\"agent_message\\\":\\n                final = str(item.get(\\\"text\\\") or \\\"\\\")\\n            elif item.get(\\\"type\\\") in {\\\"command_execution\\\", \\\"mcp_tool_call\\\", \\\"web_search\\\"}:\\n                tool_calls += 1\\n            elif item.get(\\\"type\\\") == \\\"error\\\":\\n                errors.append(str(item.get(\\\"message\\\") or \\\"codex_error\\\"))\\n        elif event.get(\\\"type\\\") == \\\"turn.completed\\\":\\n            turns += 1\\n            for key, value in (event.get(\\\"usage\\\") or {}).items():\\n                if isinstance(value, int):\\n                    usage[key] += value\\n    return {\\\"result\\\": final, \\\"usage\\\": dict(usage), \\\"turns\\\": turns, \\\"tool_calls\\\": tool_calls, \\\"errors\\\": errors}\\n\\n\\ndef mediate_candidates(\\n    issue_text: str,\\n    candidates: list[dict[str, Any]],\\n    codex: str | None,\\n    raw_dir: Path,\\n    system: str,\\n) -> tuple[list[dict[str, Any]], dict[str, Any], str | None]:\\n    if not candidates:\\n        return [], {\\\"model\\\": CODEX_MODEL, \\\"turns\\\": 0, \\\"tool_calls\\\": 0, \\\"usage\\\": {}}, \\\"no_retrieval_candidates\\\"\\n    if not codex:\\n        return candidates, {\\\"model\\\": CODEX_MODEL, \\\"turns\\\": 0, \\\"tool_calls\\\": 0, \\\"usage\\\": {}}, \\\"missing_codex_binary\\\"\\n    prompt, by_id = mediator_prompt(issue_text, candidates)\\n    output = Path(args.output)\\n    output.mkdir(parents=True, exist_ok=True)\\n    run_manifest = {\\n        \\\"schema_version\\\": SCHEMA_VERSION,\\n        \\\"suite\\\": \\\"core_bench_level2_feasibility_spike\\\",\\n        \\\"stage\\\": \\\"qrel_blind_rank_production\\\",\\n        \\\"role\\\": args.role,\\n        \\\"manifest_sha256\\\": spike.sha256_file(manifest_path),\\n        \\\"protocol_sha256\\\": spike.sha256_file(Path(args.protocol)) if args.role == \\\"sealed\\\" else None,\\n        \\\"runner_sha256\\\": spike.sha256_file(Path(__file__)),\\n        \\\"configuration\\\": protocol_configuration(),\\n        \\\"versions\\\": protocol_runtime_view(versions),\\n        \\\"selected_cases\\\": [case[\\\"id\\\"] for case in cases],\\n        \\\"started_at\\\": now_iso(),\\n    }\\n    write_json(output / \\\"run-manifest.json\\\", run_manifest)\\n    completed = []\\n    for index, case in enumerate(cases, 1):\\n        destination = output / \\\"ranks\\\" / f\\\"{case['id']}.json\\\"\\n        if destination.is_file() and not args.force:\\n            prior = load_json(destination)\\n            if prior.get(\\\"case_id\\\") == case[\\\"id\\\"] and prior.get(\\\"qrels_accessed\\\") is False:\\n                completed.append(prior)\\n                print(f\\\"[{index}/{len(cases)}] resume {case['id']}\\\", file=sys.stderr, flush=True)\\n                continue\\n        print(f\\\"[{index}/{len(cases)}] run {case['id']}\\\", file=sys.stderr, flush=True)\\n        result = run_case(case, args, versions)\\n        write_json(destination, result)\\n        completed.append(result)\\n    run_manifest[\\\"completed_at\\\"] = now_iso()\\n    run_manifest[\\\"completed_cases\\\"] = len(completed)\\n    run_manifest[\\\"rank_files_sha256\\\"] = spike.digest_file_set(\\n        [output / \\\"ranks\\\" / f\\\"{case['id']}.json\\\" for case in cases], output\\n    )\\n    write_json(output / \\\"run-manifest.json\\\", run_manifest)\\n    return run_manifest\\n\\n\\ndef freeze_protocol(args: argparse.Namespace) -> dict[str, Any]:\\n    manifest_path = Path(args.manifest)\\n    development = Path(args.development_results)\\n    run_manifest_path = development / \\\"run-manifest.json\\\"\\n    if not run_manifest_path.is_file():\\n        raise ValueError(\\\"development run manifest is missing\\\")\\n    run_manifest = load_json(run_manifest_path)\\n    if run_manifest.get(\\\"role\\\") != \\\"development\\\" or run_manifest.get(\\\"completed_cases\\\") != 6:\\n        raise ValueError(\\\"protocol freeze requires all six development cases\\\")\\n    ranks = sorted((development / \\\"ranks\\\").glob(\\\"*.json\\\"))\\n    if len(ranks) != 6:\\n        raise ValueError(\\\"protocol freeze requires six development rank artifacts\\\")\\n    for path in ranks:\\n        row = load_json(path)\\n        if row.get(\\\"qrels_accessed\\\") is not False:\\n            raise ValueError(f\\\"rank artifact does not prove qrel isolation: {path.name}\\\")\\n    artifact = {\\n        \\\"schema_version\\\": SCHEMA_VERSION,\\n        \\\"suite\\\": \\\"core_bench_level2_feasibility_spike\\\",\\n        \\\"freeze_status\\\": PROTOCOL_FREEZE_STATUS,\\n        \\\"frozen_at\\\": now_iso(),\\n        \\\"manifest_sha256\\\": spike.sha256_file(manifest_path),\\n        \\\"runner_sha256\\\": spike.sha256_file(Path(__file__)),\\n        \\\"configuration\\\": protocol_configuration(),\\n        \\\"runtime_versions\\\": run_manifest[\\\"versions\\\"],\\n        \\\"development_run_manifest_sha256\\\": spike.sha256_file(run_manifest_path),\\n        \\\"development_ranks_sha256\\\": spike.digest_file_set(ranks, development),\\n        \\\"sealed_policy\\\": {\\n            \\\"adapter_changes_after_freeze\\\": \\\"prohibited\\\",\\n            \\\"sealed_output_inspection_before_completion\\\": \\\"prohibited\\\",\\n            \\\"qrels_available_to_rank_producer\\\": False,\\n            \\\"reruns\\\": \\\"only operational failures, retaining original failed artifacts\\\",\\n        },\\n    }\\n    write_json(Path(args.output), artifact)\\n    return artifact\\n\\n\\ndef qrels_for_case(case: dict[str, Any], fetcher: spike.PinnedFetcher) -> dict[str, float]:\\n    path = fetcher.dataset_file(\\n        \\\"core-bench\\\", spike.CORE_DATASET, spike.CORE_REVISION, case[\\\"core_qrels_path\\\"]\\n    )\\n    rows = sorted(\\n        (row for row in spike.iter_jsonl_path(path) if row.get(\\\"query_id\\\") == case[\\\"id\\\"]),\\n        key=lambda row: (row[\\\"corpus_id\\\"], row.get(\\\"score\\\", 0)),\\n    )\\n    if len(rows) != case[\\\"qrel_row_count\\\"]:\\n        raise ValueError(f\\\"qrel row count mismatch for {case['id']}\\\")\\n    if sha256_bytes(canonical_json(rows)) != case[\\\"qrels_sha256\\\"]:\\n        raise ValueError(f\\\"qrel hash mismatch for {case['id']}\\\")\\n    relevances: dict[str, float] = {}\\n    for row in rows:\\n        corpus_id = row[\\\"corpus_id\\\"]\\n        relevances[corpus_id] = max(relevances.get(corpus_id, 0.0), float(row.get(\\\"score\\\") or 0))\\n    return relevances\\n\\n\\ndef dcg(values: Iterable[float]) -> float:\\n    return sum((2**value - 1) / math.log2(rank + 1) for rank, value in enumerate(values, 1))\\n\\n\\ndef retrieval_metrics(ranked: list[str], relevance: dict[str, float]) -> dict[str, Any]:\\n    gains = [relevance.get(corpus_id, 0.0) for corpus_id in ranked[:10]]\\n    ideal = sorted(relevance.values(), reverse=True)[:10]\\n    ideal_dcg = dcg(ideal)\\n    relevant_ids = set(relevance)\\n    top_100 = set(ranked[:100])\\n    first = next((index for index, corpus_id in enumerate(ranked, 1) if corpus_id in relevant_ids), None)\\n    return {\\n        \\\"ndcg_at_10\\\": dcg(gains) / ideal_dcg if ideal_dcg else 0.0,\\n        \\\"recall_at_100\\\": len(relevant_ids & top_100) / len(relevant_ids) if relevant_ids else 0.0,\\n        \\\"mrr\\\": 1 / first if first else 0.0,\\n        \\\"relevant_count\\\": len(relevant_ids),\\n        \\\"relevant_retrieved_at_100\\\": len(relevant_ids & top_100),\\n        \\\"first_relevant_rank\\\": first,\\n    }\\n\\n\\ndef unique_relevant_files(\\n    case_id: str, relevance: dict[str, float], materialization: dict[str, Any]\\n) -> tuple[set[str], int]:\\n    case = next((row for row in materialization[\\\"cases\\\"] if row[\\\"id\\\"] == case_id), None)\\n    if case is None:\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"3f90a3\",\"wall_time_seconds\":0.000003416,\"exit_code\":0,\"original_token_count\":116,\"output\":\"competitive-eval/core-bench/README.md\\ncompetitive-eval/core-bench/candidate-catalog.json\\ncompetitive-eval/core-bench/development-materialization.json\\ncompetitive-eval/core-bench/evaluation-protocol.json\\ncompetitive-eval/core-bench/feasibility-analysis.json\\ncompetitive-eval/core-bench/feasibility-report.md\\ncompetitive-eval/core-bench/overlap-exclusions.json\\ncompetitive-eval/core-bench/sealed-materialization.json\\ncompetitive-eval/core-bench/spike-manifest.json\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
