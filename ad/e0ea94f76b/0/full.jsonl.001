{"timestamp":"2026-07-18T16:05:57.248Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5ba465441c8191991f2e8488e81211","status":"completed","call_id":"call_u8wlHT2Sc17W1jNTGs5WTgqy","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '1,240p' competitive-eval/tools/core_bench_graph_spike.py && sed -n '680,940p' competitive-eval/tools/core_bench_graph_spike.py && sed -n '1,220p' competitive-eval/tools/freeze_agentic_confirmatory_slice.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 40000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:05:57.443Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f75fa-2c43-7412-a5a8-7beab147ea40","call_id":"call_u8wlHT2Sc17W1jNTGs5WTgqy","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"#!/usr/bin/env python3\n\"\"\"Freeze and validate the CORE-Bench Level-2 feasibility spike.\n\nThe freezer is intentionally separate from system adapters. It selects the\nsample and hashes its ground truth before any Entire, CBM, file-search, BM25, or\nLLM result exists.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport urllib.request\nfrom collections import defaultdict\nfrom pathlib import Path\nfrom typing import Any, Iterable\n\n\nROOT = Path(__file__).resolve().parents[2]\nSPIKE_DIR = ROOT / \"competitive-eval\" / \"core-bench-graph\"\nDEFAULT_CACHE = SPIKE_DIR / \".cache\"\nDEFAULT_EXCLUSIONS = SPIKE_DIR / \"overlap-exclusions.json\"\nDEFAULT_CATALOG = SPIKE_DIR / \"candidate-catalog.json\"\nDEFAULT_MANIFEST = SPIKE_DIR / \"spike-manifest.json\"\nDEFAULT_MATERIALIZATION = SPIKE_DIR / \"development-materialization.json\"\nDEFAULT_SEALED_MATERIALIZATION = SPIKE_DIR / \"sealed-materialization.json\"\nDEFAULT_PROTOCOL = SPIKE_DIR / \"evaluation-protocol.json\"\nDEFAULT_CHECKOUTS = SPIKE_DIR / \"checkouts\"\n\nCORE_DATASET = \"zhangfw123/CORE-Bench\"\nCORE_REVISION = \"682c1e668692a1f28a3351511d88e71fce2809ef\"\nSOURCE_DATASET = \"ByteDance-Seed/Multi-SWE-bench\"\nSOURCE_REVISION = \"56ff018c04a38e27ada1e9d0a6d5839a51f88f0d\"\nCORE_LEVEL = \"LEVEL-2\"\nCORE_SUBDATASET = \"Multi-SWE-bench\"\n\nSELECTION_SEED = 20260711\nREPOSITORY_COUNT = 8\nQUERIES_PER_REPOSITORY = 3\nDEVELOPMENT_REPOSITORIES = 2\nMIN_QUERIES_PER_REPOSITORY = 3\n\nSOURCE_LANGUAGE = {\n    \"c\": \"C\",\n    \"cpp\": \"C++\",\n    \"go\": \"Go\",\n    \"java\": \"Java\",\n    \"js\": \"JavaScript\",\n    \"rust\": \"Rust\",\n    \"ts\": \"TypeScript\",\n}\n\n\ndef canonical_json_bytes(value: Any) -> bytes:\n    return (json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(\",\", \":\")) + \"\\n\").encode()\n\n\ndef sha256_bytes(data: bytes) -> str:\n    return hashlib.sha256(data).hexdigest()\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for block in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(block)\n    return digest.hexdigest()\n\n\ndef write_json(path: Path, value: Any) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_bytes(json.dumps(value, indent=2, sort_keys=True).encode() + b\"\\n\")\n\n\ndef load_json(path: Path) -> Any:\n    return json.loads(path.read_text(encoding=\"utf-8\"))\n\n\ndef load_jsonl_bytes(data: bytes) -> list[dict[str, Any]]:\n    rows = []\n    for line_number, line in enumerate(data.decode(\"utf-8\").splitlines(), 1):\n        if not line.strip():\n            continue\n        row = json.loads(line)\n        if not isinstance(row, dict):\n            raise ValueError(f\"JSONL row {line_number} is not an object\")\n        rows.append(row)\n    return rows\n\n\ndef normalize_repo(value: str) -> str:\n    repo = value.strip().replace(\"\\\\\", \"/\")\n    repo = re.sub(r\"^git@github\\.com:\", \"\", repo, flags=re.IGNORECASE)\n    repo = re.sub(r\"^(?:https?://)?github\\.com/\", \"\", repo, flags=re.IGNORECASE)\n    repo = repo.removesuffix(\".git\").strip(\"/\")\n    if \"@\" in repo and repo.count(\"/\") == 1:\n        repo = repo.split(\"@\", 1)[0]\n    if repo.count(\"/\") != 1:\n        raise ValueError(f\"not a GitHub owner/repository identifier: {value!r}\")\n    return repo.casefold()\n\n\ndef rank_key(namespace: str, value: str, seed: int = SELECTION_SEED) -> tuple[str, str]:\n    material = f\"core-bench-spike-v1\\0{seed}\\0{namespace}\\0{value}\".encode()\n    return hashlib.sha256(material).hexdigest(), value.casefold()\n\n\ndef dataset_api_url(dataset: str, revision: str) -> str:\n    return f\"https://huggingface.co/api/datasets/{dataset}/revision/{revision}\"\n\n\ndef dataset_file_url(dataset: str, revision: str, path: str) -> str:\n    return f\"https://huggingface.co/datasets/{dataset}/resolve/{revision}/{path}\"\n\n\nclass PinnedFetcher:\n    def __init__(self, cache_dir: Path) -> None:\n        self.cache_dir = cache_dir\n\n    def fetch_path(\n        self,\n        label: str,\n        revision: str,\n        path: str,\n        url: str,\n        headers: dict[str, str] | None = None,\n    ) -> Path:\n        cache_path = self.cache_dir / label / revision / path\n        if not cache_path.exists():\n            cache_path.parent.mkdir(parents=True, exist_ok=True)\n            request_headers = {\"User-Agent\": \"brain-bench-core-spike/1\", **(headers or {})}\n            request = urllib.request.Request(url, headers=request_headers)\n            temporary = cache_path.with_suffix(cache_path.suffix + \".tmp\")\n            with urllib.request.urlopen(request, timeout=120) as response:\n                with temporary.open(\"wb\") as handle:\n                    shutil.copyfileobj(response, handle, length=1024 * 1024)\n            temporary.replace(cache_path)\n        return cache_path\n\n    def fetch_bytes(self, label: str, revision: str, path: str, url: str) -> tuple[bytes, Path]:\n        cache_path = self.fetch_path(label, revision, path, url)\n        return cache_path.read_bytes(), cache_path\n\n    def metadata(self, label: str, dataset: str, revision: str) -> tuple[dict[str, Any], str]:\n        data, _ = self.fetch_bytes(label, revision, \"api-metadata.json\", dataset_api_url(dataset, revision))\n        metadata = json.loads(data)\n        if metadata.get(\"sha\") != revision:\n            raise ValueError(f\"{dataset} resolved to {metadata.get('sha')}, expected {revision}\")\n        return metadata, sha256_bytes(data)\n\n    def dataset_file(self, label: str, dataset: str, revision: str, path: str) -> Path:\n        return self.fetch_path(label, revision, path, dataset_file_url(dataset, revision, path))\n\n    def github_pull_request(self, repo: str, number: int) -> tuple[dict[str, Any], Path]:\n        path = f\"{repo}/{number}.json\"\n        headers = {\"Accept\": \"application/vnd.github+json\", \"X-GitHub-Api-Version\": \"2022-11-28\"}\n        if os.environ.get(\"GITHUB_TOKEN\"):\n            headers[\"Authorization\"] = f\"Bearer {os.environ['GITHUB_TOKEN']}\"\n        cache_path = self.fetch_path(\n            \"github-pull-request\",\n            \"api-2022-11-28\",\n            path,\n            f\"https://api.github.com/repos/{repo}/pulls/{number}\",\n            headers,\n        )\n        return load_json(cache_path), cache_path\n\n\ndef iter_jsonl_path(path: Path) -> Iterable[dict[str, Any]]:\n    with path.open(encoding=\"utf-8\") as handle:\n        for line_number, line in enumerate(handle, 1):\n            if not line.strip():\n                continue\n            row = json.loads(line)\n            if not isinstance(row, dict):\n                raise ValueError(f\"{path}: JSONL row {line_number} is not an object\")\n            yield row\n\n\ndef select_query_rows(path: Path, repo: str, count: int) -> tuple[int, list[dict[str, Any]]]:\n    selected: list[tuple[tuple[str, str], dict[str, Any]]] = []\n    total = 0\n    for row in iter_jsonl_path(path):\n        total += 1\n        query_id = row.get(\"_id\")\n        if not query_id:\n            raise ValueError(f\"{path}: query row has no _id\")\n        selected.append((rank_key(f\"query:{repo}\", query_id), row))\n        selected.sort(key=lambda item: item[0])\n        del selected[count:]\n    return total, [row for _, row in selected]\n\n\ndef digest_file_set(paths: Iterable[Path], root: Path) -> str:\n    digest = hashlib.sha256()\n    for path in sorted(paths):\n        digest.update(str(path.relative_to(root)).encode())\n        digest.update(b\"\\0\")\n        digest.update(path.read_bytes())\n        digest.update(b\"\\0\")\n    return digest.hexdigest()\n\n\ndef add_exclusion(reasons: dict[str, set[str]], repo: str, reason: str) -> None:\n    reasons[normalize_repo(repo)].add(reason)\n\n\ndef freeze_exclusions(args: argparse.Namespace) -> dict[str, Any]:\n    sibling_root = ROOT.parent\n    entire_plan = Path(args.entire_plan or sibling_root / \"entire-plan\")\n    entire_graph = Path(args.entire_graph or sibling_root / \"entire-graph\")\n    fixed_path = entire_plan / \"paper/entire-toolchain/artifacts/fixed-answer-2026-07-11/repositories.json\"\n    breadth_path = entire_graph / \"bench/repos.json\"\n    tasks_dir = ROOT / \"competitive-eval/tasks\"\n    fidelity_paths = [ROOT / name for name in (\"repos.json\", \"repos-heldout.json\", \"repos-ts.json\", \"repos-py.json\", \"repos-rust.json\")]\n\n    required = [fixed_path, breadth_path, *fidelity_paths]\n    missing = [str(path) for path in required if not path.exists()]\n    if missing:\n        raise FileNotFoundError(\"missing exclusion inputs: \" + \", \".join(missing))\n\n    reasons: dict[str, set[str]] = defaultdict(set)\n    for row in load_json(fixed_path):\n        add_exclusion(reasons, row[\"repo\"], \"fixed_answer_81\")\n\n    task_paths = sorted(tasks_dir.glob(\"*/*.json\"))\n    for path in task_paths:\n        row = load_json(path)\n        if row.get(\"repo\"):\n            add_exclusion(reasons, row[\"repo\"], \"tasks_81\")\n\n    for path in fidelity_paths:\n        for row in load_json(path).get(\"repos\", []):\n            add_exclusion(reasons, row[\"url\"], \"fidelity_corpus\")\n\n\ndef tracked_text_files(repo: Path) -> Iterable[tuple[str, str]]:\n    for path in tracked_paths(repo):\n        try:\n            yield path, (repo / path).read_text(encoding=\"utf-8\")\n        except (UnicodeDecodeError, OSError):\n            continue\n\n\ndef all_occurrences(text: str, needle: str) -> Iterable[int]:\n    start = 0\n    while True:\n        offset = text.find(needle, start)\n        if offset < 0:\n            return\n        yield offset\n        start = offset + 1\n\n\ndef map_chunks_to_locations(repo: Path, chunks: Iterable[dict[str, Any]]) -> list[dict[str, Any]]:\n    chunk_rows = []\n    for chunk in chunks:\n        chunk_id = chunk.get(\"_id\") or chunk.get(\"corpus_id\")\n        text = chunk.get(\"text\")\n        if not chunk_id or not isinstance(text, str) or not text:\n            raise ValueError(\"chunk requires a non-empty ID and text\")\n        chunk_rows.append({\"corpus_id\": chunk_id, \"text\": text, \"locations\": []})\n    for path, body in tracked_text_files(repo):\n        for chunk in chunk_rows:\n            text = chunk[\"text\"]\n            anchor = text[: min(80, len(text))]\n            if anchor not in body:\n                continue\n            for offset in all_occurrences(body, text):\n                start_line = body.count(\"\\n\", 0, offset) + 1\n                end_line = start_line + text.rstrip(\"\\r\\n\").count(\"\\n\")\n                chunk[\"locations\"].append(\n                    {\"file_path\": path, \"start_line\": start_line, \"end_line\": end_line}\n                )\n    mappings = []\n    for chunk in chunk_rows:\n        hits = chunk[\"locations\"]\n        mappings.append(\n            {\n                \"corpus_id\": chunk[\"corpus_id\"],\n                \"text_sha256\": sha256_bytes(chunk[\"text\"].encode()),\n                \"status\": \"missing\" if not hits else \"unique\" if len(hits) == 1 else \"ambiguous\",\n                \"locations\": hits,\n            }\n        )\n    return mappings\n\n\ndef run_git(arguments: list[str], cwd: Path | None = None, timeout: int = 900) -> str:\n    process = subprocess.run(\n        [\"git\", *arguments],\n        cwd=cwd,\n        text=True,\n        capture_output=True,\n        check=False,\n        timeout=timeout,\n    )\n    if process.returncode != 0:\n        detail = (process.stderr or process.stdout).strip()[-1000:]\n        raise ValueError(f\"git {' '.join(arguments)} failed ({process.returncode}): {detail}\")\n    return process.stdout.strip()\n\n\ndef ensure_case_checkout(checkouts_dir: Path, case: dict[str, Any]) -> dict[str, Any]:\n    slug = case[\"normalized_repo\"].replace(\"/\", \"__\")\n    mirror = checkouts_dir / \"mirrors\" / f\"{slug}.git\"\n    checkout = checkouts_dir / \"cases\" / case[\"id\"]\n    if not mirror.exists():\n        mirror.parent.mkdir(parents=True, exist_ok=True)\n        run_git(\n            [\n                \"clone\",\n                \"--bare\",\n                \"--filter=blob:none\",\n                f\"https://github.com/{case['repo']}.git\",\n                str(mirror),\n            ],\n            timeout=1800,\n        )\n    commit = case[\"base_commit\"]\n    exists = subprocess.run(\n        [\"git\", f\"--git-dir={mirror}\", \"cat-file\", \"-e\", f\"{commit}^{{commit}}\"],\n        capture_output=True,\n        check=False,\n    ).returncode == 0\n    if not exists:\n        run_git([f\"--git-dir={mirror}\", \"fetch\", \"--no-tags\", \"--depth=1\", \"origin\", commit], timeout=1800)\n    if checkout.exists():\n        actual = run_git([\"rev-parse\", \"HEAD\"], cwd=checkout)\n        if actual != commit:\n            raise ValueError(f\"existing checkout {case['id']} is at {actual}, expected {commit}\")\n    else:\n        checkout.parent.mkdir(parents=True, exist_ok=True)\n        run_git([f\"--git-dir={mirror}\", \"worktree\", \"add\", \"--detach\", str(checkout), commit], timeout=1800)\n    actual = run_git([\"rev-parse\", \"HEAD\"], cwd=checkout)\n    tree = run_git([\"rev-parse\", \"HEAD^{tree}\"], cwd=checkout)\n    dirty = run_git([\"status\", \"--porcelain=v1\"], cwd=checkout)\n    if actual != commit or dirty:\n        raise ValueError(f\"checkout validation failed for {case['id']}: head={actual}, dirty={bool(dirty)}\")\n    return {\n        \"case_id\": case[\"id\"],\n        \"repo\": case[\"repo\"],\n        \"commit\": actual,\n        \"tree\": tree,\n        \"checkout\": f\"checkouts/cases/{case['id']}\",\n        \"tracked_files\": len(tracked_paths(checkout)),\n        \"path\": checkout,\n    }\n\n\ndef corpus_subset(path: Path, corpus_ids: set[str]) -> dict[str, dict[str, Any]]:\n    rows = {}\n    for row in iter_jsonl_path(path):\n        if row.get(\"_id\") in corpus_ids:\n            rows[row[\"_id\"]] = row\n            if len(rows) == len(corpus_ids):\n                break\n    return rows\n\n\ndef materialize_role(args: argparse.Namespace, role: str) -> dict[str, Any]:\n    manifest = load_json(Path(args.manifest))\n    cases = [case for case in manifest[\"cases\"] if case[\"role\"] == role]\n    expected_repositories = (\n        DEVELOPMENT_REPOSITORIES if role == \"development\" else REPOSITORY_COUNT - DEVELOPMENT_REPOSITORIES\n    )\n    expected_cases = expected_repositories * QUERIES_PER_REPOSITORY\n    if len(cases) != expected_cases:\n        raise ValueError(f\"expected {expected_cases} {role} cases, found {len(cases)}\")\n    protocol_sha256 = None\n    if role == \"sealed\":\n        protocol_path = Path(args.protocol)\n        protocol = load_json(protocol_path)\n        if protocol.get(\"freeze_status\") != \"frozen_after_development_before_sealed_run\":\n            raise ValueError(\"sealed materialization requires a frozen evaluation protocol\")\n        if protocol.get(\"manifest_sha256\") != sha256_file(Path(args.manifest)):\n            raise ValueError(\"evaluation protocol was frozen for a different manifest\")\n        protocol_sha256 = sha256_file(protocol_path)\n    fetcher = PinnedFetcher(Path(args.cache_dir))\n    checkouts_dir = Path(args.checkouts_dir)\n    cases_by_repo: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for case in cases:\n        cases_by_repo[case[\"normalized_repo\"]].append(case)\n\n    source_files = []\n    output_cases = []\n    for repo_key, repo_cases in sorted(cases_by_repo.items()):\n        sample = repo_cases[0]\n        corpus_path = sample[\"core_queries_path\"].replace(\"queries.jsonl\", \"corpus.jsonl\")\n        qrels_path = sample[\"core_qrels_path\"]\n        corpus_cache = fetcher.dataset_file(\"core-bench\", CORE_DATASET, CORE_REVISION, corpus_path)\n        qrels_cache = fetcher.dataset_file(\"core-bench\", CORE_DATASET, CORE_REVISION, qrels_path)\n        source_files.extend(\n            [\n                {\"path\": corpus_path, \"sha256\": sha256_file(corpus_cache)},\n                {\"path\": qrels_path, \"sha256\": sha256_file(qrels_cache)},\n            ]\n        )\n        qrels_by_case: dict[str, list[dict[str, Any]]] = defaultdict(list)\n        selected_ids = {case[\"id\"] for case in repo_cases}\n        for qrel in iter_jsonl_path(qrels_cache):\n            if qrel.get(\"query_id\") in selected_ids:\n                qrels_by_case[qrel[\"query_id\"]].append(qrel)\n        wanted_corpus_ids = {\n            qrel[\"corpus_id\"] for rows in qrels_by_case.values() for qrel in rows\n        }\n        chunks = corpus_subset(corpus_cache, wanted_corpus_ids)\n        missing_chunks = sorted(wanted_corpus_ids - chunks.keys())\n        if missing_chunks:\n            raise ValueError(f\"{repo_key} corpus is missing qrel chunks: {missing_chunks[:10]}\")\n        for case in sorted(repo_cases, key=lambda row: row[\"id\"]):\n            checkout = ensure_case_checkout(checkouts_dir, case)\n            qrel_rows = qrels_by_case.get(case[\"id\"], [])\n            qrel_ids = {row[\"corpus_id\"] for row in qrel_rows}\n            if len(qrel_rows) != case[\"qrel_row_count\"]:\n                raise ValueError(\n                    f\"{case['id']} qrel row count {len(qrel_rows)} != manifest {case['qrel_row_count']}\"\n                )\n            if len(qrel_ids) != case[\"relevant_corpus_count\"]:\n                raise ValueError(\n                    f\"{case['id']} relevant corpus count {len(qrel_ids)} != \"\n                    f\"manifest {case['relevant_corpus_count']}\"\n                )\n            mappings = map_chunks_to_locations(checkout[\"path\"], [chunks[corpus_id] for corpus_id in sorted(qrel_ids)])\n            output_cases.append(\n                {\n                    \"id\": case[\"id\"],\n                    \"repo\": case[\"repo\"],\n                    \"language\": case[\"language\"],\n                    \"commit\": checkout[\"commit\"],\n                    \"tree\": checkout[\"tree\"],\n                    \"checkout\": checkout[\"checkout\"],\n                    \"tracked_files\": checkout[\"tracked_files\"],\n                    \"qrel_row_count\": len(qrel_rows),\n                    \"relevant_corpus_count\": len(qrel_ids),\n                    \"mapping_counts\": {\n                        status: sum(row[\"status\"] == status for row in mappings)\n                        for status in (\"unique\", \"ambiguous\", \"missing\")\n                    },\n                    \"mappings\": mappings,\n                }\n            )\n\n    total_qrel_rows = sum(case[\"qrel_row_count\"] for case in output_cases)\n    total_relevant = sum(case[\"relevant_corpus_count\"] for case in output_cases)\n    mapping_totals = {\n        status: sum(case[\"mapping_counts\"][status] for case in output_cases)\n        for status in (\"unique\", \"ambiguous\", \"missing\")\n    }\n    artifact = {\n        \"schema_version\": 1,\n        \"suite\": \"core_bench_level2_feasibility_spike\",\n        \"stage\": f\"{role}_qrel_materialization\",\n        \"role\": role,\n        \"manifest_sha256\": sha256_file(Path(args.manifest)),\n        \"protocol_sha256\": protocol_sha256,\n        \"core_dataset\": {\"dataset\": CORE_DATASET, \"revision\": CORE_REVISION, \"files\": source_files},\n        \"summary\": {\n            \"repositories\": len(cases_by_repo),\n            \"cases\": len(output_cases),\n            \"qrel_rows\": total_qrel_rows,\n            \"relevant_corpus_documents\": total_relevant,\n            \"mapping_counts\": mapping_totals,\n            \"content_mapping_rate\": (\n                (mapping_totals[\"unique\"] + mapping_totals[\"ambiguous\"]) / total_relevant\n                if total_relevant\n                else 0.0\n            ),\n            \"unique_location_rate\": mapping_totals[\"unique\"] / total_relevant if total_relevant else 0.0,\n        },\n        \"cases\": output_cases,\n    }\n    write_json(Path(args.output), artifact)\n    return artifact\n\n\ndef materialize_development(args: argparse.Namespace) -> dict[str, Any]:\n    return materialize_role(args, \"development\")\n\n\ndef materialize_sealed(args: argparse.Namespace) -> dict[str, Any]:\n    return materialize_role(args, \"sealed\")\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=__doc__)\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    exclusions = subparsers.add_parser(\"freeze-exclusions\", help=\"freeze repository overlap exclusions\")\n    exclusions.add_argument(\"--entire-plan\")\n    exclusions.add_argument(\"--entire-graph\")\n    exclusions.add_argument(\"--output\", default=str(DEFAULT_EXCLUSIONS))\n\n    freeze = subparsers.add_parser(\"freeze-manifest\", help=\"freeze the deterministic spike sample\")\n    freeze.add_argument(\"--cache-dir\", default=str(DEFAULT_CACHE))\n#!/usr/bin/env python3\n\"\"\"Freeze an identity-safe, unpaid three-repository issue-analysis smoke.\n\nThe selector consumes only the already-predefined public CORE-Bench candidate\ncatalog.  It checks every catalog repository against the protected Graph V8\nHMAC union, but never publishes a matching identity or an identity hash.  The\npublic artifact contains aggregate exclusion counts and the selected public\nrepository metadata only.  It contains no query, qrel, expected answer, repair\noracle, rank, score, or outcome data and grants no execution or publication\nauthority.  It is development-only and cannot support a confirmatory code-\nrepair claim.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport hmac\nimport json\nimport sys\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import Any, Sequence\n\nimport construct_graph_holdout_v8 as graph_v8\nimport freeze_graph_exclusions_v8 as exclusion_freezer\nimport sem_v7_artifacts as artifacts\n\n\nROOT = Path(__file__).resolve().parents[2]\nSUITE = \"entire_graph_agentic_issue_analysis_smoke_v1\"\nSTAGE = \"frozen_unpaid_agentic_issue_analysis_repository_cohort\"\nSELECTION_SEED = \"20260718-agentic-issue-analysis-smoke-v1\"\nREPOSITORY_COUNT = 3\nMAXIMUM_INPUT_BYTES = 64 * 1024 * 1024\n\nDEFAULT_CATALOG = ROOT / \"competitive-eval/core-bench/candidate-catalog.json\"\nDEFAULT_CATALOG_SHA256 = (\n    \"795ae2d2b74a01fa5b1f366ffae51ab3b7cdd9a6f5c3a832601ac80536eb2887\"\n)\nDEFAULT_PRIOR_SPIKE = ROOT / \"competitive-eval/core-bench/spike-manifest.json\"\nDEFAULT_PRIOR_SPIKE_SHA256 = (\n    \"cc21233c751c3e1362d7e429528fde201231916b80aecefdf21a8f6817b3b4ca\"\n)\nDEFAULT_EXCLUSIONS = ROOT / \"competitive-eval/graph-v8/graph-exclusion-freeze.json\"\nDEFAULT_EXCLUSIONS_SHA256 = (\n    \"7233b60bac097f014047acbefed947db3b5501976053a4ae575512ddccc71e92\"\n)\n\n\n@dataclass(frozen=True)\nclass FrozenInput:\n    relative_path: str\n    sha256: str\n    suite: str | None = None\n    stage: str | None = None\n\n\nDEFAULT_POST_FREEZE_COHORTS = (\n    FrozenInput(\n        \"competitive-eval/agentic-tasks-smoke/manifest.json\",\n        \"120c0786fa90df0f7f06289baa55696d648712fbc64749644b012fcf4da1e2e8\",\n        \"entire_graph_agentic_mini_v1\",\n        \"frozen_three_repository_agentic_tasks_smoke\",\n    ),\n    FrozenInput(\n        \"competitive-eval/oracle-agentic-overlay/manifest.json\",\n        \"50356dade718ea38d17bbd968ae06200c9f14e6196ba3b31baf1455eb029f09c\",\n        \"entire_graph_oracle_agentic_overlay_v1\",\n        \"frozen_compiler_oracle_agentic_overlay\",\n    ),\n)\n\nDEFAULT_REPAIR_RUNS = (\n    FrozenInput(\n        \"competitive-eval/agentic-repair-pilot/agent-format-run-20260718.json\",\n        \"e9aa12fbd8553db33b0ae6d94090b419ecfb4abe31bfea1a3f37e3f4eafe4723\",\n    ),\n    FrozenInput(\n        \"competitive-eval/agentic-repair-pilot/augmentation-run-20260717.json\",\n        \"991919450ae3f237ca02d20a75deb8aa7462becc7e0f360f05b7cf2a6de75b53\",\n    ),\n    FrozenInput(\n        \"competitive-eval/agentic-repair-pilot/diagnostic-run-20260717.json\",\n        \"9a3062653054d460c475ee464ea66450c8f3ee562e16d406542456b5a7723ad6\",\n    ),\n)\n\n# The repair-pilot run artifacts intentionally keep identities opaque.  Its\n# selected development cohort is nevertheless public and fixed in the retained\n# Tasks constructor and repair-pilot documentation.  Bind every committed run\n# above and exclude this public identity set without opening any run outcome.\nREPAIR_PILOT_PUBLIC_REPOSITORIES = (\n    \"catchorg/catch2\",\n    \"microsoft/vscode\",\n    \"vitejs/vite\",\n)\n\nREPAIR_RUN_CLASSIFICATIONS = {\n    \"agent-format-run-20260718.json\": \"development_agent_format_result_not_confirmatory\",\n    \"augmentation-run-20260717.json\": \"development_augmentation_result_not_confirmatory\",\n    \"diagnostic-run-20260717.json\": \"development_diagnostic_not_rankable\",\n}\n\nFALSE_AUTHORITY_FIELDS = (\n    \"catalog_construction_authorized\",\n    \"issue_query_construction_authorized\",\n    \"controller_scoring_authorized\",\n    \"repair_execution_authorized\",\n    \"model_execution_authorized\",\n    \"paid_execution_authorized\",\n    \"confirmatory_execution_authorized\",\n    \"confirmatory_use_allowed\",\n    \"confirmatory_publication_authorized\",\n    \"rank_production_authorized\",\n    \"score_production_authorized\",\n    \"outcome_publication_authorized\",\n)\nABSENT_DATA_FIELDS = (\n    \"queries_present\",\n    \"qrels_present\",\n    \"expected_outcomes_present\",\n    \"repair_oracles_present\",\n    \"ranks_present\",\n    \"scores_present\",\n    \"outcomes_present\",\n)\n\n\nclass SliceError(ValueError):\n    \"\"\"Raised when an input or output violates the slice freeze contract.\"\"\"\n\n\n@dataclass(frozen=True)\nclass LoadedJSON:\n    document: Any\n    sha256: str\n\n\ndef _reject_duplicate_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:\n    value: dict[str, Any] = {}\n    for key, nested in pairs:\n        if key in value:\n            raise SliceError(\"JSON input contains a duplicate object key\")\n        value[key] = nested\n    return value\n\n\ndef _reject_json_constant(value: str) -> None:\n    raise SliceError(f\"JSON input contains a non-finite constant: {value}\")\n\n\ndef load_json(path: Path, *, expected_sha256: str | None = None) -> LoadedJSON:\n    \"\"\"Read one stable regular JSON file, allowing legacy pretty serialization.\"\"\"\n\n    data, digest, _size, _identity = artifacts._scan_regular_file(\n        Path(path), capture_bytes=True, maximum_bytes=MAXIMUM_INPUT_BYTES\n    )\n    assert data is not None\n    if expected_sha256 is not None:\n        artifacts.require_sha256(expected_sha256, \"expected input SHA-256\")\n        if digest != expected_sha256:\n            raise SliceError(f\"frozen input hash mismatch: {Path(path).name}\")\n    try:\n        text = data.decode(\"utf-8\")\n    except UnicodeDecodeError as error:\n        raise SliceError(\"JSON input is not UTF-8\") from error\n    try:\n        document = json.loads(\n            text,\n            object_pairs_hook=_reject_duplicate_pairs,\n            parse_constant=_reject_json_constant,\n        )\n    except json.JSONDecodeError as error:\n        raise SliceError(\"input is not valid JSON\") from error\n    artifacts.validate_json_value(document, \"input document\")\n    return LoadedJSON(document=document, sha256=digest)\n\n\ndef path_label(path: Path) -> str:\n    resolved = Path(path).resolve()\n    try:\n        return resolved.relative_to(ROOT.resolve()).as_posix()\n    except ValueError:\n        return resolved.name\n\n\ndef canonical_public_repo(value: Any) -> tuple[str, str]:\n    \"\"\"Canonicalize public identities through the Graph V8 implementation.\"\"\"\n\n    repository = artifacts.require_string(value, \"public repository identity\").strip()\n    # Fidelity manifests use the public ``github.com/owner/name`` spelling.\n    # Convert only that spelling to the URL form accepted by Graph V8, then let\n    # Graph V8 perform all owner/name validation and case normalization.\n    if repository.casefold().startswith(\"github.com/\"):\n        repository = \"https://\" + repository\n    canonical = graph_v8.canonical_repo(repository)\n    return canonical, graph_v8.normalize_repo(canonical)\n\n\ndef _repository_rows(document: dict[str, Any], label: str) -> list[dict[str, Any]]:\n    rows = document.get(\"repositories\")\n    if type(rows) is not list:\n        raise SliceError(f\"{label} has no repository collection\")\n    if any(type(row) is not dict for row in rows):\n        raise SliceError(f\"{label} repository collection is malformed\")\n    return rows\n\n\ndef extract_public_repositories(\n    document: Any,\n    *,\n    label: str,\n    expected_suite: str | None = None,\n    expected_stage: str | None = None,\n) -> set[str]:\n    \"\"\"Project only selected top-level public identities from a cohort artifact.\n\n    In particular, this function never walks ``cases``, expected answers,\n    scoring records, attempts, or outcomes.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
