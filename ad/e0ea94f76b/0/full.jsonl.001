{"timestamp":"2026-07-18T16:52:41.928Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7624-f748-7ce0-9e74-5052fbd1e255","call_id":"call_dC9J8VRnbNqviQt0C2wjwpJm","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"   150\t            \"divided by all relevant files\"\n   151\t        ),\n   152\t    },\n   153\t    \"diagnostic_localization_metrics\": {\n   154\t        \"oracle_region_overlap_recall_at_5\": (\n   155\t            \"oracle regions overlapped by any of the first five ranked locations \"\n   156\t            \"divided by all oracle regions\"\n   157\t        ),\n   158\t        \"predicted_region_overlap_precision_at_5\": (\n   159\t            \"first-five ranked locations overlapping any oracle region divided \"\n   160\t            \"by the fixed denominator five\"\n   161\t        ),\n   162\t        \"oracle_line_overlap_recall_at_5\": (\n   163\t            \"inclusive oracle lines overlapped by first-five line-bounded \"\n   164\t            \"predictions divided by unioned oracle lines\"\n   165\t        ),\n   166\t        \"predicted_line_overlap_precision_at_5\": (\n   167\t            \"inclusive predicted lines overlapping unioned oracle lines divided \"\n   168\t            \"by unioned first-five predicted lines\"\n   169\t        ),\n   170\t        \"file_only_prediction_line_overlap\": \"zero; file relevance is still scored\",\n   171\t    },\n   172\t    \"aggregation\": {\n   173\t        \"unit\": \"scheduled system attempt\",\n   174\t        \"system_weighting\": \"arithmetic mean across every scheduled attempt\",\n   175\t        \"failed_or_tool_policy_noncompliant_quality\": \"all quality metrics are zero\",\n   176\t        \"survivor_only_quality_averages_allowed\": False,\n   177\t        \"token_fields_summed_separately\": list(TOKEN_FIELDS),\n   178\t        \"task_wall_time_reported_separately\": True,\n   179\t        \"retrieval_phase_latency_reported_separately\": True,\n   180\t        \"setup_index_wall_time_reported_separately\": True,\n   181\t        \"setup_index_time_included_in_task_wall_time\": False,\n   182\t        \"cost_recomputed_from_frozen_token_prices\": True,\n   183\t        \"failures_and_tool_policy_compliance_reported_separately\": True,\n   184\t    },\n   185\t    \"measurement_sources\": {\n   186\t        \"model_tokens\": \"exact agent-runtime usage record\",\n   187\t        \"cost_usd\": \"recomputed and cross-checked against frozen per-token prices\",\n   188\t        \"task_wall_time_ms\": \"controller monotonic interval around the model process\",\n   189\t        \"retrieval_phase_latency_ms\": (\n   190\t            \"sum of controller-observed retrieval tool-call wall times within the task\"\n   191\t        ),\n   192\t        \"setup_index_wall_time_ms\": (\n   193\t            \"exact referenced unpaid setup record; excluded from task wall time\"\n   194\t        ),\n   195\t        \"tool_policy\": \"controller tool-call trace and exact trace SHA-256\",\n   196\t    },\n   197\t    \"claim_boundary\": {\n   198\t        \"development_smoke_only\": True,\n   199\t        \"broad_product_superiority_claim_allowed\": False,\n   200\t        \"confirmatory_claim_allowed\": False,\n   201\t        \"code_repair_claim_allowed\": False,\n   202\t        \"outcome_publication_authorized\": False,\n   203\t    },\n   204\t}\n   205\t\n   206\t\n   207\tclass ScoringError(ValueError):\n   208\t    \"\"\"Raised when an issue-analysis scoring boundary fails closed.\"\"\"\n   209\t\n   210\t\n   211\tdef _document_sha256(value: Any) -> str:\n   212\t    return artifacts.sha256_bytes(artifacts.canonical_bytes(value))\n   213\t\n   214\t\n   215\tdef scoring_contract_sha256() -> str:\n   216\t    \"\"\"Return the canonical hash that execution freezes should bind.\"\"\"\n   217\t\n   218\t    return _document_sha256(SCORING_CONTRACT)\n   219\t\n   220\t\n   221\tdef attempt_result_contract_sha256() -> str:\n   222\t    \"\"\"Return the exact outer result-envelope contract hash.\"\"\"\n   223\t\n   224\t    return _document_sha256(ATTEMPT_RESULT_CONTRACT)\n   225\t\n   430\t    metrics = {\n   431\t        \"file_ndcg_at_5\": dcg / ideal if ideal else 0.0,\n   432\t        \"file_recall_at_5\": recall,\n   433\t        \"file_mrr\": 1 / first_relevant if first_relevant else 0.0,\n   434\t        \"file_precision_at_5\": precision,\n   435\t        \"file_f1_at_5\": f1,\n   436\t        \"file_all_returned_recall\": len(set(ranked_files) & relevant_files) / len(relevant_files),\n   437\t        \"oracle_region_overlap_recall_at_5\": oracle_region_hits / len(oracle),\n   438\t        \"predicted_region_overlap_precision_at_5\": predicted_region_hits / 5,\n   439\t        \"oracle_line_overlap_recall_at_5\": overlap_lines / oracle_line_count,\n   440\t        \"predicted_line_overlap_precision_at_5\": (\n   441\t            overlap_lines / predicted_line_count if predicted_line_count else 0.0\n   442\t        ),\n   443\t    }\n   444\t    return {field: _rounded(metrics[field]) for field in QUALITY_FIELDS}\n   445\t\n   446\t\n   447\tdef _expected_attempts(freeze: dict[str, Any]) -> dict[tuple[Any, ...], dict[str, Any]]:\n   448\t    if (\n   449\t        freeze.get(\"schema_version\") != 1\n   450\t        or freeze.get(\"suite\") != SUITE\n   451\t        or freeze.get(\"stage\") != runner.FREEZE_STAGE\n   452\t        or freeze.get(\"development_only\") is not True\n   453\t    ):\n   454\t        raise ScoringError(\"execution freeze identity is malformed\")\n   455\t    schedule = freeze.get(\"schedule\")\n   456\t    if type(schedule) is not dict or type(schedule.get(\"rows\")) is not list:\n   457\t        raise ScoringError(\"execution freeze schedule is malformed\")\n   458\t    checkouts = freeze.get(\"checkouts\")\n   459\t    if type(checkouts) is not list:\n   460\t        raise ScoringError(\"execution freeze checkout bindings are malformed\")\n   461\t    case_by_repository: dict[str, str] = {}\n   462\t    for row in checkouts:\n   463\t        if (\n   464\t            type(row) is not dict\n   465\t            or not isinstance(row.get(\"id\"), str)\n   466\t            or not isinstance(row.get(\"repository_id\"), str)\n   467\t            or row[\"repository_id\"] in case_by_repository\n   468\t        ):\n   469\t            raise ScoringError(\"execution freeze case bindings are malformed\")\n   470\t        case_by_repository[row[\"repository_id\"]] = row[\"id\"]\n   471\t    if len(case_by_repository) != 3:\n   472\t        raise ScoringError(\"execution freeze must bind exactly three cases\")\n   473\t\n   474\t    expected: dict[tuple[Any, ...], dict[str, Any]] = {}\n   475\t    for row in schedule[\"rows\"]:\n   476\t        if (\n   477\t            type(row) is not dict\n   478\t            or type(row.get(\"pair_index\")) is not int\n   479\t            or type(row.get(\"repetition_index\")) is not int\n   480\t            or not isinstance(row.get(\"repository_id\"), str)\n   481\t            or row[\"repository_id\"] not in case_by_repository\n   482\t            or row.get(\"system_order\") is None\n   483\t            or type(row[\"system_order\"]) is not list\n   484\t            or set(row[\"system_order\"]) != set(SYSTEMS)\n   485\t            or len(row[\"system_order\"]) != len(SYSTEMS)\n   486\t        ):\n   487\t            raise ScoringError(\"execution freeze schedule row is malformed\")\n   488\t        for position, system in enumerate(row[\"system_order\"], start=1):\n   489\t            key = (\n   490\t                row[\"pair_index\"], row[\"repository_id\"], row[\"repetition_index\"],\n   491\t                system, position,\n   492\t            )\n   493\t            if key in expected:\n   494\t                raise ScoringError(\"execution freeze schedule contains a duplicate attempt\")\n   495\t            expected[key] = {\n   496\t                \"pair_index\": row[\"pair_index\"],\n   497\t                \"repository_id\": row[\"repository_id\"],\n   498\t                \"repetition_index\": row[\"repetition_index\"],\n   499\t                \"system\": system,\n   500\t                \"system_position\": position,\n   501\t                \"case_id\": case_by_repository[row[\"repository_id\"]],\n   502\t            }\n   503\t    if schedule.get(\"paid_attempt_count_if_separately_authorized\") != len(expected):\n   504\t        raise ScoringError(\"execution freeze attempt count differs from its schedule\")\n   505\t    return expected\n   506\t\n   507\t\n   508\tdef _validate_usage(value: Any, label: str) -> dict[str, int]:\n   509\t    row = _require_fields(value, TOKEN_FIELDS, label)\n   510\t    if any(type(row[field]) is not int or row[field] < 0 for field in TOKEN_FIELDS):\n   511\t        raise ScoringError(f\"{label} token counts must be non-negative integers\")\n   512\t    expected_total = sum(row[field] for field in TOKEN_FIELDS[:-1])\n   513\t    if row[\"total_model_tokens\"] != expected_total:\n   514\t        raise ScoringError(f\"{label}.total_model_tokens is inconsistent\")\n   515\t    return row\n   516\t\n   517\t\n   518\tdef _validate_timing(value: Any, label: str) -> dict[str, Any]:\n   519\t    row = _require_fields(value, TIMING_FIELDS, label)\n   520\t    for field in TIMING_FIELDS:\n   521\t        if type(row[field]) is not int or row[field] < 0:\n   522\t            raise ScoringError(f\"{label}.{field} must be a non-negative integer\")\n   523\t    return row\n   524\t\n   525\t\n   526\tdef _validate_tool_policy(value: Any, label: str) -> dict[str, Any]:\n   527\t    row = _require_fields(\n   528\t        value, TOOL_EVIDENCE_FIELDS, label,\n   529\t    )\n   530\t    if (\n   531\t        type(row[\"tool_call_count\"]) is not int\n   532\t        or row[\"tool_call_count\"] < 0\n   533\t        or type(row[\"policy_compliant\"]) is not bool\n   534\t        or type(row[\"violation_codes\"]) is not list\n   535\t    ):\n   536\t        raise ScoringError(f\"{label} is malformed\")\n   537\t    _require_sha256(row[\"trace_sha256\"], f\"{label}.trace_sha256\")\n   538\t    codes = row[\"violation_codes\"]\n   539\t    if any(not isinstance(code, str) or SAFE_CODE_RE.fullmatch(code) is None for code in codes):\n   540\t        raise ScoringError(f\"{label} contains an invalid violation code\")\n   541\t    if len(codes) != len(set(codes)) or row[\"policy_compliant\"] is not (not codes):\n   542\t        raise ScoringError(f\"{label} compliance disagrees with its violation codes\")\n   543\t    return row\n   544\t\n   545\t\n   546\tdef _validate_setup_reference(value: Any, label: str) -> dict[str, Any]:\n   547\t    row = _require_fields(\n   548\t        value, SETUP_REFERENCE_FIELDS, label,\n   549\t    )\n   550\t    _require_sha256(row[\"setup_record_sha256\"], f\"{label}.setup_record_sha256\")\n   551\t    if (\n   552\t        type(row[\"setup_index_wall_time_ms\"]) is not int\n   553\t        or row[\"setup_index_wall_time_ms\"] < 0\n   554\t        or row[\"setup_excluded_from_task_timing\"] is not True\n   555\t    ):\n   556\t        raise ScoringError(f\"{label} includes malformed or in-task setup timing\")\n   557\t    return row\n   558\t\n   559\t\n   560\tdef _validate_retrieval_telemetry(\n   561\t    value: Any, *, system: str, tool_call_count: int, task_wall_time_ms: int,\n   562\t    label: str,\n   563\t) -> dict[str, Any]:\n   564\t    row = _require_fields(\n   565\t        value, RETRIEVAL_TELEMETRY_FIELDS, label,\n   566\t    )\n   567\t    if (\n   568\t        type(row[\"retrieval_call_count\"]) is not int\n   569\t        or row[\"retrieval_call_count\"] < 0\n   570\t        or row[\"retrieval_call_count\"] > tool_call_count\n   571\t        or type(row[\"entire_graph_call_count\"]) is not int\n   572\t        or row[\"entire_graph_call_count\"] < 0\n   573\t        or row[\"entire_graph_call_count\"] > row[\"retrieval_call_count\"]\n   574\t        or type(row[\"controller_observed_latency_ms\"]) is not int\n   575\t        or row[\"controller_observed_latency_ms\"] < 0\n   576\t        or row[\"controller_observed_latency_ms\"] > task_wall_time_ms\n   577\t    ):\n   578\t        raise ScoringError(f\"{label} controller retrieval telemetry is malformed\")\n   579\t    product_latency = row[\"product_reported_total_latency_ms\"]\n   580\t    cache_hits = row[\"entire_graph_all_index_cache_hits\"]\n   581\t    graph_used = system == \"entire-graph\" and row[\"entire_graph_call_count\"] > 0\n   582\t    if system != \"entire-graph\" and row[\"entire_graph_call_count\"] != 0:\n   583\t        raise ScoringError(f\"{label} attributes Graph calls to another treatment\")\n   584\t    if graph_used:\n   585\t        if (\n   586\t            type(product_latency) is not int\n   587\t            or product_latency < 0\n   588\t            or cache_hits is not True\n   589\t        ):\n   590\t            raise ScoringError(f\"{label} does not prove preindexed Entire Graph retrieval\")\n   591\t    elif product_latency is not None or cache_hits is not None:\n   592\t        raise ScoringError(f\"{label} exposes Graph-only telemetry for a non-Graph retrieval\")\n   593\t    return row\n   594\t\n   595\tdef validate_attempt_results(\n   596\t    document: dict[str, Any], freeze: dict[str, Any], *,\n   597\t    execution_freeze_sha256: str, sealed_oracle_sha256: str,\n   598\t    require_synthetic: bool | None = None,\n   599\t) -> list[dict[str, Any]]:\n   600\t    \"\"\"Validate the exact one-result-per-scheduled-attempt result contract.\"\"\"\n   601\t\n   602\t    _require_sha256(execution_freeze_sha256, \"execution freeze hash\")\n   603\t    _require_sha256(sealed_oracle_sha256, \"sealed oracle hash\")\n   604\t    if _document_sha256(freeze) != execution_freeze_sha256:\n   605\t        raise ScoringError(\"execution freeze document differs from its exact hash\")\n   606\t    row = _require_fields(\n   607\t        document, ATTEMPT_RESULT_DOCUMENT_FIELDS, \"attempt results\",\n   608\t    )\n   609\t    synthetic = row[\"synthetic_fixture\"]\n   610\t    if (\n   611\t        row[\"schema_version\"] != 1\n   612\t        or row[\"suite\"] != SUITE\n   613\t        or row[\"stage\"] != ATTEMPT_RESULTS_STAGE\n   614\t        or row[\"development_only\"] is not True\n   615\t        or type(synthetic) is not bool\n   616\t        or (require_synthetic is not None and synthetic is not require_synthetic)\n   617\t        or row[\"execution_freeze_sha256\"] != execution_freeze_sha256\n   618\t        or row[\"sealed_oracle_sha256\"] != sealed_oracle_sha256\n   619\t        or row[\"controller_scoring_authorized\"] is not False\n   620\t        or row[\"score_production_authorized\"] is not False\n   621\t        or row[\"scores_present\"] is not False\n   622\t        or row[\"outcomes_present\"] is not False\n   623\t    ):\n   624\t        raise ScoringError(\"attempt results identity or pre-scoring boundary is malformed\")\n   625\t    _require_sha256(row[\"execution_authorization_sha256\"], \"execution authorization hash\")\n   626\t    if synthetic:\n   627\t        if row[\"paid_execution_authorized\"] is not False or row[\"model_execution_authorized\"] is not False:\n   628\t            raise ScoringError(\"synthetic results may not claim paid/model authorization\")\n   629\t    elif row[\"paid_execution_authorized\"] is not True or row[\"model_execution_authorized\"] is not True:\n   630\t        raise ScoringError(\"real attempt results lack paid/model execution authority\")\n   631\t\n   632\t    expected = _expected_attempts(freeze)\n   633\t    attempts = row[\"attempts\"]\n   634\t    if type(attempts) is not list or row[\"attempt_count\"] != len(attempts):\n   635\t        raise ScoringError(\"attempt result count is malformed\")\n   636\t    observed: dict[tuple[Any, ...], dict[str, Any]] = {}\n   637\t    for index, attempt_value in enumerate(attempts):\n   638\t        attempt = _require_fields(attempt_value, ATTEMPT_FIELDS, f\"attempts[{index}]\")\n   639\t        key = (\n   640\t            attempt[\"pair_index\"], attempt[\"repository_id\"],\n   641\t            attempt[\"repetition_index\"], attempt[\"system\"],\n   642\t            attempt[\"system_position\"],\n   643\t        )\n   644\t        expected_attempt = expected.get(key)\n   645\t        if (\n   646\t            expected_attempt is None\n   647\t            or any(attempt[field] != expected_attempt[field] for field in expected_attempt)\n   648\t            or key in observed\n   649\t        ):\n   650\t            raise ScoringError(\"attempt result is extra, duplicate, or differs from its schedule\")\n   651\t        status = attempt[\"terminal_status\"]\n   652\t        failure = attempt[\"failure_code\"]\n   653\t        if status not in {\"success\", \"failure\"}:\n   654\t            raise ScoringError(\"attempt terminal status is invalid\")\n   655\t        if status == \"success\":\n   656\t            if (\n   657\t                failure is not None\n   658\t                or type(attempt[\"final_answer\"]) is not dict\n   659\t                or attempt[\"timed_out\"] is not False\n   660\t                or attempt[\"return_code\"] != 0\n   661\t            ):\n   662\t                raise ScoringError(\"successful attempt has inconsistent process or answer state\")\n   663\t            _validate_final_answer(attempt[\"final_answer\"], f\"attempts[{index}].final_answer\")\n   664\t        elif not isinstance(failure, str) or SAFE_CODE_RE.fullmatch(failure) is None:\n   665\t            raise ScoringError(\"failed attempt lacks a safe machine failure code\")\n   666\t        if status == \"failure\" and attempt[\"final_answer\"] is not None:\n   667\t            raise ScoringError(\"failed attempt may not retain a partially interpreted final answer\")\n   668\t        if type(attempt[\"timed_out\"]) is not bool:\n   669\t            raise ScoringError(\"attempt timed_out must be an exact boolean\")\n   670\t        if attempt[\"return_code\"] is not None and type(attempt[\"return_code\"]) is not int:\n   671\t            raise ScoringError(\"attempt return_code must be an integer or null\")\n   672\t        if attempt[\"timed_out\"] and attempt[\"return_code\"] is not None:\n   673\t            raise ScoringError(\"timed-out attempt may not claim a process return code\")\n   674\t        _require_sha256(attempt[\"transcript_sha256\"], \"attempt transcript hash\")\n   675\t        _require_sha256(attempt[\"stderr_sha256\"], \"attempt stderr hash\")\n   676\t        _validate_usage(attempt[\"usage\"], f\"attempts[{index}].usage\")\n   677\t        if (\n   678\t            not isinstance(attempt[\"cost_usd\"], str)\n   679\t            or _decimal_string(_decimal(attempt[\"cost_usd\"], \"attempt cost\"))\n   680\t            != attempt[\"cost_usd\"]\n   681\t        ):\n   682\t            raise ScoringError(\"attempt cost_usd is not a canonical non-negative decimal\")\n   683\t        timing = _validate_timing(attempt[\"timing\"], f\"attempts[{index}].timing\")\n   684\t        _validate_setup_reference(\n   685\t            attempt[\"setup_reference\"], f\"attempts[{index}].setup_reference\",\n   686\t        )\n   687\t        tool_evidence = _validate_tool_policy(\n   688\t            attempt[\"tool_evidence\"], f\"attempts[{index}].tool_evidence\",\n   689\t        )\n   690\t        _validate_retrieval_telemetry(\n   691\t            attempt[\"retrieval_telemetry\"],\n   692\t            system=attempt[\"system\"],\n   693\t            tool_call_count=tool_evidence[\"tool_call_count\"],\n   694\t            task_wall_time_ms=timing[\"task_wall_time_ms\"],\n   695\t            label=f\"attempts[{index}].retrieval_telemetry\",\n   696\t        )\n   697\t        observed[key] = attempt\n   698\t    if set(observed) != set(expected):\n   699\t        raise ScoringError(\"attempt results do not cover the exact frozen schedule once\")\n   700\t    return [observed[key] for key in sorted(observed)]\n   920\t                ],\n   921\t                \"setup_excluded_from_task_timing\": attempt[\"setup_reference\"][\n   922\t                    \"setup_excluded_from_task_timing\"\n   923\t                ],\n   924\t            },\n   925\t            \"retrieval_telemetry\": attempt[\"retrieval_telemetry\"],\n   926\t            \"setup_record_sha256\": attempt[\"setup_reference\"][\"setup_record_sha256\"],\n   927\t            \"tool_trace_sha256\": attempt[\"tool_evidence\"][\"trace_sha256\"],\n   928\t            \"tool_call_count\": attempt[\"tool_evidence\"][\"tool_call_count\"],\n   929\t            \"cost_usd\": _decimal_string(cost),\n   930\t            \"final_answer_sha256\": (\n   931\t                _document_sha256(attempt[\"final_answer\"])\n   932\t                if attempt[\"final_answer\"] is not None else None\n   933\t            ),\n   934\t            \"transcript_sha256\": attempt[\"transcript_sha256\"],\n   935\t            \"stderr_sha256\": attempt[\"stderr_sha256\"],\n   936\t            \"return_code\": attempt[\"return_code\"],\n   937\t            \"timed_out\": attempt[\"timed_out\"],\n   938\t        })\n   939\t    systems = {\n   940\t        system: _aggregate_system([row for row in scored_attempts if row[\"system\"] == system])\n   941\t        for system in SYSTEMS\n   942\t    }\n   943\t    if any(value[\"attempt_count\"] == 0 for value in systems.values()):\n   944\t        raise ScoringError(\"a frozen system has no scheduled scored attempts\")\n   945\t    output = {\n   946\t        \"schema_version\": 1,\n   947\t        \"suite\": SUITE,\n   948\t        \"stage\": SYNTHETIC_SCORE_STAGE if synthetic else SCORE_STAGE,\n   949\t        \"development_only\": True,\n   950\t        \"synthetic_fixture\": synthetic,\n   951\t        \"controller_scoring_authorized\": not synthetic,\n   952\t        \"score_production_authorized\": not synthetic,\n   953\t        \"outcome_publication_authorized\": False,\n   954\t        \"confirmatory_use_allowed\": False,\n   955\t        \"broad_product_superiority_claim_allowed\": False,\n   956\t        \"execution_freeze_sha256\": execution_freeze_sha256,\n   957\t        \"sealed_oracle_sha256\": sealed_oracle_sha256,\n   958\t        \"attempt_results_sha256\": attempt_results_sha256,\n   959\t        \"scoring_authorization_sha256\": scoring_authorization_sha256,\n   960\t        **scorer_binding(),\n   961\t        \"scoring_contract\": SCORING_CONTRACT,\n   962\t        \"attempt_count\": len(scored_attempts),\n   963\t        \"attempts\": scored_attempts,\n   964\t        \"aggregates_by_system\": systems,\n   965\t        \"claim_boundary\": SCORING_CONTRACT[\"claim_boundary\"],\n   966\t    }\n   967\t    _assert_no_host_paths(output, \"score artifact\")\n   968\t    return output\n   969\t\n   970\t\n   971\tdef score_synthetic(\n   972\t    freeze: dict[str, Any], sealed: dict[str, Any], results: dict[str, Any],\n   973\t) -> dict[str, Any]:\n   974\t    \"\"\"Score only an explicitly synthetic fixture without granting real authority.\"\"\"\n   975\t\n   976\t    return _build_scores(\n   977\t        freeze,\n   978\t        sealed,\n   979\t        results,\n   980\t        execution_freeze_sha256=_document_sha256(freeze),\n  1080\tdef _assert_no_host_paths(value: Any, label: str) -> None:\n  1081\t    if isinstance(value, str):\n  1082\t        folded = value.casefold()\n  1083\t        if (\n  1084\t            value.startswith(\"/\")\n  1085\t            or folded.startswith(\"file:\")\n  1086\t            or \"/users/\" in folded\n  1087\t            or \"/private/\" in folded\n  1088\t            or \"\\\\users\\\\\" in folded\n  1089\t        ):\n  1090\t            raise ScoringError(f\"{label} contains a host path\")\n  1091\t    elif type(value) is dict:\n  1092\t        for nested in value.values():\n  1093\t            _assert_no_host_paths(nested, label)\n  1094\t    elif type(value) is list:\n  1095\t        for nested in value:\n  1096\t            _assert_no_host_paths(nested, label)\n  1097\t\n  1098\t\n  1099\tdef _write_once_or_match(path: Path, document: dict[str, Any], label: str) -> str:\n  1100\t    if path.exists():\n  1101\t        existing = artifacts.read_canonical_json(path, expected_type=dict).document\n  1102\t        if existing != document:\n  1103\t            raise ScoringError(f\"existing {label} differs from the exact document\")\n  1104\t        return artifacts.sha256_file(path)\n  1105\t    path.parent.mkdir(parents=True, exist_ok=True)\n  1106\t    return artifacts.write_new_canonical_json(path, document)\n  1107\t\n  1108\t\n  1109\tdef create_false_scoring_authorization(\n  1110\t    freeze_path: Path, sealed_path: Path, results_path: Path, output: Path, *,\n  1111\t    authorization_note: str = \"controller scoring is not authorized\",\n  1112\t) -> dict[str, Any]:\n  1113\t    \"\"\"Hash, but do not open, attempt results and emit a false authorization.\"\"\"\n  1114\t\n  1115\t    freeze_artifact = artifacts.read_canonical_json(freeze_path, expected_type=dict)\n  1116\t    freeze = freeze_artifact.document\n  1117\t    if (\n  1118\t        freeze.get(\"suite\") != SUITE\n  1119\t        or freeze.get(\"stage\") != runner.FREEZE_STAGE\n  1120\t        or freeze.get(\"development_only\") is not True\n  1121\t    ):\n  1122\t        raise ScoringError(\"execution freeze identity is malformed\")\n  1123\t    sealed_sha256 = artifacts.sha256_file(sealed_path)\n  1124\t    if freeze.get(\"inputs\", {}).get(\"sealed_oracle\", {}).get(\"sha256\") != sealed_sha256:\n  1125\t        raise ScoringError(\"sealed oracle hash differs from the execution freeze\")\n  1126\t    document = build_false_scoring_authorization(\n  1127\t        execution_freeze_sha256=freeze_artifact.sha256,\n  1128\t        sealed_oracle_sha256=sealed_sha256,\n  1129\t        attempt_results_sha256=artifacts.sha256_file(results_path),\n  1130\t        authorization_note=authorization_note,\n  1131\t    )\n  1132\t    _write_once_or_match(output, document, \"false scoring authorization\")\n  1133\t    return document\n  1134\t\n  1135\t\n  1136\tdef score_authorized(\n  1137\t    freeze_path: Path, sealed_path: Path, results_path: Path,\n  1138\t    authorization_path: Path, output: Path, *,\n  1139\t    expected_authorization_sha256: str,\n  1140\t) -> dict[str, Any]:\n  1141\t    \"\"\"Score real results only after an exact true controller authorization.\"\"\"\n  1142\t\n  1143\t    _require_sha256(expected_authorization_sha256, \"expected scoring authorization hash\")\n  1144\t    # Hash-only observations occur before authorization.  Attempt outcomes and\n  1145\t    # sealed judgments are not parsed until the exact true gate passes.\n  1146\t    freeze_artifact = artifacts.read_canonical_json(freeze_path, expected_type=dict)\n  1147\t    preliminary_freeze = freeze_artifact.document\n  1148\t    if (\n  1149\t        preliminary_freeze.get(\"suite\") != SUITE\n  1150\t        or preliminary_freeze.get(\"stage\") != runner.FREEZE_STAGE\n  1151\t        or preliminary_freeze.get(\"development_only\") is not True\n  1152\t    ):\n  1153\t        raise ScoringError(\"execution freeze identity is malformed\")\n  1154\t    sealed_sha256 = artifacts.sha256_file(sealed_path)\n  1155\t    if preliminary_freeze.get(\"inputs\", {}).get(\"sealed_oracle\", {}).get(\"sha256\") != sealed_sha256:\n  1156\t        raise ScoringError(\"sealed oracle hash differs from the execution freeze\")\n  1157\t    results_sha256 = artifacts.sha256_file(results_path)\n  1158\t    authorization_artifact = artifacts.read_canonical_json(\n  1159\t        authorization_path,\n  1160\t        expected_type=dict,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a