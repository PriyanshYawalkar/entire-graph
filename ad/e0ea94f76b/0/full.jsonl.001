{"timestamp":"2026-07-18T16:23:14.259Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5ba872445c8191a5620b76c861b93d","status":"completed","call_id":"call_7HaXrvcrVCYi1bQwgq7kzTOB","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '1,280p' competitive-eval/tools/materialize_agentic_issue_analysis_smoke.py && sed -n '280,660p' competitive-eval/tools/materialize_agentic_issue_analysis_smoke.py && sed -n '660,1040p' competitive-eval/tools/materialize_agentic_issue_analysis_smoke.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 60000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:23:14.456Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7609-ff18-7031-91d1-f413dddc8315","call_id":"call_7HaXrvcrVCYi1bQwgq7kzTOB","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"#!/usr/bin/env python3\n\"\"\"Materialize a sealed, development-only issue-localization smoke.\n\nThe repository cohort is frozen before this program runs.  This program reads\nonly rows for those three public repositories from the pinned SWE-rebench V2\nparquet, applies fixed structural eligibility rules, and hash-ranks one case\nper repository before any product or model output exists.  Agent-visible tasks\ncontain the issue only.  Gold-patch-derived base-snapshot locations are written\nto a separate controller-only artifact.\n\nThis program does not run a model, retrieval system, scorer, or repair agent.\nIt grants no confirmatory or publication authority.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport re\nimport subprocess\nimport sys\nfrom collections import Counter, defaultdict\nfrom pathlib import Path, PurePosixPath\nfrom typing import Any, Callable, Iterable, Sequence\n\nimport sem_v7_artifacts as artifacts\n\n\nROOT = Path(__file__).resolve().parents[2]\nSUITE = \"entire_graph_agentic_issue_analysis_smoke_v1\"\nCOHORT_STAGE = \"frozen_unpaid_agentic_issue_analysis_repository_cohort\"\nPUBLIC_STAGE = \"frozen_public_issue_analysis_tasks\"\nSEALED_STAGE = \"sealed_controller_issue_localization_judgments\"\nATTESTATION_STAGE = \"issue_analysis_materialization_attestation\"\nCASE_SELECTION_SEED = \"20260718-agentic-issue-analysis-case-v1\"\nREPOSITORY_COUNT = 3\nCASES_PER_REPOSITORY = 1\n\nDATASET = \"nebius/SWE-rebench-V2\"\nDATASET_REVISION = \"475dd5e8703bb5fb22dd3c60b5d038b019eba1e0\"\nPARQUET_REVISION = \"550a7d2a8e0ae1a03b393d3974aebbbf1d43fdb4\"\nPARQUET_SHA256 = \"0e0bf9355f892ad74ae98d4e1c404f39fd6654a8e351ee3e6ab162e4a64cd3ad\"\n\nSUITE_DIR = ROOT / \"competitive-eval\" / \"agentic-issue-analysis-smoke-v1\"\nDEFAULT_PUBLIC_OUTPUT = SUITE_DIR / \"public-tasks.json\"\nDEFAULT_SEALED_OUTPUT = SUITE_DIR / \"sealed-controller-judgments.json\"\nDEFAULT_ATTESTATION_OUTPUT = SUITE_DIR / \"materialization-attestation.json\"\nDEFAULT_CHECKOUTS_DIR = SUITE_DIR / \"checkouts\"\n\nTERM_RE = re.compile(r\"[A-Za-z0-9_./:+-]+\")\nCOMMIT_RE = re.compile(r\"[0-9a-f]{40}\")\nHUNK_RE = re.compile(r\"^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@\")\nMIN_QUERY_TERMS = 3\nMAX_QUERY_TERMS = 1000\nMAX_CHANGED_FILES = 8\nMAX_CHANGED_LINES = 300\nMAX_REGIONS = 20\nEXCLUDED_PARTS = {\".git\", \"node_modules\", \"vendor\", \"dist\", \"build\", \"target\"}\nEXCLUDED_NAMES = {\"package-lock.json\", \"yarn.lock\", \"pnpm-lock.yaml\"}\n\nAUTHORITY_FIELDS = (\n    \"controller_scoring_authorized\",\n    \"repair_execution_authorized\",\n    \"model_execution_authorized\",\n    \"paid_execution_authorized\",\n    \"confirmatory_execution_authorized\",\n    \"confirmatory_use_allowed\",\n    \"confirmatory_publication_authorized\",\n    \"rank_production_authorized\",\n    \"score_production_authorized\",\n    \"outcome_publication_authorized\",\n)\n\nSOURCE_COLUMNS = (\n    \"instance_id\",\n    \"repo\",\n    \"language\",\n    \"created_at\",\n    \"base_commit\",\n    \"problem_statement\",\n    \"patch\",\n)\n\n\nclass MaterializationError(ValueError):\n    \"\"\"Raised when a materialization invariant fails closed.\"\"\"\n\n\nCheckoutProvider = Callable[[Path, dict[str, Any]], dict[str, Any]]\n\n\ndef _sha256_json(value: Any) -> str:\n    return artifacts.sha256_bytes(artifacts.canonical_bytes(value))\n\n\ndef _require_string(value: Any, label: str) -> str:\n    if type(value) is not str or not value.strip():\n        raise MaterializationError(f\"{label} must be a non-empty string\")\n    return value.strip()\n\n\ndef canonical_repo(value: Any) -> str:\n    repository = _require_string(value, \"repository identity\")\n    repository = repository.replace(\"\\\\\", \"/\").removesuffix(\".git\").strip(\"/\")\n    for prefix in (\"https://github.com/\", \"http://github.com/\", \"github.com/\"):\n        if repository.casefold().startswith(prefix):\n            repository = repository[len(prefix) :]\n            break\n    if repository.casefold().startswith(\"git@github.com:\"):\n        repository = repository[len(\"git@github.com:\") :]\n    parts = repository.split(\"/\")\n    if len(parts) != 2 or any(not part or part in {\".\", \"..\"} for part in parts):\n        raise MaterializationError(\"repository identity must be GitHub owner/name\")\n    return \"/\".join(parts)\n\n\ndef normalize_repo(value: Any) -> str:\n    return canonical_repo(value).casefold()\n\n\ndef query_terms(query: str) -> list[str]:\n    return [term.casefold() for term in TERM_RE.findall(query)]\n\n\ndef _line_regions(lines: Iterable[int]) -> list[dict[str, int]]:\n    ordered = sorted(set(lines))\n    if not ordered:\n        return []\n    result: list[dict[str, int]] = []\n    start = previous = ordered[0]\n    for line in ordered[1:]:\n        if line != previous + 1:\n            result.append({\"start_line\": start, \"end_line\": previous})\n            start = line\n        previous = line\n    result.append({\"start_line\": start, \"end_line\": previous})\n    return result\n\n\ndef patch_judgments(patch: str) -> list[dict[str, Any]]:\n    \"\"\"Project removed old-file lines from a unified diff into base locations.\"\"\"\n\n    current_path: str | None = None\n    old_line = 0\n    in_hunk = False\n    changed: dict[str, set[int]] = defaultdict(set)\n    for line in patch.splitlines():\n        if line.startswith(\"diff --git \"):\n            current_path = None\n            in_hunk = False\n            continue\n        if line.startswith(\"--- \"):\n            raw = line[4:].split(\"\\t\", 1)[0]\n            current_path = raw[2:] if raw.startswith(\"a/\") else raw\n            if current_path == \"/dev/null\":\n                current_path = None\n            in_hunk = False\n            continue\n        match = HUNK_RE.match(line)\n        if match:\n            old_line = int(match.group(1))\n            in_hunk = current_path is not None\n            continue\n        if not in_hunk or current_path is None or line.startswith(\"+++\"):\n            continue\n        if line.startswith(\"-\") and not line.startswith(\"---\"):\n            if old_line < 1:\n                raise MaterializationError(\"patch produced an invalid base line\")\n            changed[current_path].add(old_line)\n            old_line += 1\n        elif line.startswith(\" \"):\n            old_line += 1\n        elif line.startswith(\"+\") or line == \"\\\\ No newline at end of file\":\n            continue\n        else:\n            in_hunk = False\n\n    judgments: list[dict[str, Any]] = []\n    for path, lines in sorted(changed.items()):\n        pure = PurePosixPath(path)\n        folded_parts = {part.casefold() for part in pure.parts}\n        if (\n            path.startswith(\"/\")\n            or \"..\" in pure.parts\n            or folded_parts & EXCLUDED_PARTS\n            or pure.name.casefold() in EXCLUDED_NAMES\n        ):\n            continue\n        for region in _line_regions(lines):\n            judgments.append({\"file_path\": path, **region})\n    return judgments\n\n\ndef _source_projection(row: dict[str, Any]) -> dict[str, str]:\n    missing = [field for field in SOURCE_COLUMNS if field not in row]\n    if missing:\n        raise MaterializationError(f\"source row is missing fields: {', '.join(missing)}\")\n    projection = {field: str(row[field]) for field in SOURCE_COLUMNS}\n    projection[\"repo\"] = canonical_repo(projection[\"repo\"])\n    projection[\"language\"] = projection[\"language\"].strip().casefold()\n    projection[\"base_commit\"] = projection[\"base_commit\"].strip().casefold()\n    for field in SOURCE_COLUMNS:\n        if not projection[field].strip():\n            raise MaterializationError(f\"source row {field} is empty\")\n    if COMMIT_RE.fullmatch(projection[\"base_commit\"]) is None:\n        raise MaterializationError(\"source row base_commit is not a lowercase full SHA\")\n    return projection\n\n\ndef _eligible_case(row: dict[str, Any]) -> tuple[dict[str, Any] | None, str | None]:\n    try:\n        source = _source_projection(row)\n    except MaterializationError:\n        return None, \"malformed_source_row\"\n    issue = source[\"problem_statement\"].strip()\n    term_count = len(query_terms(issue))\n    if not MIN_QUERY_TERMS <= term_count <= MAX_QUERY_TERMS:\n        return None, \"query_length\"\n    judgments = patch_judgments(source[\"patch\"])\n    changed_files = {row[\"file_path\"] for row in judgments}\n    changed_lines = sum(\n        row[\"end_line\"] - row[\"start_line\"] + 1 for row in judgments\n    )\n    if not judgments:\n        return None, \"no_base_snapshot_judgments\"\n    if (\n        len(changed_files) > MAX_CHANGED_FILES\n        or changed_lines > MAX_CHANGED_LINES\n        or len(judgments) > MAX_REGIONS\n    ):\n        return None, \"patch_scope\"\n    query_projection = {\n        \"repo\": source[\"repo\"],\n        \"language\": source[\"language\"],\n        \"created_at\": source[\"created_at\"],\n        \"base_commit\": source[\"base_commit\"],\n        \"problem_statement\": issue,\n    }\n    return {\n        \"source\": source,\n        \"source_record_sha256\": _sha256_json(source),\n        \"query_record_sha256\": _sha256_json(query_projection),\n        \"patch_sha256\": hashlib.sha256(source[\"patch\"].encode(\"utf-8\")).hexdigest(),\n        \"judgments\": judgments,\n        \"judgments_sha256\": _sha256_json(judgments),\n    }, None\n\n\ndef _case_rank(normalized_repo: str, instance_id: str) -> tuple[str, str]:\n    material = (\n        f\"{CASE_SELECTION_SEED}\\0case\\0{normalized_repo}\\0{instance_id}\".encode(\n            \"utf-8\"\n        )\n    )\n    return hashlib.sha256(material).hexdigest(), instance_id\n\n\ndef _public_case_id(instance_id: str) -> str:\n    material = f\"{CASE_SELECTION_SEED}\\0public-case-id\\0{instance_id}\".encode(\n        \"utf-8\"\n    )\n    return \"egias-\" + hashlib.sha256(material).hexdigest()[:24]\n\n\ndef _authority_flags() -> dict[str, bool]:\n    return {field: False for field in AUTHORITY_FIELDS}\n\n\ndef _source_descriptor(parquet_file_name: str = \"source.parquet\") -> dict[str, Any]:\n    return {\n        \"dataset\": DATASET,\n        \"dataset_revision\": DATASET_REVISION,\n        \"parquet_revision\": PARQUET_REVISION,\n        \"parquet_sha256\": PARQUET_SHA256,\n        \"parquet_file_name\": parquet_file_name,\n    }\n\n\ndef _validate_cohort(document: Any) -> list[dict[str, Any]]:\ndef _validate_cohort(document: Any) -> list[dict[str, Any]]:\n    if type(document) is not dict:\n        raise MaterializationError(\"cohort is not an object\")\n    if (\n        document.get(\"schema_version\") != 1\n        or document.get(\"suite\") != SUITE\n        or document.get(\"stage\") != COHORT_STAGE\n        or document.get(\"development_only\") is not True\n        or document.get(\"repository_count\") != REPOSITORY_COUNT\n    ):\n        raise MaterializationError(\"cohort contract mismatch\")\n    for field in AUTHORITY_FIELDS:\n        if document.get(field) is not False:\n            raise MaterializationError(f\"cohort grants authority: {field}\")\n    claim = document.get(\"claim_boundary\")\n    if type(claim) is not dict or any(\n        claim.get(field) is not False\n        for field in (\n            \"code_repair_claim_allowed\",\n            \"broad_superiority_claim_allowed\",\n            \"confirmatory_claim_allowed\",\n        )\n    ):\n        raise MaterializationError(\"cohort claim boundary mismatch\")\n    rows = document.get(\"repositories\")\n    if type(rows) is not list or len(rows) != REPOSITORY_COUNT:\n        raise MaterializationError(\"cohort repository collection mismatch\")\n    result: list[dict[str, Any]] = []\n    seen: set[str] = set()\n    for row in rows:\n        if type(row) is not dict:\n            raise MaterializationError(\"cohort repository row is malformed\")\n        repo = canonical_repo(row.get(\"repo\"))\n        normalized = normalize_repo(repo)\n        if row.get(\"normalized_repo\") != normalized:\n            raise MaterializationError(\"cohort normalized repository mismatch\")\n        if normalized in seen:\n            raise MaterializationError(\"cohort contains duplicate repository\")\n        seen.add(normalized)\n        language = _require_string(row.get(\"language\"), \"cohort language\").casefold()\n        projected: dict[str, Any] = {\n            \"repo\": repo,\n            \"normalized_repo\": normalized,\n            \"language\": language,\n        }\n        for count_field in (\"instance_count\", \"source_instance_count\"):\n            if count_field in row:\n                count = row[count_field]\n                if type(count) is not int or count < 1:\n                    raise MaterializationError(\"cohort instance count is invalid\")\n                projected[count_field] = count\n        result.append(projected)\n    return sorted(result, key=lambda row: row[\"normalized_repo\"])\n\n\ndef _read_selected_parquet_rows(\n    path: Path, repositories: Sequence[dict[str, Any]]\n) -> tuple[list[dict[str, Any]], int]:\n    try:\n        import pyarrow.dataset as ds\n        import pyarrow.parquet as pq\n    except ImportError as error:  # pragma: no cover - environment diagnostic\n        raise MaterializationError(\"pyarrow is required to read the pinned parquet\") from error\n\n    selected_names = [row[\"repo\"] for row in repositories]\n    parquet = pq.ParquetFile(path)\n    if not set(SOURCE_COLUMNS) <= set(parquet.schema.names):\n        raise MaterializationError(\"pinned parquet columns do not match the source contract\")\n    dataset = ds.dataset(path, format=\"parquet\")\n    expression = ds.field(\"repo\").isin(selected_names)\n    rows = [\n        row\n        for batch in dataset.to_batches(\n            columns=list(SOURCE_COLUMNS), filter=expression, batch_size=256\n        )\n        for row in batch.to_pylist()\n    ]\n    return rows, parquet.metadata.num_rows\n\n\ndef _git(arguments: Sequence[str], cwd: Path | None = None, timeout: int = 1800) -> str:\n    process = subprocess.run(\n        [\"git\", *arguments],\n        cwd=cwd,\n        text=True,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        check=False,\n        timeout=timeout,\n    )\n    if process.returncode != 0:\n        detail = (process.stderr or process.stdout).strip()[-1000:]\n        raise MaterializationError(\n            f\"git {' '.join(arguments)} failed ({process.returncode}): {detail}\"\n        )\n    return process.stdout.strip()\n\n\ndef _inspect_checkout(\n    checkout: Path, case: dict[str, Any], expected_tree: str | None = None\n) -> dict[str, Any]:\n    if not checkout.is_dir() or checkout.is_symlink():\n        raise MaterializationError(f\"checkout is missing or ambiguous: {case['id']}\")\n    commit = _git([\"rev-parse\", \"HEAD\"], cwd=checkout)\n    tree = _git([\"rev-parse\", \"HEAD^{tree}\"], cwd=checkout)\n    dirty = _git([\"status\", \"--porcelain=v1\", \"--untracked-files=all\"], cwd=checkout)\n    if commit != case[\"base_commit\"] or dirty:\n        raise MaterializationError(f\"checkout validation failed: {case['id']}\")\n    if expected_tree is not None and tree != expected_tree:\n        raise MaterializationError(f\"checkout tree changed: {case['id']}\")\n    tracked_raw = subprocess.check_output([\"git\", \"-C\", str(checkout), \"ls-files\", \"-z\"])\n    tracked = [value for value in tracked_raw.split(b\"\\0\") if value]\n    return {\n        \"path\": checkout,\n        \"commit\": commit,\n        \"tree\": tree,\n        \"tracked_files\": len(tracked),\n    }\n\n\ndef ensure_checkout(checkouts_dir: Path, case: dict[str, Any]) -> dict[str, Any]:\n    checkout = checkouts_dir / \"cases\" / case[\"id\"]\n    if not checkout.exists():\n        checkout.parent.mkdir(parents=True, exist_ok=True)\n        _git([\"init\", str(checkout)])\n        _git(\n            [\"remote\", \"add\", \"origin\", f\"https://github.com/{case['repo']}.git\"],\n            cwd=checkout,\n        )\n        _git(\n            [\"fetch\", \"--quiet\", \"--depth=1\", \"--no-tags\", \"origin\", case[\"base_commit\"]],\n            cwd=checkout,\n        )\n        _git([\"checkout\", \"--quiet\", \"--detach\", \"FETCH_HEAD\"], cwd=checkout)\n    inspected = _inspect_checkout(checkout, case)\n    return {\n        **inspected,\n        \"checkout_relative_path\": f\"cases/{case['id']}\",\n    }\n\n\ndef _validate_judgments(checkout: Path, judgments: Sequence[dict[str, Any]]) -> None:\n    tracked_raw = subprocess.check_output([\"git\", \"-C\", str(checkout), \"ls-files\", \"-z\"])\n    tracked = {\n        value.decode(\"utf-8\", \"surrogateescape\")\n        for value in tracked_raw.split(b\"\\0\")\n        if value\n    }\n    for judgment in judgments:\n        path = judgment[\"file_path\"]\n        if path not in tracked:\n            raise MaterializationError(f\"sealed judgment path is not tracked: {path}\")\n        target = checkout / path\n        if not target.is_file() or target.is_symlink():\n            raise MaterializationError(f\"sealed judgment path is ambiguous: {path}\")\n        try:\n            line_count = len(target.read_text(encoding=\"utf-8\").splitlines())\n        except (OSError, UnicodeDecodeError) as error:\n            raise MaterializationError(f\"sealed judgment path is not UTF-8 text: {path}\") from error\n        if not (\n            type(judgment[\"start_line\"]) is int\n            and type(judgment[\"end_line\"]) is int\n            and 1 <= judgment[\"start_line\"] <= judgment[\"end_line\"] <= line_count\n        ):\n            raise MaterializationError(f\"sealed judgment lines are outside base snapshot: {path}\")\n\n\ndef _select_cases(\n    source_rows: Iterable[dict[str, Any]], repositories: Sequence[dict[str, Any]]\n) -> tuple[list[dict[str, Any]], dict[str, int], dict[str, int]]:\n    selected_by_repo = {row[\"normalized_repo\"]: row for row in repositories}\n    raw_counts: Counter[str] = Counter()\n    exclusion_counts: Counter[str] = Counter()\n    eligible: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    source_ids: set[str] = set()\n    for raw in source_rows:\n        try:\n            normalized = normalize_repo(raw.get(\"repo\"))\n        except MaterializationError as error:\n            raise MaterializationError(\"filtered source contains a malformed repository\") from error\n        if normalized not in selected_by_repo:\n            raise MaterializationError(\"source reader returned a non-cohort repository\")\n        raw_counts[normalized] += 1\n        case, reason = _eligible_case(raw)\n        if case is None:\n            exclusion_counts[reason or \"unknown\"] += 1\n            continue\n        source = case[\"source\"]\n        if source[\"instance_id\"] in source_ids:\n            raise MaterializationError(\"source contains a duplicate instance_id\")\n        source_ids.add(source[\"instance_id\"])\n        cohort = selected_by_repo[normalized]\n        if source[\"language\"] != cohort[\"language\"]:\n            raise MaterializationError(\"source language differs from cohort language\")\n        eligible[normalized].append(case)\n\n    selected: list[dict[str, Any]] = []\n    for cohort in repositories:\n        normalized = cohort[\"normalized_repo\"]\n        count = raw_counts[normalized]\n        for count_field in (\"instance_count\", \"source_instance_count\"):\n            if count_field in cohort and cohort[count_field] != count:\n                raise MaterializationError(\"cohort source instance count mismatch\")\n        rows = eligible.get(normalized, [])\n        if not rows:\n            raise MaterializationError(\n                f\"selected repository has no structurally eligible case: {cohort['repo']}\"\n            )\n        rows.sort(\n            key=lambda row: _case_rank(normalized, row[\"source\"][\"instance_id\"])\n        )\n        chosen = rows[0]\n        source = chosen[\"source\"]\n        selected.append(\n            {\n                **chosen,\n                \"id\": _public_case_id(source[\"instance_id\"]),\n                \"repo\": cohort[\"repo\"],\n                \"normalized_repo\": normalized,\n                \"language\": cohort[\"language\"],\n                \"base_commit\": source[\"base_commit\"],\n            }\n        )\n    return selected, dict(sorted(raw_counts.items())), dict(sorted(exclusion_counts.items()))\n\n\ndef _checkout_projection(case: dict[str, Any]) -> dict[str, Any]:\n    return {\n        field: case[field]\n        for field in (\n            \"id\",\n            \"repo\",\n            \"normalized_repo\",\n            \"base_commit\",\n            \"base_tree\",\n            \"checkout_relative_path\",\n            \"source_record_sha256\",\n            \"query_record_sha256\",\n        )\n    }\n\n\ndef build_artifacts(\n    *,\n    cohort: dict[str, Any],\n    cohort_sha256: str,\n    source_rows: Iterable[dict[str, Any]],\n    source_row_count: int,\n    checkouts_dir: Path,\n    checkout_provider: CheckoutProvider = ensure_checkout,\n    parquet_file_name: str = \"source.parquet\",\n) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:\n    artifacts.require_sha256(cohort_sha256, \"cohort_sha256\")\n    if _sha256_json(cohort) != cohort_sha256:\n        raise MaterializationError(\"cohort document hash mismatch\")\n    repositories = _validate_cohort(cohort)\n    selected, raw_counts, exclusion_counts = _select_cases(source_rows, repositories)\n    if type(source_row_count) is not int or source_row_count < sum(raw_counts.values()):\n        raise MaterializationError(\"source row count is invalid\")\n\n    materialized: list[dict[str, Any]] = []\n    for case in selected:\n        checkout = checkout_provider(Path(checkouts_dir), case)\n        required_checkout = {\n            \"path\",\n            \"commit\",\n            \"tree\",\n            \"tracked_files\",\n            \"checkout_relative_path\",\n        }\n        if type(checkout) is not dict or not required_checkout <= set(checkout):\n            raise MaterializationError(\"checkout provider returned a malformed binding\")\n        if checkout[\"commit\"] != case[\"base_commit\"] or COMMIT_RE.fullmatch(\n            str(checkout[\"tree\"])\n        ) is None:\n            raise MaterializationError(\"checkout provider returned the wrong snapshot\")\n        if type(checkout[\"tracked_files\"]) is not int or checkout[\"tracked_files\"] < 1:\n            raise MaterializationError(\"checkout contains no tracked files\")\n        _validate_judgments(Path(checkout[\"path\"]), case[\"judgments\"])\n        materialized.append(\n            {\n                **case,\n                \"base_tree\": checkout[\"tree\"],\n                \"tracked_files\": checkout[\"tracked_files\"],\n                \"checkout_relative_path\": checkout[\"checkout_relative_path\"],\n            }\n        )\n    materialized.sort(key=lambda row: row[\"id\"])\n\n    flags = _authority_flags()\n    source = _source_descriptor(parquet_file_name)\n    public_cases: list[dict[str, Any]] = []\n    sealed_cases: list[dict[str, Any]] = []\n    for case in materialized:\n        source_row = case[\"source\"]\n        issue = source_row[\"problem_statement\"].strip()\n        common = {\n            \"id\": case[\"id\"],\n            \"repo\": case[\"repo\"],\n            \"normalized_repo\": case[\"normalized_repo\"],\n            \"language\": case[\"language\"],\n            \"base_commit\": case[\"base_commit\"],\n            \"base_tree\": case[\"base_tree\"],\n            \"checkout_relative_path\": case[\"checkout_relative_path\"],\n            \"source_record_sha256\": case[\"source_record_sha256\"],\n            \"query_record_sha256\": case[\"query_record_sha256\"],\n        }\n        instruction = (\n            \"Read-only issue analysis. Identify the most likely source files and code \"\n            \"regions involved, and explain a plausible implementation path. Do not edit \"\n            \"files, produce a patch, or claim the issue is fixed.\"\n        )\n        public_cases.append(\n            {\n                **common,\n                \"created_at\": source_row[\"created_at\"],\n                \"tracked_files\": case[\"tracked_files\"],\n                \"issue_text_sha256\": hashlib.sha256(issue.encode(\"utf-8\")).hexdigest(),\n                \"task\": {\n                    \"kind\": \"read_only_issue_analysis\",\n                    \"instruction\": instruction,\n                    \"issue_text\": issue,\n                    \"prompt\": f\"{instruction}\\n\\nIssue:\\n{issue}\",\n                },\n            }\n        )\n        sealed_cases.append(\n            {\n                **common,\n                \"source_instance_id\": source_row[\"instance_id\"],\n                \"patch_sha256\": case[\"patch_sha256\"],\n                \"judgment_count\": len(case[\"judgments\"]),\n                \"judgments_sha256\": case[\"judgments_sha256\"],\n                \"judgments\": case[\"judgments\"],\n            }\n        )\n\n    selection = {\n        \"algorithm\": \"minimum_sha256_seed_nul_case_nul_normalized_repo_nul_instance_id_v1\",\n        \"seed\": CASE_SELECTION_SEED,\n        \"repository_count\": REPOSITORY_COUNT,\n        \"cases_per_repository\": CASES_PER_REPOSITORY,\n        \"generic_query_and_patch_scope_rules_predeclared\": True,\n        \"selection_completed_before_system_results\": True,\n        \"post_result_resampling_permitted\": False,\n        \"system_output_data_consulted\": False,\n        \"rank_data_consulted\": False,\n        \"score_data_consulted\": False,\n        \"model_or_paid_process_used\": False,\n    }\n    claim_boundary = {\n        \"issue_localization_development_smoke_only\": True,\n        \"source_may_leak_solution_direction\": True,\n        \"code_repair_claim_allowed\": False,\n        \"broad_superiority_claim_allowed\": False,\n        \"confirmatory_claim_allowed\": False,\n    }\n    common_root = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        **flags,\n        \"development_only\": True,\n        \"generator_sha256\": artifacts.sha256_file(Path(__file__)),\n        \"producer_dependency_bindings\": {\n            \"artifact_contract_sha256\": artifacts.sha256_file(Path(artifacts.__file__))\n        },\n        \"cohort_sha256\": cohort_sha256,\n        \"source\": source,\n        \"selection\": selection,\n        \"claim_boundary\": claim_boundary,\n        \"repository_count\": REPOSITORY_COUNT,\n        \"case_count\": len(public_cases),\n    }\n    public = {\n        **common_root,\n        \"stage\": PUBLIC_STAGE,\n        \"agent_visible\": True,\n        \"sealed\": False,\n        \"queries_present\": True,\n        \"qrels_present\": False,\n        \"expected_outcomes_present\": False,\n        \"expected_outcomes_present\": False,\n        \"patches_present\": False,\n        \"repair_oracles_present\": False,\n        \"ranks_present\": False,\n        \"scores_present\": False,\n        \"outcomes_present\": False,\n        \"cases\": public_cases,\n    }\n    sealed = {\n        **common_root,\n        \"stage\": SEALED_STAGE,\n        \"agent_visible\": False,\n        \"sealed\": True,\n        \"queries_present\": False,\n        \"qrels_present\": True,\n        \"patch_content_present\": False,\n        \"patch_derived_judgments_present\": True,\n        \"expected_outcomes_present\": False,\n        \"repair_oracles_present\": False,\n        \"system_ranks_present\": False,\n        \"system_scores_present\": False,\n        \"system_outcomes_present\": False,\n        \"cases\": sealed_cases,\n    }\n    public_sha256 = _sha256_json(public)\n    sealed_sha256 = _sha256_json(sealed)\n    checkout_bindings = sorted(\n        (_checkout_projection(case) for case in materialized), key=lambda row: row[\"id\"]\n    )\n    mapping_counts = {\n        \"cases\": len(materialized),\n        \"repositories\": len({case[\"normalized_repo\"] for case in materialized}),\n        \"patch_derived_regions\": sum(len(case[\"judgments\"]) for case in materialized),\n        \"unique_base_snapshot_paths\": len(\n            {\n                (case[\"id\"], judgment[\"file_path\"])\n                for case in materialized\n                for judgment in case[\"judgments\"]\n            }\n        ),\n        \"missing_base_snapshot_paths\": 0,\n        \"ambiguous_base_snapshot_paths\": 0,\n    }\n    attestation = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": ATTESTATION_STAGE,\n        **flags,\n        \"development_only\": True,\n        \"model_or_paid_process_used\": False,\n        \"cohort_sha256\": cohort_sha256,\n        \"public_tasks_sha256\": public_sha256,\n        \"sealed_controller_sha256\": sealed_sha256,\n        \"source\": {**source, \"source_row_count\": source_row_count},\n        \"selection_seed\": CASE_SELECTION_SEED,\n        \"checkout_binding_sha256\": _sha256_json(checkout_bindings),\n        \"source_record_binding_sha256\": _sha256_json(\n            sorted(case[\"source_record_sha256\"] for case in materialized)\n        ),\n        \"selected_repository_source_row_counts\": raw_counts,\n        \"structural_exclusion_counts\": exclusion_counts,\n        \"mapping_counts\": mapping_counts,\n        \"claim_boundary\": claim_boundary,\n    }\n    validate_public_contract(public)\n    return public, sealed, attestation\n\n\ndef validate_public_contract(document: dict[str, Any]) -> None:\n    if document.get(\"queries_present\") is not True:\n        raise MaterializationError(\"public tasks must carry queries\")\n    for field in (\n        \"qrels_present\",\n        \"expected_outcomes_present\",\n        \"patches_present\",\n        \"repair_oracles_present\",\n        \"ranks_present\",\n        \"scores_present\",\n        \"outcomes_present\",\n    ):\n        if document.get(field) is not False:\n            raise MaterializationError(f\"public task leakage flag is true: {field}\")\n    forbidden = {\n        \"source_instance_id\",\n        \"patch\",\n        \"patch_sha256\",\n        \"judgment_count\",\n        \"judgments\",\n        \"judgments_sha256\",\n        \"locations\",\n        \"expected_answer\",\n        \"touched_paths\",\n    }\n\n    def walk(value: Any) -> None:\n        if type(value) is dict:\n            leaked = set(value) & forbidden\n            if leaked:\n                raise MaterializationError(\n                    \"public tasks contain controller-only keys: \" + \", \".join(sorted(leaked))\n                )\n            for nested in value.values():\n                walk(nested)\n        elif type(value) is list:\n            for nested in value:\n                walk(nested)\n\n    walk(document)\n    if any(document.get(field) is not False for field in AUTHORITY_FIELDS):\n        raise MaterializationError(\"public tasks grant authority\")\n\n\ndef publish_artifacts(\n    public_path: Path,\n    sealed_path: Path,\n    attestation_path: Path,\n    public: dict[str, Any],\n    sealed: dict[str, Any],\n    attestation: dict[str, Any],\n) -> None:\n    paths = [Path(public_path), Path(sealed_path), Path(attestation_path)]\n    if len({path.absolute() for path in paths}) != 3:\n        raise MaterializationError(\"output paths must be distinct\")\n    if any(path.exists() or path.is_symlink() for path in paths):\n        raise MaterializationError(\"refusing to overwrite a materialization artifact\")\n    artifacts.write_new_canonical_json(paths[0], public)\n    artifacts.write_new_canonical_json(paths[1], sealed)\n    artifacts.write_new_canonical_json(paths[2], attestation)\n\n\ndef validate_artifacts(\n    public_path: Path,\n    sealed_path: Path,\n    attestation_path: Path,\n    expected: tuple[dict[str, Any], dict[str, Any], dict[str, Any]],\n) -> None:\n    for path, document, label in zip(\n        (public_path, sealed_path, attestation_path),\n        expected,\n        (\"public tasks\", \"sealed controller\", \"materialization attestation\"),\n        strict=True,\n    ):\n        opened = artifacts.read_canonical_json(Path(path), expected_type=dict)\n        artifacts.validate_exact_document(opened.document, document, label)\n\n\ndef _load_inputs(args: argparse.Namespace, *, allow_checkout_creation: bool) -> tuple[\n    dict[str, Any], str, list[dict[str, Any]], int, CheckoutProvider\n]:\n    cohort_opened = artifacts.read_canonical_json(\n        Path(args.cohort), expected_sha256=args.cohort_sha256, expected_type=dict\n    )\n    repositories = _validate_cohort(cohort_opened.document)\n    parquet_path = Path(args.parquet)\n    if artifacts.sha256_file(parquet_path) != PARQUET_SHA256:\n        raise MaterializationError(\"pinned SWE-rebench V2 parquet hash mismatch\")\n    rows, row_count = _read_selected_parquet_rows(parquet_path, repositories)\n    if allow_checkout_creation:\n        provider = ensure_checkout\n    else:\n        def provider(root: Path, case: dict[str, Any]) -> dict[str, Any]:\n            checkout = root / \"cases\" / case[\"id\"]\n            inspected = _inspect_checkout(checkout, case)\n            return {\n                **inspected,\n                \"checkout_relative_path\": f\"cases/{case['id']}\",\n            }\n    return cohort_opened.document, cohort_opened.sha256, rows, row_count, provider\n\n\ndef _build_from_args(\n    args: argparse.Namespace, *, allow_checkout_creation: bool\n) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:\n    cohort, cohort_sha, rows, row_count, provider = _load_inputs(\n        args, allow_checkout_creation=allow_checkout_creation\n    )\n    return build_artifacts(\n        cohort=cohort,\n        cohort_sha256=cohort_sha,\n        source_rows=rows,\n        source_row_count=row_count,\n        checkouts_dir=Path(args.checkouts_dir),\n        checkout_provider=provider,\n        parquet_file_name=Path(args.parquet).name,\n    )\n\n\ndef _common_arguments(parser: argparse.ArgumentParser) -> None:\n    parser.add_argument(\"--cohort\", type=Path, required=True)\n    parser.add_argument(\"--cohort-sha256\", required=True)\n    parser.add_argument(\"--parquet\", type=Path, required=True)\n    parser.add_argument(\"--checkouts-dir\", type=Path, default=DEFAULT_CHECKOUTS_DIR)\n    parser.add_argument(\"--public-output\", type=Path, default=DEFAULT_PUBLIC_OUTPUT)\n    parser.add_argument(\"--sealed-output\", type=Path, default=DEFAULT_SEALED_OUTPUT)\n    parser.add_argument(\"--attestation-output\", type=Path, default=DEFAULT_ATTESTATION_OUTPUT)\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=__doc__)\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n    materialize = commands.add_parser(\"materialize\")\n    _common_arguments(materialize)\n    validate = commands.add_parser(\"validate\")\n    _common_arguments(validate)\n    return parser\n\n\ndef main(argv: Sequence[str] | None = None) -> int:\n    args = build_parser().parse_args(argv)\n    try:\n        expected = _build_from_args(\n            args, allow_checkout_creation=args.command == \"materialize\"\n        )\n        if args.command == \"materialize\":\n            publish_artifacts(\n                args.public_output,\n                args.sealed_output,\n                args.attestation_output,\n                *expected,\n            )\n        else:\n            validate_artifacts(\n                args.public_output,\n                args.sealed_output,\n                args.attestation_output,\n                expected,\n            )\n        summary = {\n            \"valid\": True,\n            \"suite\": SUITE,\n            \"repositories\": REPOSITORY_COUNT,\n            \"cases\": REPOSITORY_COUNT,\n            \"patch_derived_regions\": expected[2][\"mapping_counts\"][\n                \"patch_derived_regions\"\n            ],\n            \"model_or_paid_process_used\": False,\n        }\n        print(json.dumps(summary, sort_keys=True, separators=(\",\", \":\")))\n    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError) as error:\n        print(f\"error: {error}\", file=sys.stderr)\n        return 1\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
