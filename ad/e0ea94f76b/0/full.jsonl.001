{"timestamp":"2026-07-18T18:32:38.395Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7680-76fb-7e21-a8bd-78d9d1898557","call_id":"call_TK4MCA4ZuJrcnLhVuwr1Xrn2","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"    freeze.add_argument(\"--max-total-budget-usd\", required=True)\n    freeze.add_argument(\"--input-price\", required=True)\n    freeze.add_argument(\"--output-price\", required=True)\n    freeze.add_argument(\"--cache-creation-5m-price\", required=True)\n    freeze.add_argument(\"--cache-creation-1h-price\", required=True)\n    freeze.add_argument(\"--cache-read-price\", required=True)\n    freeze.add_argument(\"--pricing-source-url\", required=True)\n    freeze.add_argument(\"--pricing-effective-date\", required=True)\n    freeze.add_argument(\"--pricing-service-tier\", required=True)\n    freeze.add_argument(\"--runtime-path-prefix\", default=\"\")\n\n    authorize = subparsers.add_parser(\n        \"authorize\", help=\"write the safe false execution-authorization default\",\n    )\n    authorize.add_argument(\"--freeze\", type=Path, required=True)\n    authorize.add_argument(\"--output\", type=Path, required=True)\n    authorize.add_argument(\"--authorization-note\", required=True)\n\n    validate = subparsers.add_parser(\"validate\", help=\"recompute all unpaid freeze bindings\")\n    validate.add_argument(\"--freeze\", type=Path, required=True)\n\n    check = subparsers.add_parser(\"preflight\", help=\"validate exact bindings and isolated namespaces\")\n    check.add_argument(\"--freeze\", type=Path, required=True)\n    check.add_argument(\"--authorization\", type=Path, required=True)\n    check.add_argument(\"--authorization-sha256\")\n    check.add_argument(\"--output\", type=Path)\n\n    run = subparsers.add_parser(\n        \"run\", help=\"run the exact gated sequential Claude Code adapter\",\n    )\n    run.add_argument(\"--freeze\", type=Path, required=True)\n    run.add_argument(\"--authorization\", type=Path, required=True)\n    run.add_argument(\"--authorization-sha256\", required=True)\n    run.add_argument(\"--preflight\", type=Path, required=True)\n    run.add_argument(\"--preflight-sha256\", required=True)\n    run.add_argument(\"--output\", type=Path, required=True)\n\n    broker = subparsers.add_parser(\n        \"graph-broker\", help=argparse.SUPPRESS,\n    )\n    broker.add_argument(\"--graph-binary\", type=Path, required=True)\n    broker.add_argument(\"--checkout\", type=Path, required=True)\n    broker.add_argument(\"--cache-dir\", type=Path, required=True)\n    broker.add_argument(\"--commit\", required=True)\n    broker.add_argument(\"--tree\", required=True)\n    broker.add_argument(\"--timeout-seconds\", type=int, required=True)\n    return parser\n\n\ndef main(argv: list[str] | None = None) -> int:\n    args = build_parser().parse_args(argv)\n    try:\n        if args.command == \"graph-broker\":\n            return _serve_graph_broker(args)\n        if args.command == \"freeze\":\n            freeze_execution(\n                public_manifest=args.public_manifest,\n                sealed_oracle=args.sealed_oracle,\n                cohort=args.cohort,\n                materialization_attestation=args.materialization_attestation,\n                materialized_root=args.materialized_root,\n                product_source=args.product_source,\n                graph_binary=args.graph_binary,\n                cbm_binary=args.cbm_binary,\n                agent_binary=args.agent_binary,\n                go_binary=args.go_binary,\n                cache_root=args.cache_root,\n                output=args.output,\n                model=args.model,\n                max_turns=args.max_turns,\n                timeout_seconds=args.timeout_seconds,\n                prices=_prices_from_args(args),\n                max_budget_usd_per_attempt=args.max_budget_usd_per_attempt,\n                max_total_budget_usd=args.max_total_budget_usd,\n                repetition_count=args.repetition_count,\n                runtime_path_prefix=args.runtime_path_prefix,\n                pricing_source_url=args.pricing_source_url,\n                pricing_effective_date=args.pricing_effective_date,\n                pricing_service_tier=args.pricing_service_tier,\n            )\n            authorization_output = args.authorization_output or args.output.with_name(\n                \"execution-authorization.json\"\n            )\n            create_execution_authorization(args.output, authorization_output)\n        elif args.command == \"authorize\":\n            create_execution_authorization(\n                args.freeze,\n                args.output,\n                authorization_note=args.authorization_note,\n            )\n        elif args.command == \"validate\":\n            document = validate_execution_freeze(args.freeze)\n            print(json.dumps({\n                \"status\": \"valid\",\n                \"execution_freeze_sha256\": artifacts.sha256_file(args.freeze),\n                \"planned_attempt_count\": document[\"schedule\"][\"paid_attempt_count_if_separately_authorized\"],\n            }, sort_keys=True))\n        elif args.command == \"preflight\":\n            report = preflight(\n                args.freeze,\n                args.authorization,\n                expected_authorization_sha256=args.authorization_sha256,\n                output=args.output,\n            )\n            print(json.dumps(report, sort_keys=True))\n        elif args.command == \"run\":\n            aggregate = run_authorized(\n                args.freeze,\n                args.authorization,\n                args.preflight,\n                args.output,\n                expected_authorization_sha256=args.authorization_sha256,\n                expected_preflight_sha256=args.preflight_sha256,\n            )\n            print(json.dumps({\n                \"status\": \"complete\",\n                \"attempt_count\": aggregate[\"attempt_count\"],\n                \"attempt_results_sha256\": artifacts.sha256_file(\n                    args.output / \"attempt-results.json\"\n                ),\n            }, sort_keys=True))\n        return 0\n    except (\n        IssueAnalysisError,\n        artifacts.ArtifactValidationError,\n        smoke.SmokeError,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
