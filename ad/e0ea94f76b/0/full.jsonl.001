{"timestamp":"2026-07-18T16:06:21.436Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5ba47d6f4c81919150b09707a8cc4c","status":"completed","call_id":"call_sZI9mCMdIP3G6a5thVAAU29S","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"python3 - <<'PY'\\nimport json\\nfrom pathlib import Path\\nroot=Path('competitive-eval/core-bench')\\nfor name in ('candidate-catalog.json','spike-manifest.json'):\\n d=json.loads((root/name).read_text())\\n print(name, sorted(d))\\n if name=='candidate-catalog.json':\\n  print('repo_count',len(d.get('repositories',[])))\\n  for row in d.get('repositories',[])[:2]: print(sorted(row), row)\\n else:\\n  print('case_count',len(d.get('cases',[])))\\n  for row in d.get('cases',[])[:1]: print(sorted(row), row)\\nPY\\nsed -n '240,620p' competitive-eval/tools/core_bench_graph_spike.py\\nsed -n '1,220p' competitive-eval/tools/test_core_bench_graph_spike.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 50000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:06:21.638Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f75fa-8ac6-78a2-a78b-d68e3f2ac6ec","call_id":"call_sZI9mCMdIP3G6a5thVAAU29S","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"candidate-catalog.json ['core_dataset', 'core_revision', 'minimum_queries', 'repositories', 'schema_version', 'source_dataset', 'source_revision']\nrepo_count 35\n['core_repo_key', 'corpus_count', 'eligible', 'ineligible_reasons', 'language', 'qrel_count', 'query_count', 'repo', 'source_candidates', 'source_dataset_path'] {'core_repo_key': 'BurntSushi__ripgrep', 'corpus_count': 6511, 'eligible': False, 'ineligible_reasons': ['repository_overlap'], 'language': 'Rust', 'qrel_count': 678, 'query_count': 13, 'repo': 'BurntSushi/ripgrep', 'source_candidates': ['rust/BurntSushi__ripgrep_dataset.jsonl'], 'source_dataset_path': 'rust/BurntSushi__ripgrep_dataset.jsonl'}\n['core_repo_key', 'corpus_count', 'eligible', 'ineligible_reasons', 'language', 'qrel_count', 'query_count', 'repo', 'source_candidates', 'source_dataset_path'] {'core_repo_key': 'Kong__insomnia', 'corpus_count': 3615, 'eligible': False, 'ineligible_reasons': ['fewer_than_three_queries'], 'language': 'JavaScript', 'qrel_count': 1, 'query_count': 1, 'repo': 'Kong/insomnia', 'source_candidates': ['js/Kong__insomnia_dataset.jsonl'], 'source_dataset_path': 'js/Kong__insomnia_dataset.jsonl'}\nspike-manifest.json ['cases', 'freeze_status', 'repositories', 'schema_version', 'sealed_policy', 'selection', 'sources', 'suite']\ncase_count 24\n['base_commit', 'candidate_corpus_count', 'candidate_corpus_ids_sha256', 'core_qrels_path', 'core_queries_path', 'id', 'issue_text', 'language', 'normalized_repo', 'pull_request_metadata_sha256', 'pull_request_number', 'pull_request_url', 'qrel_row_count', 'qrels_sha256', 'query_record_sha256', 'relevant_corpus_count', 'repo', 'role', 'source_dataset_path'] {'base_commit': '6648b96c0162c222467eb44bac30a9d59392c7ff', 'candidate_corpus_count': 41403, 'candidate_corpus_ids_sha256': 'f2a5aaff86b6af5185b31cabfb629fdc63d4aa1936c86c6216390ee955f936b8', 'core_qrels_path': 'data/LEVEL-2/Multi-SWE-bench/alibaba__fastjson2/qrels.jsonl', 'core_queries_path': 'data/LEVEL-2/Multi-SWE-bench/alibaba__fastjson2/queries.jsonl', 'id': 'alibaba__fastjson2-1245', 'issue_text': \"#1244 fix EnumSet deserialization fail ### What this PR does / why we need it?\\r\\nfix #1244 EnumSet deserialization fail\\r\\n\\r\\n### Summary of your change\\r\\n\\r\\n\\r\\n\\r\\n#### Please indicate you've done the following:\\r\\n\\r\\n- [ ] Made sure tests are passing and test coverage is added if needed.\\r\\n- [ ] Made sure commit message follow the rule of [Conventional Commits specification](https://www.conventionalcommits.org/).\\r\\n- [ ] Considered the docs impact and opened a new docs issue or PR with docs changes if needed.\\r\\n\", 'language': 'Java', 'normalized_repo': 'alibaba/fastjson2', 'pull_request_metadata_sha256': '4d423e21488d5fe564434f3e4941a184bac1e5f7470d189d4554f24a2e704467', 'pull_request_number': 1245, 'pull_request_url': 'https://github.com/alibaba/fastjson2/pull/1245', 'qrel_row_count': 2, 'qrels_sha256': 'b89087e62333b3dfce1f070f5cba3c72de3034aaf58e624ca78686781f5fdaa8', 'query_record_sha256': 'f13bcbbc6d0f3bcdcf822ed3b3f377f8bec909cd960257c2e0bc3338cac5fd21', 'relevant_corpus_count': 2, 'repo': 'alibaba/fastjson2', 'role': 'development', 'source_dataset_path': 'java/alibaba__fastjson2_dataset.jsonl'}\n            add_exclusion(reasons, row[\"url\"], \"fidelity_corpus\")\n\n    breadth = load_json(breadth_path)\n    for repos in breadth[\"languages\"].values():\n        for repo in repos:\n            add_exclusion(reasons, repo, \"entire_graph_breadth_240\")\n\n    implementation_repos = [\n        \"ashtom/entire-brain\",\n        \"ashtom/entire-plan\",\n        \"entirehq/brain-bench\",\n        \"entireio/entire-brain\",\n        \"entireio/entire-graph\",\n    ]\n    for repo in implementation_repos:\n        add_exclusion(reasons, repo, \"entire_implementation\")\n\n    source_files = [\n        {\n            \"id\": \"fixed_answer_81\",\n            \"path\": \"entire-plan/paper/entire-toolchain/artifacts/fixed-answer-2026-07-11/repositories.json\",\n            \"sha256\": sha256_file(fixed_path),\n        },\n        {\n            \"id\": \"tasks_81\",\n            \"path\": \"brain-bench/competitive-eval/tasks/*/*.json\",\n            \"file_count\": len(task_paths),\n            \"sha256\": digest_file_set(task_paths, ROOT),\n        },\n        {\n            \"id\": \"fidelity_corpus\",\n            \"path\": \"brain-bench/repos*.json\",\n            \"file_count\": len(fidelity_paths),\n            \"sha256\": digest_file_set(fidelity_paths, ROOT),\n        },\n        {\n            \"id\": \"entire_graph_breadth_240\",\n            \"path\": \"entire-graph/bench/repos.json\",\n            \"sha256\": sha256_file(breadth_path),\n        },\n        {\n            \"id\": \"entire_implementation\",\n            \"repositories\": sorted(implementation_repos, key=str.casefold),\n            \"sha256\": sha256_bytes(canonical_json_bytes(sorted(implementation_repos, key=str.casefold))),\n        },\n    ]\n    result = {\n        \"schema_version\": 1,\n        \"normalization\": \"github_owner_repo_casefold_v1\",\n        \"repository_count\": len(reasons),\n        \"sources\": source_files,\n        \"repositories\": [\n            {\"normalized_repo\": repo, \"reasons\": sorted(repo_reasons)}\n            for repo, repo_reasons in sorted(reasons.items())\n        ],\n    }\n    write_json(Path(args.output), result)\n    return result\n\n\ndef source_file_descriptor(path: str) -> dict[str, str]:\n    language_dir, filename = path.split(\"/\", 1)\n    suffix = \"_dataset.jsonl\"\n    if language_dir not in SOURCE_LANGUAGE or not filename.endswith(suffix):\n        raise ValueError(f\"unsupported source dataset path: {path}\")\n    stem = filename[: -len(suffix)]\n    owner, separator, repo = stem.partition(\"__\")\n    if not separator:\n        raise ValueError(f\"source dataset filename has no owner separator: {path}\")\n    return {\n        \"path\": path,\n        \"stem\": stem,\n        \"owner\": owner,\n        \"repo_name\": repo,\n        \"repo\": f\"{owner}/{repo}\",\n        \"language\": SOURCE_LANGUAGE[language_dir],\n    }\n\n\ndef match_source_descriptors(core_repo_key: str, descriptors: list[dict[str, str]]) -> list[dict[str, str]]:\n    folded = core_repo_key.casefold()\n    exact = [row for row in descriptors if row[\"stem\"].casefold() == folded]\n    if exact:\n        return exact\n    if \"__\" in core_repo_key:\n        owner, repo = core_repo_key.split(\"__\", 1)\n        owner_repo = [\n            row\n            for row in descriptors\n            if row[\"owner\"].casefold() == owner.casefold()\n            and (\n                row[\"repo_name\"].casefold() == repo.casefold()\n                or row[\"repo_name\"].casefold().startswith(repo.casefold() + \"-\")\n            )\n        ]\n        if owner_repo:\n            return owner_repo\n    return [row for row in descriptors if row[\"repo_name\"].casefold() == folded]\n\n\ndef build_candidate_catalog(\n    core_manifest: dict[str, Any], source_metadata: dict[str, Any], exclusion_repos: set[str]\n) -> list[dict[str, Any]]:\n    source_paths = [\n        item[\"rfilename\"]\n        for item in source_metadata.get(\"siblings\", [])\n        if item.get(\"rfilename\", \"\").split(\"/\", 1)[0] in SOURCE_LANGUAGE\n        and item.get(\"rfilename\", \"\").endswith(\"_dataset.jsonl\")\n    ]\n    descriptors = [source_file_descriptor(path) for path in source_paths]\n    core_repos = core_manifest[\"levels\"][CORE_LEVEL][\"datasets\"][CORE_SUBDATASET][\"repos\"]\n    catalog = []\n    for core_repo_key, stats in sorted(core_repos.items()):\n        matches = match_source_descriptors(core_repo_key, descriptors)\n        row: dict[str, Any] = {\n            \"core_repo_key\": core_repo_key,\n            \"query_count\": stats[\"queries\"],\n            \"corpus_count\": stats[\"corpus\"],\n            \"qrel_count\": stats[\"qrels\"],\n            \"source_candidates\": [match[\"path\"] for match in matches],\n        }\n        ineligible = []\n        if len(matches) != 1:\n            ineligible.append(\"source_mapping_not_unique\")\n        else:\n            descriptor = matches[0]\n            row.update({key: descriptor[key] for key in (\"repo\", \"language\", \"path\")})\n            row[\"source_dataset_path\"] = row.pop(\"path\")\n            if normalize_repo(descriptor[\"repo\"]) in exclusion_repos:\n                ineligible.append(\"repository_overlap\")\n        if stats[\"queries\"] < MIN_QUERIES_PER_REPOSITORY:\n            ineligible.append(\"fewer_than_three_queries\")\n        row[\"eligible\"] = not ineligible\n        row[\"ineligible_reasons\"] = ineligible\n        catalog.append(row)\n    return catalog\n\n\ndef select_repositories(catalog: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    eligible = [row for row in catalog if row[\"eligible\"]]\n    by_language: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for row in eligible:\n        by_language[row[\"language\"]].append(row)\n    if len(by_language) < 4:\n        raise ValueError(f\"only {len(by_language)} eligible languages; at least four required\")\n\n    selected: list[dict[str, Any]] = []\n    language_order = sorted(by_language, key=lambda language: rank_key(\"language\", language))\n    for language in language_order[:REPOSITORY_COUNT]:\n        selected.append(\n            min(by_language[language], key=lambda row: rank_key(f\"language-repo:{language}\", row[\"repo\"]))\n        )\n    selected_repos = {row[\"repo\"] for row in selected}\n    remaining = [row for row in eligible if row[\"repo\"] not in selected_repos]\n    remaining.sort(key=lambda row: rank_key(\"fill-repository\", row[\"repo\"]))\n    selected.extend(remaining[: max(0, REPOSITORY_COUNT - len(selected))])\n    if len(selected) != REPOSITORY_COUNT:\n        raise ValueError(f\"selected {len(selected)} repositories, expected {REPOSITORY_COUNT}\")\n\n    development = {\n        row[\"repo\"]\n        for row in sorted(selected, key=lambda row: rank_key(\"development-role\", row[\"repo\"]))[\n            :DEVELOPMENT_REPOSITORIES\n        ]\n    }\n    return [\n        {**row, \"role\": \"development\" if row[\"repo\"] in development else \"sealed\"}\n        for row in sorted(selected, key=lambda row: row[\"repo\"].casefold())\n    ]\n\n\ndef canonical_row_hash(row: dict[str, Any]) -> str:\n    return sha256_bytes(canonical_json_bytes(row))\n\n\ndef freeze_manifest(args: argparse.Namespace) -> dict[str, Any]:\n    exclusions_path = Path(args.exclusions)\n    exclusions = load_json(exclusions_path)\n    exclusion_repos = {row[\"normalized_repo\"] for row in exclusions[\"repositories\"]}\n    fetcher = PinnedFetcher(Path(args.cache_dir))\n\n    core_metadata, core_metadata_hash = fetcher.metadata(\"core-bench\", CORE_DATASET, CORE_REVISION)\n    source_metadata, source_metadata_hash = fetcher.metadata(\n        \"multi-swe-bench\", SOURCE_DATASET, SOURCE_REVISION\n    )\n    core_manifest_path = \"manifest.json\"\n    core_manifest_cache = fetcher.dataset_file(\n        \"core-bench\", CORE_DATASET, CORE_REVISION, core_manifest_path\n    )\n    core_manifest = load_json(core_manifest_cache)\n\n    catalog = build_candidate_catalog(core_manifest, source_metadata, exclusion_repos)\n    catalog_doc = {\n        \"schema_version\": 1,\n        \"core_dataset\": CORE_DATASET,\n        \"core_revision\": CORE_REVISION,\n        \"source_dataset\": SOURCE_DATASET,\n        \"source_revision\": SOURCE_REVISION,\n        \"minimum_queries\": MIN_QUERIES_PER_REPOSITORY,\n        \"repositories\": catalog,\n    }\n    write_json(Path(args.catalog), catalog_doc)\n    selected = select_repositories(catalog)\n\n    selected_repositories = []\n    selected_cases = []\n    selected_source_paths: set[str] = set()\n    github_file_hashes: dict[str, str] = {}\n    core_file_hashes: dict[str, str] = {core_manifest_path: sha256_file(core_manifest_cache)}\n    for repo in selected:\n        core_prefix = f\"data/{CORE_LEVEL}/{CORE_SUBDATASET}/{repo['core_repo_key']}\"\n        queries_path = f\"{core_prefix}/queries.jsonl\"\n        qrels_path = f\"{core_prefix}/qrels.jsonl\"\n        queries_cache = fetcher.dataset_file(\n            \"core-bench\", CORE_DATASET, CORE_REVISION, queries_path\n        )\n        qrels_cache = fetcher.dataset_file(\"core-bench\", CORE_DATASET, CORE_REVISION, qrels_path)\n        core_file_hashes[queries_path] = sha256_file(queries_cache)\n        core_file_hashes[qrels_path] = sha256_file(qrels_cache)\n        query_count, chosen_queries = select_query_rows(\n            queries_cache, repo[\"repo\"], QUERIES_PER_REPOSITORY\n        )\n        if query_count != repo[\"query_count\"]:\n            raise ValueError(\n                f\"{repo['repo']} query count {query_count} != manifest {repo['query_count']}\"\n            )\n        chosen_ids = {row[\"_id\"] for row in chosen_queries}\n\n        source_path = repo[\"source_dataset_path\"]\n        selected_source_paths.add(source_path)\n\n        qrels_by_query: dict[str, list[dict[str, Any]]] = defaultdict(list)\n        for row in iter_jsonl_path(qrels_cache):\n            if row.get(\"query_id\") in chosen_ids:\n                qrels_by_query[row[\"query_id\"]].append(row)\n\n        selected_repositories.append(\n            {\n                \"repo\": repo[\"repo\"],\n                \"normalized_repo\": normalize_repo(repo[\"repo\"]),\n                \"language\": repo[\"language\"],\n                \"role\": repo[\"role\"],\n                \"core_repo_key\": repo[\"core_repo_key\"],\n                \"core_repo_path\": core_prefix,\n                \"source_dataset_path\": source_path,\n                \"available_queries\": repo[\"query_count\"],\n                \"selected_query_ids\": sorted(chosen_ids),\n            }\n        )\n        for query in sorted(chosen_queries, key=lambda row: row[\"_id\"]):\n            query_id = query[\"_id\"]\n            number_match = re.search(r\"-(\\d+)$\", query_id)\n            if not number_match:\n                raise ValueError(f\"cannot derive pull request number from {query_id}\")\n            pull_number = int(number_match.group(1))\n            pull, pull_cache = fetcher.github_pull_request(repo[\"repo\"], pull_number)\n            github_path = f\"{repo['repo']}/{pull_number}.json\"\n            github_file_hashes[github_path] = sha256_file(pull_cache)\n            source_repo = ((pull.get(\"base\") or {}).get(\"repo\") or {}).get(\"full_name\") or \"\"\n            if normalize_repo(source_repo) != normalize_repo(repo[\"repo\"]):\n                raise ValueError(\n                    f\"{query_id} pull-request repository {source_repo} does not match selected {repo['repo']}\"\n                )\n            base_commit = ((pull.get(\"base\") or {}).get(\"sha\") or \"\").strip()\n            if not re.fullmatch(r\"[0-9a-fA-F]{40}\", base_commit):\n                raise ValueError(f\"{query_id} has invalid base commit {base_commit!r}\")\n            pull_projection = {\n                \"number\": pull.get(\"number\"),\n                \"html_url\": pull.get(\"html_url\"),\n                \"state\": pull.get(\"state\"),\n                \"merged_at\": pull.get(\"merged_at\"),\n                \"base_repo\": source_repo,\n                \"base_sha\": base_commit.lower(),\n                \"head_sha\": ((pull.get(\"head\") or {}).get(\"sha\") or \"\").lower(),\n            }\n            filtered = query.get(\"filtered_corpus_id\")\n            if not isinstance(filtered, list) or not filtered:\n                raise ValueError(f\"{query_id} has no candidate corpus IDs\")\n            qrels = sorted(\n                qrels_by_query.get(query_id, []), key=lambda row: (row[\"corpus_id\"], row.get(\"score\", 0))\n            )\n            if not qrels:\n                raise ValueError(f\"{query_id} has no qrels\")\n            candidate_ids = set(filtered)\n            missing_qrels = sorted({row[\"corpus_id\"] for row in qrels} - candidate_ids)\n            if missing_qrels:\n                raise ValueError(f\"{query_id} qrels outside candidate set: {missing_qrels[:5]}\")\n            selected_cases.append(\n                {\n                    \"id\": query_id,\n                    \"repo\": source_repo,\n                    \"normalized_repo\": normalize_repo(source_repo),\n                    \"language\": repo[\"language\"],\n                    \"role\": repo[\"role\"],\n                    \"base_commit\": base_commit.lower(),\n                    \"pull_request_number\": pull_number,\n                    \"pull_request_url\": pull.get(\"html_url\"),\n                    \"issue_text\": query.get(\"text\", \"\"),\n                    \"query_record_sha256\": canonical_row_hash(query),\n                    \"pull_request_metadata_sha256\": canonical_row_hash(pull_projection),\n                    \"candidate_corpus_count\": len(filtered),\n                    \"candidate_corpus_ids_sha256\": sha256_bytes(canonical_json_bytes(sorted(filtered))),\n                    \"qrel_row_count\": len(qrels),\n                    \"relevant_corpus_count\": len({row[\"corpus_id\"] for row in qrels}),\n                    \"qrels_sha256\": sha256_bytes(canonical_json_bytes(qrels)),\n                    \"core_queries_path\": queries_path,\n                    \"core_qrels_path\": qrels_path,\n                    \"source_dataset_path\": source_path,\n                }\n            )\n\n    manifest = {\n        \"schema_version\": 1,\n        \"suite\": \"core_bench_level2_feasibility_spike\",\n        \"freeze_status\": \"selected_before_system_adapter_implementation\",\n        \"sources\": {\n            \"core_bench\": {\n                \"dataset\": CORE_DATASET,\n                \"revision\": CORE_REVISION,\n                \"api_metadata_sha256\": core_metadata_hash,\n                \"files\": [\n                    {\"path\": path, \"sha256\": digest} for path, digest in sorted(core_file_hashes.items())\n                ],\n            },\n            \"multi_swe_bench\": {\n                \"dataset\": SOURCE_DATASET,\n                \"revision\": SOURCE_REVISION,\n                \"api_metadata_sha256\": source_metadata_hash,\n                \"selected_source_paths\": sorted(selected_source_paths),\n                \"note\": \"Paths identify upstream repositories; embedded patch files are not downloaded.\",\n            },\n            \"github_pull_requests\": {\n                \"api_version\": \"2022-11-28\",\n                \"files\": [\n                    {\"path\": path, \"sha256\": digest}\n                    for path, digest in sorted(github_file_hashes.items())\n                ],\n            },\n        },\n        \"selection\": {\n            \"algorithm\": \"sha256_language_stratified_v1\",\n            \"seed\": SELECTION_SEED,\n            \"source_level\": CORE_LEVEL,\n            \"source_subdataset\": CORE_SUBDATASET,\n            \"repository_count\": REPOSITORY_COUNT,\n            \"queries_per_repository\": QUERIES_PER_REPOSITORY,\n            \"development_repository_count\": DEVELOPMENT_REPOSITORIES,\n            \"minimum_queries_per_repository\": MIN_QUERIES_PER_REPOSITORY,\n            \"candidate_catalog_sha256\": sha256_bytes(canonical_json_bytes(catalog_doc)),\n            \"exclusions_sha256\": sha256_file(exclusions_path),\n            \"eligible_repository_count\": sum(row[\"eligible\"] for row in catalog),\n            \"eligible_languages\": sorted({row[\"language\"] for row in catalog if row[\"eligible\"]}),\n        },\n        \"repositories\": selected_repositories,\n        \"cases\": sorted(selected_cases, key=lambda row: row[\"id\"]),\n        \"sealed_policy\": {\n            \"development_repositories\": DEVELOPMENT_REPOSITORIES,\n            \"sealed_repositories\": REPOSITORY_COUNT - DEVELOPMENT_REPOSITORIES,\n            \"qrels_forbidden_to_systems\": True,\n            \"repository_specific_adapter_logic_forbidden\": True,\n            \"sealed_output_may_not_change_protocol\": True,\n        },\n    }\n    validate_manifest_data(manifest, exclusions)\n    write_json(Path(args.output), manifest)\n    return manifest\n\n\ndef validate_manifest_data(manifest: dict[str, Any], exclusions: dict[str, Any]) -> None:\n    if manifest.get(\"suite\") != \"core_bench_level2_feasibility_spike\":\n        raise ValueError(\"unexpected suite\")\n    repos = manifest.get(\"repositories\", [])\n    cases = manifest.get(\"cases\", [])\n    if len(repos) != REPOSITORY_COUNT:\n        raise ValueError(f\"manifest has {len(repos)} repositories\")\n    if len(cases) != REPOSITORY_COUNT * QUERIES_PER_REPOSITORY:\n        raise ValueError(f\"manifest has {len(cases)} cases\")\n    if len({row[\"normalized_repo\"] for row in repos}) != len(repos):\n        raise ValueError(\"duplicate selected repository\")\n    if len({row[\"id\"] for row in cases}) != len(cases):\n        raise ValueError(\"duplicate selected case\")\nsed: competitive-eval/tools/test_core_bench_graph_spike.py: No such file or directory\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
