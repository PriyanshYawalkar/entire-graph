{"timestamp":"2026-07-18T16:15:13.009Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5ba690fcc88191b1020a8898947894","status":"completed","call_id":"call_MKokQjbjbx0OX0wHoBYyDyuY","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '1,260p' competitive-eval/tools/run_agentic_issue_analysis_smoke.py && sed -n '260,620p' competitive-eval/tools/run_agentic_issue_analysis_smoke.py && sed -n '620,940p' competitive-eval/tools/run_agentic_issue_analysis_smoke.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 60000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:15:13.194Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7602-a72a-7e60-a556-b84d2b255a5e","call_id":"call_MKokQjbjbx0OX0wHoBYyDyuY","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"#!/usr/bin/env python3\n\"\"\"Freeze and preflight the unpaid agentic issue-analysis smoke protocol.\n\nThis module deliberately does not implement a paid/model execution engine.  A\nfuture execution adapter may only be called through :func:`run_authorized`,\nafter an exact, separately hashed authorization passes every live binding.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nfrom collections import Counter\nfrom decimal import Decimal, InvalidOperation\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nimport run_agentic_tasks_smoke as smoke\n\n\nartifacts = smoke.artifacts\nruntime = smoke.runtime\ncanonical_write = smoke.canonical_write\n\nSUITE = \"entire_graph_agentic_issue_analysis_smoke_v1\"\nFREEZE_STAGE = \"frozen_unpaid_agentic_issue_analysis_execution\"\nAUTHORIZATION_STAGE = \"exact_hash_agentic_issue_analysis_execution_authorization\"\nPREFLIGHT_STAGE = \"unpaid_agentic_issue_analysis_preflight\"\nSYSTEMS = (\"file-tools\", \"entire-graph\", \"cbm\")\nROTATIONS = (\n    SYSTEMS,\n    (\"entire-graph\", \"cbm\", \"file-tools\"),\n    (\"cbm\", \"file-tools\", \"entire-graph\"),\n)\nDEFAULT_REPETITION_COUNT = 1\nMIN_CONFIRMATORY_REPETITIONS = 3\n\nAUTHORITY_FALSE_FIELDS = (\n    \"repair_execution_authorized\",\n    \"confirmatory_execution_authorized\",\n    \"confirmatory_use_allowed\",\n    \"confirmatory_publication_allowed\",\n    \"rank_production_authorized\",\n    \"score_production_authorized\",\n    \"outcome_publication_authorized\",\n)\n\nPUBLIC_MANIFEST_FALSE_FIELDS = (\n    \"catalog_construction\",\n    \"issue_query_construction\",\n    \"controller_scoring\",\n    \"repair_execution\",\n    \"model_execution\",\n    \"paid_execution\",\n    \"confirmatory_execution\",\n    \"confirmatory_use\",\n    \"confirmatory_publication\",\n    \"rank_production\",\n    \"score_production\",\n    \"outcome_publication\",\n    \"queries_present\",\n    \"qrels_present\",\n    \"expected_outcomes_present\",\n    \"repair_oracles_present\",\n    \"ranks_present\",\n    \"scores_present\",\n    \"outcomes_present\",\n)\n\nPRICE_FIELDS = (\n    \"input_tokens_usd_per_million\",\n    \"output_tokens_usd_per_million\",\n    \"cache_creation_input_tokens_usd_per_million\",\n    \"cache_read_input_tokens_usd_per_million\",\n)\n\nTIMING_POLICY = {\n    \"setup_excluded_from_task_timing\": True,\n    \"all_product_setup_completed_before_paid_process\": True,\n    \"task_timer_starts_after_checkout_and_index_validation\": True,\n    \"task_timer_stops_after_model_process_completion\": True,\n    \"setup_wall_time_reported_separately\": True,\n    \"paired_attempts_execute_without_concurrent_setup\": True,\n}\n\nGRAPH_PHASE_TELEMETRY_FIELD_DEFINITIONS = {\n    \"search\": {\n        \"index_cache_hit\": {\n            \"json_path\": \"stats.index_cache_hit\",\n            \"type\": \"boolean\",\n            \"definition\": \"whether the exact committed-tree provider index was reused\",\n        },\n        \"preselect_latency_ms\": {\n            \"json_path\": \"stats.preselect_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"repository file discovery and query-dependent preselection\",\n        },\n        \"index_latency_ms\": {\n            \"json_path\": \"stats.index_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"load or construction of the selected provider index\",\n        },\n        \"query_latency_ms\": {\n            \"json_path\": \"stats.query_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"retrieval and ranking after the provider index is available\",\n        },\n        \"total_latency_ms\": {\n            \"json_path\": \"stats.total_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"end-to-end Graph retrieval latency including preselection, index, and query phases\",\n        },\n    },\n    \"neighbors\": {\n        \"index_cache_hit\": {\n            \"json_path\": \"index_cache_hit\",\n            \"type\": \"boolean\",\n            \"definition\": \"whether the exact committed-tree provider snapshot was reused\",\n        },\n        \"index_latency_ms\": {\n            \"json_path\": \"index_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"load or construction of the provider snapshot\",\n        },\n        \"query_latency_ms\": {\n            \"json_path\": \"query_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"focus matching, adjacency selection, ordering, and bounded path construction\",\n        },\n        \"total_latency_ms\": {\n            \"json_path\": \"total_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"end-to-end Graph retrieval latency including index and neighbor-query phases\",\n        },\n    },\n    \"measurement_rules\": {\n        \"phase_values_are_product_reported\": True,\n        \"setup_index_time_is_not_a_task_phase\": True,\n        \"controller_task_wall_time_is_reported_separately\": True,\n        \"cache_hit_is_required_for_timed_graph_retrieval\": True,\n    },\n}\n\n\nclass IssueAnalysisError(ValueError):\n    \"\"\"Raised when an unpaid freeze or execution binding fails closed.\"\"\"\n\n\ndef _document_sha256(value: Any) -> str:\n    return artifacts.sha256_bytes(artifacts.canonical_bytes(value))\n\n\ndef _write_once_or_match(path: Path, value: dict[str, Any], label: str) -> str:\n    if path.exists():\n        existing = artifacts.read_canonical_json(path, expected_type=dict).document\n        if existing != value:\n            raise IssueAnalysisError(f\"existing {label} differs from the exact frozen document\")\n        return artifacts.sha256_file(path)\n    return canonical_write(path, value)\n\n\ndef _file_binding(path: Path, label: str) -> dict[str, Any]:\n    try:\n        resolved = path.resolve(strict=True)\n        digest = artifacts.sha256_file(resolved)\n    except (OSError, ValueError) as error:\n        raise IssueAnalysisError(f\"{label} is not a stable readable regular file: {path}\") from error\n    return {\"path\": str(resolved), \"sha256\": digest, \"bytes\": resolved.stat().st_size}\n\n\ndef _binary_binding(path: Path, label: str) -> dict[str, Any]:\n    binding = _file_binding(path, label)\n    if not os.access(binding[\"path\"], os.X_OK):\n        raise IssueAnalysisError(f\"{label} is not executable: {binding['path']}\")\n    return binding\n\n\ndef _product_source_binding(path: Path) -> dict[str, Any]:\n    try:\n        source = path.resolve(strict=True)\n    except OSError as error:\n        raise IssueAnalysisError(f\"product source is unavailable: {path}\") from error\n    head = runtime.checked_git([\"rev-parse\", \"HEAD\"], cwd=source).decode().strip()\n    tree = runtime.checked_git([\"rev-parse\", \"HEAD^{tree}\"], cwd=source).decode().strip()\n    status = runtime.checked_git(\n        [\"status\", \"--porcelain=v1\", \"--untracked-files=all\"], cwd=source,\n    )\n    if re.fullmatch(r\"[0-9a-f]{40}\", head) is None or re.fullmatch(r\"[0-9a-f]{40}\", tree) is None:\n        raise IssueAnalysisError(\"product source did not resolve to exact Git head and tree objects\")\n    if status.strip():\n        raise IssueAnalysisError(\"product source must be pristine before its head/tree are frozen\")\n    return {\"path\": str(source), \"head\": head, \"tree\": tree, \"pristine\": True}\n\n\ndef _repository_identity(row: dict[str, Any]) -> str:\n    for field in (\"normalized_repo\", \"repo\", \"repository\"):\n        value = row.get(field)\n        if isinstance(value, str) and value.strip():\n            return value.strip().casefold()\n    raise IssueAnalysisError(\"public manifest repository row lacks a public repository identity\")\n\n\ndef _public_manifest_binding(path: Path) -> dict[str, Any]:\n    artifact = artifacts.read_canonical_json(path, expected_type=dict)\n    manifest = artifact.document\n    if (\n        manifest.get(\"suite\") != SUITE\n        or manifest.get(\"development_only\") is not True\n        or manifest.get(\"repository_count\") != 3\n        or type(manifest.get(\"repositories\")) is not list\n        or len(manifest[\"repositories\"]) != 3\n    ):\n        raise IssueAnalysisError(\"public manifest is not the frozen three-repository development smoke\")\n    for field in PUBLIC_MANIFEST_FALSE_FIELDS:\n        if manifest.get(field) is not False:\n            raise IssueAnalysisError(f\"public manifest must keep {field}=false\")\n    repositories = []\n    for row in manifest[\"repositories\"]:\n        if type(row) is not dict:\n            raise IssueAnalysisError(\"public manifest repository rows must be objects\")\n        repositories.append(_repository_identity(row))\n    if len(set(repositories)) != 3:\n        raise IssueAnalysisError(\"public manifest repositories must be three distinct identities\")\n    return {\n        \"path\": str(path.resolve(strict=True)),\n        \"sha256\": artifact.sha256,\n        \"bytes\": artifact.byte_count,\n        \"repository_ids\": repositories,\n    }\n\n\ndef _decimal_string(value: Any, label: str, *, positive: bool) -> str:\n    try:\n        parsed = Decimal(str(value))\n    except (InvalidOperation, ValueError) as error:\n        raise IssueAnalysisError(f\"{label} must be an exact decimal value\") from error\n    if not parsed.is_finite() or parsed < 0 or (positive and parsed <= 0):\n        comparison = \"positive\" if positive else \"non-negative\"\n        raise IssueAnalysisError(f\"{label} must be finite and {comparison}\")\n    normalized = format(parsed, \"f\")\n    if \".\" in normalized:\n        normalized = normalized.rstrip(\"0\").rstrip(\".\")\n    return normalized or \"0\"\n\n\ndef _pricing(prices: dict[str, Any]) -> dict[str, str]:\n    if type(prices) is not dict or set(prices) != set(PRICE_FIELDS):\n        raise IssueAnalysisError(f\"prices must contain exactly: {', '.join(PRICE_FIELDS)}\")\n    return {\n        field: _decimal_string(prices[field], field, positive=False)\n        field: _decimal_string(prices[field], field, positive=False)\n        for field in PRICE_FIELDS\n    }\n\n\ndef _schedule_seed(\n    *, public_manifest_sha256: str, product: dict[str, Any], binaries: dict[str, Any],\n    model: str, repetition_count: int,\n) -> str:\n    return _document_sha256({\n        \"domain\": \"entire-graph-agentic-issue-analysis-balanced-paired-schedule-v1\",\n        \"public_manifest_sha256\": public_manifest_sha256,\n        \"product_head\": product[\"head\"],\n        \"product_tree\": product[\"tree\"],\n        \"graph_binary_sha256\": binaries[\"entire_graph\"][\"sha256\"],\n        \"cbm_binary_sha256\": binaries[\"cbm\"][\"sha256\"],\n        \"model\": model,\n        \"repetition_count\": repetition_count,\n    })\n\n\ndef build_balanced_schedule(\n    repository_ids: list[str], repetition_count: int, seed_sha256: str,\n) -> dict[str, Any]:\n    if len(repository_ids) != 3 or len(set(repository_ids)) != 3:\n        raise IssueAnalysisError(\"paired schedule requires exactly three distinct repositories\")\n    if type(repetition_count) is not int or repetition_count < 1:\n        raise IssueAnalysisError(\"repetition_count must be a positive integer\")\n    if re.fullmatch(r\"[0-9a-f]{64}\", seed_sha256) is None:\n        raise IssueAnalysisError(\"schedule seed must be an exact SHA-256\")\n    ordered = sorted(\n        repository_ids,\n        key=lambda value: artifacts.sha256_bytes(\n            f\"{seed_sha256}\\0{value}\".encode(\"utf-8\")\n        ),\n    )\n    repository_slot = {repository: index + 1 for index, repository in enumerate(ordered)}\n    rows: list[dict[str, Any]] = []\n    for repetition_index in range(1, repetition_count + 1):\n        offset = (repetition_index - 1) % len(ordered)\n        execution_order = ordered[offset:] + ordered[:offset]\n        for repository in execution_order:\n            slot = repository_slot[repository]\n            rotation = ROTATIONS[(slot - 1 + repetition_index - 1) % len(ROTATIONS)]\n            rows.append({\n                \"pair_index\": len(rows) + 1,\n                \"repository_id\": repository,\n                \"repository_slot\": slot,\n                \"repetition_index\": repetition_index,\n                \"system_order\": list(rotation),\n            })\n    position_counts = {\n        system: [\n            sum(row[\"system_order\"][position] == system for row in rows)\n            for position in range(len(SYSTEMS))\n        ]\n        for system in SYSTEMS\n    }\n    carryover = Counter(\n        (left, right)\n        for row in rows\n        for left, right in zip(row[\"system_order\"], row[\"system_order\"][1:])\n    )\n    expected_position_count = len(rows) // len(SYSTEMS)\n    if any(count != expected_position_count for counts in position_counts.values() for count in counts):\n        raise IssueAnalysisError(\"paired schedule is not exactly system-position balanced\")\n    cyclic_pairs = ((SYSTEMS[0], SYSTEMS[1]), (SYSTEMS[1], SYSTEMS[2]), (SYSTEMS[2], SYSTEMS[0]))\n    if len({carryover[pair] for pair in cyclic_pairs}) != 1 or any(\n        pair not in cyclic_pairs and count for pair, count in carryover.items()\n    ):\n        raise IssueAnalysisError(\"paired schedule is not first-order carryover balanced\")\n    schedule = {\n        \"domain\": \"balanced_three_system_repeated_paired_issue_analysis_v1\",\n        \"seed_sha256\": seed_sha256,\n        \"repetition_count\": repetition_count,\n        \"pair_count\": len(rows),\n        \"paid_attempt_count_if_separately_authorized\": len(rows) * len(SYSTEMS),\n        \"system_position_counts\": position_counts,\n        \"first_order_carryover_counts\": {\n            f\"{left}->{right}\": carryover[(left, right)] for left, right in cyclic_pairs\n        },\n        \"rows\": rows,\n    }\n    schedule[\"schedule_sha256\"] = _document_sha256(schedule)\n    return schedule\n\n\ndef _cache_layout(cache_root: Path, schedule: dict[str, Any]) -> dict[str, Any]:\n    root = cache_root.resolve(strict=False)\n    attempts = []\n    observed: set[str] = set()\n    for row in schedule[\"rows\"]:\n        for system_position, system in enumerate(row[\"system_order\"], start=1):\n            attempt_root = (\n                root / f\"repo-{row['repository_slot']:02d}\"\n                / f\"repeat-{row['repetition_index']:02d}\" / system\n            )\n            paths = {\n                \"home\": str(attempt_root / \"home\"),\n                \"temp\": str(attempt_root / \"temp\"),\n                \"graph_cache\": str(attempt_root / \"graph-cache\"),\n                \"cbm_cache\": str(attempt_root / \"cbm-cache\"),\n            }\n            if observed.intersection(paths.values()):\n                raise IssueAnalysisError(\"attempt cache/home paths are not isolated\")\n            observed.update(paths.values())\n            attempts.append({\n                \"pair_index\": row[\"pair_index\"],\n                \"repository_slot\": row[\"repository_slot\"],\n                \"repetition_index\": row[\"repetition_index\"],\n                \"system\": system,\n                \"system_position\": system_position,\n                **paths,\n            })\n    return {\n        \"root\": str(root),\n        \"scope\": \"unique home, temp, Graph cache, and CBM cache per repository/repetition/system attempt\",\n        \"reuse_across_attempts_allowed\": False,\n        \"attempts\": attempts,\n    }\n\n\ndef _claim_boundary(repetition_count: int) -> dict[str, Any]:\n    return {\n        \"scope\": \"development-only public-issue analysis and retrieval smoke\",\n        \"issue_analysis_claim_allowed\": True,\n        \"code_repair_claim_allowed\": False,\n        \"broad_product_superiority_claim_allowed\": False,\n        \"confirmatory_claim_allowed\": False,\n        \"immediate_repetition_count\": repetition_count,\n        \"minimum_repetitions_for_future_confirmatory_repair_claim\": MIN_CONFIRMATORY_REPETITIONS,\n        \"executable_hidden_tests_required_for_future_confirmatory_repair_claim\": True,\n        \"current_protocol_has_executable_hidden_tests\": False,\n        \"repetition_requirement_satisfied\": repetition_count >= MIN_CONFIRMATORY_REPETITIONS,\n        \"confirmatory_repair_prerequisites_satisfied\": False,\n    }\n\n\ndef freeze_execution(\n    *, public_manifest: Path, sealed_oracle: Path,\n    hmac_disjointness_attestation: Path, product_source: Path,\n    graph_binary: Path, cbm_binary: Path, cache_root: Path, output: Path,\n    model: str, max_turns: int, timeout_seconds: int,\n    prices: dict[str, Any], max_budget_usd_per_attempt: Any,\n    max_total_budget_usd: Any, repetition_count: int = DEFAULT_REPETITION_COUNT,\n) -> dict[str, Any]:\n    \"\"\"Create the canonical unpaid execution freeze without running a model.\"\"\"\n    if not isinstance(model, str) or not model.strip():\n        raise IssueAnalysisError(\"model must be a non-empty exact identifier\")\n    if type(max_turns) is not int or max_turns < 1:\n        raise IssueAnalysisError(\"max_turns must be a positive integer\")\n    if type(timeout_seconds) is not int or timeout_seconds < 1:\n        raise IssueAnalysisError(\"timeout_seconds must be a positive integer\")\n    if type(repetition_count) is not int or repetition_count < 1:\n        raise IssueAnalysisError(\"repetition_count must be a positive integer\")\n\n    public = _public_manifest_binding(public_manifest)\n    product = _product_source_binding(product_source)\n    binaries = {\n        \"entire_graph\": _binary_binding(graph_binary, \"Entire Graph binary\"),\n        \"cbm\": _binary_binding(cbm_binary, \"CBM binary\"),\n    }\n    runner = _file_binding(Path(__file__), \"issue-analysis runner\")\n    frozen_prices = _pricing(prices)\n    seed = _schedule_seed(\n        public_manifest_sha256=public[\"sha256\"], product=product,\n        binaries=binaries, model=model.strip(), repetition_count=repetition_count,\n    )\n    schedule = build_balanced_schedule(public[\"repository_ids\"], repetition_count, seed)\n    per_attempt = _decimal_string(\n        max_budget_usd_per_attempt, \"max_budget_usd_per_attempt\", positive=True,\n    )\n    total_budget = _decimal_string(max_total_budget_usd, \"max_total_budget_usd\", positive=True)\n    theoretical = Decimal(per_attempt) * schedule[\"paid_attempt_count_if_separately_authorized\"]\n    if Decimal(total_budget) > theoretical:\n        raise IssueAnalysisError(\"total budget may not exceed the sum of per-attempt caps\")\n    cache = _cache_layout(cache_root, schedule)\n    cache_path = Path(cache[\"root\"])\n    if cache_path == Path(product[\"path\"]) or cache_path.is_relative_to(Path(product[\"path\"])):\n        raise IssueAnalysisError(\"isolated caches may not live inside the product source checkout\")\n\n    document: dict[str, Any] = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": FREEZE_STAGE,\n        \"development_only\": True,\n        **{field: False for field in AUTHORITY_FALSE_FIELDS},\n        \"inputs\": {\n            \"public_manifest\": public,\n            \"sealed_oracle\": _file_binding(sealed_oracle, \"sealed oracle\"),\n            \"hmac_disjointness_attestation\": _file_binding(\n                hmac_disjointness_attestation, \"HMAC disjointness attestation\",\n            ),\n        },\n        \"product_source\": product,\n        \"binaries\": binaries,\n        \"runner\": runner,\n        \"protocol\": {\n            \"systems\": list(SYSTEMS),\n            \"repository_count\": 3,\n            \"repetition_count\": repetition_count,\n            \"paired_attempts\": True,\n            \"model\": model.strip(),\n            \"max_turns_per_attempt\": max_turns,\n            \"timeout_seconds_per_attempt\": timeout_seconds,\n            \"prices_usd_per_million_tokens\": frozen_prices,\n            \"max_budget_usd_per_attempt\": per_attempt,\n            \"max_total_budget_usd\": total_budget,\n            \"paid_attempt_count_if_separately_authorized\": schedule[\n                \"paid_attempt_count_if_separately_authorized\"\n            ],\n        },\n        \"schedule\": schedule,\n        \"cache_policy\": cache,\n        \"timing_policy\": TIMING_POLICY,\n        \"graph_phase_telemetry_field_definitions\": GRAPH_PHASE_TELEMETRY_FIELD_DEFINITIONS,\n        \"claim_boundary\": _claim_boundary(repetition_count),\n        \"paid_execution_engine_present\": False,\n    }\n    _write_once_or_match(output, document, \"execution freeze\")\n    return document\n\n\ndef _validate_false_authority(document: dict[str, Any]) -> None:\n    for field in AUTHORITY_FALSE_FIELDS:\n        if document.get(field) is not False:\n            raise IssueAnalysisError(f\"execution freeze must keep {field}=false\")\n\n\ndef validate_execution_freeze(path: Path) -> dict[str, Any]:\n    \"\"\"Recompute every live binding in an execution freeze without paid work.\"\"\"\n    document = artifacts.read_canonical_json(path, expected_type=dict).document\n    if (\n        document.get(\"schema_version\") != 1\n        or document.get(\"suite\") != SUITE\n        or document.get(\"stage\") != FREEZE_STAGE\n        or document.get(\"development_only\") is not True\n        or document.get(\"paid_execution_engine_present\") is not False\n    ):\n        raise IssueAnalysisError(\"execution freeze identity or development-only boundary changed\")\n    _validate_false_authority(document)\n    inputs = document.get(\"inputs\")\n    if type(inputs) is not dict:\n        raise IssueAnalysisError(\"execution freeze inputs are malformed\")\n    public = _public_manifest_binding(Path(inputs[\"public_manifest\"][\"path\"]))\n    if public != inputs.get(\"public_manifest\"):\n        raise IssueAnalysisError(\"public manifest binding changed after freeze\")\n    for field, label in (\n        (\"sealed_oracle\", \"sealed oracle\"),\n        (\"hmac_disjointness_attestation\", \"HMAC disjointness attestation\"),\n    ):\n        expected = inputs.get(field)\n        if type(expected) is not dict or _file_binding(Path(expected[\"path\"]), label) != expected:\n            raise IssueAnalysisError(f\"{label} binding changed after freeze\")\n    product = _product_source_binding(Path(document[\"product_source\"][\"path\"]))\n    if product != document.get(\"product_source\"):\n        raise IssueAnalysisError(\"product source head/tree changed after freeze\")\n    binaries = document.get(\"binaries\")\n    if type(binaries) is not dict:\n        raise IssueAnalysisError(\"binary bindings are malformed\")\n    for field, label in ((\"entire_graph\", \"Entire Graph binary\"), (\"cbm\", \"CBM binary\")):\n        expected = binaries.get(field)\n        if type(expected) is not dict or _binary_binding(Path(expected[\"path\"]), label) != expected:\n            raise IssueAnalysisError(f\"{label} changed after freeze\")\n    if _file_binding(Path(__file__), \"issue-analysis runner\") != document.get(\"runner\"):\n        raise IssueAnalysisError(\"issue-analysis runner changed after freeze\")\n\n    protocol = document.get(\"protocol\")\n    if type(protocol) is not dict or protocol.get(\"systems\") != list(SYSTEMS):\n        raise IssueAnalysisError(\"frozen protocol systems are malformed\")\n    repetition_count = protocol.get(\"repetition_count\")\n    if type(repetition_count) is not int or repetition_count < 1:\n        raise IssueAnalysisError(\"frozen repetition_count is malformed\")\n    if protocol.get(\"repository_count\") != 3 or protocol.get(\"paired_attempts\") is not True:\n        raise IssueAnalysisError(\"frozen protocol is not a three-repository paired design\")\n    if type(protocol.get(\"max_turns_per_attempt\")) is not int or protocol[\"max_turns_per_attempt\"] < 1:\n        raise IssueAnalysisError(\"frozen max-turns value is malformed\")\n    if type(protocol.get(\"timeout_seconds_per_attempt\")) is not int or protocol[\"timeout_seconds_per_attempt\"] < 1:\n        raise IssueAnalysisError(\"frozen timeout is malformed\")\n    if _pricing(protocol.get(\"prices_usd_per_million_tokens\")) != protocol.get(\n        \"prices_usd_per_million_tokens\"\n    ):\n        raise IssueAnalysisError(\"frozen prices are not canonical exact decimals\")\n    per_attempt = _decimal_string(\n        protocol.get(\"max_budget_usd_per_attempt\"), \"max_budget_usd_per_attempt\", positive=True,\n    )\n    total_budget = _decimal_string(\n        protocol.get(\"max_total_budget_usd\"), \"max_total_budget_usd\", positive=True,\n    )\n    if per_attempt != protocol.get(\"max_budget_usd_per_attempt\") or total_budget != protocol.get(\n        \"max_total_budget_usd\"\n    ):\n        raise IssueAnalysisError(\"frozen budgets are not canonical exact decimals\")\n    seed = _schedule_seed(\n        public_manifest_sha256=public[\"sha256\"], product=product,\n        binaries=binaries, model=protocol.get(\"model\"), repetition_count=repetition_count,\n    )\n    expected_schedule = build_balanced_schedule(public[\"repository_ids\"], repetition_count, seed)\n    if document.get(\"schedule\") != expected_schedule:\n        raise IssueAnalysisError(\"deterministic balanced schedule changed after freeze\")\n    expected_attempts = expected_schedule[\"paid_attempt_count_if_separately_authorized\"]\n    if protocol.get(\"paid_attempt_count_if_separately_authorized\") != expected_attempts:\n        raise IssueAnalysisError(\"frozen paid-attempt cap differs from its schedule\")\n    if Decimal(total_budget) > Decimal(per_attempt) * expected_attempts:\n        raise IssueAnalysisError(\"frozen total budget exceeds per-attempt aggregate cap\")\n    expected_cache = _cache_layout(Path(document[\"cache_policy\"][\"root\"]), expected_schedule)\n    if document.get(\"cache_policy\") != expected_cache:\n        raise IssueAnalysisError(\"isolated cache layout changed after freeze\")\n    cache_root = Path(expected_cache[\"root\"])\n    if cache_root == Path(product[\"path\"]) or cache_root.is_relative_to(Path(product[\"path\"])):\n        raise IssueAnalysisError(\"frozen cache root overlaps the product source checkout\")\n    if document.get(\"timing_policy\") != TIMING_POLICY:\n        raise IssueAnalysisError(\"setup/task timing boundary changed after freeze\")\n    if document.get(\"graph_phase_telemetry_field_definitions\") != GRAPH_PHASE_TELEMETRY_FIELD_DEFINITIONS:\n        raise IssueAnalysisError(\"Graph phase telemetry definitions changed after freeze\")\n    if document.get(\"claim_boundary\") != _claim_boundary(repetition_count):\n        raise IssueAnalysisError(\"development-only claim boundary changed after freeze\")\n    return document\n\n\ndef _authorization_bindings(freeze: dict[str, Any], freeze_sha256: str) -> dict[str, Any]:\n    return {\n        \"execution_freeze_sha256\": freeze_sha256,\n        \"public_manifest_sha256\": freeze[\"inputs\"][\"public_manifest\"][\"sha256\"],\n        \"sealed_oracle_sha256\": freeze[\"inputs\"][\"sealed_oracle\"][\"sha256\"],\n        \"hmac_disjointness_attestation_sha256\": freeze[\"inputs\"][\n            \"hmac_disjointness_attestation\"\n        ][\"sha256\"],\n        \"product_source_head\": freeze[\"product_source\"][\"head\"],\n        \"product_source_tree\": freeze[\"product_source\"][\"tree\"],\n        \"entire_graph_binary_sha256\": freeze[\"binaries\"][\"entire_graph\"][\"sha256\"],\n        \"cbm_binary_sha256\": freeze[\"binaries\"][\"cbm\"][\"sha256\"],\n        \"runner_sha256\": freeze[\"runner\"][\"sha256\"],\n        \"schedule_sha256\": freeze[\"schedule\"][\"schedule_sha256\"],\n        \"protocol_sha256\": _document_sha256(freeze[\"protocol\"]),\n        \"cache_policy_sha256\": _document_sha256(freeze[\"cache_policy\"]),\n        \"timing_policy_sha256\": _document_sha256(freeze[\"timing_policy\"]),\n        \"graph_phase_telemetry_definitions_sha256\": _document_sha256(\n            freeze[\"graph_phase_telemetry_field_definitions\"]\n        ),\n    }\n\n\ndef create_execution_authorization(\n    freeze_path: Path, output: Path, *, paid_execution_authorized: bool = False,\n    authorization_note: str = \"unpaid freeze only; no paid/model execution authorized\",\n) -> dict[str, Any]:\n    \"\"\"Write a separate exact-hash authorization; false is the safe default.\"\"\"\n    if type(paid_execution_authorized) is not bool:\n        raise IssueAnalysisError(\"paid_execution_authorized must be an exact boolean\")\n    if not isinstance(authorization_note, str) or not authorization_note.strip():\n        raise IssueAnalysisError(\"authorization_note must be non-empty\")\n    freeze = validate_execution_freeze(freeze_path)\n    freeze_sha256 = artifacts.sha256_file(freeze_path)\n    document = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": AUTHORIZATION_STAGE,\n        \"development_only\": True,\n        \"paid_execution_authorized\": paid_execution_authorized,\n        **{field: False for field in AUTHORITY_FALSE_FIELDS},\n        **{field: False for field in AUTHORITY_FALSE_FIELDS},\n        \"authorization_note\": authorization_note.strip(),\n        \"bindings\": _authorization_bindings(freeze, freeze_sha256),\n    }\n    _write_once_or_match(output, document, \"execution authorization\")\n    return document\n\n\ndef validate_execution_authorization(\n    freeze_path: Path, authorization_path: Path, *, expected_authorization_sha256: str | None = None,\n) -> dict[str, Any]:\n    freeze = validate_execution_freeze(freeze_path)\n    if expected_authorization_sha256 is not None and re.fullmatch(\n        r\"[0-9a-f]{64}\", expected_authorization_sha256,\n    ) is None:\n        raise IssueAnalysisError(\"expected authorization SHA-256 is malformed\")\n    artifact = artifacts.read_canonical_json(\n        authorization_path, expected_type=dict,\n        expected_sha256=expected_authorization_sha256,\n    )\n    authorization = artifact.document\n    if (\n        authorization.get(\"schema_version\") != 1\n        or authorization.get(\"suite\") != SUITE\n        or authorization.get(\"stage\") != AUTHORIZATION_STAGE\n        or authorization.get(\"development_only\") is not True\n        or type(authorization.get(\"paid_execution_authorized\")) is not bool\n    ):\n        raise IssueAnalysisError(\"execution authorization identity is malformed\")\n    _validate_false_authority(authorization)\n    expected = _authorization_bindings(freeze, artifacts.sha256_file(freeze_path))\n    if authorization.get(\"bindings\") != expected:\n        raise IssueAnalysisError(\"execution authorization does not match every frozen binding\")\n    return authorization\n\n\ndef _materialize_isolated_cache_paths(cache_policy: dict[str, Any]) -> None:\n    root = Path(cache_policy[\"root\"])\n    if root.exists() and root.is_symlink():\n        raise IssueAnalysisError(\"cache root may not be a symlink\")\n    root.mkdir(parents=True, exist_ok=True)\n    resolved_root = root.resolve(strict=True)\n    if str(resolved_root) != cache_policy[\"root\"]:\n        raise IssueAnalysisError(\"cache root resolution changed after freeze\")\n    for attempt in cache_policy[\"attempts\"]:\n        for field in (\"home\", \"temp\", \"graph_cache\", \"cbm_cache\"):\n            path = Path(attempt[field])\n            if path.exists() and path.is_symlink():\n                raise IssueAnalysisError(f\"isolated {field} path may not be a symlink\")\n            path.mkdir(parents=True, exist_ok=True)\n            if not path.resolve(strict=True).is_relative_to(resolved_root):\n                raise IssueAnalysisError(f\"isolated {field} path escaped the frozen cache root\")\n\n\ndef preflight(\n    freeze_path: Path, authorization_path: Path, *,\n    expected_authorization_sha256: str | None = None,\n    output: Path | None = None,\n) -> dict[str, Any]:\n    \"\"\"Validate bindings and materialize empty namespaces; never launch a model.\"\"\"\n    freeze = validate_execution_freeze(freeze_path)\n    authorization = validate_execution_authorization(\n        freeze_path, authorization_path,\n        expected_authorization_sha256=expected_authorization_sha256,\n    )\n    _materialize_isolated_cache_paths(freeze[\"cache_policy\"])\n    report = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": PREFLIGHT_STAGE,\n        \"development_only\": True,\n        \"execution_freeze_sha256\": artifacts.sha256_file(freeze_path),\n        \"execution_authorization_sha256\": artifacts.sha256_file(authorization_path),\n        \"paid_execution_authorized\": authorization[\"paid_execution_authorized\"],\n        \"paid_processes_launched\": 0,\n        \"model_processes_launched\": 0,\n        \"product_setup_executed\": False,\n        \"product_setup_required_before_any_paid_attempt\": True,\n        \"setup_excluded_from_task_timing\": True,\n        \"isolated_attempt_namespaces\": len(freeze[\"cache_policy\"][\"attempts\"]),\n        \"planned_pair_count\": freeze[\"schedule\"][\"pair_count\"],\n        \"planned_attempt_count\": freeze[\"schedule\"][\"paid_attempt_count_if_separately_authorized\"],\n        \"run_gate_status\": (\n            \"authorization_true_but_paid_adapter_absent\"\n            if authorization[\"paid_execution_authorized\"]\n            else \"blocked_by_false_authorization\"\n        ),\n    }\n    if output is not None:\n        _write_once_or_match(output, report, \"preflight report\")\n    return report\n\n\nPaidExecutor = Callable[[dict[str, Any]], Any]\n\n\ndef run_authorized(\n    freeze_path: Path, authorization_path: Path, *,\n    expected_authorization_sha256: str, paid_executor: PaidExecutor | None = None,\n) -> Any:\n    \"\"\"Fail closed before a paid adapter unless the exact authorization is true.\"\"\"\n    if not expected_authorization_sha256:\n        raise IssueAnalysisError(\"run requires the separately supplied exact authorization SHA-256\")\n    authorization = validate_execution_authorization(\n        freeze_path, authorization_path,\n        expected_authorization_sha256=expected_authorization_sha256,\n    )\n    if authorization[\"paid_execution_authorized\"] is not True:\n        raise IssueAnalysisError(\"paid execution is not authorized by the exact authorization artifact\")\n    freeze = validate_execution_freeze(freeze_path)\n    if paid_executor is None:\n        raise IssueAnalysisError(\"paid execution adapter is intentionally absent from this unpaid runner surface\")\n    ticket = {\n        \"suite\": SUITE,\n        \"execution_freeze_sha256\": artifacts.sha256_file(freeze_path),\n        \"execution_authorization_sha256\": expected_authorization_sha256,\n        \"bindings\": _authorization_bindings(freeze, artifacts.sha256_file(freeze_path)),\n        \"schedule\": freeze[\"schedule\"],\n        \"cache_policy\": freeze[\"cache_policy\"],\n        \"timing_policy\": freeze[\"timing_policy\"],\n    }\n    return paid_executor(ticket)\n\n\ndef _prices_from_args(args: argparse.Namespace) -> dict[str, str]:\n    return {\n        \"input_tokens_usd_per_million\": args.input_price,\n        \"output_tokens_usd_per_million\": args.output_price,\n        \"cache_creation_input_tokens_usd_per_million\": args.cache_creation_price,\n        \"cache_read_input_tokens_usd_per_million\": args.cache_read_price,\n    }\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=__doc__)\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    freeze = subparsers.add_parser(\"freeze\", help=\"write the unpaid execution freeze and false authorization\")\n    freeze.add_argument(\"--public-manifest\", type=Path, required=True)\n    freeze.add_argument(\"--sealed-oracle\", type=Path, required=True)\n    freeze.add_argument(\"--hmac-disjointness-attestation\", type=Path, required=True)\n    freeze.add_argument(\"--product-source\", type=Path, required=True)\n    freeze.add_argument(\"--graph-binary\", type=Path, required=True)\n    freeze.add_argument(\"--cbm-binary\", type=Path, required=True)\n    freeze.add_argument(\"--cache-root\", type=Path, required=True)\n    freeze.add_argument(\"--output\", type=Path, required=True)\n    freeze.add_argument(\"--authorization-output\", type=Path)\n    freeze.add_argument(\"--model\", required=True)\n    freeze.add_argument(\"--max-turns\", type=int, required=True)\n    freeze.add_argument(\"--timeout-seconds\", type=int, required=True)\n    freeze.add_argument(\"--repetition-count\", type=int, default=DEFAULT_REPETITION_COUNT)\n    freeze.add_argument(\"--max-budget-usd-per-attempt\", required=True)\n    freeze.add_argument(\"--max-total-budget-usd\", required=True)\n    freeze.add_argument(\"--input-price\", required=True)\n    freeze.add_argument(\"--output-price\", required=True)\n    freeze.add_argument(\"--cache-creation-price\", required=True)\n    freeze.add_argument(\"--cache-read-price\", required=True)\n\n    authorize = subparsers.add_parser(\"authorize\", help=\"write a separately reviewed exact-hash authorization\")\n    authorize.add_argument(\"--freeze\", type=Path, required=True)\n    authorize.add_argument(\"--output\", type=Path, required=True)\n    authorize.add_argument(\"--paid-execution-authorized\", action=\"store_true\")\n    authorize.add_argument(\"--authorization-note\", required=True)\n\n    validate = subparsers.add_parser(\"validate\", help=\"recompute all unpaid freeze bindings\")\n    validate.add_argument(\"--freeze\", type=Path, required=True)\n\n    check = subparsers.add_parser(\"preflight\", help=\"validate exact bindings and isolated namespaces\")\n    check.add_argument(\"--freeze\", type=Path, required=True)\n    check.add_argument(\"--authorization\", type=Path, required=True)\n    check.add_argument(\"--authorization-sha256\")\n    check.add_argument(\"--output\", type=Path)\n\n    run = subparsers.add_parser(\"run\", help=\"authorization gate; paid adapter intentionally absent\")\n    run.add_argument(\"--freeze\", type=Path, required=True)\n    run.add_argument(\"--authorization\", type=Path, required=True)\n    run.add_argument(\"--authorization-sha256\", required=True)\n    return parser\n\n\ndef main(argv: list[str] | None = None) -> int:\n    args = build_parser().parse_args(argv)\n    try:\n        if args.command == \"freeze\":\n            freeze_execution(\n                public_manifest=args.public_manifest,\n                sealed_oracle=args.sealed_oracle,\n                hmac_disjointness_attestation=args.hmac_disjointness_attestation,\n                product_source=args.product_source,\n                graph_binary=args.graph_binary,\n                cbm_binary=args.cbm_binary,\n                cache_root=args.cache_root,\n                output=args.output,\n                model=args.model,\n                max_turns=args.max_turns,\n                timeout_seconds=args.timeout_seconds,\n                prices=_prices_from_args(args),\n                max_budget_usd_per_attempt=args.max_budget_usd_per_attempt,\n                max_total_budget_usd=args.max_total_budget_usd,\n                repetition_count=args.repetition_count,\n            )\n            authorization_output = args.authorization_output or args.output.with_name(\n                \"execution-authorization.json\"\n            )\n            create_execution_authorization(args.output, authorization_output)\n        elif args.command == \"authorize\":\n            create_execution_authorization(\n                args.freeze,\n                args.output,\n                paid_execution_authorized=args.paid_execution_authorized,\n                authorization_note=args.authorization_note,\n            )\n        elif args.command == \"validate\":\n            document = validate_execution_freeze(args.freeze)\n            print(json.dumps({\n                \"status\": \"valid\",\n                \"execution_freeze_sha256\": artifacts.sha256_file(args.freeze),\n                \"planned_attempt_count\": document[\"schedule\"][\"paid_attempt_count_if_separately_authorized\"],\n            }, sort_keys=True))\n        elif args.command == \"preflight\":\n            report = preflight(\n                args.freeze,\n                args.authorization,\n                expected_authorization_sha256=args.authorization_sha256,\n                output=args.output,\n            )\n            print(json.dumps(report, sort_keys=True))\n        elif args.command == \"run\":\n            run_authorized(\n                args.freeze,\n                args.authorization,\n                expected_authorization_sha256=args.authorization_sha256,\n            )\n        return 0\n    except (IssueAnalysisError, artifacts.ArtifactValidationError, smoke.SmokeError) as error:\n        print(f\"error: {error}\", file=sys.stderr)\n        return 2\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
