cord_sha256\\\": setup[\\\"record_sha256\\\"],\\n+        \\\"prompt_sha256\\\": artifacts.sha256_bytes(prompt.encode(\\\"utf-8\\\")),\\n+        \\\"command_sha256\\\": artifacts.sha256_bytes(artifacts.canonical_bytes(command)),\\n+        \\\"mcp_config_sha256\\\": artifacts.sha256_file(mcp),\\n+        \\\"sandbox_profile_sha256\\\": sandbox_sha,\\n+    }\\n+    attempt_start_sha = canonical_write(record_root / \\\"attempt-start.json\\\", attempt_start)\\n     started = time.monotonic()\\n@@\\n     audit = audit_smoke_treatment(\\n         system, parsed[\\\"tools\\\"], graph, graph_cache=graph_cache,\\n-        cbm_project=setup.get(\\\"project\\\"),\\n+        cbm_project=setup.get(\\\"project\\\"), cbm_binary=cbm,\\n@@\\n         \\\"setup_wall_time_ms\\\": setup[\\\"setup_wall_time_ms\\\"],\\n         \\\"setup_record_sha256\\\": setup[\\\"record_sha256\\\"],\\n+        \\\"execution_config_sha256\\\": setup[\\\"execution_config_sha256\\\"],\\n+        \\\"attempt_start_sha256\\\": attempt_start_sha,\\n@@\\n-    canonical_write(record_root / \\\"record.json\\\", record)\\n+    canonical_write(record_root / \\\"record.json\\\", record)\\n+    if not audit[\\\"passed\\\"]:\\n+        raise SmokeError(\\n+            f\\\"timed treatment protocol violation for {repository['repository']} {system}: \\\"\\n+            f\\\"{audit['violations']}; invalid record preserved\\\"\\n+        )\\n     return record\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"019f756f-5147-7222-9084-187ed68d3651"}}}
