{"timestamp":"2026-07-18T16:21:34.468Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7608-7884-7f81-a1f1-6f91ba92db7b","call_id":"call_dVtjvVKUxDRvZM1y9RbRkNUM","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"28:MEASUREMENT_PROTOCOL = \"preindexed-agentic-v2\"\n29:SYSTEMS = (\"file-tools\", \"entire-graph\", \"cbm\")\n32:    (\"entire-graph\", \"cbm\", \"file-tools\"),\n33:    (\"cbm\", \"file-tools\", \"entire-graph\"),\n55:        raise SmokeError(\"refusing to use the preindexed protocol in a legacy evidence directory\")\n251:    repository: dict[str, Any], system: str, graph_binary: Path, *, cbm_project: str | None = None,\n271:    elif system == \"entire-graph\":\n275:For search use `{graph_binary} search --repo . --query \\\"...\\\" --format agent --head --profile full --index-all-files --cache-dir \\\"$ENTIRE_GRAPH_CACHE_DIR\\\"`. For a named relationship focus use `{graph_binary} neighbors --repo . --symbol NAME --file PATH --depth 2 --limit 100 --format agent --head --profile full --cache-dir \\\"$ENTIRE_GRAPH_CACHE_DIR\\\"{scope_flags}`. Do not use `--worktree` or `--no-cache`, and do not stream or dump the full graph.\"\"\"\n278:            raise SmokeError(\"CBM prompt requires a validated preindexed project\")\n285:def claude_command(\n286:    *, claude: Path, model: str, system: str, prompt: str, mcp: Path,\n291:    if system == \"entire-graph\":\n295:        allowed.append(\"mcp__codebase-memory-mcp\")\n297:        str(claude), \"-p\", prompt, \"--output-format\", \"stream-json\", \"--verbose\",\n480:def parse_setup_json(process: subprocess.CompletedProcess[bytes], label: str) -> dict[str, Any]:\n493:def setup_treatment_index(\n512:    setup_stdout = b\"\"\n513:    setup_stderr = b\"\"\n514:    setup_commands: list[list[str]] = []\n517:    elif system == \"entire-graph\":\n524:        setup_commands.extend([command, command])\n526:        setup_stdout += first.stdout\n527:        setup_stderr += first.stderr\n528:        first_response = parse_setup_json(first, \"Entire Graph preindex\")\n530:        setup_stdout += second.stdout\n531:        setup_stderr += second.stderr\n532:        second_response = parse_setup_json(second, \"Entire Graph cache validation\")\n537:                or response.get(\"provider\") != \"entire-graph\"\n552:                raise SmokeError(\"Entire Graph preindex is incomplete or does not match the frozen checkout\")\n554:            raise SmokeError(\"Entire Graph provider version changed during preindex validation\")\n557:        if first_response.get(\"index_cache_hit\") is not False:\n558:            raise SmokeError(\"Entire Graph fresh preindex unexpectedly reused prior cache state\")\n559:        if second_response.get(\"index_cache_hit\") is not True:\n560:            raise SmokeError(\"Entire Graph preindex validation did not hit the prepared cache\")\n563:            raise SmokeError(\"Entire Graph preindex produced no persistent cache\")\n565:            \"status\": \"indexed\", \"first_cache_hit\": first_response.get(\"index_cache_hit\"),\n566:            \"validation_cache_hit\": True,\n581:        setup_commands.append([str(cbm), \"cli\", \"index_repository\", payload])\n582:        setup_stdout += indexed.stdout\n583:        setup_stderr += indexed.stderr\n584:        indexed_response = parse_setup_json(indexed, \"Codebase Memory preindex\")\n592:            raise SmokeError(f\"Codebase Memory preindex is not healthy: {indexed_response}\")\n598:        setup_commands.append([str(cbm), \"cli\", \"index_status\", status_payload])\n599:        setup_stdout += status.stdout\n600:        setup_stderr += status.stderr\n601:        status_response = parse_setup_json(status, \"Codebase Memory index validation\")\n611:            raise SmokeError(\"Codebase Memory preindex produced no persistent cache\")\n616:    setup_wall_time_ms = max(1, round((time.monotonic() - started) * 1000))\n617:    (record_root / \"setup.stdout\").write_bytes(setup_stdout)\n618:    (record_root / \"setup.stderr\").write_bytes(setup_stderr)\n625:        \"setup_wall_time_ms\": setup_wall_time_ms, \"project\": project,\n626:        \"commands\": setup_commands,\n627:        \"setup_stdout_sha256\": artifacts.sha256_bytes(setup_stdout),\n628:        \"setup_stderr_sha256\": artifacts.sha256_bytes(setup_stderr),\n641:def load_or_setup_treatment_index(\n649:        return setup_treatment_index(\n665:        raise SmokeError(\"existing setup record does not match the preindexed protocol binding\")\n666:    if system == \"entire-graph\" and cache_inventory(graph_cache) != setup.get(\"validation\", {}).get(\"cache_inventory\"):\n675:    system: str, tools: list[dict[str, Any]], graph_binary: Path, *,\n677:    cbm_binary: Path | None = None,\n679:    audit = runtime.audit_treatment(system, tools, graph_binary)\n687:        if str(graph_binary) in command and \" search \" in f\" {command} \"\n691:        if str(graph_binary) in command and \" neighbors \" in f\" {command} \"\n695:        str(graph_binary) in command and \" neighbors \" in f\" {command} \"\n699:    if system == \"entire-graph\":\n712:                violations.add(\"entire_graph_retrieval_not_bound_to_preindexed_head\")\n727:                violations.add(\"entire_graph_search_not_bound_to_complete_preindex\")\n741:            if str(tool.get(\"name\") or \"\").startswith(\"mcp__codebase-memory-mcp\")\n774:    graph_commands = [command for command in commands if str(graph_binary) in command]\n775:    if system != \"entire-graph\" and graph_commands:\n776:        violations.add(\"unassigned_entire_graph_binary_used\")\n777:    if system == \"entire-graph\" and any(\n781:    if cbm_binary is not None and any(str(cbm_binary) in command for command in commands):\n793:    repository: dict[str, Any], system: str, output: Path, *, claude: Path,\n800:    for path in (cbm_cache, graph_cache, temp, home / \".claude\"):\n802:    runtime.copy_claude_credentials(home / \".claude\" / \".credentials.json\")\n805:    command = claude_command(\n806:        claude=claude, model=model, system=system,\n811:    readable_files = [claude, mcp]\n812:    if system == \"entire-graph\":\n826:        \"HOME\": str(home), \"CLAUDE_CONFIG_DIR\": str(home / \".claude\"),\n837:        \"setup_record_sha256\": setup[\"record_sha256\"],\n863:        cbm_project=setup.get(\"project\"), cbm_binary=cbm,\n865:    if system == \"entire-graph\":\n877:        \"setup_wall_time_ms\": setup[\"setup_wall_time_ms\"],\n878:        \"setup_record_sha256\": setup[\"record_sha256\"],\n905:    repository: dict[str, Any], system: str, output: Path, *, claude: Path,\n922:    setup_path = record_root / \"setup.json\"\n924:    if not setup_path.is_file() or not attempt_start_path.is_file():\n926:    setup = artifacts.read_canonical_json(setup_path, expected_type=dict).document\n927:    setup_sha = artifacts.sha256_file(setup_path)\n944:        or attempt_start.get(\"setup_record_sha256\") != setup_sha\n957:            or existing.get(\"setup_record_sha256\") != setup_sha\n967:    readable_files = [claude, mcp]\n968:    if system == \"entire-graph\":\n975:    expected_command = claude_command(\n976:        claude=claude, model=model, system=system, prompt=expected_prompt,\n1001:        cbm_project=setup.get(\"project\"), cbm_binary=cbm,\n1003:    if system == \"entire-graph\" and (\n1019:        \"setup_wall_time_ms\": setup[\"setup_wall_time_ms\"],\n1020:        \"setup_record_sha256\": setup_sha,\n1073:            \"mean_setup_wall_time_ms\": sum(row.get(\"setup_wall_time_ms\", 0) for row in rows) / len(rows),\n1101:    lines = [title, \"\", scope, \"\", f\"| System | {quality_label} | Macro recall | Micro recall | Tool calls | Task wall time, preindexed (s) | Setup/index, excluded (s) | Provider input incl. cache | Output tokens | Cost (USD) | Compliance |\", \"| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\"]\n1104:        lines.append(f\"| {system} | {row['exact_pass_rate']:.3f} | {row['mean_recall']:.3f} | {row['micro_recall']:.3f} | {row['mean_tool_calls']:.1f} | {row['mean_task_wall_time_ms']/1000:.1f} | {row['mean_setup_wall_time_ms']/1000:.1f} | {row['provider_input_tokens_including_cache']} | {row['output_tokens']} | {row['reported_cost_usd']:.4f} | {row['treatment_compliance_rate']:.3f} |\")\n1113:        raise SmokeError(\"preindexed rescore requires its execution configuration\")\n1123:            or not source.get(\"setup_record_sha256\")\n1173:        raise SmokeError(\"preindexed-agentic-v2 requires --workers 1 for uncontended latency measurement\")\n1189:        \"claude\": runtime.executable_binding(args.claude_binary, [\"--version\"]),\n1190:        \"entire_graph\": runtime.executable_binding(args.graph_binary, [\"--version\"]),\n1191:        \"cbm\": runtime.executable_binding(args.cbm_binary, [\"--version\"]),\n1198:                \"existing preindexed execution configuration differs from this invocation\"\n1203:    graph = args.graph_binary.resolve(strict=True)\n1204:    cbm = args.cbm_binary.resolve(strict=True)\n1206:        \"file-tools\": {\"claude\": execution_config[\"claude\"]},\n1207:        \"entire-graph\": {\n1220:            setup = load_or_setup_treatment_index(\n1235:                claude=args.claude_binary.resolve(strict=True),\n1236:                graph=args.graph_binary.resolve(strict=True),\n1237:                cbm=args.cbm_binary.resolve(strict=True),\n1258:                    execute_one, repo, system, output, claude=args.claude_binary.resolve(strict=True),\n1279:    parser.add_argument(\"--repos-dir\", type=Path, default=Path(\"/private/tmp/entire-graph-agentic-tasks-smoke-repos\"))\n1280:    parser.add_argument(\"--claude-binary\", type=Path, default=Path(shutil.which(\"claude\") or \"/missing/claude\"))\n1281:    parser.add_argument(\"--graph-binary\", type=Path, default=Path(shutil.which(\"entire-graph\") or \"/missing/entire-graph\"))\n1282:    parser.add_argument(\"--cbm-binary\", type=Path, default=Path(shutil.which(\"codebase-memory-mcp\") or \"/missing/codebase-memory-mcp\"))\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
