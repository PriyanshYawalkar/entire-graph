{"timestamp":"2026-07-18T17:49:44.086Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5bbcb7e32c8191aecb43ae3e5eee64","status":"completed","call_id":"call_FLBwdnxg7v0VUlV9Mrq4psBj","name":"exec","input":"const r = await tools.exec_command({cmd:\"sed -n '1760,2110p' competitive-eval/tools/run_agentic_issue_analysis_smoke.py\",workdir:\"/private/tmp/brain-bench-graph-agentic-pilot\",yield_time_ms:10000,max_output_tokens:30000});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T17:49:44.282Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7659-2fda-7cb3-8473-ba76613313a3","call_id":"call_FLBwdnxg7v0VUlV9Mrq4psBj","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"    return authorization\n\n\ndef _materialize_isolated_cache_paths(cache_policy: dict[str, Any]) -> None:\n    root = Path(cache_policy[\"root\"])\n    if root.exists() and root.is_symlink():\n        raise IssueAnalysisError(\"cache root may not be a symlink\")\n    root.mkdir(parents=True, exist_ok=True)\n    resolved_root = root.resolve(strict=True)\n    if str(resolved_root) != cache_policy[\"root\"]:\n        raise IssueAnalysisError(\"cache root resolution changed after freeze\")\n    for attempt in cache_policy[\"attempts\"]:\n        for field in (\"home\", \"temp\", \"graph_cache\", \"cbm_cache\"):\n            path = Path(attempt[field])\n            if path.exists() and path.is_symlink():\n                raise IssueAnalysisError(f\"isolated {field} path may not be a symlink\")\n            path.mkdir(parents=True, exist_ok=True)\n            if not path.resolve(strict=True).is_relative_to(resolved_root):\n                raise IssueAnalysisError(f\"isolated {field} path escaped the frozen cache root\")\n\n\ndef _parse_setup_response(process: Any, label: str) -> dict[str, Any]:\n    if process.returncode != 0:\n        detail = process.stderr.decode(\"utf-8\", \"replace\")[-2000:]\n        raise IssueAnalysisError(f\"{label} failed during unpaid setup: {detail}\")\n    try:\n        response = json.loads(process.stdout)\n    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n        raise IssueAnalysisError(f\"{label} did not return JSON\") from error\n    if type(response) is not dict:\n        raise IssueAnalysisError(f\"{label} returned a non-object response\")\n    return response\n\n\ndef _assert_checkout_binding(binding: dict[str, Any]) -> Path:\n    checkout = Path(binding[\"path\"]).resolve(strict=True)\n    head = runtime.checked_git([\"rev-parse\", \"HEAD\"], cwd=checkout).decode().strip()\n    tree = runtime.checked_git([\"rev-parse\", \"HEAD^{tree}\"], cwd=checkout).decode().strip()\n    status = runtime.checked_git(\n        [\"status\", \"--porcelain=v1\", \"--untracked-files=all\"], cwd=checkout,\n    )\n    if head != binding[\"commit\"] or tree != binding[\"tree\"] or status.strip():\n        raise IssueAnalysisError(f\"setup checkout changed: {binding['id']}\")\n    return checkout\n\n\ndef _load_existing_setup(\n    path: Path, *, attempt: dict[str, Any], checkout: dict[str, Any],\n    freeze_sha256: str,\n) -> dict[str, Any] | None:\n    if not path.is_file():\n        return None\n    record = artifacts.read_canonical_json(path, expected_type=dict).document\n    if (\n        record.get(\"schema_version\") != 1\n        or record.get(\"suite\") != SUITE\n        or record.get(\"stage\") != \"unpaid_product_setup\"\n        or record.get(\"execution_freeze_sha256\") != freeze_sha256\n        or record.get(\"case_id\") != checkout[\"id\"]\n        or record.get(\"repository_id\") != attempt[\"repository_id\"]\n        or record.get(\"system\") != attempt[\"system\"]\n        or record.get(\"commit\") != checkout[\"commit\"]\n        or record.get(\"tree\") != checkout[\"tree\"]\n        or record.get(\"setup_excluded_from_task_timing\") is not True\n        or record.get(\"repetition_index\") != attempt[\"repetition_index\"]\n        or record.get(\"environment_binding\") != {\n            \"home\": attempt[\"home\"],\n            \"temp\": attempt[\"temp\"],\n            \"graph_cache\": attempt[\"graph_cache\"],\n            \"cbm_cache\": attempt[\"cbm_cache\"],\n        }\n        or type(record.get(\"setup_wall_time_ms\")) is not int\n        or record[\"setup_wall_time_ms\"] < 1\n        or not _is_sha256(record.get(\"commands_sha256\"))\n        or not _is_sha256(record.get(\"stdout_sha256\"))\n        or not _is_sha256(record.get(\"stderr_sha256\"))\n    ):\n        raise IssueAnalysisError(\"existing unpaid setup record differs from its frozen attempt\")\n    validation = record.get(\"validation\")\n    if type(validation) is not dict or validation.get(\"status\") not in {\"not_required\", \"indexed\"}:\n        raise IssueAnalysisError(\"existing unpaid setup validation is malformed\")\n    if attempt[\"system\"] == \"file-tools\":\n        if (\n            validation != {\"status\": \"not_required\"}\n            or record.get(\"graph_search_validation_wall_time_ms\") is not None\n        ):\n            raise IssueAnalysisError(\"file-tools setup evidence is malformed\")\n    elif attempt[\"system\"] == \"entire-graph\":\n        timed_search = validation.get(\"timed_search_cache_validation\")\n        if (\n            validation.get(\"fresh_cache_hit\") is not False\n            or validation.get(\"validation_cache_hit\") is not True\n            or validation.get(\"timed_retrieval_cache_hit_required\") is not True\n            or type(timed_search) is not dict\n            or timed_search.get(\"index_cache_hit\") is not True\n            or type(record.get(\"graph_search_validation_wall_time_ms\")) is not int\n            or record[\"graph_search_validation_wall_time_ms\"] < 1\n            or smoke.cache_inventory(Path(attempt[\"graph_cache\"]))\n            != validation.get(\"cache_inventory\")\n        ):\n            raise IssueAnalysisError(\"existing Entire Graph cache differs from setup evidence\")\n    elif attempt[\"system\"] == \"cbm\":\n        if (\n            record.get(\"graph_search_validation_wall_time_ms\") is not None\n            or not isinstance(validation.get(\"project\"), str)\n            or not validation[\"project\"]\n            or type(validation.get(\"nodes\")) is not int\n            or validation[\"nodes\"] <= 0\n            or smoke.cache_inventory(Path(attempt[\"cbm_cache\"]))\n            != validation.get(\"cache_inventory\")\n        ):\n            raise IssueAnalysisError(\"existing CBM cache differs from setup evidence\")\n    return record\n\n\ndef _setup_attempt(\n    freeze: dict[str, Any], attempt: dict[str, Any], checkout_binding: dict[str, Any],\n    *, freeze_sha256: str,\n) -> dict[str, Any]:\n    checkout = _assert_checkout_binding(checkout_binding)\n    attempt_root = Path(attempt[\"home\"]).parent\n    setup_path = attempt_root / \"setup.json\"\n    existing = _load_existing_setup(\n        setup_path, attempt=attempt, checkout=checkout_binding,\n        freeze_sha256=freeze_sha256,\n    )\n    if existing is not None:\n        return existing\n\n    graph_cache = Path(attempt[\"graph_cache\"])\n    cbm_cache = Path(attempt[\"cbm_cache\"])\n    if smoke.cache_inventory(graph_cache) or smoke.cache_inventory(cbm_cache):\n        raise IssueAnalysisError(\"uncommitted product cache state exists before setup\")\n    environment = runtime.runtime_environment(freeze[\"protocol\"][\"runtime_path_prefix\"])\n    environment.update({\n        \"HOME\": attempt[\"home\"],\n        \"TMPDIR\": attempt[\"temp\"],\n        \"GIT_CONFIG_GLOBAL\": \"/dev/null\",\n        \"GIT_CONFIG_NOSYSTEM\": \"1\",\n        \"CBM_CACHE_DIR\": attempt[\"cbm_cache\"],\n        \"ENTIRE_GRAPH_CACHE_DIR\": attempt[\"graph_cache\"],\n    })\n    timeout = freeze[\"protocol\"][\"timeout_seconds_per_attempt\"]\n    system = attempt[\"system\"]\n    commands: list[list[str]] = []\n    stdout = b\"\"\n    stderr = b\"\"\n    graph_search_validation_wall_time_ms: int | None = None\n    started = time.monotonic()\n    if system == \"file-tools\":\n        validation: dict[str, Any] = {\"status\": \"not_required\"}\n    elif system == \"entire-graph\":\n        graph = Path(freeze[\"binaries\"][\"entire_graph\"][\"path\"])\n        command = [\n            str(graph), \"index\", \"--repo\", str(checkout), \"--head\",\n            \"--profile\", \"full\", \"--cache-dir\", str(graph_cache), \"--format\", \"json\",\n        ]\n        search_command = [\n            str(graph), \"search\", \"--repo\", str(checkout),\n            \"--query\", \"__entire_graph_preflight_cache_validation__\",\n            \"--format\", \"json\", \"--head\", \"--profile\", \"full\",\n            \"--index-all-files\", \"--cache-dir\", str(graph_cache),\n        ]\n        commands = [command, command, search_command]\n        first_process = runtime.run_command(\n            command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        second_process = runtime.run_command(\n            command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        stdout = first_process.stdout + second_process.stdout\n        stderr = first_process.stderr + second_process.stderr\n        first = _parse_setup_response(first_process, \"Entire Graph fresh preindex\")\n        second = _parse_setup_response(second_process, \"Entire Graph cache validation\")\n        for response in (first, second):\n            counts = response.get(\"counts\")\n            if (\n                response.get(\"format_version\") != 1\n                or response.get(\"provider\") != \"entire-graph\"\n                or not isinstance(response.get(\"provider_version\"), str)\n                or not response[\"provider_version\"]\n                or response.get(\"commit\") != checkout_binding[\"commit\"]\n                or response.get(\"tree\") != checkout_binding[\"tree\"]\n                or response.get(\"profile\") != \"full\"\n                or Path(str(response.get(\"repo_root\") or \"\")).resolve() != checkout\n                or type(counts) is not dict\n                or int(counts.get(\"files\") or 0) <= 0\n                or int(counts.get(\"parsed_files\") or 0) <= 0\n                or int(counts.get(\"symbols\") or 0) <= 0\n                or int(counts.get(\"partial_failures\") or 0) != 0\n                or counts.get(\"completeness_level\") != \"ok\"\n                or response.get(\"warnings\") != []\n                or response.get(\"partial_failures\") != []\n            ):\n                raise IssueAnalysisError(\"Entire Graph setup is partial or not bound to the checkout\")\n        if first.get(\"index_cache_hit\") is not False or second.get(\"index_cache_hit\") is not True:\n            raise IssueAnalysisError(\"Entire Graph setup did not prove fresh-miss then exact cache-hit\")\n        if first.get(\"counts\") != second.get(\"counts\") or first.get(\n            \"provider_version\"\n        ) != second.get(\"provider_version\"):\n            raise IssueAnalysisError(\"Entire Graph setup changed across cache validation\")\n        search_started = time.monotonic()\n        search_process = runtime.run_command(\n            search_command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        graph_search_validation_wall_time_ms = max(\n            1, round((time.monotonic() - search_started) * 1000),\n        )\n        stdout += search_process.stdout\n        stderr += search_process.stderr\n        search = _parse_setup_response(\n            search_process, \"Entire Graph timed-search cache validation\",\n        )\n        search_stats = search.get(\"stats\")\n        completeness = search.get(\"completeness\")\n        if (\n            search.get(\"query\") != \"__entire_graph_preflight_cache_validation__\"\n            or search.get(\"commit\") != checkout_binding[\"commit\"]\n            or search.get(\"tree\") != checkout_binding[\"tree\"]\n            or search.get(\"profile\") != \"full\"\n            or Path(str(search.get(\"repo_root\") or \"\")).resolve() != checkout\n            or type(search_stats) is not dict\n            or search_stats.get(\"index_cache_hit\") is not True\n            or any(\n                type(search_stats.get(field)) is not int or search_stats[field] < 0\n                for field in (\n                    \"preselect_latency_ms\", \"index_latency_ms\",\n                    \"query_latency_ms\", \"total_latency_ms\",\n                )\n            )\n            or search.get(\"warnings\") != []\n            or search.get(\"partial_failures\") != []\n            or type(completeness) is not dict\n            or type(completeness.get(\"languages\")) is not dict\n            or not completeness[\"languages\"]\n        ):\n            raise IssueAnalysisError(\n                \"Entire Graph timed search did not reuse a complete prepared index\"\n            )\n        inventory = smoke.cache_inventory(graph_cache)\n        if not inventory:\n            raise IssueAnalysisError(\"Entire Graph setup produced no persistent cache\")\n        validation = {\n            \"status\": \"indexed\",\n            \"fresh_cache_hit\": False,\n            \"timed_retrieval_cache_hit_required\": True,\n            \"validation_cache_hit\": True,\n            \"provider\": first[\"provider\"],\n            \"provider_version\": first[\"provider_version\"],\n            \"counts\": first[\"counts\"],\n            \"timed_search_cache_validation\": {\n                \"query\": search[\"query\"],\n                \"index_cache_hit\": True,\n                \"preselect_latency_ms\": search_stats[\"preselect_latency_ms\"],\n                \"index_latency_ms\": search_stats[\"index_latency_ms\"],\n                \"query_latency_ms\": search_stats[\"query_latency_ms\"],\n                \"total_latency_ms\": search_stats[\"total_latency_ms\"],\n            },\n            \"cache_inventory\": inventory,\n        }\n    elif system == \"cbm\":\n        cbm = Path(freeze[\"binaries\"][\"cbm\"][\"path\"])\n        payload = json.dumps({\"repo_path\": str(checkout)}, separators=(\",\", \":\"), sort_keys=True)\n        index_command = [str(cbm), \"cli\", \"index_repository\", payload]\n        indexed_process = runtime.run_command(\n            index_command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        indexed = _parse_setup_response(indexed_process, \"CBM preindex\")\n        project = indexed.get(\"project\")\n        if (\n            indexed.get(\"status\") != \"indexed\"\n            or not isinstance(project, str) or not project\n            or int(indexed.get(\"nodes\") or 0) <= 0\n            or indexed.get(\"error\")\n        ):\n            raise IssueAnalysisError(\"CBM preindex is not healthy\")\n        status_payload = json.dumps({\"project\": project}, separators=(\",\", \":\"), sort_keys=True)\n        status_command = [str(cbm), \"cli\", \"index_status\", status_payload]\n        status_process = runtime.run_command(\n            status_command, cwd=checkout, env=environment, timeout=timeout,\n        )\n        status = _parse_setup_response(status_process, \"CBM index validation\")\n        commands = [index_command, status_command]\n        stdout = indexed_process.stdout + status_process.stdout\n        stderr = indexed_process.stderr + status_process.stderr\n        if (\n            status.get(\"status\") != \"indexed\"\n            or status.get(\"project\") != project\n            or int(status.get(\"nodes\") or 0) <= 0\n            or status.get(\"error\")\n        ):\n            raise IssueAnalysisError(\"CBM validation is not ready\")\n        inventory = smoke.cache_inventory(cbm_cache)\n        if not inventory:\n            raise IssueAnalysisError(\"CBM setup produced no persistent cache\")\n        validation = {\n            \"status\": \"indexed\",\n            \"project\": project,\n            \"nodes\": status[\"nodes\"],\n            \"cache_inventory\": inventory,\n        }\n    else:\n        raise IssueAnalysisError(f\"unknown setup system: {system}\")\n    setup_wall_time_ms = max(1, round((time.monotonic() - started) * 1000))\n    _assert_checkout_binding(checkout_binding)\n    record = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": \"unpaid_product_setup\",\n        \"execution_freeze_sha256\": freeze_sha256,\n        \"case_id\": checkout_binding[\"id\"],\n        \"repository_id\": attempt[\"repository_id\"],\n        \"system\": system,\n        \"repetition_index\": attempt[\"repetition_index\"],\n        \"commit\": checkout_binding[\"commit\"],\n        \"tree\": checkout_binding[\"tree\"],\n        \"setup_wall_time_ms\": setup_wall_time_ms,\n        \"graph_search_validation_wall_time_ms\": graph_search_validation_wall_time_ms,\n        \"setup_excluded_from_task_timing\": True,\n        \"commands_sha256\": _document_sha256(commands),\n        \"stdout_sha256\": artifacts.sha256_bytes(stdout),\n        \"stderr_sha256\": artifacts.sha256_bytes(stderr),\n        \"environment_binding\": {\n            \"home\": attempt[\"home\"],\n            \"temp\": attempt[\"temp\"],\n            \"graph_cache\": attempt[\"graph_cache\"],\n            \"cbm_cache\": attempt[\"cbm_cache\"],\n        },\n        \"validation\": validation,\n    }\n    _write_once_or_match(setup_path, record, \"unpaid setup record\")\n    return record\n\n\ndef setup_all_products(freeze: dict[str, Any], freeze_sha256: str) -> list[dict[str, Any]]:\n    \"\"\"Sequentially prepare every treatment cache without launching the agent runtime.\"\"\"\n    checkouts = {row[\"repository_id\"]: row for row in freeze[\"checkouts\"]}\n    records = []\n    for attempt in freeze[\"cache_policy\"][\"attempts\"]:\n        checkout = checkouts.get(attempt[\"repository_id\"])\n        if checkout is None:\n            raise IssueAnalysisError(\"cache attempt has no frozen checkout\")\n        records.append(\n            _setup_attempt(freeze, attempt, checkout, freeze_sha256=freeze_sha256)\n        )\n    return records\n\n\ndef validate_completed_setup(\n    freeze: dict[str, Any], freeze_sha256: str,\n) -> list[dict[str, Any]]:\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
