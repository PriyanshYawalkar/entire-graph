{"timestamp":"2026-07-18T16:03:15.404Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5ba3c369c881918819dd4c2df14efe","status":"completed","call_id":"call_8Em6ND0Q2pZ73wKIQdXU6AeX","name":"exec","input":"const r = await tools.exec_command({cmd:\"sed -n '640,930p' competitive-eval/tools/core_bench_graph_spike.py\",workdir:\"/private/tmp/brain-bench-graph-agentic-pilot\",yield_time_ms:1000,max_output_tokens:24000}); text(r);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:03:15.600Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f75f7-b410-7480-a9be-663c6cc879f0","call_id":"call_8Em6ND0Q2pZ73wKIQdXU6AeX","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"81599c\",\"wall_time_seconds\":0.000004,\"exit_code\":0,\"original_token_count\":3159,\"output\":\"            raise ValueError(f\\\"invalid retrieval counts for {case['id']}\\\")\\n    if roles != {\\\"development\\\": DEVELOPMENT_REPOSITORIES, \\\"sealed\\\": REPOSITORY_COUNT - DEVELOPMENT_REPOSITORIES}:\\n        raise ValueError(f\\\"invalid repository roles: {dict(roles)}\\\")\\n    if set(by_repo.values()) != {QUERIES_PER_REPOSITORY}:\\n        raise ValueError(f\\\"invalid cases per repository: {dict(by_repo)}\\\")\\n    if len({row[\\\"language\\\"] for row in repos}) < 4:\\n        raise ValueError(\\\"fewer than four selected languages\\\")\\n\\n\\ndef validate_manifest(args: argparse.Namespace) -> dict[str, Any]:\\n    manifest_path = Path(args.manifest)\\n    exclusions_path = Path(args.exclusions)\\n    manifest = load_json(manifest_path)\\n    exclusions = load_json(exclusions_path)\\n    validate_manifest_data(manifest, exclusions)\\n    catalog_path = Path(args.catalog)\\n    catalog = load_json(catalog_path)\\n    expected_catalog_hash = manifest[\\\"selection\\\"][\\\"candidate_catalog_sha256\\\"]\\n    actual_catalog_hash = sha256_bytes(canonical_json_bytes(catalog))\\n    if actual_catalog_hash != expected_catalog_hash:\\n        raise ValueError(f\\\"candidate catalog hash {actual_catalog_hash} != {expected_catalog_hash}\\\")\\n    if sha256_file(exclusions_path) != manifest[\\\"selection\\\"][\\\"exclusions_sha256\\\"]:\\n        raise ValueError(\\\"exclusion artifact hash does not match manifest\\\")\\n    return {\\n        \\\"valid\\\": True,\\n        \\\"repositories\\\": len(manifest[\\\"repositories\\\"]),\\n        \\\"cases\\\": len(manifest[\\\"cases\\\"]),\\n        \\\"languages\\\": sorted({row[\\\"language\\\"] for row in manifest[\\\"repositories\\\"]}),\\n        \\\"development_repositories\\\": sum(row[\\\"role\\\"] == \\\"development\\\" for row in manifest[\\\"repositories\\\"]),\\n        \\\"sealed_repositories\\\": sum(row[\\\"role\\\"] == \\\"sealed\\\" for row in manifest[\\\"repositories\\\"]),\\n    }\\n\\n\\ndef tracked_paths(repo: Path) -> list[str]:\\n    output = subprocess.check_output([\\\"git\\\", \\\"-C\\\", str(repo), \\\"ls-files\\\", \\\"-z\\\"])\\n    return [\\n        raw_path.decode(\\\"utf-8\\\", \\\"surrogateescape\\\")\\n        for raw_path in output.split(b\\\"\\\\0\\\")\\n        if raw_path\\n    ]\\n\\n\\ndef tracked_text_files(repo: Path) -> Iterable[tuple[str, str]]:\\n    for path in tracked_paths(repo):\\n        try:\\n            yield path, (repo / path).read_text(encoding=\\\"utf-8\\\")\\n        except (UnicodeDecodeError, OSError):\\n            continue\\n\\n\\ndef all_occurrences(text: str, needle: str) -> Iterable[int]:\\n    start = 0\\n    while True:\\n        offset = text.find(needle, start)\\n        if offset < 0:\\n            return\\n        yield offset\\n        start = offset + 1\\n\\n\\ndef map_chunks_to_locations(repo: Path, chunks: Iterable[dict[str, Any]]) -> list[dict[str, Any]]:\\n    chunk_rows = []\\n    for chunk in chunks:\\n        chunk_id = chunk.get(\\\"_id\\\") or chunk.get(\\\"corpus_id\\\")\\n        text = chunk.get(\\\"text\\\")\\n        if not chunk_id or not isinstance(text, str) or not text:\\n            raise ValueError(\\\"chunk requires a non-empty ID and text\\\")\\n        chunk_rows.append({\\\"corpus_id\\\": chunk_id, \\\"text\\\": text, \\\"locations\\\": []})\\n    for path, body in tracked_text_files(repo):\\n        for chunk in chunk_rows:\\n            text = chunk[\\\"text\\\"]\\n            anchor = text[: min(80, len(text))]\\n            if anchor not in body:\\n                continue\\n            for offset in all_occurrences(body, text):\\n                start_line = body.count(\\\"\\\\n\\\", 0, offset) + 1\\n                end_line = start_line + text.rstrip(\\\"\\\\r\\\\n\\\").count(\\\"\\\\n\\\")\\n                chunk[\\\"locations\\\"].append(\\n                    {\\\"file_path\\\": path, \\\"start_line\\\": start_line, \\\"end_line\\\": end_line}\\n                )\\n    mappings = []\\n    for chunk in chunk_rows:\\n        hits = chunk[\\\"locations\\\"]\\n        mappings.append(\\n            {\\n                \\\"corpus_id\\\": chunk[\\\"corpus_id\\\"],\\n                \\\"text_sha256\\\": sha256_bytes(chunk[\\\"text\\\"].encode()),\\n                \\\"status\\\": \\\"missing\\\" if not hits else \\\"unique\\\" if len(hits) == 1 else \\\"ambiguous\\\",\\n                \\\"locations\\\": hits,\\n            }\\n        )\\n    return mappings\\n\\n\\ndef run_git(arguments: list[str], cwd: Path | None = None, timeout: int = 900) -> str:\\n    process = subprocess.run(\\n        [\\\"git\\\", *arguments],\\n        cwd=cwd,\\n        text=True,\\n        capture_output=True,\\n        check=False,\\n        timeout=timeout,\\n    )\\n    if process.returncode != 0:\\n        detail = (process.stderr or process.stdout).strip()[-1000:]\\n        raise ValueError(f\\\"git {' '.join(arguments)} failed ({process.returncode}): {detail}\\\")\\n    return process.stdout.strip()\\n\\n\\ndef ensure_case_checkout(checkouts_dir: Path, case: dict[str, Any]) -> dict[str, Any]:\\n    slug = case[\\\"normalized_repo\\\"].replace(\\\"/\\\", \\\"__\\\")\\n    mirror = checkouts_dir / \\\"mirrors\\\" / f\\\"{slug}.git\\\"\\n    checkout = checkouts_dir / \\\"cases\\\" / case[\\\"id\\\"]\\n    if not mirror.exists():\\n        mirror.parent.mkdir(parents=True, exist_ok=True)\\n        run_git(\\n            [\\n                \\\"clone\\\",\\n                \\\"--bare\\\",\\n                \\\"--filter=blob:none\\\",\\n                f\\\"https://github.com/{case['repo']}.git\\\",\\n                str(mirror),\\n            ],\\n            timeout=1800,\\n        )\\n    commit = case[\\\"base_commit\\\"]\\n    exists = subprocess.run(\\n        [\\\"git\\\", f\\\"--git-dir={mirror}\\\", \\\"cat-file\\\", \\\"-e\\\", f\\\"{commit}^{{commit}}\\\"],\\n        capture_output=True,\\n        check=False,\\n    ).returncode == 0\\n    if not exists:\\n        run_git([f\\\"--git-dir={mirror}\\\", \\\"fetch\\\", \\\"--no-tags\\\", \\\"--depth=1\\\", \\\"origin\\\", commit], timeout=1800)\\n    if checkout.exists():\\n        actual = run_git([\\\"rev-parse\\\", \\\"HEAD\\\"], cwd=checkout)\\n        if actual != commit:\\n            raise ValueError(f\\\"existing checkout {case['id']} is at {actual}, expected {commit}\\\")\\n    else:\\n        checkout.parent.mkdir(parents=True, exist_ok=True)\\n        run_git([f\\\"--git-dir={mirror}\\\", \\\"worktree\\\", \\\"add\\\", \\\"--detach\\\", str(checkout), commit], timeout=1800)\\n    actual = run_git([\\\"rev-parse\\\", \\\"HEAD\\\"], cwd=checkout)\\n    tree = run_git([\\\"rev-parse\\\", \\\"HEAD^{tree}\\\"], cwd=checkout)\\n    dirty = run_git([\\\"status\\\", \\\"--porcelain=v1\\\"], cwd=checkout)\\n    if actual != commit or dirty:\\n        raise ValueError(f\\\"checkout validation failed for {case['id']}: head={actual}, dirty={bool(dirty)}\\\")\\n    return {\\n        \\\"case_id\\\": case[\\\"id\\\"],\\n        \\\"repo\\\": case[\\\"repo\\\"],\\n        \\\"commit\\\": actual,\\n        \\\"tree\\\": tree,\\n        \\\"checkout\\\": f\\\"checkouts/cases/{case['id']}\\\",\\n        \\\"tracked_files\\\": len(tracked_paths(checkout)),\\n        \\\"path\\\": checkout,\\n    }\\n\\n\\ndef corpus_subset(path: Path, corpus_ids: set[str]) -> dict[str, dict[str, Any]]:\\n    rows = {}\\n    for row in iter_jsonl_path(path):\\n        if row.get(\\\"_id\\\") in corpus_ids:\\n            rows[row[\\\"_id\\\"]] = row\\n            if len(rows) == len(corpus_ids):\\n                break\\n    return rows\\n\\n\\ndef materialize_role(args: argparse.Namespace, role: str) -> dict[str, Any]:\\n    manifest = load_json(Path(args.manifest))\\n    cases = [case for case in manifest[\\\"cases\\\"] if case[\\\"role\\\"] == role]\\n    expected_repositories = (\\n        DEVELOPMENT_REPOSITORIES if role == \\\"development\\\" else REPOSITORY_COUNT - DEVELOPMENT_REPOSITORIES\\n    )\\n    expected_cases = expected_repositories * QUERIES_PER_REPOSITORY\\n    if len(cases) != expected_cases:\\n        raise ValueError(f\\\"expected {expected_cases} {role} cases, found {len(cases)}\\\")\\n    protocol_sha256 = None\\n    if role == \\\"sealed\\\":\\n        protocol_path = Path(args.protocol)\\n        protocol = load_json(protocol_path)\\n        if protocol.get(\\\"freeze_status\\\") != \\\"frozen_after_development_before_sealed_run\\\":\\n            raise ValueError(\\\"sealed materialization requires a frozen evaluation protocol\\\")\\n        if protocol.get(\\\"manifest_sha256\\\") != sha256_file(Path(args.manifest)):\\n            raise ValueError(\\\"evaluation protocol was frozen for a different manifest\\\")\\n        protocol_sha256 = sha256_file(protocol_path)\\n    fetcher = PinnedFetcher(Path(args.cache_dir))\\n    checkouts_dir = Path(args.checkouts_dir)\\n    cases_by_repo: dict[str, list[dict[str, Any]]] = defaultdict(list)\\n    for case in cases:\\n        cases_by_repo[case[\\\"normalized_repo\\\"]].append(case)\\n\\n    source_files = []\\n    output_cases = []\\n    for repo_key, repo_cases in sorted(cases_by_repo.items()):\\n        sample = repo_cases[0]\\n        corpus_path = sample[\\\"core_queries_path\\\"].replace(\\\"queries.jsonl\\\", \\\"corpus.jsonl\\\")\\n        qrels_path = sample[\\\"core_qrels_path\\\"]\\n        corpus_cache = fetcher.dataset_file(\\\"core-bench\\\", CORE_DATASET, CORE_REVISION, corpus_path)\\n        qrels_cache = fetcher.dataset_file(\\\"core-bench\\\", CORE_DATASET, CORE_REVISION, qrels_path)\\n        source_files.extend(\\n            [\\n                {\\\"path\\\": corpus_path, \\\"sha256\\\": sha256_file(corpus_cache)},\\n                {\\\"path\\\": qrels_path, \\\"sha256\\\": sha256_file(qrels_cache)},\\n            ]\\n        )\\n        qrels_by_case: dict[str, list[dict[str, Any]]] = defaultdict(list)\\n        selected_ids = {case[\\\"id\\\"] for case in repo_cases}\\n        for qrel in iter_jsonl_path(qrels_cache):\\n            if qrel.get(\\\"query_id\\\") in selected_ids:\\n                qrels_by_case[qrel[\\\"query_id\\\"]].append(qrel)\\n        wanted_corpus_ids = {\\n            qrel[\\\"corpus_id\\\"] for rows in qrels_by_case.values() for qrel in rows\\n        }\\n        chunks = corpus_subset(corpus_cache, wanted_corpus_ids)\\n        missing_chunks = sorted(wanted_corpus_ids - chunks.keys())\\n        if missing_chunks:\\n            raise ValueError(f\\\"{repo_key} corpus is missing qrel chunks: {missing_chunks[:10]}\\\")\\n        for case in sorted(repo_cases, key=lambda row: row[\\\"id\\\"]):\\n            checkout = ensure_case_checkout(checkouts_dir, case)\\n            qrel_rows = qrels_by_case.get(case[\\\"id\\\"], [])\\n            qrel_ids = {row[\\\"corpus_id\\\"] for row in qrel_rows}\\n            if len(qrel_rows) != case[\\\"qrel_row_count\\\"]:\\n                raise ValueError(\\n                    f\\\"{case['id']} qrel row count {len(qrel_rows)} != manifest {case['qrel_row_count']}\\\"\\n                )\\n            if len(qrel_ids) != case[\\\"relevant_corpus_count\\\"]:\\n                raise ValueError(\\n                    f\\\"{case['id']} relevant corpus count {len(qrel_ids)} != \\\"\\n                    f\\\"manifest {case['relevant_corpus_count']}\\\"\\n                )\\n            mappings = map_chunks_to_locations(checkout[\\\"path\\\"], [chunks[corpus_id] for corpus_id in sorted(qrel_ids)])\\n            output_cases.append(\\n                {\\n                    \\\"id\\\": case[\\\"id\\\"],\\n                    \\\"repo\\\": case[\\\"repo\\\"],\\n                    \\\"language\\\": case[\\\"language\\\"],\\n                    \\\"commit\\\": checkout[\\\"commit\\\"],\\n                    \\\"tree\\\": checkout[\\\"tree\\\"],\\n                    \\\"checkout\\\": checkout[\\\"checkout\\\"],\\n                    \\\"tracked_files\\\": checkout[\\\"tracked_files\\\"],\\n                    \\\"qrel_row_count\\\": len(qrel_rows),\\n                    \\\"relevant_corpus_count\\\": len(qrel_ids),\\n                    \\\"mapping_counts\\\": {\\n                        status: sum(row[\\\"status\\\"] == status for row in mappings)\\n                        for status in (\\\"unique\\\", \\\"ambiguous\\\", \\\"missing\\\")\\n                    },\\n                    \\\"mappings\\\": mappings,\\n                }\\n            )\\n\\n    total_qrel_rows = sum(case[\\\"qrel_row_count\\\"] for case in output_cases)\\n    total_relevant = sum(case[\\\"relevant_corpus_count\\\"] for case in output_cases)\\n    mapping_totals = {\\n        status: sum(case[\\\"mapping_counts\\\"][status] for case in output_cases)\\n        for status in (\\\"unique\\\", \\\"ambiguous\\\", \\\"missing\\\")\\n    }\\n    artifact = {\\n        \\\"schema_version\\\": 1,\\n        \\\"suite\\\": \\\"core_bench_level2_feasibility_spike\\\",\\n        \\\"stage\\\": f\\\"{role}_qrel_materialization\\\",\\n        \\\"role\\\": role,\\n        \\\"manifest_sha256\\\": sha256_file(Path(args.manifest)),\\n        \\\"protocol_sha256\\\": protocol_sha256,\\n        \\\"core_dataset\\\": {\\\"dataset\\\": CORE_DATASET, \\\"revision\\\": CORE_REVISION, \\\"files\\\": source_files},\\n        \\\"summary\\\": {\\n            \\\"repositories\\\": len(cases_by_repo),\\n            \\\"cases\\\": len(output_cases),\\n            \\\"qrel_rows\\\": total_qrel_rows,\\n            \\\"relevant_corpus_documents\\\": total_relevant,\\n            \\\"mapping_counts\\\": mapping_totals,\\n            \\\"content_mapping_rate\\\": (\\n                (mapping_totals[\\\"unique\\\"] + mapping_totals[\\\"ambiguous\\\"]) / total_relevant\\n                if total_relevant\\n                else 0.0\\n            ),\\n            \\\"unique_location_rate\\\": mapping_totals[\\\"unique\\\"] / total_relevant if total_relevant else 0.0,\\n        },\\n        \\\"cases\\\": output_cases,\\n    }\\n    write_json(Path(args.output), artifact)\\n    return artifact\\n\\n\\ndef materialize_development(args: argparse.Namespace) -> dict[str, Any]:\\n    return materialize_role(args, \\\"development\\\")\\n\\n\\ndef materialize_sealed(args: argparse.Namespace) -> dict[str, Any]:\\n    return materialize_role(args, \\\"sealed\\\")\\n\\n\\ndef build_parser() -> argparse.ArgumentParser:\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
