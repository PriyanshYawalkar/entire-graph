{"timestamp":"2026-07-18T16:31:08.333Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7611-3a2d-7480-87bf-5f4fdaebb71f","call_id":"call_UzIBPFcDU5kVJiuclz7wLZl4","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"36:MATERIALIZATION_ATTESTATION_STAGE = \"issue_analysis_materialization_attestation\"\n375:def _checkout_binding_projection(cases: list[dict[str, Any]]) -> list[dict[str, Any]]:\n406:def _materialized_input_bindings(\n490:        \"hmac_disjointness_cohort\": cohort,\n499:        \"materialization_attestation\": {\n591:def _prompt_bindings(\n614:    agent_runtime: dict[str, Any],\n624:        \"agent_runtime_sha256\": agent_runtime[\"sha256\"],\n748:def freeze_execution(\n750:    hmac_disjointness_attestation: Path, materialization_attestation: Path,\n770:        cohort_path=hmac_disjointness_attestation,\n773:        attestation_path=materialization_attestation,\n784:    agent_runtime = _binary_binding(agent_binary, \"agent runtime binary\")\n789:        binaries=binaries, agent_runtime=agent_runtime,\n818:        \"agent_runtime\": agent_runtime,\n864:def validate_execution_freeze(path: Path) -> dict[str, Any]:\n881:            cohort_path=Path(inputs[\"hmac_disjointness_cohort\"][\"path\"]),\n884:            attestation_path=Path(inputs[\"materialization_attestation\"][\"path\"]),\n906:    agent_runtime = document.get(\"agent_runtime\")\n907:    if type(agent_runtime) is not dict or _binary_binding(\n908:        Path(agent_runtime[\"path\"]), \"agent runtime binary\",\n909:    ) != agent_runtime:\n953:        binaries=binaries, agent_runtime=agent_runtime,\n979:def _authorization_bindings(freeze: dict[str, Any], freeze_sha256: str) -> dict[str, Any]:\n982:        \"hmac_disjointness_cohort_sha256\": freeze[\"inputs\"][\n983:            \"hmac_disjointness_cohort\"\n987:        \"materialization_attestation_sha256\": freeze[\"inputs\"][\n988:            \"materialization_attestation\"\n994:        \"agent_runtime_sha256\": freeze[\"agent_runtime\"][\"sha256\"],\n1094:def _assert_checkout_binding(binding: dict[str, Any]) -> Path:\n1140:def _setup_attempt(\n1467:                hmac_disjointness_attestation=args.hmac_disjointness_attestation,\n1468:                materialization_attestation=args.materialization_attestation,\n                raise IssueAnalysisError(f\"{label} case mapping is malformed\")\n            nested = dict(row)\n            nested.setdefault(\"id\", case_id)\n            rows.append(nested)\n    else:\n        raise IssueAnalysisError(f\"{label} has no case collection\")\n    if len(rows) != 3 or any(type(row) is not dict for row in rows):\n        raise IssueAnalysisError(f\"{label} must contain exactly three case objects\")\n    return sorted(rows, key=lambda row: str(row.get(\"id\") or \"\"))\n\n\ndef _public_task_binding(path: Path) -> tuple[dict[str, Any], dict[str, Any]]:\n    artifact = artifacts.read_canonical_json(path, expected_type=dict)\n    manifest = artifact.document\n    if (\n        manifest.get(\"schema_version\") != 1\n        or manifest.get(\"suite\") != SUITE\n        or manifest.get(\"stage\") != PUBLIC_TASK_STAGE\n        or manifest.get(\"development_only\") is not True\n        or manifest.get(\"agent_visible\") is not True\n        or manifest.get(\"sealed\") is not False\n        or manifest.get(\"repository_count\") != 3\n        or manifest.get(\"case_count\") != 3\n        or manifest.get(\"queries_present\") is not True\n    ):\n        raise IssueAnalysisError(\"public task manifest identity or query boundary is malformed\")\n    for field in PUBLIC_TASK_FALSE_FIELDS:\n        if manifest.get(field) is not False:\n            raise IssueAnalysisError(f\"public task manifest must keep {field}=false\")\n    _require_no_authority(manifest, \"public task manifest\")\n    rows = _case_rows(manifest, \"public task manifest\")\n    case_ids: list[str] = []\n    repository_ids: list[str] = []\n    cases: list[dict[str, Any]] = []\n    for row in rows:\n        case_id = row.get(\"id\")\n        task = row.get(\"task\")\n        if (\n            not isinstance(case_id, str) or not case_id\n            or type(task) is not dict\n            or task.get(\"kind\") != \"read_only_issue_analysis\"\n            or not isinstance(task.get(\"prompt\"), str) or not task[\"prompt\"].strip()\n            or not isinstance(row.get(\"checkout_relative_path\"), str)\n            or re.fullmatch(r\"[0-9a-f]{40}\", str(row.get(\"base_commit\") or \"\")) is None\n            or re.fullmatch(r\"[0-9a-f]{40}\", str(row.get(\"base_tree\") or \"\")) is None\n        ):\n            raise IssueAnalysisError(\"public task case lacks its read-only prompt or checkout binding\")\n        repository_id = _repository_identity(row)\n        case_ids.append(case_id)\n        repository_ids.append(repository_id)\n        cases.append({\n            \"id\": case_id,\n            \"repository_id\": repository_id,\n            \"repo\": row.get(\"repo\"),\n            \"normalized_repo\": row.get(\"normalized_repo\"),\n            \"language\": row.get(\"language\"),\n            \"base_commit\": row[\"base_commit\"],\n            \"base_tree\": row[\"base_tree\"],\n            \"checkout_relative_path\": row[\"checkout_relative_path\"],\n            \"source_record_sha256\": row.get(\"source_record_sha256\"),\n            \"query_record_sha256\": row.get(\"query_record_sha256\"),\n            \"prompt\": task[\"prompt\"],\n        })\n    if len(set(case_ids)) != 3 or len(set(repository_ids)) != 3:\n        raise IssueAnalysisError(\"public task case/repository identities must be distinct\")\n    binding = {\n        \"path\": str(path.resolve(strict=True)),\n        \"sha256\": artifact.sha256,\n        \"bytes\": artifact.byte_count,\n        \"repository_ids\": repository_ids,\n        \"case_ids\": case_ids,\n    }\n    return binding, {\"document\": manifest, \"cases\": cases}\n\n\ndef _checkout_binding_projection(cases: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    return sorted(\n        [\n            {\n                \"id\": row[\"id\"],\n                \"repo\": row[\"repo\"],\n                \"normalized_repo\": row[\"normalized_repo\"],\n                \"base_commit\": row[\"base_commit\"],\n                \"base_tree\": row[\"base_tree\"],\n                \"checkout_relative_path\": row[\"checkout_relative_path\"],\n                \"source_record_sha256\": row[\"source_record_sha256\"],\n                \"query_record_sha256\": row[\"query_record_sha256\"],\n            }\n            for row in cases\n        ],\n        key=lambda row: row[\"id\"],\n    )\n\n\ndef _resolve_attested_path(value: Any, attestation_path: Path, label: str) -> Path:\n    if not isinstance(value, str) or not value:\n        raise IssueAnalysisError(f\"materialization attestation lacks {label} path\")\n    path = Path(value)\n    if not path.is_absolute():\n        path = attestation_path.parent / path\n    try:\n        return path.resolve(strict=True)\n    except OSError as error:\n        raise IssueAnalysisError(f\"attested {label} path is unavailable\") from error\n\n\ndef _materialized_input_bindings(\n    *, cohort_path: Path, public_path: Path, sealed_path: Path,\n    attestation_path: Path,\n) -> tuple[dict[str, Any], dict[str, Any]]:\n    cohort = _cohort_binding(cohort_path)\n    public, public_loaded = _public_task_binding(public_path)\n    sealed_artifact = artifacts.read_canonical_json(sealed_path, expected_type=dict)\n    sealed = sealed_artifact.document\n    if (\n        sealed.get(\"schema_version\") != 1\n        or sealed.get(\"suite\") != SUITE\n        or sealed.get(\"stage\") != SEALED_ORACLE_STAGE\n        or sealed.get(\"development_only\") is not True\n        or sealed.get(\"agent_visible\") is not False\n        or sealed.get(\"sealed\") is not True\n        or sealed.get(\"repository_count\") != 3\n        or sealed.get(\"case_count\") != 3\n        or sealed.get(\"qrels_present\") is not True\n    ):\n        raise IssueAnalysisError(\"sealed controller oracle identity is malformed\")\n    _require_no_authority(sealed, \"sealed controller oracle\")\n    sealed_rows = _case_rows(sealed, \"sealed controller oracle\")\n    public_by_id = {row[\"id\"]: row for row in public_loaded[\"cases\"]}\n    if {str(row.get(\"id\") or \"\") for row in sealed_rows} != set(public_by_id):\n        raise IssueAnalysisError(\"public and sealed case IDs differ\")\n    sealed_repository_ids = []\n    for row in sealed_rows:\n        case_id = row[\"id\"]\n        public_row = public_by_id[case_id]\n        repository_id = _repository_identity(row)\n        sealed_repository_ids.append(repository_id)\n        for field in (\n            \"repo\", \"normalized_repo\", \"base_commit\", \"base_tree\",\n            \"checkout_relative_path\", \"source_record_sha256\", \"query_record_sha256\",\n        ):\n            if row.get(field) != public_row.get(field):\n                raise IssueAnalysisError(f\"public/sealed case binding differs for {case_id}: {field}\")\n    if set(sealed_repository_ids) != set(public[\"repository_ids\"]):\n        raise IssueAnalysisError(\"public and sealed repository IDs differ\")\n    if set(public[\"repository_ids\"]) != set(cohort[\"repository_ids\"]):\n        raise IssueAnalysisError(\"materialized public repositories differ from the HMAC-disjoint cohort\")\n\n    attestation_artifact = artifacts.read_canonical_json(\n        attestation_path, expected_type=dict,\n    )\n    attestation = attestation_artifact.document\n    if (\n        attestation.get(\"schema_version\") != 1\n        or attestation.get(\"suite\") != SUITE\n        or attestation.get(\"stage\") != MATERIALIZATION_ATTESTATION_STAGE\n        or attestation.get(\"development_only\") is not True\n    ):\n        raise IssueAnalysisError(\"materialization attestation identity is malformed\")\n    _require_no_authority(attestation, \"materialization attestation\")\n    if attestation.get(\"cohort_sha256\") != cohort[\"sha256\"]:\n        raise IssueAnalysisError(\"materialization attestation does not bind the exact HMAC cohort\")\n    if attestation.get(\"public_tasks_sha256\") != public[\"sha256\"]:\n        raise IssueAnalysisError(\"materialization attestation public task hash mismatch\")\n    if attestation.get(\"sealed_controller_sha256\") != sealed_artifact.sha256:\n        raise IssueAnalysisError(\"materialization attestation sealed controller hash mismatch\")\n    public_document = public_loaded[\"document\"]\n    if (\n        public_document.get(\"cohort_sha256\") != cohort[\"sha256\"]\n        or sealed.get(\"cohort_sha256\") != cohort[\"sha256\"]\n    ):\n        raise IssueAnalysisError(\"public or sealed materialization lost its cohort binding\")\n    source = public_document.get(\"source\")\n    attested_source = attestation.get(\"source\")\n    if (\n        type(source) is not dict\n        or sealed.get(\"source\") != source\n        or type(attested_source) is not dict\n        or {key: attested_source.get(key) for key in source} != source\n        or set(attested_source) != {*source, \"source_row_count\"}\n        or type(attested_source.get(\"source_row_count\")) is not int\n        or attested_source[\"source_row_count\"] < 3\n    ):\n        raise IssueAnalysisError(\"public, sealed, and attested source bindings differ\")\n    projection = _checkout_binding_projection(public_loaded[\"cases\"])\n    checkout_digest = _document_sha256(projection)\n    if attestation.get(\"checkout_binding_sha256\") != checkout_digest:\n        raise IssueAnalysisError(\"materialization checkout binding digest mismatch\")\n\n    bindings = {\n        \"hmac_disjointness_cohort\": cohort,\n        \"public_task_manifest\": public,\n        \"sealed_oracle\": {\n            \"path\": str(sealed_path.resolve(strict=True)),\n            \"sha256\": sealed_artifact.sha256,\n            \"bytes\": sealed_artifact.byte_count,\n            \"repository_ids\": sealed_repository_ids,\n            \"case_ids\": sorted(public_by_id),\n        },\n        \"materialization_attestation\": {\n            \"path\": str(attestation_path.resolve(strict=True)),\n            \"sha256\": attestation_artifact.sha256,\n            \"bytes\": attestation_artifact.byte_count,\n            \"checkout_binding_sha256\": checkout_digest,\n        },\n        \"source\": {\n            \"materialized\": source,\n            \"attested\": attested_source,\n        },\n    }\n    loaded = {\n        \"public_document\": public_document,\n        \"public_cases\": public_loaded[\"cases\"],\n    }\n    return bindings, loaded\n\n\ndef _materialized_checkout_bindings(\n    materialized_root: Path, public_cases: list[dict[str, Any]],\n) -> list[dict[str, Any]]:\n    try:\n        root = materialized_root.resolve(strict=True)\n    except OSError as error:\n        raise IssueAnalysisError(\"materialized checkout root is unavailable\") from error\n    bindings = []\n    for case in sorted(public_cases, key=lambda row: row[\"id\"]):\n        relative = Path(case[\"checkout_relative_path\"])\n        if relative.is_absolute() or \"..\" in relative.parts:\n            raise IssueAnalysisError(\"materialized checkout path must be a safe relative path\")\n        checkout = (root / relative).resolve(strict=True)\n        if not checkout.is_relative_to(root):\n            raise IssueAnalysisError(\"materialized checkout escaped its frozen root\")\n        head = runtime.checked_git([\"rev-parse\", \"HEAD\"], cwd=checkout).decode().strip()\n        tree = runtime.checked_git([\"rev-parse\", \"HEAD^{tree}\"], cwd=checkout).decode().strip()\n        status = runtime.checked_git(\n            [\"status\", \"--porcelain=v1\", \"--untracked-files=all\"], cwd=checkout,\n        )\n        if head != case[\"base_commit\"] or tree != case[\"base_tree\"] or status.strip():\n            raise IssueAnalysisError(f\"materialized checkout is not pristine at its bound tree: {case['id']}\")\n        bindings.append({\n            \"id\": case[\"id\"],\n            \"repository_id\": case[\"repository_id\"],\n            \"path\": str(checkout),\n            \"commit\": head,\n            \"tree\": tree,\n        })\n    return bindings\n\n\ndef _decimal_string(value: Any, label: str, *, positive: bool) -> str:\n    try:\n        parsed = Decimal(str(value))\n    except (InvalidOperation, ValueError) as error:\n        raise IssueAnalysisError(f\"{label} must be an exact decimal value\") from error\n    if not parsed.is_finite() or parsed < 0 or (positive and parsed <= 0):\n        comparison = \"positive\" if positive else \"non-negative\"\n        raise IssueAnalysisError(f\"{label} must be finite and {comparison}\")\n    normalized = format(parsed, \"f\")\n    if \".\" in normalized:\n        normalized = normalized.rstrip(\"0\").rstrip(\".\")\n    return normalized or \"0\"\n\n\ndef _pricing(prices: dict[str, Any]) -> dict[str, str]:\n    if type(prices) is not dict or set(prices) != set(PRICE_FIELDS):\n        raise IssueAnalysisError(f\"prices must contain exactly: {', '.join(PRICE_FIELDS)}\")\n    return {\n        field: _decimal_string(prices[field], field, positive=False)\n        for field in PRICE_FIELDS\n    }\n\n\ndef issue_analysis_prompt(case: dict[str, Any], system: str, graph_binary: Path) -> str:\n    if system not in SYSTEMS:\n        raise IssueAnalysisError(f\"unknown issue-analysis system: {system}\")\n    common = f\"\"\"Analyze the public issue below in the repository at the current working directory.\n\n{case['prompt'].strip()}\n\nThis is read-only issue analysis, not a repair task. Identify the most relevant repository-relative source locations and explain the likely implementation area and evidence. Do not edit files, run tests, use the network, inspect Git history or objects, read parent directories, or access files outside this checkout. Ordinary targeted Read, Grep, Glob, and Bash-based file inspection is allowed. Repository CLAUDE.md instructions remain in scope. User-home memory is unavailable because every attempt uses a fresh isolated HOME.\n\n\"\"\"\n    if system == \"file-tools\":\n        treatment = \"Entire Graph and Codebase Memory are unavailable; use ordinary file discovery tools as useful.\"\n    elif system == \"entire-graph\":\n        treatment = f\"\"\"Entire Graph is preindexed for this exact committed tree and is available alongside ordinary file tools. Choose `search`, `neighbors`, both, or neither according to the issue; no fixed retrieval sequence is required. If used, call `{graph_binary} search --repo . --query \\\"...\\\" --format agent --head --profile full --index-all-files --cache-dir \\\"$ENTIRE_GRAPH_CACHE_DIR\\\"` or `{graph_binary} neighbors --repo . --symbol NAME --file PATH --depth 2 --format agent --head --profile full --cache-dir \\\"$ENTIRE_GRAPH_CACHE_DIR\\\"`. Never rebuild, use worktree mode, disable the cache, or dump the full graph.\"\"\"\n    else:\n        treatment = \"Codebase Memory is preindexed as $CBM_PROJECT and is available alongside ordinary file tools. Choose any useful retrieval operation or ordinary targeted file reads; no fixed retrieval sequence is required. Never index, delete, or mutate the project during the task.\"\n    return common + treatment\n\n\ndef _prompt_bindings(\n    cases: list[dict[str, Any]], graph_binary: Path,\n) -> list[dict[str, Any]]:\n    bindings = []\n    for case in sorted(cases, key=lambda row: row[\"id\"]):\n        for system in SYSTEMS:\n            prompt = issue_analysis_prompt(case, system, graph_binary)\n            bindings.append({\n                \"case_id\": case[\"id\"],\n                \"repository_id\": case[\"repository_id\"],\n                \"system\": system,\n                \"prompt\": prompt,\n                \"prompt_sha256\": artifacts.sha256_bytes(prompt.encode(\"utf-8\")),\n                \"allowed_tool_policy\": {\n                    \"common_tools\": ALLOWED_TOOL_POLICY[\"common_tools\"],\n                    **ALLOWED_TOOL_POLICY[system],\n                },\n            })\n    return bindings\n\n\ndef _schedule_seed(\n    *, public_manifest_sha256: str, product: dict[str, Any], binaries: dict[str, Any],\n    agent_runtime: dict[str, Any],\n    model: str, repetition_count: int,\n) -> str:\n    return _document_sha256({\n        \"domain\": \"entire-graph-agentic-issue-analysis-balanced-paired-schedule-v1\",\n        \"public_manifest_sha256\": public_manifest_sha256,\n        \"product_head\": product[\"head\"],\n        \"product_tree\": product[\"tree\"],\n        \"graph_binary_sha256\": binaries[\"entire_graph\"][\"sha256\"],\n        \"cbm_binary_sha256\": binaries[\"cbm\"][\"sha256\"],\n        \"agent_runtime_sha256\": agent_runtime[\"sha256\"],\n        \"model\": model,\n        \"repetition_count\": repetition_count,\n    })\n\n\ndef build_balanced_schedule(\n    repository_ids: list[str], repetition_count: int, seed_sha256: str,\n) -> dict[str, Any]:\n    if len(repository_ids) != 3 or len(set(repository_ids)) != 3:\n        raise IssueAnalysisError(\"paired schedule requires exactly three distinct repositories\")\n    if type(repetition_count) is not int or repetition_count < 1:\n        raise IssueAnalysisError(\"repetition_count must be a positive integer\")\n    if re.fullmatch(r\"[0-9a-f]{64}\", seed_sha256) is None:\n        raise IssueAnalysisError(\"schedule seed must be an exact SHA-256\")\n    ordered = sorted(\n        repository_ids,\n        key=lambda value: artifacts.sha256_bytes(\n            f\"{seed_sha256}\\0{value}\".encode(\"utf-8\")\n        ),\n    )\n    repository_slot = {repository: index + 1 for index, repository in enumerate(ordered)}\n    rows: list[dict[str, Any]] = []\n    for repetition_index in range(1, repetition_count + 1):\n        offset = (repetition_index - 1) % len(ordered)\n        execution_order = ordered[offset:] + ordered[:offset]\n        for repository in execution_order:\n        for repository in execution_order:\n            slot = repository_slot[repository]\n            rotation = ROTATIONS[(slot - 1 + repetition_index - 1) % len(ROTATIONS)]\n            rows.append({\n                \"pair_index\": len(rows) + 1,\n                \"repository_id\": repository,\n                \"repository_slot\": slot,\n                \"repetition_index\": repetition_index,\n                \"system_order\": list(rotation),\n            })\n    position_counts = {\n        system: [\n            sum(row[\"system_order\"][position] == system for row in rows)\n            for position in range(len(SYSTEMS))\n        ]\n        for system in SYSTEMS\n    }\n    carryover = Counter(\n        (left, right)\n        for row in rows\n        for left, right in zip(row[\"system_order\"], row[\"system_order\"][1:])\n    )\n    expected_position_count = len(rows) // len(SYSTEMS)\n    if any(count != expected_position_count for counts in position_counts.values() for count in counts):\n        raise IssueAnalysisError(\"paired schedule is not exactly system-position balanced\")\n    cyclic_pairs = ((SYSTEMS[0], SYSTEMS[1]), (SYSTEMS[1], SYSTEMS[2]), (SYSTEMS[2], SYSTEMS[0]))\n    if len({carryover[pair] for pair in cyclic_pairs}) != 1 or any(\n        pair not in cyclic_pairs and count for pair, count in carryover.items()\n    ):\n        raise IssueAnalysisError(\"paired schedule is not first-order carryover balanced\")\n    schedule = {\n        \"domain\": \"balanced_three_system_repeated_paired_issue_analysis_v1\",\n        \"seed_sha256\": seed_sha256,\n        \"repetition_count\": repetition_count,\n        \"pair_count\": len(rows),\n        \"paid_attempt_count_if_separately_authorized\": len(rows) * len(SYSTEMS),\n        \"system_position_counts\": position_counts,\n        \"first_order_carryover_counts\": {\n            f\"{left}->{right}\": carryover[(left, right)] for left, right in cyclic_pairs\n        },\n        \"rows\": rows,\n    }\n    schedule[\"schedule_sha256\"] = _document_sha256(schedule)\n    return schedule\n\n\ndef _cache_layout(cache_root: Path, schedule: dict[str, Any]) -> dict[str, Any]:\n    root = cache_root.resolve(strict=False)\n    attempts = []\n    observed: set[str] = set()\n    for row in schedule[\"rows\"]:\n        for system_position, system in enumerate(row[\"system_order\"], start=1):\n            attempt_root = (\n                root / f\"repo-{row['repository_slot']:02d}\"\n                / f\"repeat-{row['repetition_index']:02d}\" / system\n            )\n            paths = {\n                \"home\": str(attempt_root / \"home\"),\n                \"temp\": str(attempt_root / \"temp\"),\n                \"graph_cache\": str(attempt_root / \"graph-cache\"),\n                \"cbm_cache\": str(attempt_root / \"cbm-cache\"),\n            }\n            if observed.intersection(paths.values()):\n                raise IssueAnalysisError(\"attempt cache/home paths are not isolated\")\n            observed.update(paths.values())\n            attempts.append({\n                \"pair_index\": row[\"pair_index\"],\n                \"repository_id\": row[\"repository_id\"],\n                \"repository_slot\": row[\"repository_slot\"],\n                \"repetition_index\": row[\"repetition_index\"],\n                \"system\": system,\n                \"system_position\": system_position,\n                **paths,\n            })\n    return {\n        \"root\": str(root),\n        \"scope\": \"unique home, temp, Graph cache, and CBM cache per repository/repetition/system attempt\",\n        \"reuse_across_attempts_allowed\": False,\n        \"attempts\": attempts,\n    }\n\n\ndef _claim_boundary(repetition_count: int) -> dict[str, Any]:\n    return {\n        \"scope\": \"development-only public-issue analysis and retrieval smoke\",\n        \"issue_analysis_claim_allowed\": True,\n        \"code_repair_claim_allowed\": False,\n        \"broad_product_superiority_claim_allowed\": False,\n        \"confirmatory_claim_allowed\": False,\n        \"immediate_repetition_count\": repetition_count,\n        \"minimum_repetitions_for_future_confirmatory_repair_claim\": MIN_CONFIRMATORY_REPETITIONS,\n        \"executable_hidden_tests_required_for_future_confirmatory_repair_claim\": True,\n        \"current_protocol_has_executable_hidden_tests\": False,\n        \"repetition_requirement_satisfied\": repetition_count >= MIN_CONFIRMATORY_REPETITIONS,\n        \"confirmatory_repair_prerequisites_satisfied\": False,\n    }\n\n\ndef freeze_execution(\n    *, public_manifest: Path, sealed_oracle: Path,\n    hmac_disjointness_attestation: Path, materialization_attestation: Path,\n    materialized_root: Path, product_source: Path,\n    graph_binary: Path, cbm_binary: Path, agent_binary: Path,\n    cache_root: Path, output: Path,\n    model: str, max_turns: int, timeout_seconds: int,\n    prices: dict[str, Any], max_budget_usd_per_attempt: Any,\n    max_total_budget_usd: Any, repetition_count: int = DEFAULT_REPETITION_COUNT,\n    runtime_path_prefix: str = \"\",\n) -> dict[str, Any]:\n    \"\"\"Create the canonical unpaid execution freeze without running a model.\"\"\"\n    if not isinstance(model, str) or not model.strip():\n        raise IssueAnalysisError(\"model must be a non-empty exact identifier\")\n    if type(max_turns) is not int or max_turns < 1:\n        raise IssueAnalysisError(\"max_turns must be a positive integer\")\n    if type(timeout_seconds) is not int or timeout_seconds < 1:\n        raise IssueAnalysisError(\"timeout_seconds must be a positive integer\")\n    if type(repetition_count) is not int or repetition_count < 1:\n        raise IssueAnalysisError(\"repetition_count must be a positive integer\")\n\n    inputs, materialized = _materialized_input_bindings(\n        cohort_path=hmac_disjointness_attestation,\n        public_path=public_manifest,\n        sealed_path=sealed_oracle,\n        attestation_path=materialization_attestation,\n    )\n    public = inputs[\"public_task_manifest\"]\n    checkouts = _materialized_checkout_bindings(\n        materialized_root, materialized[\"public_cases\"],\n    )\n    product = _product_source_binding(product_source)\n    binaries = {\n        \"entire_graph\": _binary_binding(graph_binary, \"Entire Graph binary\"),\n        \"cbm\": _binary_binding(cbm_binary, \"CBM binary\"),\n    }\n    agent_runtime = _binary_binding(agent_binary, \"agent runtime binary\")\n    runner = _file_binding(Path(__file__), \"issue-analysis runner\")\n    frozen_prices = _pricing(prices)\n    seed = _schedule_seed(\n        public_manifest_sha256=public[\"sha256\"], product=product,\n        binaries=binaries, agent_runtime=agent_runtime,\n        model=model.strip(), repetition_count=repetition_count,\n    )\n    schedule = build_balanced_schedule(public[\"repository_ids\"], repetition_count, seed)\n    per_attempt = _decimal_string(\n        max_budget_usd_per_attempt, \"max_budget_usd_per_attempt\", positive=True,\n    )\n    total_budget = _decimal_string(max_total_budget_usd, \"max_total_budget_usd\", positive=True)\n    theoretical = Decimal(per_attempt) * schedule[\"paid_attempt_count_if_separately_authorized\"]\n    if Decimal(total_budget) > theoretical:\n        raise IssueAnalysisError(\"total budget may not exceed the sum of per-attempt caps\")\n    cache = _cache_layout(cache_root, schedule)\n    cache_path = Path(cache[\"root\"])\n    if cache_path == Path(product[\"path\"]) or cache_path.is_relative_to(Path(product[\"path\"])):\n        raise IssueAnalysisError(\"isolated caches may not live inside the product source checkout\")\n\n    document: dict[str, Any] = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": FREEZE_STAGE,\n        \"development_only\": True,\n        \"paid_execution_authorized\": False,\n        \"model_execution_authorized\": False,\n        **{field: False for field in AUTHORITY_FALSE_FIELDS},\n        \"inputs\": inputs,\n        \"materialized_root\": str(materialized_root.resolve(strict=True)),\n        \"checkouts\": checkouts,\n        \"product_source\": product,\n        \"binaries\": binaries,\n        \"agent_runtime\": agent_runtime,\n        \"runner\": runner,\n        \"prompt_bindings\": _prompt_bindings(materialized[\"public_cases\"], graph_binary.resolve(strict=True)),\n        \"allowed_tool_policy\": ALLOWED_TOOL_POLICY,\n        \"protocol\": {\n            \"systems\": list(SYSTEMS),\n            \"repository_count\": 3,\n            \"repetition_count\": repetition_count,\n            \"paired_attempts\": True,\n            \"model\": model.strip(),\n            \"max_turns_per_attempt\": max_turns,\n            \"timeout_seconds_per_attempt\": timeout_seconds,\n            \"runtime_path_prefix\": runtime_path_prefix,\n            \"prices_usd_per_million_tokens\": frozen_prices,\n            \"max_budget_usd_per_attempt\": per_attempt,\n            \"max_total_budget_usd\": total_budget,\n            \"paid_attempt_count_if_separately_authorized\": schedule[\n                \"paid_attempt_count_if_separately_authorized\"\n            ],\n        },\n        \"schedule\": schedule,\n        \"cache_policy\": cache,\n        \"timing_policy\": TIMING_POLICY,\n        \"graph_phase_telemetry_field_definitions\": GRAPH_PHASE_TELEMETRY_FIELD_DEFINITIONS,\n        \"claim_boundary\": _claim_boundary(repetition_count),\n        \"paid_execution_engine_present\": False,\n    }\n    _write_once_or_match(output, document, \"execution freeze\")\n    return document\n\n\ndef _validate_false_authority(\n    document: dict[str, Any], *, separate_paid_authorization: bool = False,\n) -> None:\n    paid = document.get(\"paid_execution_authorized\")\n    model = document.get(\"model_execution_authorized\")\n    if separate_paid_authorization:\n        if type(paid) is not bool or model is not paid:\n            raise IssueAnalysisError(\"authorization paid/model authority flags disagree\")\n    elif paid is not False or model is not False:\n        raise IssueAnalysisError(\"execution freeze grants paid or model authority\")\n    for field in AUTHORITY_FALSE_FIELDS:\n        if document.get(field) is not False:\n            raise IssueAnalysisError(f\"execution freeze must keep {field}=false\")\n\n\ndef validate_execution_freeze(path: Path) -> dict[str, Any]:\n    \"\"\"Recompute every live binding in an execution freeze without paid work.\"\"\"\n    document = artifacts.read_canonical_json(path, expected_type=dict).document\n    if (\n        document.get(\"schema_version\") != 1\n        or document.get(\"suite\") != SUITE\n        or document.get(\"stage\") != FREEZE_STAGE\n        or document.get(\"development_only\") is not True\n        or document.get(\"paid_execution_engine_present\") is not False\n    ):\n        raise IssueAnalysisError(\"execution freeze identity or development-only boundary changed\")\n    _validate_false_authority(document)\n    inputs = document.get(\"inputs\")\n    if type(inputs) is not dict:\n        raise IssueAnalysisError(\"execution freeze inputs are malformed\")\n    try:\n        recomputed_inputs, materialized = _materialized_input_bindings(\n            cohort_path=Path(inputs[\"hmac_disjointness_cohort\"][\"path\"]),\n            public_path=Path(inputs[\"public_task_manifest\"][\"path\"]),\n            sealed_path=Path(inputs[\"sealed_oracle\"][\"path\"]),\n            attestation_path=Path(inputs[\"materialization_attestation\"][\"path\"]),\n        )\n    except (KeyError, TypeError) as error:\n        raise IssueAnalysisError(\"execution freeze materialization bindings are malformed\") from error\n    if recomputed_inputs != inputs:\n        raise IssueAnalysisError(\"cohort/public/sealed/materialization bindings changed after freeze\")\n    public = inputs[\"public_task_manifest\"]\n    checkouts = _materialized_checkout_bindings(\n        Path(document[\"materialized_root\"]), materialized[\"public_cases\"],\n    )\n    if checkouts != document.get(\"checkouts\"):\n        raise IssueAnalysisError(\"materialized checkout head/tree bindings changed after freeze\")\n    product = _product_source_binding(Path(document[\"product_source\"][\"path\"]))\n    if product != document.get(\"product_source\"):\n        raise IssueAnalysisError(\"product source head/tree changed after freeze\")\n    binaries = document.get(\"binaries\")\n    if type(binaries) is not dict:\n        raise IssueAnalysisError(\"binary bindings are malformed\")\n    for field, label in ((\"entire_graph\", \"Entire Graph binary\"), (\"cbm\", \"CBM binary\")):\n        expected = binaries.get(field)\n        if type(expected) is not dict or _binary_binding(Path(expected[\"path\"]), label) != expected:\n            raise IssueAnalysisError(f\"{label} changed after freeze\")\n    agent_runtime = document.get(\"agent_runtime\")\n    if type(agent_runtime) is not dict or _binary_binding(\n        Path(agent_runtime[\"path\"]), \"agent runtime binary\",\n    ) != agent_runtime:\n        raise IssueAnalysisError(\"agent runtime binary changed after freeze\")\n    if _file_binding(Path(__file__), \"issue-analysis runner\") != document.get(\"runner\"):\n        raise IssueAnalysisError(\"issue-analysis runner changed after freeze\")\n    expected_prompts = _prompt_bindings(\n        materialized[\"public_cases\"], Path(binaries[\"entire_graph\"][\"path\"]),\n    )\n    if document.get(\"prompt_bindings\") != expected_prompts:\n        raise IssueAnalysisError(\"task/system prompt bindings changed after freeze\")\n    if document.get(\"allowed_tool_policy\") != ALLOWED_TOOL_POLICY:\n        raise IssueAnalysisError(\"allowed-tool policy changed after freeze\")\n\n    protocol = document.get(\"protocol\")\n    if type(protocol) is not dict or protocol.get(\"systems\") != list(SYSTEMS):\n        raise IssueAnalysisError(\"frozen protocol systems are malformed\")\n    repetition_count = protocol.get(\"repetition_count\")\n    if type(repetition_count) is not int or repetition_count < 1:\n        raise IssueAnalysisError(\"frozen repetition_count is malformed\")\n    if protocol.get(\"repository_count\") != 3 or protocol.get(\"paired_attempts\") is not True:\n        raise IssueAnalysisError(\"frozen protocol is not a three-repository paired design\")\n    if not isinstance(protocol.get(\"model\"), str) or not protocol[\"model\"]:\n        raise IssueAnalysisError(\"frozen model identifier is malformed\")\n    if not isinstance(protocol.get(\"runtime_path_prefix\"), str):\n        raise IssueAnalysisError(\"frozen runtime path prefix is malformed\")\n    if type(protocol.get(\"max_turns_per_attempt\")) is not int or protocol[\"max_turns_per_attempt\"] < 1:\n        raise IssueAnalysisError(\"frozen max-turns value is malformed\")\n    if type(protocol.get(\"timeout_seconds_per_attempt\")) is not int or protocol[\"timeout_seconds_per_attempt\"] < 1:\n        raise IssueAnalysisError(\"frozen timeout is malformed\")\n    if _pricing(protocol.get(\"prices_usd_per_million_tokens\")) != protocol.get(\n        \"prices_usd_per_million_tokens\"\n    ):\n        raise IssueAnalysisError(\"frozen prices are not canonical exact decimals\")\n    per_attempt = _decimal_string(\n        protocol.get(\"max_budget_usd_per_attempt\"), \"max_budget_usd_per_attempt\", positive=True,\n    )\n    total_budget = _decimal_string(\n        protocol.get(\"max_total_budget_usd\"), \"max_total_budget_usd\", positive=True,\n    )\n    if per_attempt != protocol.get(\"max_budget_usd_per_attempt\") or total_budget != protocol.get(\n        \"max_total_budget_usd\"\n    ):\n        raise IssueAnalysisError(\"frozen budgets are not canonical exact decimals\")\n    seed = _schedule_seed(\n        public_manifest_sha256=public[\"sha256\"], product=product,\n        binaries=binaries, agent_runtime=agent_runtime,\n        model=protocol.get(\"model\"), repetition_count=repetition_count,\n    )\n    expected_schedule = build_balanced_schedule(public[\"repository_ids\"], repetition_count, seed)\n    if document.get(\"schedule\") != expected_schedule:\n        raise IssueAnalysisError(\"deterministic balanced schedule changed after freeze\")\n    expected_attempts = expected_schedule[\"paid_attempt_count_if_separately_authorized\"]\n    if protocol.get(\"paid_attempt_count_if_separately_authorized\") != expected_attempts:\n        raise IssueAnalysisError(\"frozen paid-attempt cap differs from its schedule\")\n    if Decimal(total_budget) > Decimal(per_attempt) * expected_attempts:\n        raise IssueAnalysisError(\"frozen total budget exceeds per-attempt aggregate cap\")\n    expected_cache = _cache_layout(Path(document[\"cache_policy\"][\"root\"]), expected_schedule)\n    if document.get(\"cache_policy\") != expected_cache:\n        raise IssueAnalysisError(\"isolated cache layout changed after freeze\")\n    cache_root = Path(expected_cache[\"root\"])\n    if cache_root == Path(product[\"path\"]) or cache_root.is_relative_to(Path(product[\"path\"])):\n        raise IssueAnalysisError(\"frozen cache root overlaps the product source checkout\")\n    if document.get(\"timing_policy\") != TIMING_POLICY:\n        raise IssueAnalysisError(\"setup/task timing boundary changed after freeze\")\n    if document.get(\"graph_phase_telemetry_field_definitions\") != GRAPH_PHASE_TELEMETRY_FIELD_DEFINITIONS:\n        raise IssueAnalysisError(\"Graph phase telemetry definitions changed after freeze\")\n    if document.get(\"claim_boundary\") != _claim_boundary(repetition_count):\n        raise IssueAnalysisError(\"development-only claim boundary changed after freeze\")\n    return document\n\n\ndef _authorization_bindings(freeze: dict[str, Any], freeze_sha256: str) -> dict[str, Any]:\n    return {\n        \"execution_freeze_sha256\": freeze_sha256,\n        \"hmac_disjointness_cohort_sha256\": freeze[\"inputs\"][\n            \"hmac_disjointness_cohort\"\n        ][\"sha256\"],\n        \"public_manifest_sha256\": freeze[\"inputs\"][\"public_task_manifest\"][\"sha256\"],\n        \"sealed_oracle_sha256\": freeze[\"inputs\"][\"sealed_oracle\"][\"sha256\"],\n        \"materialization_attestation_sha256\": freeze[\"inputs\"][\n            \"materialization_attestation\"\n        ][\"sha256\"],\n        \"product_source_head\": freeze[\"product_source\"][\"head\"],\n        \"product_source_tree\": freeze[\"product_source\"][\"tree\"],\n        \"entire_graph_binary_sha256\": freeze[\"binaries\"][\"entire_graph\"][\"sha256\"],\n        \"cbm_binary_sha256\": freeze[\"binaries\"][\"cbm\"][\"sha256\"],\n        \"agent_runtime_sha256\": freeze[\"agent_runtime\"][\"sha256\"],\n        \"runner_sha256\": freeze[\"runner\"][\"sha256\"],\n        \"checkouts_sha256\": _document_sha256(freeze[\"checkouts\"]),\n        \"prompt_bindings_sha256\": _document_sha256(freeze[\"prompt_bindings\"]),\n        \"allowed_tool_policy_sha256\": _document_sha256(freeze[\"allowed_tool_policy\"]),\n        \"schedule_sha256\": freeze[\"schedule\"][\"schedule_sha256\"],\n        \"protocol_sha256\": _document_sha256(freeze[\"protocol\"]),\n        \"cache_policy_sha256\": _document_sha256(freeze[\"cache_policy\"]),\n        \"timing_policy_sha256\": _document_sha256(freeze[\"timing_policy\"]),\n        \"graph_phase_telemetry_definitions_sha256\": _document_sha256(\n            freeze[\"graph_phase_telemetry_field_definitions\"]\n        ),\n    }\n\n\ndef create_execution_authorization(\n    freeze_path: Path, output: Path, *, paid_execution_authorized: bool = False,\n    authorization_note: str = \"unpaid freeze only; no paid/model execution authorized\",\n) -> dict[str, Any]:\n    \"\"\"Write a separate exact-hash authorization; false is the safe default.\"\"\"\n    if type(paid_execution_authorized) is not bool:\n        raise IssueAnalysisError(\"paid_execution_authorized must be an exact boolean\")\n    if not isinstance(authorization_note, str) or not authorization_note.strip():\n        raise IssueAnalysisError(\"authorization_note must be non-empty\")\n    freeze = validate_execution_freeze(freeze_path)\n    freeze_sha256 = artifacts.sha256_file(freeze_path)\n    document = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": AUTHORIZATION_STAGE,\n        \"development_only\": True,\n        \"paid_execution_authorized\": paid_execution_authorized,\n        \"model_execution_authorized\": paid_execution_authorized,\n        **{field: False for field in AUTHORITY_FALSE_FIELDS},\n        \"authorization_note\": authorization_note.strip(),\n        \"bindings\": _authorization_bindings(freeze, freeze_sha256),\n    }\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
