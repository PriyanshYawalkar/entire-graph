{"timestamp":"2026-07-18T16:36:57.505Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5baba986448191a9d336f83da02307","status":"completed","call_id":"call_jXIF9ACwjrtQxnqQQCy6sNJI","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '1,180p' competitive-eval/tools/test_freeze_agentic_issue_analysis_smoke.py && sed -n '200,460p' competitive-eval/tools/test_freeze_agentic_issue_analysis_smoke.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 40000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:36:57.729Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7616-8f01-7ae1-80ac-43db078c7d13","call_id":"call_jXIF9ACwjrtQxnqQQCy6sNJI","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"from __future__ import annotations\n\nimport copy\nimport hashlib\nimport inspect\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\n\nimport freeze_agentic_issue_analysis_smoke as subject\n\n\ndef write_json(path: Path, document: object) -> str:\n    subject.artifacts.write_new_canonical_json(path, document)\n    return subject.artifacts.sha256_file(path)\n\n\ndef write_key(path: Path, value: bytes = b\"k\" * 32) -> Path:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_bytes(value)\n    path.chmod(0o600)\n    return path\n\n\ndef exclusion_document(key: bytes, repositories: list[str]) -> dict[str, Any]:\n    hashes = sorted(\n        subject.exclusion_freezer.identity_hmac(repo, key) for repo in repositories\n    )\n    return {\n        \"schema_version\": 1,\n        \"suite\": subject.graph_v8.SUITE,\n        \"stage\": \"frozen_graph_v8_repository_exclusions_before_catalog\",\n        \"policy_sha256\": \"a\" * 64,\n        \"catalog_construction_authorized\": False,\n        \"rank_production_authorized\": False,\n        \"identity_representation\": (\n            \"hmac_sha256_of_normalized_owner_slash_repository_utf8\"\n        ),\n        \"identity_hmac_key_sha256\": hashlib.sha256(key).hexdigest(),\n        \"generator_sha256\": \"b\" * 64,\n        \"producer_dependency_bindings\": {\n            \"artifact_contract_sha256\": subject.artifacts.sha256_file(\n                Path(subject.artifacts.__file__)\n            ),\n            \"normalization_source_sha256\": subject.artifacts.sha256_file(\n                Path(subject.graph_v8.__file__)\n            ),\n        },\n        \"source_bindings\": {\"synthetic\": {\"sha256\": \"c\" * 64}},\n        \"repository_count\": len(hashes),\n        \"repository_identity_hmac_sha256\": hashes,\n    }\n\n\ndef prior_spike(repositories: list[str]) -> dict[str, Any]:\n    return {\n        \"schema_version\": 1,\n        \"suite\": \"core_bench_level2_feasibility_spike\",\n        \"selection\": {\"repository_count\": len(repositories)},\n        \"repositories\": [\n            {\"repo\": repo, \"normalized_repo\": subject.graph_v8.normalize_repo(repo)}\n            for repo in repositories\n        ],\n        \"cases\": [{\"query\": \"controller-only\", \"qrels\": [\"controller-only\"]}],\n    }\n\n\ndef cohort(repositories: list[str]) -> dict[str, Any]:\n    return {\n        \"schema_version\": 1,\n        \"suite\": \"synthetic_post_freeze_cohort\",\n        \"stage\": \"synthetic_public_repository_inventory\",\n        \"repository_count\": len(repositories),\n        \"repositories\": [\n            {\n                \"repository\": repo,\n                \"controller_expected\": {\"answer\": \"must remain controller-only\"},\n            }\n            for repo in repositories\n        ],\n        \"cases\": [{\"expected\": \"must not be projected\", \"score\": 1.0}],\n    }\n\n\ndef source_rows(\n    repo: str,\n    language: str,\n    *,\n    count: int = subject.MINIMUM_INSTANCES_PER_REPOSITORY,\n    prefix: str | None = None,\n) -> list[dict[str, Any]]:\n    identity_prefix = prefix or repo\n    return [\n        {\n            \"instance_id\": f\"{identity_prefix}:instance-{index}\",\n            \"repo\": repo,\n            \"language\": language,\n            # Injected readers may return unrelated fields.  The selector must\n            # neither consult nor project them.\n            \"outcome\": f\"secret-outcome-{index}\",\n            \"score\": index / 10,\n            \"query\": f\"secret-query-{index}\",\n        }\n        for index in range(count)\n    ]\n\n\ndef base_rows() -> list[dict[str, Any]]:\n    return [\n        *source_rows(\"https://github.com/OWNER/PROTECTED.git\", \"Go\"),\n        *source_rows(\"owner/ineligible-protected\", \"Go\", count=5),\n        *source_rows(\"owner/prior\", \"Rust\"),\n        *source_rows(\"owner/post\", \"TypeScript\"),\n        *source_rows(\"owner/one\", \"Python\"),\n        *source_rows(\"owner/two\", \"Java\"),\n        *source_rows(\"owner/three\", \"C\"),\n        *source_rows(\"owner/four\", \"C++\"),\n        *source_rows(\"owner/small\", \"Ruby\", count=5),\n        *source_rows(\"owner/multi\", \"Swift\", count=3),\n        *source_rows(\"owner/multi\", \"Kotlin\", count=3, prefix=\"owner/multi-k\"),\n    ]\n\n\ndef fixture_paths(\n    tmp_path: Path,\n    monkeypatch: pytest.MonkeyPatch,\n    *,\n    rows: list[dict[str, Any]],\n    protected: list[str] = (),\n    prior: list[str] = (),\n    post: list[str] = (),\n) -> dict[str, Any]:\n    key = b\"k\" * 32\n    source_path = tmp_path / \"host-private-source-name.parquet\"\n    source_path.parent.mkdir(parents=True, exist_ok=True)\n    source_path.write_bytes(b\"synthetic projected parquet fixture\\n\")\n    source_digest = subject.artifacts.sha256_file(source_path)\n    monkeypatch.setattr(subject, \"SOURCE_PARQUET_SHA256\", source_digest)\n    monkeypatch.setattr(subject, \"SOURCE_PARQUET_BYTES\", source_path.stat().st_size)\n    monkeypatch.setattr(subject, \"SOURCE_ROW_COUNT\", len(rows))\n\n    prior_path = tmp_path / \"prior-spike.json\"\n    cohort_path = tmp_path / \"post-freeze.json\"\n    exclusions_path = tmp_path / \"exclusions.json\"\n    key_path = write_key(tmp_path / \"identity-key\", key)\n\n    # Production has no exclusion bypass.  Synthetic tests point the mandatory\n    # loader at an empty frozen-input inventory while still exercising the\n    # prior, protected, repair-public, and supplemental exclusion code path.\n    repository_root = tmp_path / \"synthetic-repository-root\"\n    (repository_root / \"competitive-eval/agentic-repair-pilot\").mkdir(\n        parents=True, exist_ok=True\n    )\n    monkeypatch.setattr(subject, \"DEFAULT_POST_FREEZE_COHORTS\", ())\n    monkeypatch.setattr(subject, \"DEFAULT_REPAIR_RUNS\", ())\n\n    def reader(_path: Path) -> subject.SourceMetadata:\n        return subject.SourceMetadata(\n            rows=copy.deepcopy(rows),\n            row_count=len(rows),\n            projected_schema=subject.SOURCE_PROJECTED_SCHEMA,\n        )\n\n    return {\n        \"source_parquet_path\": source_path,\n        \"source_reader\": reader,\n        \"prior_spike_path\": prior_path,\n        \"prior_spike_sha256\": write_json(prior_path, prior_spike(list(prior))),\n        \"exclusions_path\": exclusions_path,\n        \"exclusions_sha256\": write_json(\n            exclusions_path, exclusion_document(key, list(protected))\n        ),\n        \"identity_key_path\": key_path,\n        \"supplemental_cohort_paths\": (cohort_path,),\n        \"repository_root\": repository_root,\n        \"cohort_path\": cohort_path,\n        \"cohort_sha256\": write_json(cohort_path, cohort(list(post))),\n        \"rows\": rows,\n        and str(row[\"repo\"]) in {\n            \"owner/one\", \"owner/two\", \"owner/three\", \"owner/four\"\n        }\n    }\n    languages = sorted(\n        available,\n        key=lambda language: (\n            subject.selection_digest(\"language\", language, key),\n            language,\n        ),\n    )[:3]\n    return [available[language] for language in languages]\n\n\ndef test_freeze_is_identity_safe_deterministic_diverse_and_public_only(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n):\n    rows = base_rows()\n    paths = fixture_paths(\n        tmp_path,\n        monkeypatch,\n        rows=rows,\n        protected=[\"owner/protected\", \"owner/ineligible-protected\"],\n        prior=[\"owner/prior\"],\n        post=[\"owner/post\"],\n    )\n    manifest = build(paths)\n\n    assert [row[\"normalized_repo\"] for row in manifest[\"repositories\"]] == (\n        expected_selection(rows, b\"k\" * 32)\n    )\n    languages = [row[\"language\"] for row in manifest[\"repositories\"]]\n    assert len(set(languages)) == 3\n    assert manifest[\"selection\"][\"selected_languages\"] == languages\n    assert manifest[\"repository_count\"] == subject.REPOSITORY_COUNT == 3\n    assert manifest[\"suite\"] == \"entire_graph_agentic_issue_analysis_smoke_v1\"\n    assert manifest[\"development_only\"] is True\n    assert manifest[\"claim_boundary\"] == {\n        \"issue_analysis_development_smoke_only\": True,\n        \"code_repair_claim_allowed\": False,\n        \"broad_superiority_claim_allowed\": False,\n        \"confirmatory_claim_allowed\": False,\n    }\n    assert manifest[\"selection_counts\"] == {\n        \"source_row_count\": len(rows),\n        \"source_unique_instance_count\": len(rows),\n        \"source_duplicate_instance_row_count\": 0,\n        \"source_repository_identity_count\": 10,\n        \"metadata_eligible_repository_count\": 7,\n        \"source_protected_union_match_count\": 2,\n        \"source_explicit_cohort_match_count\": 2,\n        \"eligible_nonmatching_repository_count\": 4,\n        \"eligible_nonmatching_language_count\": 4,\n        \"selected_repository_count\": 3,\n        \"selected_language_count\": 3,\n    }\n    assert all(manifest[field] is False for field in subject.FALSE_AUTHORITY_FIELDS)\n    assert all(manifest[field] is False for field in subject.ABSENT_DATA_FIELDS)\n    assert manifest[\"selection\"][\"model_or_paid_process_used\"] is False\n    assert manifest[\"selection\"][\"all_source_languages_eligible\"] is True\n    assert manifest[\"selection\"][\"mandatory_default_post_freeze_exclusions_applied\"] is True\n    assert all(\n        set(row) == {\"repo\", \"normalized_repo\", \"language\", \"selection_rank\"}\n        for row in manifest[\"repositories\"]\n    )\n\n    source_binding = manifest[\"source_bindings\"][\"swe_rebench_v2_metadata\"]\n    assert source_binding == {\n        \"dataset\": subject.SOURCE_DATASET,\n        \"dataset_revision\": subject.SOURCE_DATASET_REVISION,\n        \"dataset_metadata_sha256\": subject.SOURCE_DATASET_METADATA_SHA256,\n        \"parquet_revision\": subject.SOURCE_PARQUET_REVISION,\n        \"logical_path\": \"data/train-00000-of-00001.parquet\",\n        \"sha256\": subject.SOURCE_PARQUET_SHA256,\n        \"byte_count\": subject.SOURCE_PARQUET_BYTES,\n        \"row_count\": len(rows),\n        \"projected_schema\": list(subject.SOURCE_PROJECTED_SCHEMA),\n    }\n    serialized = subject.artifacts.canonical_bytes(manifest).decode()\n    assert str(tmp_path) not in serialized\n    assert \"host-private-source-name.parquet\" not in serialized\n    for forbidden in (\n        \"owner/protected\",\n        \"OWNER/PROTECTED\",\n        \"owner/ineligible-protected\",\n        \"owner/prior\",\n        \"owner/post\",\n        \"secret-query\",\n        \"secret-outcome\",\n        \"must remain controller-only\",\n    ):\n        assert forbidden not in serialized\n    assert \"repository_identity_hmac_sha256\" not in serialized\n    assert \"selection_digest\" not in serialized\n\n\ndef test_selection_uses_language_then_repository_keyed_rank(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n):\n    rows: list[dict[str, Any]] = []\n    for language in (\"Go\", \"Rust\", \"Python\", \"Java\"):\n        rows.extend(source_rows(f\"owner/{language.casefold()}-one\", language))\n        rows.extend(source_rows(f\"owner/{language.casefold()}-two\", language))\n    paths = fixture_paths(tmp_path, monkeypatch, rows=rows)\n    manifest = build(paths)\n\n    expected_languages = sorted(\n        {str(row[\"language\"]).casefold() for row in rows},\n        key=lambda language: (\n            subject.selection_digest(\"language\", language, b\"k\" * 32),\n            language,\n        ),\n    )[:3]\n    assert manifest[\"selection\"][\"selected_languages\"] == expected_languages\n    for selected in manifest[\"repositories\"]:\n        language = selected[\"language\"]\n        expected_repo = min(\n            {\n                subject.graph_v8.normalize_repo(str(row[\"repo\"]))\n                for row in rows\n                if str(row[\"language\"]).casefold() == language\n            },\n            key=lambda repo: (\n                subject.selection_digest(f\"repository:{language}\", repo, b\"k\" * 32),\n                repo,\n            ),\n        )\n        assert selected[\"normalized_repo\"] == expected_repo\n\n\ndef test_selection_does_not_depend_on_source_order_or_unconsulted_fields(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n):\n    rows = [\n        row\n        for index in range(7)\n        for row in source_rows(f\"owner/repo-{index}\", f\"language-{index}\")\n    ]\n    first_paths = fixture_paths(tmp_path / \"first\", monkeypatch, rows=rows)\n    first = build(first_paths)\n\n    second_rows = list(reversed(copy.deepcopy(rows)))\n    for index, row in enumerate(second_rows):\n        row[\"outcome\"] = f\"different-outcome-{index}\"\n        row[\"score\"] = -index\n        row[\"query\"] = f\"different-query-{index}\"\n    second_paths = fixture_paths(tmp_path / \"second\", monkeypatch, rows=second_rows)\n    second = build(second_paths)\n    assert first[\"repositories\"] == second[\"repositories\"]\n    assert first[\"selection\"] == second[\"selection\"]\n    assert first[\"selection_counts\"] == second[\"selection_counts\"]\n\n\ndef test_every_identity_bearing_row_is_hmac_checked_before_eligibility(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n):\n    rows = [\n        *source_rows(\"owner/protected\", \"Go\", count=5),\n        *source_rows(\"owner/python\", \"Python\"),\n        *source_rows(\"owner/rust\", \"Rust\"),\n        *source_rows(\"owner/java\", \"Java\"),\n    ]\n    paths = fixture_paths(\n        tmp_path, monkeypatch, rows=rows, protected=[\"OWNER/PROTECTED\"]\n    )\n    original = subject.exclusion_freezer.identity_hmac\n    checked: list[str] = []\n\n    def checking(repo: str, key: bytes) -> str:\n        checked.append(repo)\n        return original(repo, key)\n\n    monkeypatch.setattr(subject.exclusion_freezer, \"identity_hmac\", checking)\n    manifest = build(paths)\n    assert len(checked) == len(rows)\n    assert manifest[\"selection_counts\"][\"source_protected_union_match_count\"] == 1\n    assert manifest[\"selection_counts\"][\"metadata_eligible_repository_count\"] == 3\n\n\ndef test_exact_duplicate_instances_are_deduplicated_and_counted(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n):\n    rows = [\n        *source_rows(\"owner/go\", \"Go\"),\n        *source_rows(\"owner/rust\", \"Rust\"),\n        *source_rows(\"owner/python\", \"Python\"),\n    ]\n    rows.append(copy.deepcopy(rows[0]))\n    paths = fixture_paths(tmp_path, monkeypatch, rows=rows)\n    manifest = build(paths)\n    assert manifest[\"selection_counts\"][\"source_row_count\"] == len(rows)\n    assert manifest[\"selection_counts\"][\"source_unique_instance_count\"] == len(rows) - 1\n    assert manifest[\"selection_counts\"][\"source_duplicate_instance_row_count\"] == 1\n\n\ndef test_duplicate_instance_with_disagreeing_metadata_fails_closed(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n):\n    rows = [\n        *source_rows(\"owner/go\", \"Go\"),\n        *source_rows(\"owner/rust\", \"Rust\"),\n        *source_rows(\"owner/python\", \"Python\"),\n    ]\n    conflict = copy.deepcopy(rows[0])\n    conflict[\"repo\"] = \"owner/different\"\n    rows.append(conflict)\n    paths = fixture_paths(tmp_path, monkeypatch, rows=rows)\n    with pytest.raises(subject.SliceError, match=\"metadata disagrees\"):\n        build(paths)\n\n\ndef test_multiple_byte_distinct_source_spellings_fail_closed(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n):\n    rows = [\n        *source_rows(\"Owner/Repo\", \"Go\", count=3),\n        *source_rows(\n            \"https://github.com/owner/repo.git\",\n            \"Go\",\n            count=3,\n            prefix=\"owner/repo-alias\",\n        ),\n        *source_rows(\"owner/rust\", \"Rust\"),\n        *source_rows(\"owner/python\", \"Python\"),\n        *source_rows(\"owner/java\", \"Java\"),\n    ]\n    paths = fixture_paths(tmp_path, monkeypatch, rows=rows)\n    with pytest.raises(subject.SliceError, match=\"byte-distinct spellings\") as raised:\n        build(paths)\n    assert \"Owner/Repo\" not in str(raised.value)\n\n\ndef test_selected_repo_preserves_exact_source_spelling(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n):\n    rows = [\n        *source_rows(\"Owner/GoRepo\", \"Go\"),\n        *source_rows(\"OWNER/RustRepo\", \"Rust\"),\n        *source_rows(\"owner/PythonRepo\", \"Python\"),\n    ]\n    paths = fixture_paths(tmp_path, monkeypatch, rows=rows)\n    manifest = build(paths)\n    source_spellings = {str(row[\"repo\"]) for row in rows}\n    assert {row[\"repo\"] for row in manifest[\"repositories\"]} == source_spellings\n    assert all(row[\"repo\"] != row[\"normalized_repo\"] for row in manifest[\"repositories\"])\n\n\ndef test_insufficient_cohort_error_discloses_count_not_matching_identity(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n):\n    secret = \"owner/protected-secret\"\n    rows = [\n        *source_rows(secret, \"Go\"),\n        *source_rows(\"owner/python\", \"Python\"),\n        *source_rows(\"owner/rust\", \"Rust\"),\n    ]\n    paths = fixture_paths(tmp_path, monkeypatch, rows=rows, protected=[secret])\n    with pytest.raises(subject.SliceError) as raised:\n        build(paths)\n    assert \"2 available\" in str(raised.value)\n    assert secret not in str(raised.value)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
