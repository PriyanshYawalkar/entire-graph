{"timestamp":"2026-07-18T16:27:40.553Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5ba97c8d508191af3e61e9526c3581","status":"completed","call_id":"call_yrZprW0MYY3HIPv972dhYsmn","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"stat -f '%z' /private/tmp/swe-rebench-v2-550a7d2a-0000.parquet && sed -n '330,550p' competitive-eval/tools/freeze_agentic_issue_analysis_smoke.py && sed -n '570,810p' competitive-eval/tools/freeze_agentic_issue_analysis_smoke.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 50000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:27:40.740Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f760e-0f44-7942-8eb3-0a59128e4ace","call_id":"call_yrZprW0MYY3HIPv972dhYsmn","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"428839266\n    policy_sha256 = artifacts.require_sha256(\n        opened.document.get(\"policy_sha256\"), \"exclusion freeze policy SHA-256\"\n    )\n    artifacts.require_int(\n        opened.document.get(\"repository_count\"),\n        \"exclusion freeze repository count\",\n        minimum=0,\n    )\n    excluded, key, _bindings = graph_v8._excluded_repositories(\n        Path(path), Path(key_path), expected_sha256, policy_sha256\n    )\n    return excluded, key, opened.document, opened.sha256\n\n\ndef _schema_descriptor(schema: Any) -> tuple[dict[str, str], ...]:\n    \"\"\"Project Arrow schema objects without importing Arrow at module import time.\"\"\"\n\n    return tuple(\n        {\"name\": str(field.name), \"arrow_type\": str(field.type)} for field in schema\n    )\n\n\ndef read_source_metadata(path: Path) -> SourceMetadata:\n    \"\"\"Read only the three permitted identity/count parquet columns.\"\"\"\n\n    import pyarrow.parquet as pq\n\n    parquet = pq.ParquetFile(path)\n    rows: list[dict[str, Any]] = []\n    projected_schema: tuple[dict[str, str], ...] | None = None\n    for batch in parquet.iter_batches(\n        batch_size=4096, columns=list(SOURCE_METADATA_COLUMNS)\n    ):\n        observed = _schema_descriptor(batch.schema)\n        if projected_schema is None:\n            projected_schema = observed\n        elif observed != projected_schema:\n            raise SliceError(\"source parquet projected schema changed between batches\")\n        rows.extend(batch.to_pylist())\n    if projected_schema is None:\n        raise SliceError(\"source parquet has no metadata rows\")\n    return SourceMetadata(\n        rows=rows,\n        row_count=parquet.metadata.num_rows,\n        projected_schema=projected_schema,\n    )\n\n\ndef _validated_source(\n    path: Path, source_reader: SourceReader | None\n) -> tuple[SourceMetadata, int]:\n    \"\"\"Validate exact source bytes before invoking even the metadata-only reader.\"\"\"\n\n    observation = artifacts.observe_regular_file(\n        Path(path), maximum_bytes=MAXIMUM_SOURCE_BYTES\n    )\n    if observation.sha256 != SOURCE_PARQUET_SHA256:\n        raise SliceError(\"source parquet SHA-256 mismatch\")\n    if observation.byte_count != SOURCE_PARQUET_BYTES:\n        raise SliceError(\"source parquet byte count mismatch\")\n    reader = read_source_metadata if source_reader is None else source_reader\n    source = reader(Path(path))\n    artifacts.assert_file_stat_identity(\n        Path(path), observation.stat_identity, \"source parquet\"\n    )\n    if type(source) is not SourceMetadata:\n        raise SliceError(\"source metadata reader returned a malformed result\")\n    if source.row_count != SOURCE_ROW_COUNT:\n        raise SliceError(\"source parquet row count mismatch\")\n    if len(source.rows) != source.row_count:\n        raise SliceError(\"source parquet projected row count mismatch\")\n    if source.projected_schema != SOURCE_PROJECTED_SCHEMA:\n        raise SliceError(\"source parquet projected schema mismatch\")\n    return source, observation.byte_count\n\n\ndef _source_candidates(\n    rows: list[dict[str, Any]],\n    protected: set[str],\n    key: bytes,\n    explicit: set[str],\n) -> tuple[list[dict[str, Any]], dict[str, int], list[str]]:\n    \"\"\"Aggregate permitted metadata, then make one keyed diverse selection.\"\"\"\n\n    instances: dict[str, tuple[str, str]] = {}\n    repositories: dict[str, dict[str, Any]] = {}\n    duplicate_instance_rows = 0\n\n    for row in rows:\n        if type(row) is not dict:\n            raise SliceError(\"source metadata row is malformed\")\n        instance_id = artifacts.require_string(\n            row.get(\"instance_id\"), \"source instance identity\"\n        ).strip()\n        if not instance_id:\n            raise SliceError(\"source instance identity is empty\")\n        raw_repo = artifacts.require_string(\n            row.get(\"repo\"), \"source repository identity\"\n        )\n        if not raw_repo.strip():\n            raise SliceError(\"source repository identity is empty\")\n        canonical, normalized = canonical_public_repo(raw_repo)\n        language = artifacts.require_string(\n            row.get(\"language\"), \"source language\"\n        ).strip().casefold()\n        if not language:\n            raise SliceError(\"source language is empty\")\n\n        # This check occurs for every identity-bearing physical row, before\n        # eligibility or duplicate-instance handling.\n        identity_hash = exclusion_freezer.identity_hmac(canonical, key)\n        protected_match = identity_hash in protected\n\n        identity = (normalized, language)\n        previous = instances.get(instance_id)\n        if previous is not None:\n            if previous != identity:\n                raise SliceError(\"duplicate source instance identity metadata disagrees\")\n            duplicate_instance_rows += 1\n            continue\n        instances[instance_id] = identity\n\n        repository = repositories.setdefault(\n            normalized,\n            {\n                \"source_variants\": set(),\n                \"languages\": set(),\n                \"instance_ids\": set(),\n                \"protected_match\": protected_match,\n                \"explicit_match\": normalized in explicit,\n            },\n        )\n        if repository[\"protected_match\"] != protected_match:\n            raise SliceError(\"normalized source repository HMAC classification disagrees\")\n        # Preserve the selected source spelling byte-for-byte for the sealed\n        # materializer's projected Arrow filter.  Normalization is separate.\n        repository[\"source_variants\"].add(raw_repo)\n        repository[\"languages\"].add(language)\n        repository[\"instance_ids\"].add(instance_id)\n\n    candidates: list[dict[str, Any]] = []\n    protected_matches = 0\n    explicit_matches = 0\n    metadata_eligible = 0\n    for normalized, repository in repositories.items():\n        languages = repository[\"languages\"]\n        eligible = (\n            len(repository[\"instance_ids\"]) >= MINIMUM_INSTANCES_PER_REPOSITORY\n            and len(languages) == 1\n        )\n        protected_match = bool(repository[\"protected_match\"])\n        explicit_match = bool(repository[\"explicit_match\"])\n        protected_matches += int(protected_match)\n        explicit_matches += int(explicit_match)\n        metadata_eligible += int(eligible)\n        if not eligible or protected_match or explicit_match:\n            continue\n        candidates.append(\n            {\n                \"repo\": min(\n                    repository[\"source_variants\"],\n                    key=lambda value: (value.casefold(), value),\n                ),\n                \"normalized_repo\": normalized,\n                \"language\": next(iter(languages)),\n            }\n        )\n\n    by_language: dict[str, list[dict[str, Any]]] = {}\n    for candidate in candidates:\n        by_language.setdefault(candidate[\"language\"], []).append(candidate)\n    ranked_languages = sorted(\n        by_language,\n        key=lambda language: (\n            selection_digest(\"language\", language, key),\n            language,\n        ),\n    )\n    if len(ranked_languages) < REPOSITORY_COUNT:\n        # Count-only failure: never identify a protected or explicitly excluded\n        # repository, nor disclose a skipped language.\n        raise SliceError(\n            \"fewer than three eligible nonmatching languages \"\n            f\"({len(ranked_languages)} available)\"\n        )\n\n    selected_languages = ranked_languages[:REPOSITORY_COUNT]\n    selected: list[dict[str, Any]] = []\n    for language in selected_languages:\n        ranked_repositories = sorted(\n            by_language[language],\n            key=lambda row: (\n                selection_digest(\n                    f\"repository:{language}\", row[\"normalized_repo\"], key\n                ),\n                row[\"normalized_repo\"],\n            ),\n        )\n        selected.append(ranked_repositories[0])\n\n    return selected, {\n        \"source_row_count\": len(rows),\n        \"source_unique_instance_count\": len(instances),\n        \"source_duplicate_instance_row_count\": duplicate_instance_rows,\n        \"source_repository_identity_count\": len(repositories),\n        \"metadata_eligible_repository_count\": metadata_eligible,\n        \"source_protected_union_match_count\": protected_matches,\n        \"source_explicit_cohort_match_count\": explicit_matches,\n        \"eligible_nonmatching_repository_count\": len(candidates),\n        \"eligible_nonmatching_language_count\": len(by_language),\n        \"selected_repository_count\": REPOSITORY_COUNT,\n        \"selected_language_count\": REPOSITORY_COUNT,\n    }, selected_languages\n\n\ndef _binding(\n    path: Path, digest: str, repository_count: int | None = None\n) -> dict[str, Any]:\n    result: dict[str, Any] = {\"path\": path_label(path), \"sha256\": digest}\n    if repository_count is not None:\n        result[\"repository_count\"] = repository_count\n\n    run_directory = repository_root / \"competitive-eval/agentic-repair-pilot\"\n    expected_names = {Path(frozen.relative_path).name for frozen in DEFAULT_REPAIR_RUNS}\n    observed_names = {path.name for path in run_directory.glob(\"*.json\")}\n    if observed_names != expected_names:\n        raise SliceError(\"repair-pilot JSON run inventory changed\")\n    run_bindings: list[dict[str, Any]] = []\n    for frozen in DEFAULT_REPAIR_RUNS:\n        path = repository_root / frozen.relative_path\n        opened = load_json(path, expected_sha256=frozen.sha256)\n        count = validate_repair_run(opened.document, path)\n        run_bindings.append(_binding(path, opened.sha256, count))\n    identities.update(\n        canonical_public_repo(repository)[1]\n        for repository in REPAIR_PILOT_PUBLIC_REPOSITORIES\n    )\n    return identities, cohort_bindings, run_bindings\n\n\ndef build_manifest(\n    *,\n    source_parquet_path: Path,\n    prior_spike_path: Path,\n    prior_spike_sha256: str,\n    exclusions_path: Path,\n    exclusions_sha256: str,\n    identity_key_path: Path,\n    supplemental_cohort_paths: Sequence[Path] = (),\n    repository_root: Path = ROOT,\n    source_reader: SourceReader | None = None,\n    include_default_post_freeze: bool = True,\n) -> dict[str, Any]:\n    prior = load_json(prior_spike_path, expected_sha256=prior_spike_sha256)\n    prior_repositories = extract_prior_spike(prior.document)\n\n    explicit_repositories = set(prior_repositories)\n    default_cohort_bindings: list[dict[str, Any]] = []\n    repair_run_bindings: list[dict[str, Any]] = []\n    if include_default_post_freeze:\n        defaults, default_cohort_bindings, repair_run_bindings = (\n            _load_default_post_freeze_inputs(Path(repository_root))\n        )\n        explicit_repositories.update(defaults)\n\n    supplemental_bindings: list[dict[str, Any]] = []\n    labels: set[str] = set()\n    resolved_paths: set[Path] = set()\n    for path in supplemental_cohort_paths:\n        resolved = Path(path).absolute()\n        label = path_label(resolved)\n        if resolved in resolved_paths or label in labels:\n            raise SliceError(\"supplemental cohort inputs must be distinct\")\n        resolved_paths.add(resolved)\n        labels.add(label)\n        opened = load_json(resolved)\n        repositories = extract_public_repositories(\n            opened.document, label=resolved.name\n        )\n        explicit_repositories.update(repositories)\n        supplemental_bindings.append(_binding(resolved, opened.sha256, len(repositories)))\n\n    protected, key, exclusion_document, exclusion_digest = _load_protected_union(\n        exclusions_path, identity_key_path, exclusions_sha256\n    )\n    source, source_byte_count = _validated_source(source_parquet_path, source_reader)\n    selected, counts, selected_languages = _source_candidates(\n        source.rows, protected, key, explicit_repositories\n    )\n    repositories = [\n        {\n            \"repo\": row[\"repo\"],\n            \"normalized_repo\": row[\"normalized_repo\"],\n            \"language\": row[\"language\"],\n            \"selection_rank\": index,\n        }\n        for index, row in enumerate(selected, 1)\n    ]\n\n    flags = {field: False for field in (*FALSE_AUTHORITY_FIELDS, *ABSENT_DATA_FIELDS)}\n    return {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": STAGE,\n        **flags,\n        \"development_only\": True,\n        \"public_selection_metadata_only\": True,\n        \"identity_representation\": (\n            \"hmac_sha256_of_normalized_owner_slash_repository_utf8\"\n        ),\n        \"identity_hmac_key_sha256\": hashlib.sha256(key).hexdigest(),\n        \"generator_sha256\": artifacts.sha256_file(Path(__file__)),\n        \"producer_dependency_bindings\": {\n            \"artifact_contract_sha256\": artifacts.sha256_file(Path(artifacts.__file__)),\n            \"normalization_source_sha256\": artifacts.sha256_file(Path(graph_v8.__file__)),\n            \"identity_hmac_source_sha256\": artifacts.sha256_file(\n                Path(exclusion_freezer.__file__)\n            ),\n        },\n        \"source_bindings\": {\n            \"swe_rebench_v2_metadata\": {\n                \"dataset\": SOURCE_DATASET,\n                \"dataset_revision\": SOURCE_DATASET_REVISION,\n                \"parquet_revision\": SOURCE_PARQUET_REVISION,\n                \"logical_path\": SOURCE_LOGICAL_PATH,\n                \"sha256\": SOURCE_PARQUET_SHA256,\n                \"byte_count\": source_byte_count,\n                \"row_count\": source.row_count,\n                \"projected_schema\": list(source.projected_schema),\n            },\n            \"prior_spike_selection\": _binding(\n                prior_spike_path, prior.sha256, len(prior_repositories)\n            ),\n            \"protected_exclusion_freeze\": _binding(\n                exclusions_path,\n                exclusion_digest,\n                int(exclusion_document[\"repository_count\"]),\n            ),\n            \"default_post_freeze_cohorts\": default_cohort_bindings,\n            \"repair_pilot_run_bindings\": repair_run_bindings,\n            \"supplemental_post_freeze_cohorts\": supplemental_bindings,\n        },\n        \"selection\": {\n            \"algorithm\": (\n                \"keyed_language_then_repository_hmac_sha256_v1\"\n            ),\n            \"seed\": SELECTION_SEED,\n            \"repository_count\": REPOSITORY_COUNT,\n            \"distinct_language_count\": REPOSITORY_COUNT,\n            \"minimum_unique_instances_per_repository\": (\n                MINIMUM_INSTANCES_PER_REPOSITORY\n            ),\n            \"selected_languages\": selected_languages,\n            \"mandatory_default_post_freeze_exclusions_applied\": (\n                include_default_post_freeze\n            ),\n            \"identity_and_count_metadata_consulted\": True,\n            \"all_source_languages_eligible\": True,\n            \"repository_identity_disjointness_consulted\": True,\n            \"query_content_consulted\": False,\n            \"patch_data_consulted\": False,\n            \"query_or_qrel_identity_consulted\": False,\n            \"qrel_data_consulted\": False,\n            \"expected_outcome_data_consulted\": False,\n            \"rank_data_consulted\": False,\n            \"score_data_consulted\": False,\n            \"system_output_data_consulted\": False,\n            \"model_or_paid_process_used\": False,\n        },\n        \"claim_boundary\": {\n            \"issue_analysis_development_smoke_only\": True,\n            \"code_repair_claim_allowed\": False,\n            \"broad_superiority_claim_allowed\": False,\n            \"confirmatory_claim_allowed\": False,\n        },\n        \"selection_counts\": counts,\n        \"repository_count\": len(repositories),\n        \"repositories\": repositories,\n    }\n\n\ndef validate_manifest(document: Any, expected: dict[str, Any]) -> None:\n    artifacts.validate_exact_document(document, expected, \"agentic slice manifest\")\n    if any(document.get(field) is not False for field in FALSE_AUTHORITY_FIELDS):\n        raise SliceError(\"manifest grants authority\")\n    if any(document.get(field) is not False for field in ABSENT_DATA_FIELDS):\n        raise SliceError(\"manifest contains controller-only data\")\n    repositories = document.get(\"repositories\")\n    if type(repositories) is not list or len(repositories) != REPOSITORY_COUNT:\n        raise SliceError(\"manifest repository count mismatch\")\n    languages = {row.get(\"language\") for row in repositories if type(row) is dict}\n    if len(languages) != REPOSITORY_COUNT:\n        raise SliceError(\"manifest does not contain three distinct languages\")\n\n\ndef _common_arguments(parser: argparse.ArgumentParser) -> None:\n    parser.add_argument(\"--source-parquet\", type=Path, required=True)\n    parser.add_argument(\"--prior-spike\", type=Path, default=DEFAULT_PRIOR_SPIKE)\n    parser.add_argument(\"--prior-spike-sha256\", REDACTED)\n    parser.add_argument(\"--exclusions\", type=Path, default=DEFAULT_EXCLUSIONS)\n    parser.add_argument(\"--exclusions-sha256\", REDACTED)\n    parser.add_argument(\"--identity-key\", type=Path, required=True)\n    parser.add_argument(\n        \"--post-freeze-cohort\",\n        type=Path,\n        action=\"append\",\n        default=[],\n        help=\"supplement (never replace) the mandatory default public cohorts\",\n    )\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=__doc__)\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n    freeze_parser = commands.add_parser(\"freeze\")\n    _common_arguments(freeze_parser)\n    freeze_parser.add_argument(\"--output\", type=Path, required=True)\n    validate_parser = commands.add_parser(\"validate\")\n    _common_arguments(validate_parser)\n    validate_parser.add_argument(\"--manifest\", type=Path, required=True)\n    return parser\n\n\ndef _build_from_args(args: argparse.Namespace) -> dict[str, Any]:\n    return build_manifest(\n        source_parquet_path=args.source_parquet,\n        prior_spike_path=args.prior_spike,\n        prior_spike_sha256=args.prior_spike_sha256,\n        exclusions_path=args.exclusions,\n        exclusions_sha256=args.exclusions_sha256,\n        identity_key_path=args.identity_key,\n        supplemental_cohort_paths=tuple(args.post_freeze_cohort),\n    )\n\n\ndef main(argv: Sequence[str] | None = None) -> int:\n    args = build_parser().parse_args(argv)\n    try:\n        expected = _build_from_args(args)\n        if args.command == \"freeze\":\n            artifacts.write_new_canonical_json(args.output, expected)\n            print(args.output)\n        else:\n            opened = artifacts.read_canonical_json(args.manifest, expected_type=dict)\n            validate_manifest(opened.document, expected)\n            print(\n                json.dumps(\n                    {\n                        \"valid\": True,\n                        \"repository_count\": REPOSITORY_COUNT,\n                        \"language_count\": REPOSITORY_COUNT,\n                        \"protected_match_count\": expected[\"selection_counts\"][\n                            \"source_protected_union_match_count\"\n                        ],\n                    },\n                    sort_keys=True,\n                    separators=(\",\", \":\"),\n                )\n            )\n    except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError) as error:\n        print(f\"error: {error}\", file=sys.stderr)\n        return 1\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
