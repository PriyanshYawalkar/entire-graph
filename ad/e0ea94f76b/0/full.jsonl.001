The cache-state header is\\n-\\t\\t\\t// intentionally indivisible, so a budget smaller than that header emits\\n-\\t\\t\\t// the header alone instead of accidentally switching to the zero-budget\\n-\\t\\t\\t// (unbounded diagnostic) behavior below.\\n-\\t\\t\\treturn nil\\n+\\t\\tformatted = []byte(\\\"No search results.\\\\n\\\")\\n+\\t} else {\\n+\\t\\tresultBudget := budget\\n+\\t\\tif resultBudget > 0 {\\n+\\t\\t\\tresultBudget -= len(header)\\n+\\t\\t\\tif resultBudget > 0 {\\n+\\t\\t\\t\\tformatted = fitAgentSearchResults(results, resultBudget)\\n+\\t\\t\\t}\\n+\\t\\t} else {\\n+\\t\\t\\tformatted = fitAgentSearchResults(results, resultBudget)\\n \\t\\t}\\n \\t}\\n-\\tformatted := fitAgentSearchResults(results, resultBudget)\\n-\\t_, err := out.Write(formatted)\\n+\\tpayload := append(header, formatted...)\\n+\\tif budget > 0 && len(payload) > budget {\\n+\\t\\tpayload = payload[:budget]\\n+\\t}\\n+\\t_, err := out.Write(payload)\\n \\treturn err\\n }\\n \\ndiff --git a/internal/sem/provider.go b/internal/sem/provider.go\\nindex a807c88..18423c9 100644\\n--- a/internal/sem/provider.go\\n+++ b/internal/sem/provider.go\\n@@ -453,6 +453,8 @@ func Capabilities() CapabilityReport {\\n \\t\\t\\t\\\"hybrid_source_search\\\": true,\\n \\t\\t\\t\\\"near_clone_detection\\\": true,\\n \\t\\t\\t\\\"git_cochange_edges\\\":   true,\\n+\\t\\t\\t\\\"durable_preindex\\\":     true,\\n+\\t\\t\\t\\\"focused_neighbors\\\":    true,\\n \\t\\t},\\n \\t\\tFeaturesRequiringNetworkAccess: map[string]bool{\\n \\t\\t\\t\\\"grammar_download\\\":  false,\\ndiff --git a/internal/sem/provider_test.go b/internal/sem/provider_test.go\\nindex 92f529e..bfe5124 100644\\n--- a/internal/sem/provider_test.go\\n+++ b/internal/sem/provider_test.go\\n@@ -10200,7 +10200,7 @@ func TestCapabilitiesAdvertiseExpandedLanguageSet(t *testing.T) {\\n \\t\\t\\tt.Fatalf(\\\"feature %s should not require network access\\\", feature)\\n \\t\\t}\\n \\t}\\n-\\tfor _, feature := range []string{\\\"stable_symbol_ids\