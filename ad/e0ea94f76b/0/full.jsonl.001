tpartialFailures = []PartialFailure{}\n   290\t\t\t\t}\n   291\t\t\t\tcompleteness = cachedSnapshot.Header.Completeness\n   292\t\t\t\tsymbolsConsidered = len(cachedSnapshot.Symbols)\n   293\t\t\t}\n   294\t\t\treturn SearchResponse{\n   295\t\t\t\tQuery:    query,\n   296\t\t\t\tRepoRoot: repoRoot,\n   297\t\t\t\tCommit:   commit,\n   298\t\t\t\tTree:     tree,\n   299\t\t\t\tProfile:  string(options.Profile),\n   300\t\t\t\tResults:  []SearchResult{},\n   301\t\t\t\tStats: SearchStats{\n   302\t\t\t\t\tFilesScanned:       selection.filesScanned,\n   303\t\t\t\t\tFilesContentRead:   selection.filesContentRead,\n   304\t\t\t\t\tFilesIndexed:       0,\n   305\t\t\t\t\tSymbolsConsidered:  symbolsConsidered,\n   306\t\t\t\t\tResultBytes:        serializedSearchResultBytes([]SearchResult{}),\n   307\t\t\t\t\tContextBudgetBytes: options.MaxContextBytes,\n   308\t\t\t\t\tIndexCacheHit:      cacheHit,\n   309\t\t\t\t\tIndexLatencyMS:     indexLatency.Milliseconds(),\n   310\t\t\t\t\tPreselectLatencyMS: preselectLatency.Milliseconds(),\n   311\t\t\t\t\tTotalLatencyMS:     totalLatency,\n   312\t\t\t\t\tSearchLatencyMS:    totalLatency,\n   313\t\t\t\t},\n   314\t\t\t\tWarnings:        warnings,\n   315\t\t\t\tPartialFailures: partialFailures,\n   316\t\t\t\tCompleteness:    completeness,\n   317\t\t\t}, nil\n   318\t\t}\n   319\t\n   320\t\t// The provider graph and the lexical query scope are independent. A full\n   321\t\t// graph gives relation expansion repository-wide context, while only the\n   322\t\t// preselected files need content hydration for this query.\n   323\t\tonlyFiles := selectedFiles\n   324\t\tif options.IndexAllFiles || len(selectedFiles) == selection.filesScanned {\n   325\t\t\t// Canonicalize complete snapshots to the query-independent cache key so\n   326\t\t\t// `graph index` and all-files search share one durable artifact.\n   327\t\t\tonlyFiles = nil\n   328\t\t}\n   329\t\tsnapshotOptions := ProviderSnapshotOptions{\n   330\t\t\tNoNetwork:     t