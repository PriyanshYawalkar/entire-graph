{"timestamp":"2026-07-18T16:52:30.889Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5baf4ed6908191ac89277c8490b176","status":"completed","call_id":"call_cWL0b6w35QftSROyYpuL7rse","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '1,240p' competitive-eval/tools/score_agentic_issue_analysis_smoke.py && sed -n '240,560p' competitive-eval/tools/score_agentic_issue_analysis_smoke.py && sed -n '560,980p' competitive-eval/tools/score_agentic_issue_analysis_smoke.py && sed -n '980,1120p' competitive-eval/tools/score_agentic_issue_analysis_smoke.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 70000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:52:31.097Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7624-ccf9-7ba2-ad8a-625164b4daef","call_id":"call_cWL0b6w35QftSROyYpuL7rse","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 11967)\nTotal output lines: 1123\n\n#!/usr/bin/env python3\n\"\"\"Score the development-only agentic issue-analysis smoke, fail closed.\n\nThe pure ``score_synthetic`` surface exists only for contract tests.  Real\nattempt results are not opened or scored until a separate exact-hash scoring\nauthorization explicitly grants controller scoring and score production.\nThis module never launches a model and never performs network I/O.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport math\nimport re\nimport sys\nfrom decimal import Decimal, InvalidOperation\nfrom pathlib import Path, PurePosixPath\nfrom typing import Any, Iterable, Sequence\n\nimport run_agentic_issue_analysis_smoke as runner\n\n\nartifacts = runner.artifacts\n\nSUITE = runner.SUITE\nSYSTEMS = runner.SYSTEMS\nATTEMPT_RESULTS_STAGE = \"agentic_issue_analysis_attempt_results\"\nSCORING_AUTHORIZATION_STAGE = (\n    \"exact_hash_agentic_issue_analysis_scoring_authorization\"\n)\nSYNTHETIC_SCORE_STAGE = \"synthetic_agentic_issue_analysis_scores\"\nSCORE_STAGE = \"development_agentic_issue_analysis_scores\"\nMAX_RANKED_LOCATIONS = 10\nQUALITY_FIELDS = (\n    \"file_ndcg_at_5\",\n    \"file_recall_at_5\",\n    \"file_mrr\",\n    \"file_precision_at_5\",\n    \"file_f1_at_5\",\n    \"file_all_returned_recall\",\n    \"oracle_region_overlap_recall_at_5\",\n    \"predicted_region_overlap_precision_at_5\",\n    \"oracle_line_overlap_recall_at_5\",\n    \"predicted_line_overlap_precision_at_5\",\n)\nTOKEN_FIELDS = (\n    \"input_tokens\",\n    \"output_tokens\",\n    \"cache_creation_input_tokens\",\n    \"cache_read_input_tokens\",\n    \"total_model_tokens\",\n)\nTIMING_FIELDS = (\"task_wall_time_ms\",)\nPRICE_FIELDS = runner.PRICE_FIELDS\nSHA256_RE = re.compile(r\"[0-9a-f]{64}\")\nSAFE_CODE_RE = re.compile(r\"[a-z][a-z0-9_]{0,63}\")\n\nATTEMPT_RESULT_DOCUMENT_FIELDS = (\n    \"schema_version\", \"suite\", \"stage\", \"development_only\",\n    \"synthetic_fixture\", \"execution_freeze_sha256\",\n    \"execution_authorization_sha256\", \"sealed_oracle_sha256\",\n    \"paid_execution_authorized\", \"model_execution_authorized\",\n    \"controller_scoring_authorized\", \"score_production_authorized\",\n    \"scores_present\", \"outcomes_present\", \"attempt_count\", \"attempts\",\n)\nATTEMPT_FIELDS = (\n    \"pair_index\", \"repository_id\", \"repetition_index\", \"system\",\n    \"system_position\", \"case_id\", \"terminal_status\", \"failure_code\",\n    \"final_answer\", \"usage\", \"cost_usd\", \"timing\", \"setup_reference\",\n    \"tool_evidence\", \"retrieval_telemetry\", \"transcript_sha256\",\n    \"stderr_sha256\", \"return_code\", \"timed_out\",\n)\nFINAL_ANSWER_FIELDS = (\"summary\", \"locations\", \"confidence\")\nFINAL_LOCATION_REQUIRED_FIELDS = (\"file_path\", \"rationale\")\nFINAL_LOCATION_OPTIONAL_PAIRED_FIELDS = (\"start_line\", \"end_line\")\nSETUP_REFERENCE_FIELDS = (\n    \"setup_record_sha256\", \"setup_index_wall_time_ms\",\n    \"setup_excluded_from_task_timing\",\n)\nTOOL_EVIDENCE_FIELDS = (\n    \"tool_call_count\", \"trace_sha256\", \"policy_compliant\", \"violation_codes\",\n)\nRETRIEVAL_TELEMETRY_FIELDS = (\n    \"retrieval_call_count\", \"controller_observed_latency_ms\",\n    \"entire_graph_call_count\", \"product_reported_total_latency_ms\",\n    \"entire_graph_all_index_cache_hits\",\n)\nATTEMPT_RESULT_CONTRACT: dict[str, Any] = {\n    \"schema_version\": 1,\n    \"document_fields\": list(ATTEMPT_RESULT_DOCUMENT_FIELDS),\n    \"attempt_fields\": list(ATTEMPT_FIELDS),\n    \"final_answer_fields\": list(FINAL_ANSWER_FIELDS),\n    \"final_location_required_fields\": list(FINAL_LOCATION_REQUIRED_FIELDS),\n    \"final_location_optional_paired_fields\": list(\n        FINAL_LOCATION_OPTIONAL_PAIRED_FIELDS\n    ),\n    \"maximum_ordered_locations\": MAX_RANKED_LOCATIONS,\n    \"usage_fields\": list(TOKEN_FIELDS),\n    \"timing_fields\": list(TIMING_FIELDS),\n    \"setup_reference_fields\": list(SETUP_REFERENCE_FIELDS),\n    \"tool_evidence_fields\": list(TOOL_EVIDENCE_FIELDS),\n    \"retrieval_telemetry_fields\": list(RETRIEVAL_TELEMETRY_FIELDS),\n    \"success_invariants\": (\n        \"final_answer object; failure_code null; return_code 0; timed_out false\"\n    ),\n    \"failure_invariants\": (\n        \"final_answer null; safe failure_code; timed_out implies return_code null\"\n    ),\n    \"real_results_authority_invariants\": (\n        \"paid/model execution true; controller scoring, score production, scores, \"\n        \"and outcomes false\"\n    ),\n}\n\n\nSCORING_CONTRACT: dict[str, Any] = {\n    \"schema_version\": 1,\n    \"suite\": SUITE,\n    \"development_only\": True,\n    \"task\": \"read-only issue analysis and source localization\",\n    \"maximum_ranked_locations_per_attempt\": MAX_RANKED_LOCATIONS,\n    \"attempt_result_contract\": ATTEMPT_RESULT_CONTRACT,\n    \"ranked_location_source\": (\n        \"controller-recorded structured agent output; no post-hoc semantic \"\n        \"reinterpretation\"\n    ),\n    \"primary_quality_metrics\": {\n        \"file_ndcg_at_5\": (\n            \"binary relevance over distinct files in first-seen rank order; \"\n            \"DCG uses 1/log2(rank+1), normalized by the ideal ranking\"\n        ),\n        \"file_recall_at_5\": (\n            \"relevant distinct files returned among the first five distinct \"\n            \"files divided by all relevant files\"\n        ),\n        \"file_mrr\": (\n            \"reciprocal rank of the first relevant distinct file across all \"\n            \"returned locations, or zero\"\n        ),\n    },\n    \"secondary_quality_metrics\": {\n        \"file_precision_at_5\": (\n            \"relevant distinct files among the first five divided by the fixed \"\n            \"denominator five\"\n        ),\n        \"file_f1_at_5\": \"harmonic mean of file precision@5 and file recall@5\",\n        \"file_all_returned_recall\": (\n            \"relevant distinct files found anywhere in the bounded returned list \"\n            \"divided by all relevant files\"\n        ),\n    },\n    \"diagnostic_localization_metrics\": {\n        \"oracle_region_overlap_recall_at_5\": (\n            \"oracle regions overlapped by any of the first five ranked locations \"\n            \"divided by all oracle regions\"\n        ),\n        \"predicted_region_overlap_precision_at_5\": (\n            \"first-five ranked locations overlapping any oracle region divided \"\n            \"by the fixed denominator five\"\n        ),\n        \"oracle_line_overlap_recall_at_5\": (\n            \"inclusive oracle lines overlapped by first-five line-bounded \"\n            \"predictions divided by unioned oracle lines\"\n        ),\n        \"predicted_line_overlap_precision_at_5\": (\n            \"inclusive predicted lines overlapping unioned oracle lines divided \"\n            \"by unioned first-five predicted lines\"\n        ),\n        \"file_only_prediction_line_overlap\": \"zero; file relevance is still scored\",\n    },\n    \"aggregation\": {\n        \"unit\": \"scheduled system attempt\",\n        \"system_weighting\": \"arithmetic mean across every scheduled attempt\",\n        \"failed_or_tool_policy_noncompliant_quality\": \"all quality metrics are zero\",\n        \"survivor_only_quality_averages_allowed\": False,\n        \"token_fields_summed_separately\": list(TOKEN_FIELDS),\n        \"task_wall_time_reported_separately\": True,\n        \"retrieval_phase_latency_reported_separately\": True,\n        \"setup_index_wall_time_reported_separately\": True,\n        \"setup_index_time_included_in_task_wall_time\": False,\n        \"cost_recomputed_from_frozen_token_prices\": True,\n        \"failures_and_tool_policy_compliance_reported_separately\": True,\n    },\n    \"measurement_sources\": {\n        \"model_tokens\": \"exact agent-runtime usage record\",\n        \"cost_usd\": \"recomputed and cross-checked against frozen per-token prices\",\n        \"task_wall_time_ms\": \"controller monotonic interval around the model process\",\n        \"retrieval_phase_latency_ms\": (\n            \"sum of controller-observed retrieval tool-call wall times within the task\"\n        ),\n        \"setup_index_wall_time_ms\": (\n            \"exact referenced unpaid setup record; excluded from task wall time\"\n        ),\n        \"tool_policy\": \"controller tool-call trace and exact trace SHA-256\",\n    },\n    \"claim_boundary\": {\n        \"development_smoke_only\": True,\n        \"broad_product_superiority_claim_allowed\": False,\n        \"confirmatory_claim_allowed\": False,\n        \"code_repair_claim_allowed\": False,\n        \"outcome_publication_authorized\": False,\n    },\n}\n\n\nclass ScoringError(ValueError):\n    \"\"\"Raised when an issue-analysis scoring boundary fails closed.\"\"\"\n\n\ndef _document_sha256(value: Any) -> str:\n    return artifacts.sha256_bytes(artifacts.canonical_bytes(value))\n\n\ndef scoring_contract_sha256() -> str:\n    \"\"\"Return the canonical hash that execution freezes should bind.\"\"\"\n\n    return _document_sha256(SCORING_CONTRACT)\n\n\ndef attempt_result_contract_sha256() -> str:\n    \"\"\"Return the exact outer result-envelope contract hash.\"\"\"\n\n    return _document_sha256(ATTEMPT_RESULT_CONTRACT)\n\n\ndef scorer_binding() -> dict[str, str]:\n    \"\"\"Return every code/contract hash a future execution freeze must bind.\"\"\"\n\n    return {\n        \"scorer_sha256\": artifacts.sha256_file(Path(__file__)),\n        \"scoring_contract_sha256\": scoring_contract_sha256(),\n        \"attempt_result_contract_sha256\": attempt_result_contract_sha256(),\n        \"artifact_contract_sha256\": artifacts.sha256_file(Path(artifacts.__file__)),\n    }\n\n\ndef _require_fields(value: Any, expected: Iterable[str], label: str) -> dict[str, Any]:\n    if type(value) is not dict or set(value) != set(expected):\n        raise ScoringError(f\"{label} fields differ from the frozen schema\")\n        raise ScoringError(f\"{label} fields differ from the frozen schema\")\n    return value\n\n\ndef _require_sha256(value: Any, label: str) -> str:\n    if not isinstance(value, str) or SHA256_RE.fullmatch(value) is None:\n        raise ScoringError(f\"{label} must be an exact SHA-256\")\n    return value\n\n\ndef _safe_relative_path(value: Any, label: str) -> str:\n    if not isinstance(value, str) or not value or \"\\\\\" in value:\n        raise ScoringError(f\"{label} must be a non-empty POSIX repository path\")\n    path = PurePosixPath(value)\n    if path.is_absolute() or value != path.as_posix() or any(\n        part in {\"\", \".\", \"..\"} for part in path.parts\n    ):\n        raise ScoringError(f\"{label} must stay relative to the repository\")\n    return value\n\n\ndef _validate_judgment(value: Any, label: str) -> dict[str, Any]:\n    row = _require_fields(value, (\"file_path\", \"start_line\", \"end_line\"), label)\n    _safe_relative_path(row[\"file_path\"], f\"{label}.file_path\")\n    if (\n        type(row[\"start_line\"]) is not int\n        or type(row[\"end_line\"]) is not int\n        or row[\"start_line\"] < 1\n        or row[\"end_line\"] < row[\"start_line\"]\n    ):\n        raise ScoringError(f\"{label} has an invalid inclusive line interval\")\n    return row\n\n\ndef _validate_final_location(value: Any, label: str) -> dict[str, Any]:\n    if type(value) is not dict or set(value) not in (\n        {\"file_path\", \"rationale\"},\n        {\"file_path\", \"start_line\", \"end_line\", \"rationale\"},\n    ):\n        raise ScoringError(f\"{label} fields differ from the frozen structured-answer schema\")\n    row = value\n    _safe_relative_path(row[\"file_path\"], f\"{label}.file_path\")\n    if not isinstance(row[\"rationale\"], str) or not row[\"rationale\"].strip():\n        raise ScoringError(f\"{label}.rationale must be non-empty\")\n    start, end = row.get(\"start_line\"), row.get(\"end_line\")\n    if start is None and end is None and \"start_line\" not in row and \"end_line\" not in row:\n        return {\"file_path\": row[\"file_path\"], \"start_line\": None, \"end_line\": None}\n    if (\n        type(start) is not int\n        or type(end) is not int\n        or start < 1\n        or end < start\n    ):\n        raise ScoringError(f\"{label} must provide both valid lines or neither\")\n    return {\"file_path\": row[\"file_path\"], \"start_line\": start, \"end_line\": end}\n\n\ndef _validate_final_answer(value: Any, label: str) -> dict[str, Any]:\n    row = _require_fields(value, FINAL_ANSWER_FIELDS, label)\n    if not isinstance(row[\"summary\"], str) or not row[\"summary\"].strip():\n        raise ScoringError(f\"{label}.summary must be non-empty\")\n    if row[\"confidence\"] not in {\"high\", \"medium\", \"low\"}:\n        raise ScoringError(f\"{label}.confidence is invalid\")\n    locations = row[\"locations\"]\n    if type(locations) is not list or not (1 <= len(locations) <= MAX_RANKED_LOCATIONS):\n        raise ScoringError(f\"{label}.locations must contain one to ten ordered locations\")\n    for index, location in enumerate(locations):\n        _validate_final_location(location, f\"{label}.locations[{index}]\")\n    return row\n\n\ndef _rounded(value: float) -> float:\n    rounded = round(value, 12)\n    return 0.0 if rounded == 0 else rounded\n\n\ndef _overlaps(left: dict[str, Any], right: dict[str, Any]) -> bool:\n    return (\n        left[\"file_path\"] == right[\"file_path\"]\n        and left[\"start_line\"] is not None\n        and left[\"end_line\"] is not None\n        and left[\"start_line\"] <= right[\"end_line\"]\n        and left[\"end_line\"] >= right[\"start_line\"]\n    )\n\n\ndef _merged_intervals(\n    locations: Sequence[dict[str, Any]],\n) -> dict[str, list[tuple[int, int]]]:\n    by_file: dict[str, list[tuple[int, int]]] = {}\n    for row in locations:\n        if row[\"start_line\"] is None:\n            continue\n        by_file.setdefault(row[\"file_path\"], []).append(\n            (row[\"start_line\"], row[\"end_line\"])\n        )\n    merged: dict[str, list[tuple[int, int]]] = {}\n    for file_path, intervals in by_file.items():\n        output: list[tuple[int, int]] = []\n        for start, end in sorted(intervals):\n            if output and start <= output[-1][1] + 1:\n                output[-1] = (output[-1][0], max(output[-1][1], end))\n            else:\n                output.append((start, end))\n        merged[file_path] = output\n    return merged\n\n\ndef _interval_line_count(intervals: dict[str, list[tuple[int, int]]]) -> int:\n    return sum(end - start + 1 for rows in intervals.values() for start, end in rows)\n\n\ndef _intersection_line_count(\n    left: dict[str, list[tuple[int, int]]],\n    right: dict[str, list[tuple[int, int]]],\n) -> int:\n    total = 0\n    for file_path in set(left) & set(right):\n        left_rows, right_rows = left[file_path], right[file_path]\n        left_index = right_index = 0\n        while left_index < len(left_rows) and right_index < len(right_rows):\n            left_start, left_end = left_rows[left_index]\n            right_start, right_end = right_rows[right_index]\n            start, end = max(left_start, right_start), min(left_end, right_end)\n            if start <= end:\n                total += end - start + 1\n            if left_end <= right_end:\n                left_index += 1\n            else:\n                right_index += 1\n    return total\n\n\ndef quality_metrics(\n    ranked_locations: Sequence[dict[str, Any]],\n    judgments: Sequence[dict[str, Any]],\n) -> dict[str, float]:\n    \"\"\"Compute the predeclared quality metrics for one synthetic or real attempt.\"\"\"\n\n    if type(ranked_locations) is not list or len(ranked_locations) > MAX_RANKED_LOCATIONS:\n        raise ScoringError(\"ranked locations exceed their frozen bounded schema\")\n    if type(judgments) is not list or not judgments:\n        raise ScoringError(\"sealed judgments must be a non-empty list\")\n    ranked = [\n        _validate_final_location(row, f\"ranked_locations[{index}]\")\n        for index, row in enumerate(ranked_locations)\n    ]\n    oracle = [\n        _validate_judgment(row, f\"judgments[{index}]\")\n        for index, row in enumerate(judgments)\n    ]\n    if len({(row[\"file_path\"], row[\"start_line\"], row[\"end_line\"]) for row in oracle}) != len(oracle):\n        raise ScoringError(\"sealed judgments contain a duplicate region\")\n\n    relevant_files = {row[\"file_path\"] for row in oracle}\n    ranked_files: list[str] = []\n    for row in ranked:\n        if row[\"file_path\"] not in ranked_files:\n            ranked_files.append(row[\"file_path\"])\n    top_files = ranked_files[:5]\n    file_hits = len(set(top_files) & relevant_files)\n    gains = [1.0 if file_path in relevant_files else 0.0 for file_path in top_files]\n    dcg = sum(gain / math.log2(rank + 1) for rank, gain in enumerate(gains, start=1))\n    ideal = sum(\n        1.0 / math.log2(rank + 1)\n        for rank in range(1, min(5, len(relevant_files)) + 1)\n    )\n    first_relevant = next(\n        (rank for rank, file_path in enumerate(ranked_files, start=1) if file_path in relevant_files),\n        None,\n    )\n    recall = file_hits / len(relevant_files)\n    precision = file_hits / 5\n    f1 = 2 * precision * recall / (precision + recall) if precision + recall else 0.0\n\n    top_regions = ranked[:5]\n    oracle_region_hits = sum(\n        any(_overlaps(prediction, judgment) for prediction in top_regions)\n        for judgment in oracle\n    )\n    predicted_region_hits = sum(\n        any(_overlaps(prediction, judgment) for judgment in oracle)\n        for prediction in top_regions\n    )\n    oracle_lines = _merged_intervals(oracle)\n    predicted_lines = _merged_intervals(top_regions)\n    overlap_lines = _intersection_line_count(oracle_lines, predicted_lines)\n    oracle_line_count = _interval_line_count(oracle_lines)\n    predicted_line_count = _interval_line_count(predicted_lines)\n\n    metrics = {\n        \"file_ndcg_at_5\": dcg / ideal if ideal else 0.0,\n        \"file_recall_at_5\": recall,\n        \"file_mrr\": 1 / first_relevant if first_relevant else 0.0,\n        \"file_precision_at_5\": precision,\n        \"file_f1_at_5\": f1,\n        \"file_all_returned_recall\": len(set(ranked_files) & relevant_files) / len(relevant_files),\n        \"oracle_region_overlap_recall_at_5\": oracle_region_hits / len(oracle),\n        \"predicted_region_overlap_precision_at_5\": predicted_region_hits / 5,\n        \"oracle_line_overlap_recall_at_5\": overlap_lines / oracle_line_count,\n        \"predicted_line_overlap_precision_at_5\": (\n            overlap_lines / predicted_line_count if predicted_line_count else 0.0\n        ),\n    }\n    return {field: _rounded(metrics[field]) for field in QUALITY_FIELDS}\n\n\ndef _expected_attempts(freeze: dict[str, Any]) -> dict[tuple[Any, ...], dict[str, Any]]:\n    if (\n        freeze.get(\"schema_version\") != 1\n        or freeze.get(\"suite\") != SUITE\n        or freeze.get(\"stage\") != runner.FREEZE_STAGE\n        or freeze.get(\"development_only\") is not True\n    ):\n        raise ScoringError(\"execution freeze identity is malformed\")\n    schedule = freeze.get(\"schedule\")\n    if type(schedule) is not dict or type(schedule.get(\"rows\")) is not list:\n        raise ScoringError(\"execution freeze schedule is malformed\")\n    checkouts = freeze.get(\"checkouts\")\n    if type(checkouts) is not list:\n        raise ScoringError(\"execution freeze checkout bindings are malformed\")\n    case_by_repository: dict[str, str] = {}\n    for row in checkouts:\n        if (\n            type(row) is not dict\n            or not isinstance(row.get(\"id\"), str)\n            or not isinstance(row.get(\"repository_id\"), str)\n            or row[\"repository_id\"] in case_by_repository\n        ):\n            raise ScoringError(\"execution freeze case bindings are malformed\")\n        case_by_repository[row[\"repository_id\"]] = row[\"id\"]\n    if len(case_by_repository) != 3:\n        raise ScoringError(\"execution freeze must bind exactly three cases\")\n\n    expected: dict[tuple[Any, ...], dict[str, Any]] = {}\n    for row in schedule[\"rows\"]:\n        if (\n            type(row) is not dict\n            or type(row.get(\"pair_index\")) is not int\n            or type(row.get(\"repetition_index\")) is not int\n            or not isinstance(row.get(\"repository_id\"), str)\n            or row[\"repository_id\"] not in case_by_repository\n            or row.get(\"system_order\") is None\n            or type(row[\"system_order\"]) is not list\n            or set(row[\"system_order\"]) != set(SYSTEMS)\n            or len(row[\"system_order\"]) != len(SYSTEMS)\n        ):\n            raise ScoringError(\"execution freeze schedule row is malformed\")\n        for position, system in enumerate(row[\"system_order\"], start=1):\n            key = (\n                row[\"pair_index\"], row[\"repository_id\"], row[\"repetition_index\"],\n                system, position,\n     …1967 tokens truncated…           ):\n                raise ScoringError(\"successful attempt has inconsistent process or answer state\")\n            _validate_final_answer(attempt[\"final_answer\"], f\"attempts[{index}].final_answer\")\n        elif not isinstance(failure, str) or SAFE_CODE_RE.fullmatch(failure) is None:\n            raise ScoringError(\"failed attempt lacks a safe machine failure code\")\n        if status == \"failure\" and attempt[\"final_answer\"] is not None:\n            raise ScoringError(\"failed attempt may not retain a partially interpreted final answer\")\n        if type(attempt[\"timed_out\"]) is not bool:\n            raise ScoringError(\"attempt timed_out must be an exact boolean\")\n        if attempt[\"return_code\"] is not None and type(attempt[\"return_code\"]) is not int:\n            raise ScoringError(\"attempt return_code must be an integer or null\")\n        if attempt[\"timed_out\"] and attempt[\"return_code\"] is not None:\n            raise ScoringError(\"timed-out attempt may not claim a process return code\")\n        _require_sha256(attempt[\"transcript_sha256\"], \"attempt transcript hash\")\n        _require_sha256(attempt[\"stderr_sha256\"], \"attempt stderr hash\")\n        _validate_usage(attempt[\"usage\"], f\"attempts[{index}].usage\")\n        if (\n            not isinstance(attempt[\"cost_usd\"], str)\n            or _decimal_string(_decimal(attempt[\"cost_usd\"], \"attempt cost\"))\n            != attempt[\"cost_usd\"]\n        ):\n            raise ScoringError(\"attempt cost_usd is not a canonical non-negative decimal\")\n        timing = _validate_timing(attempt[\"timing\"], f\"attempts[{index}].timing\")\n        _validate_setup_reference(\n            attempt[\"setup_reference\"], f\"attempts[{index}].setup_reference\",\n        )\n        tool_evidence = _validate_tool_policy(\n            attempt[\"tool_evidence\"], f\"attempts[{index}].tool_evidence\",\n        )\n        _validate_retrieval_telemetry(\n            attempt[\"retrieval_telemetry\"],\n            system=attempt[\"system\"],\n            tool_call_count=tool_evidence[\"tool_call_count\"],\n            task_wall_time_ms=timing[\"task_wall_time_ms\"],\n            label=f\"attempts[{index}].retrieval_telemetry\",\n        )\n        observed[key] = attempt\n    if set(observed) != set(expected):\n        raise ScoringError(\"attempt results do not cover the exact frozen schedule once\")\n    return [observed[key] for key in sorted(observed)]\n\n\ndef validate_sealed_oracle(\n    sealed: dict[str, Any], freeze: dict[str, Any], *, sealed_oracle_sha256: str,\n) -> dict[str, list[dict[str, Any]]]:\n    _require_sha256(sealed_oracle_sha256, \"sealed oracle hash\")\n    if _document_sha256(sealed) != sealed_oracle_sha256:\n        raise ScoringError(\"sealed oracle document differs from its exact hash\")\n    frozen = freeze.get(\"inputs\", {}).get(\"sealed_oracle\", {})\n    if frozen.get(\"sha256\") != sealed_oracle_sha256:\n        raise ScoringError(\"sealed oracle hash differs from the execution freeze\")\n    if (\n        sealed.get(\"schema_version\") != 1\n        or sealed.get(\"suite\") != SUITE\n        or sealed.get(\"stage\") != runner.SEALED_ORACLE_STAGE\n        or sealed.get(\"development_only\") is not True\n        or sealed.get(\"agent_visible\") is not False\n        or sealed.get(\"sealed\") is not True\n        or sealed.get(\"qrels_present\") is not True\n    ):\n        raise ScoringError(\"sealed oracle identity is malformed\")\n    for key, value in sealed.items():\n        if (key.endswith(\"_authorized\") or key == \"confirmatory_use_allowed\") and value is not False:\n            raise ScoringError(f\"sealed oracle unexpectedly grants {key}\")\n    cases = sealed.get(\"cases\")\n    if type(cases) is not list or len(cases) != 3:\n        raise ScoringError(\"sealed oracle must contain exactly three cases\")\n    expected_cases = {\n        row[\"id\"]: row[\"repository_id\"] for row in freeze.get(\"checkouts\", [])\n        if type(row) is dict and isinstance(row.get(\"id\"), str)\n    }\n    by_case: dict[str, list[dict[str, Any]]] = {}\n    for index, case in enumerate(cases):\n        if type(case) is not dict or not isinstance(case.get(\"id\"), str):\n            raise ScoringError(\"sealed oracle case is malformed\")\n        case_id = case[\"id\"]\n        repository_id = str(case.get(\"normalized_repo\") or case.get(\"repo\") or \"\").casefold()\n        if case_id in by_case or expected_cases.get(case_id) != repository_id:\n            raise ScoringError(\"sealed oracle case differs from frozen checkout bindings\")\n        judgments = case.get(\"judgments\")\n        if type(judgments) is not list or not judgments:\n            raise ScoringError(\"sealed oracle case lacks judgments\")\n        normalized = [\n            _validate_judgment(value, f\"sealed.cases[{index}].judgments[{judgment_index}]\")\n            for judgment_index, value in enumerate(judgments)\n        ]\n        if (\n            case.get(\"judgment_count\") != len(normalized)\n            or case.get(\"judgments_sha256\") != _document_sha256(normalized)\n        ):\n            raise ScoringError(\"sealed oracle judgment commitment differs\")\n        by_case[case_id] = normalized\n    if set(by_case) != set(expected_cases):\n        raise ScoringError(\"sealed oracle does not cover the exact frozen cases\")\n    return by_case\n\n\ndef _decimal(value: Any, label: str) -> Decimal:\n    try:\n        parsed = Decimal(str(value))\n    except (InvalidOperation, ValueError) as error:\n        raise ScoringError(f\"{label} must be an exact decimal\") from error\n    if not parsed.is_finite() or parsed < 0:\n        raise ScoringError(f\"{label} must be finite and non-negative\")\n    return parsed\n\n\ndef _decimal_string(value: Decimal) -> str:\n    rendered = format(value, \"f\")\n    if \".\" in rendered:\n        rendered = rendered.rstrip(\"0\").rstrip(\".\")\n    return rendered or \"0\"\n\n\ndef _prices(freeze: dict[str, Any]) -> dict[str, Decimal]:\n    raw = freeze.get(\"protocol\", {}).get(\"prices_usd_per_million_tokens\")\n    if type(raw) is not dict or set(raw) != set(PRICE_FIELDS):\n        raise ScoringError(\"execution freeze token prices are malformed\")\n    return {field: _decimal(raw[field], field) for field in PRICE_FIELDS}\n\n\ndef _attempt_cost(usage: dict[str, int], prices: dict[str, Decimal]) -> Decimal:\n    units = {\n        \"input_tokens_usd_per_million\": usage[\"input_tokens\"],\n        \"output_tokens_usd_per_million\": usage[\"output_tokens\"],\n        \"cache_creation_input_tokens_usd_per_million\": usage[\n            \"cache_creation_input_tokens\"\n        ],\n        \"cache_read_input_tokens_usd_per_million\": usage[\"cache_read_input_tokens\"],\n    }\n    return sum((prices[field] * count for field, count in units.items()), Decimal(0)) / Decimal(1_000_000)\n\n\ndef _zero_quality() -> dict[str, float]:\n    return {field: 0.0 for field in QUALITY_FIELDS}\n\n\ndef _mean(values: Sequence[float]) -> float:\n    return _rounded(sum(values) / len(values)) if values else 0.0\n\n\ndef _aggregate_system(rows: list[dict[str, Any]]) -> dict[str, Any]:\n    count = len(rows)\n    usage = {field: sum(row[\"usage\"][field] for row in rows) for field in TOKEN_FIELDS}\n    quality = {\n        field: _mean([row[\"quality\"][field] for row in rows]) for field in QUALITY_FIELDS\n    }\n    timing = {\n        \"task_wall_time_ms_total\": sum(row[\"timing\"][\"task_wall_time_ms\"] for row in rows),\n        \"task_wall_time_ms_mean\": _rounded(\n            sum(row[\"timing\"][\"task_wall_time_ms\"] for row in rows) / count\n        ),\n        \"retrieval_phase_latency_ms_total\": sum(\n            row[\"retrieval_telemetry\"][\"controller_observed_latency_ms\"]\n            for row in rows\n        ),\n        \"retrieval_phase_latency_ms_mean\": _rounded(\n            sum(\n                row[\"retrieval_telemetry\"][\"controller_observed_latency_ms\"]\n                for row in rows\n            ) / count\n        ),\n        \"setup_index_wall_time_ms_total\": sum(\n            row[\"timing\"][\"setup_index_wall_time_ms\"] for row in rows\n        ),\n        \"setup_index_wall_time_ms_mean\": _rounded(\n            sum(\n                row[\"timing\"][\"setup_index_wall_time_ms\"] for row in rows\n            ) / count\n        ),\n        \"setup_excluded_from_task_timing\": True,\n    }\n    total_cost = sum((Decimal(row[\"cost_usd\"]) for row in rows), Decimal(0))\n    failures = sum(row[\"terminal_status\"] == \"failure\" for row in rows)\n    compliant = sum(row[\"tool_policy_compliant\"] for row in rows)\n    failure_codes = {\n        code: sum(row[\"failure_code\"] == code for row in rows)\n        for code in sorted(\n            {row[\"failure_code\"] for row in rows if row[\"failure_code\"] is not None}\n        )\n    }\n    violation_codes = {\n        code: sum(code in row[\"tool_policy_violation_codes\"] for row in rows)\n        for code in sorted(\n            {\n                code\n                for row in rows\n                for code in row[\"tool_policy_violation_codes\"]\n            }\n        )\n    }\n    return {\n        \"attempt_count\": count,\n        \"quality_attempt_weighted_mean\": quality,\n        \"usage_tokens_total\": usage,\n        \"timing\": timing,\n        \"cost_usd_total\": _decimal_string(total_cost),\n        \"cost_usd_mean_per_attempt\": _decimal_string(total_cost / count),\n        \"failure_count\": failures,\n        \"failure_rate\": _rounded(failures / count),\n        \"failure_code_counts\": failure_codes,\n        \"tool_policy_compliant_count\": compliant,\n        \"tool_policy_compliance_rate\": _rounded(compliant / count),\n        \"tool_policy_violation_code_counts\": violation_codes,\n    }\n\n\ndef _build_scores(\n    freeze: dict[str, Any], sealed: dict[str, Any], results: dict[str, Any], *,\n    execution_freeze_sha256: str, sealed_oracle_sha256: str,\n    attempt_results_sha256: str, synthetic: bool,\n    scoring_authorization_sha256: str | None,\n) -> dict[str, Any]:\n    attempts = validate_attempt_results(\n        results,\n        freeze,\n        execution_freeze_sha256=execution_freeze_sha256,\n        sealed_oracle_sha256=sealed_oracle_sha256,\n        require_synthetic=synthetic,\n    )\n    oracle = validate_sealed_oracle(\n        sealed, freeze, sealed_oracle_sha256=sealed_oracle_sha256,\n    )\n    prices = _prices(freeze)\n    scored_attempts: list[dict[str, Any]] = []\n    for attempt in attempts:\n        compliant = attempt[\"tool_evidence\"][\"policy_compliant\"]\n        eligible = attempt[\"terminal_status\"] == \"success\" and compliant\n        quality = (\n            quality_metrics(\n                attempt[\"final_answer\"][\"locations\"], oracle[attempt[\"case_id\"]],\n            )\n            if eligible\n            else _zero_quality()\n        )\n        cost = _attempt_cost(attempt[\"usage\"], prices)\n        if attempt[\"cost_usd\"] != _decimal_string(cost):\n            raise ScoringError(\"attempt cost differs from frozen prices and exact token usage\")\n        scored_attempts.append({\n            \"pair_index\": attempt[\"pair_index\"],\n            \"repository_id\": attempt[\"repository_id\"],\n            \"repetition_index\": attempt[\"repetition_index\"],\n            \"system\": attempt[\"system\"],\n            \"system_position\": attempt[\"system_position\"],\n            \"case_id\": attempt[\"case_id\"],\n            \"terminal_status\": attempt[\"terminal_status\"],\n            \"failure_code\": attempt[\"failure_code\"],\n            \"tool_policy_compliant\": compliant,\n            \"tool_policy_violation_codes\": attempt[\"tool_evidence\"][\"violation_codes\"],\n            \"quality_eligible\": eligible,\n            \"quality\": quality,\n            \"usage\": attempt[\"usage\"],\n            \"timing\": {\n                \"task_wall_time_ms\": attempt[\"timing\"][\"task_wall_time_ms\"],\n                \"retrieval_phase_latency_ms\": attempt[\"retrieval_telemetry\"][\n                    \"controller_observed_latency_ms\"\n                ],\n                \"setup_index_wall_time_ms\": attempt[\"setup_reference\"][\n                    \"setup_index_wall_time_ms\"\n                ],\n                \"setup_excluded_from_task_timing\": attempt[\"setup_reference\"][\n                    \"setup_excluded_from_task_timing\"\n                ],\n            },\n            \"retrieval_telemetry\": attempt[\"retrieval_telemetry\"],\n            \"setup_record_sha256\": attempt[\"setup_reference\"][\"setup_record_sha256\"],\n            \"tool_trace_sha256\": attempt[\"tool_evidence\"][\"trace_sha256\"],\n            \"tool_call_count\": attempt[\"tool_evidence\"][\"tool_call_count\"],\n            \"cost_usd\": _decimal_string(cost),\n            \"final_answer_sha256\": (\n                _document_sha256(attempt[\"final_answer\"])\n                if attempt[\"final_answer\"] is not None else None\n            ),\n            \"transcript_sha256\": attempt[\"transcript_sha256\"],\n            \"stderr_sha256\": attempt[\"stderr_sha256\"],\n            \"return_code\": attempt[\"return_code\"],\n            \"timed_out\": attempt[\"timed_out\"],\n        })\n    systems = {\n        system: _aggregate_system([row for row in scored_attempts if row[\"system\"] == system])\n        for system in SYSTEMS\n    }\n    if any(value[\"attempt_count\"] == 0 for value in systems.values()):\n        raise ScoringError(\"a frozen system has no scheduled scored attempts\")\n    output = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": SYNTHETIC_SCORE_STAGE if synthetic else SCORE_STAGE,\n        \"development_only\": True,\n        \"synthetic_fixture\": synthetic,\n        \"controller_scoring_authorized\": not synthetic,\n        \"score_production_authorized\": not synthetic,\n        \"outcome_publication_authorized\": False,\n        \"confirmatory_use_allowed\": False,\n        \"broad_product_superiority_claim_allowed\": False,\n        \"execution_freeze_sha256\": execution_freeze_sha256,\n        \"sealed_oracle_sha256\": sealed_oracle_sha256,\n        \"attempt_results_sha256\": attempt_results_sha256,\n        \"scoring_authorization_sha256\": scoring_authorization_sha256,\n        **scorer_binding(),\n        \"scoring_contract\": SCORING_CONTRACT,\n        \"attempt_count\": len(scored_attempts),\n        \"attempts\": scored_attempts,\n        \"aggregates_by_system\": systems,\n        \"claim_boundary\": SCORING_CONTRACT[\"claim_boundary\"],\n    }\n    _assert_no_host_paths(output, \"score artifact\")\n    return output\n\n\ndef score_synthetic(\n    freeze: dict[str, Any], sealed: dict[str, Any], results: dict[str, Any],\n) -> dict[str, Any]:\n    \"\"\"Score only an explicitly synthetic fixture without granting real authority.\"\"\"\n\n    return _build_scores(\n        freeze,\n        sealed,\n        results,\n        execution_freeze_sha256=_document_sha256(freeze),\n        execution_freeze_sha256=_document_sha256(freeze),\n        sealed_oracle_sha256=_document_sha256(sealed),\n        attempt_results_sha256=_document_sha256(results),\n        synthetic=True,\n        scoring_authorization_sha256=None,\n    )\n\n\ndef _scoring_bindings(\n    *, execution_freeze_sha256: str, sealed_oracle_sha256: str,\n    attempt_results_sha256: str,\n) -> dict[str, str]:\n    return {\n        \"execution_freeze_sha256\": _require_sha256(\n            execution_freeze_sha256, \"execution freeze hash\",\n        ),\n        \"sealed_oracle_sha256\": _require_sha256(\n            sealed_oracle_sha256, \"sealed oracle hash\",\n        ),\n        \"attempt_results_sha256\": _require_sha256(\n            attempt_results_sha256, \"attempt results hash\",\n        ),\n        **scorer_binding(),\n    }\n\n\ndef build_false_scoring_authorization(\n    *, execution_freeze_sha256: str, sealed_oracle_sha256: str,\n    attempt_results_sha256: str,\n    authorization_note: str = \"controller scoring is not authorized\",\n) -> dict[str, Any]:\n    \"\"\"Build the only authorization document this CLI is allowed to create.\"\"\"\n\n    if not isinstance(authorization_note, str) or not authorization_note.strip():\n        raise ScoringError(\"authorization note must be non-empty\")\n    document = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": SCORING_AUTHORIZATION_STAGE,\n        \"development_only\": True,\n        \"controller_scoring_authorized\": False,\n        \"score_production_authorized\": False,\n        \"rank_production_authorized\": False,\n        \"outcome_publication_authorized\": False,\n        \"confirmatory_use_allowed\": False,\n        \"authorization_note\": authorization_note.strip(),\n        \"bindings\": _scoring_bindings(\n            execution_freeze_sha256=execution_freeze_sha256,\n            sealed_oracle_sha256=sealed_oracle_sha256,\n            attempt_results_sha256=attempt_results_sha256,\n        ),\n    }\n    _assert_no_host_paths(document, \"scoring authorization\")\n    return document\n\n\ndef validate_scoring_authorization(\n    document: dict[str, Any], *, execution_freeze_sha256: str,\n    sealed_oracle_sha256: str, attempt_results_sha256: str,\n    require_authorized: bool,\n) -> dict[str, Any]:\n    row = _require_fields(\n        document,\n        (\n            \"schema_version\", \"suite\", \"stage\", \"development_only\",\n            \"controller_scoring_authorized\", \"score_production_authorized\",\n            \"rank_production_authorized\", \"outcome_publication_authorized\",\n            \"confirmatory_use_allowed\", \"authorization_note\", \"bindings\",\n        ),\n        \"scoring authorization\",\n    )\n    controller = row[\"controller_scoring_authorized\"]\n    production = row[\"score_production_authorized\"]\n    if (\n        row[\"schema_version\"] != 1\n        or row[\"suite\"] != SUITE\n        or row[\"stage\"] != SCORING_AUTHORIZATION_STAGE\n        or row[\"development_only\"] is not True\n        or type(controller) is not bool\n        or type(production) is not bool\n        or controller is not production\n        or row[\"rank_production_authorized\"] is not False\n        or row[\"outcome_publication_authorized\"] is not False\n        or row[\"confirmatory_use_allowed\"] is not False\n        or not isinstance(row[\"authorization_note\"], str)\n        or not row[\"authorization_note\"].strip()\n    ):\n        raise ScoringError(\"scoring authorization identity or authority boundary is malformed\")\n    if row[\"bindings\"] != _scoring_bindings(\n        execution_freeze_sha256=execution_freeze_sha256,\n        sealed_oracle_sha256=sealed_oracle_sha256,\n        attempt_results_sha256=attempt_results_sha256,\n    ):\n        raise ScoringError(\"scoring authorization does not match every exact scoring binding\")\n    if require_authorized and controller is not True:\n        raise ScoringError(\"controller scoring is not authorized by the exact authorization artifact\")\n    _assert_no_host_paths(row, \"scoring authorization\")\n    return row\n\n\ndef _assert_no_host_paths(value: Any, label: str) -> None:\n    if isinstance(value, str):\n        folded = value.casefold()\n        if (\n            value.startswith(\"/\")\n            or folded.startswith(\"file:\")\n            or \"/users/\" in folded\n            or \"/private/\" in folded\n            or \"\\\\users\\\\\" in folded\n        ):\n            raise ScoringError(f\"{label} contains a host path\")\n    elif type(value) is dict:\n        for nested in value.values():\n            _assert_no_host_paths(nested, label)\n    elif type(value) is list:\n        for nested in value:\n            _assert_no_host_paths(nested, label)\n\n\ndef _write_once_or_match(path: Path, document: dict[str, Any], label: str) -> str:\n    if path.exists():\n        existing = artifacts.read_canonical_json(path, expected_type=dict).document\n        if existing != document:\n            raise ScoringError(f\"existing {label} differs from the exact document\")\n        return artifacts.sha256_file(path)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    return artifacts.write_new_canonical_json(path, document)\n\n\ndef create_false_scoring_authorization(\n    freeze_path: Path, sealed_path: Path, results_path: Path, output: Path, *,\n    authorization_note: str = \"controller scoring is not authorized\",\n) -> dict[str, Any]:\n    \"\"\"Hash, but do not open, attempt results and emit a false authorization.\"\"\"\n\n    freeze_artifact = artifacts.read_canonical_json(freeze_path, expected_type=dict)\n    freeze = freeze_artifact.document\n    if (\n        freeze.get(\"suite\") != SUITE\n        or freeze.get(\"stage\") != runner.FREEZE_STAGE\n        or freeze.get(\"development_only\") is not True\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
