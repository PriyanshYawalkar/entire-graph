{"timestamp":"2026-07-18T16:30:06.097Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7610-4711-7b82-8810-64d02c65c64d","call_id":"call_tACyOsoOY97CmHXxhSH7YCTC","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"9:to a separate controller-only artifact.\n34:SEALED_STAGE = \"sealed_controller_issue_localization_judgments\"\n53:DEFAULT_SEALED_OUTPUT = SUITE_DIR / \"sealed-controller-judgments.json\"\n68:AUTHORITY_FIELDS = (\n71:    \"controller_scoring_authorized\",\n275:    return {field: False for field in AUTHORITY_FIELDS}\n287:        \"logical_path\": SOURCE_LOGICAL_PATH,\n302:    for field in AUTHORITY_FIELDS:\n323:        \"logical_path\": SOURCE_LOGICAL_PATH,\n691:        \"agent_visible\": True,\n693:        \"queries_present\": True,\n706:        \"agent_visible\": False,\n708:        \"queries_present\": False,\n752:        \"controller_judgments_agent_visible\": False,\n755:        \"sealed_controller_sha256\": sealed_sha256,\n767:    validate_public_contract(public)\n768:    validate_sealed_contract(sealed, public)\n769:    validate_attestation_contract(attestation, public, sealed)\n773:def validate_public_contract(document: dict[str, Any]) -> None:\n774:    if document.get(\"queries_present\") is not True:\n804:                    \"public tasks contain controller-only keys: \" + \", \".join(sorted(leaked))\n813:    if any(document.get(field) is not False for field in AUTHORITY_FIELDS):\n857:def validate_sealed_contract(\n863:        or sealed.get(\"agent_visible\") is not False\n868:        raise MaterializationError(\"sealed controller contract mismatch\")\n869:    if any(sealed.get(field) is not False for field in AUTHORITY_FIELDS):\n870:        raise MaterializationError(\"sealed controller grants authority\")\n889:            raise MaterializationError(\"sealed controller contains agent prompt or patch content\")\n894:            raise MaterializationError(\"sealed controller judgments are missing\")\n896:            raise MaterializationError(\"sealed controller judgment hash mismatch\")\n898:            raise MaterializationError(\"sealed controller judgment count mismatch\")\n899:    _assert_no_host_paths(sealed, \"sealed controller\")\n902:def validate_attestation_contract(\n913:        or attestation.get(\"controller_judgments_agent_visible\") is not False\n916:    if any(attestation.get(field) is not False for field in AUTHORITY_FIELDS):\n926:        or attestation.get(\"sealed_controller_sha256\") != _sha256_json(sealed)\n965:def publish_artifacts(\n977:    validate_public_contract(public)\n978:    validate_sealed_contract(sealed, public)\n979:    validate_attestation_contract(attestation, public, sealed)\n1007:        (\"public tasks\", \"sealed controller\", \"materialization attestation\"),\n1013:    validate_public_contract(observed[0])\n1014:    validate_sealed_contract(observed[1], observed[0])\n1015:    validate_attestation_contract(observed[2], observed[0], observed[1])\n1096:            publish_artifacts(\nMIN_QUERY_TERMS = 3\nMAX_QUERY_TERMS = 1000\nMAX_CHANGED_FILES = 8\nMAX_CHANGED_LINES = 300\nMAX_REGIONS = 20\nEXCLUDED_PARTS = {\".git\", \"node_modules\", \"vendor\", \"dist\", \"build\", \"target\"}\nEXCLUDED_NAMES = {\"package-lock.json\", \"yarn.lock\", \"pnpm-lock.yaml\"}\n\nAUTHORITY_FIELDS = (\n    \"catalog_construction_authorized\",\n    \"issue_query_construction_authorized\",\n    \"controller_scoring_authorized\",\n    \"repair_execution_authorized\",\n    \"model_execution_authorized\",\n    \"paid_execution_authorized\",\n    \"confirmatory_execution_authorized\",\n    \"confirmatory_use_allowed\",\n    \"confirmatory_publication_authorized\",\n    \"rank_production_authorized\",\n    \"score_production_authorized\",\n    \"outcome_publication_authorized\",\n)\n\nSOURCE_COLUMNS = (\n    \"instance_id\",\n    \"repo\",\n    \"language\",\n    \"created_at\",\n    \"base_commit\",\n    \"problem_statement\",\n    \"patch\",\n)\n\n\nclass MaterializationError(ValueError):\n    \"\"\"Raised when a materialization invariant fails closed.\"\"\"\n\n\nCheckoutProvider = Callable[[Path, dict[str, Any]], dict[str, Any]]\n\n\ndef _sha256_json(value: Any) -> str:\n    return artifacts.sha256_bytes(artifacts.canonical_bytes(value))\n\n\ndef _require_string(value: Any, label: str) -> str:\n    if type(value) is not str or not value.strip():\n        raise MaterializationError(f\"{label} must be a non-empty string\")\n    return value.strip()\n\n\ndef canonical_repo(value: Any) -> str:\n    repository = _require_string(value, \"repository identity\")\n    repository = repository.replace(\"\\\\\", \"/\").removesuffix(\".git\").strip(\"/\")\n    for prefix in (\"https://github.com/\", \"http://github.com/\", \"github.com/\"):\n        if repository.casefold().startswith(prefix):\n            repository = repository[len(prefix) :]\n            break\n    if repository.casefold().startswith(\"git@github.com:\"):\n        repository = repository[len(\"git@github.com:\") :]\n    parts = repository.split(\"/\")\n                \"created_at\": source_row[\"created_at\"],\n                \"tracked_files\": case[\"tracked_files\"],\n                \"issue_text_sha256\": hashlib.sha256(issue.encode(\"utf-8\")).hexdigest(),\n                \"task\": {\n                    \"kind\": \"read_only_issue_analysis\",\n                    \"instruction\": instruction,\n                    \"issue_text\": issue,\n                    \"prompt\": f\"{instruction}\\n\\nIssue:\\n{issue}\",\n                },\n            }\n        )\n        sealed_cases.append(\n            {\n                **common,\n                \"source_instance_id\": source_row[\"instance_id\"],\n                \"patch_sha256\": case[\"patch_sha256\"],\n                \"judgment_count\": len(case[\"judgments\"]),\n                \"judgments_sha256\": case[\"judgments_sha256\"],\n                \"judgments\": case[\"judgments\"],\n            }\n        )\n\n    selection = {\n        \"algorithm\": \"minimum_sha256_seed_nul_case_nul_normalized_repo_nul_instance_id_v1\",\n        \"seed\": CASE_SELECTION_SEED,\n        \"repository_count\": REPOSITORY_COUNT,\n        \"cases_per_repository\": CASES_PER_REPOSITORY,\n        \"generic_query_and_patch_scope_rules_predeclared\": True,\n        \"selection_completed_before_system_results\": True,\n        \"post_result_resampling_permitted\": False,\n        \"system_output_data_consulted\": False,\n        \"rank_data_consulted\": False,\n        \"score_data_consulted\": False,\n        \"model_or_paid_process_used\": False,\n    }\n    claim_boundary = {\n        \"issue_localization_development_smoke_only\": True,\n        \"source_may_leak_solution_direction\": True,\n        \"code_repair_claim_allowed\": False,\n        \"broad_superiority_claim_allowed\": False,\n        \"confirmatory_claim_allowed\": False,\n    }\n    common_root = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        **flags,\n        \"development_only\": True,\n        \"generator_sha256\": artifacts.sha256_file(Path(__file__)),\n        \"producer_dependency_bindings\": {\n            \"artifact_contract_sha256\": artifacts.sha256_file(Path(artifacts.__file__))\n        },\n        \"cohort_sha256\": cohort_sha256,\n        \"source\": source,\n        \"selection\": selection,\n        \"claim_boundary\": claim_boundary,\n        \"repository_count\": REPOSITORY_COUNT,\n        \"case_count\": len(public_cases),\n    }\n    public = {\n        **common_root,\n        \"stage\": PUBLIC_STAGE,\n        \"agent_visible\": True,\n        \"sealed\": False,\n        \"queries_present\": True,\n        \"qrels_present\": False,\n        \"expected_outcomes_present\": False,\n        \"patches_present\": False,\n        \"repair_oracles_present\": False,\n        \"ranks_present\": False,\n        \"scores_present\": False,\n        \"outcomes_present\": False,\n        \"cases\": public_cases,\n    }\n    sealed = {\n        **common_root,\n        \"stage\": SEALED_STAGE,\n        \"agent_visible\": False,\n        \"sealed\": True,\n        \"queries_present\": False,\n        \"qrels_present\": True,\n        \"patch_content_present\": False,\n        \"patch_derived_judgments_present\": True,\n        \"expected_outcomes_present\": False,\n        \"repair_oracles_present\": False,\n        \"system_ranks_present\": False,\n        \"system_scores_present\": False,\n        \"system_outcomes_present\": False,\n        \"cases\": sealed_cases,\n    }\n    public_sha256 = _sha256_json(public)\n    sealed_sha256 = _sha256_json(sealed)\n    checkout_bindings = sorted(\n        (_checkout_projection(case) for case in materialized), key=lambda row: row[\"id\"]\n    )\n    mapping_counts = {\n        \"cases\": len(materialized),\n        \"repositories\": len({case[\"normalized_repo\"] for case in materialized}),\n        \"patch_derived_regions\": sum(len(case[\"judgments\"]) for case in materialized),\n        \"unique_base_snapshot_paths\": len(\n            {\n                (case[\"id\"], judgment[\"file_path\"])\n                for case in materialized\n                for judgment in case[\"judgments\"]\n            }\n        ),\n        \"missing_base_snapshot_paths\": 0,\n        \"ambiguous_base_snapshot_paths\": 0,\n    }\n    attestation = {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": ATTESTATION_STAGE,\n        **flags,\n        \"development_only\": True,\n        \"generator_sha256\": artifacts.sha256_file(Path(__file__)),\n        \"producer_dependency_bindings\": {\n            \"artifact_contract_sha256\": artifacts.sha256_file(Path(artifacts.__file__))\n        },\n        \"model_or_paid_process_used\": False,\n        \"system_output_data_consulted\": False,\n        \"rank_data_consulted\": False,\n        \"score_data_consulted\": False,\n        \"controller_judgments_agent_visible\": False,\n        \"cohort_sha256\": cohort_sha256,\n        \"public_tasks_sha256\": public_sha256,\n        \"sealed_controller_sha256\": sealed_sha256,\n        \"source\": {**source, \"source_row_count\": source_row_count},\n        \"selection_seed\": CASE_SELECTION_SEED,\n        \"checkout_binding_sha256\": _sha256_json(checkout_bindings),\n        \"source_record_binding_sha256\": _sha256_json(\n            sorted(case[\"source_record_sha256\"] for case in materialized)\n        ),\n        \"selected_repository_source_row_counts\": raw_counts,\n        \"structural_exclusion_counts\": exclusion_counts,\n        \"mapping_counts\": mapping_counts,\n        \"claim_boundary\": claim_boundary,\n    }\n    validate_public_contract(public)\n    validate_sealed_contract(sealed, public)\n    validate_attestation_contract(attestation, public, sealed)\n    return public, sealed, attestation\n\n\ndef validate_public_contract(document: dict[str, Any]) -> None:\n    if document.get(\"queries_present\") is not True:\n        raise MaterializationError(\"public tasks must carry queries\")\n    for field in (\n        \"qrels_present\",\n        \"expected_outcomes_present\",\n        \"patches_present\",\n        \"repair_oracles_present\",\n        \"ranks_present\",\n        \"scores_present\",\n        \"outcomes_present\",\n    ):\n        if document.get(field) is not False:\n            raise MaterializationError(f\"public task leakage flag is true: {field}\")\n    forbidden = {\n        \"source_instance_id\",\n        \"patch\",\n        \"patch_sha256\",\n        \"judgment_count\",\n        \"judgments\",\n        \"judgments_sha256\",\n        \"locations\",\n        \"expected_answer\",\n        \"touched_paths\",\n    }\n\n    def walk(value: Any) -> None:\n        if type(value) is dict:\n            leaked = set(value) & forbidden\n            if leaked:\n                raise MaterializationError(\n                    \"public tasks contain controller-only keys: \" + \", \".join(sorted(leaked))\n                )\n            for nested in value.values():\n                walk(nested)\n        elif type(value) is list:\n            for nested in value:\n                walk(nested)\n\n    walk(document)\n    if any(document.get(field) is not False for field in AUTHORITY_FIELDS):\n        raise MaterializationError(\"public tasks grant authority\")\n\n\ndef _case_bindings(document: dict[str, Any]) -> dict[str, dict[str, Any]]:\n    rows = document.get(\"cases\")\n    if type(rows) is not list or len(rows) != REPOSITORY_COUNT:\n        raise MaterializationError(\"materialization must contain exactly three cases\")\n    bindings: dict[str, dict[str, Any]] = {}\n    repositories: set[str] = set()\n    for row in rows:\n        if type(row) is not dict:\n            raise MaterializationError(\"materialization case is malformed\")\n        case_id = _require_string(row.get(\"id\"), \"case id\")\n        if case_id in bindings:\n            raise MaterializationError(\"materialization contains duplicate case id\")\n        normalized = normalize_repo(row.get(\"repo\"))\n        if row.get(\"normalized_repo\") != normalized or normalized in repositories:\n            raise MaterializationError(\"materialization repository binding mismatch\")\n        repositories.add(normalized)\n        bindings[case_id] = row\n    if len(repositories) != REPOSITORY_COUNT:\n        raise MaterializationError(\"materialization must contain three repositories\")\n    return bindings\n\n\ndef _assert_no_host_paths(value: Any, label: str) -> None:\n    if type(value) is str:\n        folded = value.casefold()\n        if (\n            value.startswith(\"/\")\n            or re.match(r\"^[a-zA-Z]:[\\\\/]\", value)\n            or \"/private/tmp/\" in folded\n            or \"/users/\" in folded\n        ):\n            raise MaterializationError(f\"{label} contains a host path\")\n    elif type(value) is dict:\n        for nested in value.values():\n            _assert_no_host_paths(nested, label)\n    elif type(value) is list:\n        for nested in value:\n            _assert_no_host_paths(nested, label)\n\n\ndef validate_sealed_contract(\n    sealed: dict[str, Any], public: dict[str, Any]\n) -> None:\n    if (\n        sealed.get(\"suite\") != SUITE\n        or sealed.get(\"stage\") != SEALED_STAGE\n        or sealed.get(\"agent_visible\") is not False\n        or sealed.get(\"sealed\") is not True\n        or sealed.get(\"patch_content_present\") is not False\n        or sealed.get(\"patch_derived_judgments_present\") is not True\n    ):\n        raise MaterializationError(\"sealed controller contract mismatch\")\n    if any(sealed.get(field) is not False for field in AUTHORITY_FIELDS):\n        raise MaterializationError(\"sealed controller grants authority\")\n    public_bindings = _case_bindings(public)\n    sealed_bindings = _case_bindings(sealed)\n    if set(public_bindings) != set(sealed_bindings):\n        raise MaterializationError(\"public and sealed case identifiers differ\")\n    common_fields = (\n        \"id\",\n        \"repo\",\n        \"normalized_repo\",\n        \"language\",\n        \"base_commit\",\n        \"base_tree\",\n        \"checkout_relative_path\",\n        \"source_record_sha256\",\n        \"query_record_sha256\",\n    )\n    forbidden = {\"task\", \"prompt\", \"instruction\", \"issue_text\", \"problem_statement\", \"patch\"}\n    for case_id, row in sealed_bindings.items():\n        if set(row) & forbidden:\n            raise MaterializationError(\"sealed controller contains agent prompt or patch content\")\n        if any(row.get(field) != public_bindings[case_id].get(field) for field in common_fields):\n            raise MaterializationError(\"public and sealed case bindings differ\")\n        judgments = row.get(\"judgments\")\n        if type(judgments) is not list or not judgments:\n            raise MaterializationError(\"sealed controller judgments are missing\")\n        if row.get(\"judgments_sha256\") != _sha256_json(judgments):\n            raise MaterializationError(\"sealed controller judgment hash mismatch\")\n        if row.get(\"judgment_count\") != len(judgments):\n            raise MaterializationError(\"sealed controller judgment count mismatch\")\n    _assert_no_host_paths(sealed, \"sealed controller\")\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
