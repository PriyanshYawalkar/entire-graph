{"timestamp":"2026-07-18T17:43:21.114Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7653-571a-7130-8c0d-a838b3be944f","call_id":"call_jEkMi0w8Pkdt3FbUPGxCKhKv","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"#!/usr/bin/env python3\n\"\"\"Freeze, preflight, and exactly gate the agentic issue-analysis smoke.\n\nThe built-in Claude Code adapter is unreachable unless separately hashed paid\nauthorization and unpaid-preflight artifacts pass every live binding.  Tests\ninject fake credentials, sandboxes, and processes; importing or freezing this\nmodule never launches a model.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport shlex\nimport shutil\nimport subprocess\nimport sys\nimport time\nfrom collections import Counter\nfrom decimal import Decimal, InvalidOperation\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nimport run_agentic_tasks_smoke as smoke\n\n\nartifacts = smoke.artifacts\nruntime = smoke.runtime\ncanonical_write = smoke.canonical_write\n\nSUITE = \"entire_graph_agentic_issue_analysis_smoke_v1\"\nFREEZE_STAGE = \"frozen_unpaid_agentic_issue_analysis_execution\"\nAUTHORIZATION_STAGE = \"exact_hash_agentic_issue_analysis_execution_authorization\"\nPREFLIGHT_STAGE = \"unpaid_agentic_issue_analysis_preflight\"\nCOHORT_STAGE = \"frozen_unpaid_agentic_issue_analysis_repository_cohort\"\nPUBLIC_TASK_STAGE = \"frozen_public_issue_analysis_tasks\"\nSEALED_ORACLE_STAGE = \"sealed_controller_issue_localization_judgments\"\nMATERIALIZATION_ATTESTATION_STAGE = \"issue_analysis_materialization_attestation\"\nATTEMPT_START_STAGE = \"agentic_issue_analysis_attempt_start\"\nATTEMPT_COMPLETE_STAGE = \"complete_agentic_issue_analysis_attempt\"\nRUN_ATTESTATION_STAGE = \"agentic_issue_analysis_run_attestation\"\nSYSTEMS = (\"file-tools\", \"entire-graph\", \"cbm\")\nCBM_RETRIEVAL_TOOLS = (\n    \"mcp__codebase-memory-mcp__search_graph\",\n    \"mcp__codebase-memory-mcp__query_graph\",\n    \"mcp__codebase-memory-mcp__trace_path\",\n    \"mcp__codebase-memory-mcp__get_code_snippet\",\n    \"mcp__codebase-memory-mcp__get_architecture\",\n    \"mcp__codebase-memory-mcp__search_code\",\n)\nROTATIONS = (\n    SYSTEMS,\n    (\"entire-graph\", \"cbm\", \"file-tools\"),\n    (\"cbm\", \"file-tools\", \"entire-graph\"),\n)\nDEFAULT_REPETITION_COUNT = 1\nMIN_CONFIRMATORY_REPETITIONS = 3\n\nAUTHORITY_FALSE_FIELDS = (\n    \"catalog_construction_authorized\",\n    \"issue_query_construction_authorized\",\n    \"controller_scoring_authorized\",\n    \"repair_execution_authorized\",\n    \"confirmatory_execution_authorized\",\n    \"confirmatory_use_allowed\",\n    \"confirmatory_publication_authorized\",\n    \"rank_production_authorized\",\n    \"score_production_authorized\",\n    \"outcome_publication_authorized\",\n)\n\nCOHORT_FALSE_FIELDS = (\n    \"catalog_construction_authorized\",\n    \"issue_query_construction_authorized\",\n    \"controller_scoring_authorized\",\n    \"repair_execution_authorized\",\n    \"model_execution_authorized\",\n    \"paid_execution_authorized\",\n    \"confirmatory_execution_authorized\",\n    \"confirmatory_use_allowed\",\n    \"confirmatory_publication_authorized\",\n    \"rank_production_authorized\",\n    \"score_production_authorized\",\n    \"outcome_publication_authorized\",\n    \"queries_present\",\n    \"qrels_present\",\n    \"expected_outcomes_present\",\n    \"repair_oracles_present\",\n    \"ranks_present\",\n    \"scores_present\",\n    \"outcomes_present\",\n)\n\nPUBLIC_TASK_FALSE_FIELDS = (\n    \"qrels_present\",\n    \"expected_outcomes_present\",\n    \"patches_present\",\n    \"repair_oracles_present\",\n    \"ranks_present\",\n    \"scores_present\",\n    \"outcomes_present\",\n)\n\nMATERIALIZATION_AUTHORITY_FIELDS = (\n    \"catalog_construction_authorized\",\n    \"issue_query_construction_authorized\",\n    \"controller_scoring_authorized\",\n    \"repair_execution_authorized\",\n    \"model_execution_authorized\",\n    \"paid_execution_authorized\",\n    \"confirmatory_execution_authorized\",\n    \"confirmatory_use_allowed\",\n    \"confirmatory_publication_authorized\",\n    \"rank_production_authorized\",\n    \"score_production_authorized\",\n    \"outcome_publication_authorized\",\n)\n\nSOURCE_BINDING_FIELDS = {\n    \"dataset\",\n    \"dataset_revision\",\n    \"dataset_metadata_sha256\",\n    \"parquet_revision\",\n    \"parquet_sha256\",\n    \"parquet_byte_count\",\n    \"source_row_count\",\n    \"logical_path\",\n}\n\nFINAL_ANSWER_SCHEMA = {\n    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n    \"type\": \"object\",\n    \"additionalProperties\": False,\n    \"required\": [\"summary\", \"locations\", \"confidence\"],\n    \"properties\": {\n        \"summary\": {\"type\": \"string\", \"minLength\": 1},\n        \"locations\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"maxItems\": 10,\n            \"description\": \"ordered from most to least relevant\",\n            \"items\": {\n                \"type\": \"object\",\n                \"additionalProperties\": False,\n                \"required\": [\"file_path\", \"rationale\"],\n                \"dependentRequired\": {\n                    \"start_line\": [\"end_line\"],\n                    \"end_line\": [\"start_line\"],\n                },\n                \"properties\": {\n                    \"file_path\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1,\n                        \"pattern\": r\"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$\",\n                        \"description\": \"repository-relative path\",\n                    },\n                    \"start_line\": {\"type\": \"integer\", \"minimum\": 1},\n                    \"end_line\": {\n                        \"type\": \"integer\",\n                        \"minimum\": 1,\n                        \"description\": \"inclusive and not less than start_line\",\n                    },\n                    \"rationale\": {\"type\": \"string\", \"minLength\": 1},\n                },\n            },\n        },\n        \"confidence\": {\"type\": \"string\", \"enum\": [\"high\", \"medium\", \"low\"]},\n    },\n}\n\nATTEMPT_RESULT_SCHEMA = {\n    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n    \"type\": \"object\",\n    \"additionalProperties\": False,\n    \"required\": [\n        \"pair_index\", \"repository_id\", \"repetition_index\", \"system\",\n        \"system_position\", \"case_id\", \"terminal_status\", \"failure_code\",\n        \"final_answer\", \"usage\", \"cost_usd\", \"timing\", \"setup_reference\",\n        \"tool_evidence\", \"retrieval_telemetry\", \"transcript_sha256\",\n        \"stderr_sha256\", \"return_code\", \"timed_out\",\n    ],\n    \"$defs\": {\n        \"sha256\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{64}$\"},\n        \"safe_code\": {\"type\": \"string\", \"pattern\": \"^[a-z][a-z0-9_]{0,63}$\"},\n        \"final_answer\": FINAL_ANSWER_SCHEMA,\n    },\n    \"properties\": {\n        \"pair_index\": {\"type\": \"integer\", \"minimum\": 1},\n        \"repository_id\": {\"type\": \"string\", \"minLength\": 1},\n        \"repetition_index\": {\"type\": \"integer\", \"minimum\": 1},\n        \"system\": {\"type\": \"string\", \"enum\": list(SYSTEMS)},\n        \"system_position\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 3},\n        \"case_id\": {\"type\": \"string\", \"minLength\": 1},\n        \"terminal_status\": {\"type\": \"string\", \"enum\": [\"success\", \"failure\"]},\n        \"failure_code\": {\n            \"oneOf\": [{\"$ref\": \"#/$defs/safe_code\"}, {\"type\": \"null\"}],\n        },\n        \"final_answer\": {\n            \"oneOf\": [{\"$ref\": \"#/$defs/final_answer\"}, {\"type\": \"null\"}],\n        },\n        \"usage\": {\n            \"type\": \"object\",\n            \"additionalProperties\": False,\n            \"required\": [\n                \"input_tokens\", \"output_tokens\", \"cache_creation_input_tokens\",\n                \"cache_read_input_tokens\", \"total_model_tokens\",\n            ],\n            \"properties\": {\n                field: {\"type\": \"integer\", \"minimum\": 0}\n                for field in (\n                    \"input_tokens\", \"output_tokens\", \"cache_creation_input_tokens\",\n                    \"cache_read_input_tokens\", \"total_model_tokens\",\n                )\n            },\n            \"description\": \"total_model_tokens equals the sum of the four token counters\",\n        },\n        \"cost_usd\": {\n            \"type\": \"string\",\n            \"pattern\": r\"^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$\",\n            \"description\": \"canonical nonnegative decimal recomputed from frozen prices\",\n        },\n        \"timing\": {\n            \"type\": \"object\",\n            \"additionalProperties\": False,\n            \"required\": [\"task_wall_time_ms\"],\n            \"properties\": {\"task_wall_time_ms\": {\"type\": \"integer\", \"minimum\": 0}},\n        },\n        \"setup_reference\": {\n            \"type\": \"object\",\n            \"additionalProperties\": False,\n            \"required\": [\n                \"setup_record_sha256\", \"setup_index_wall_time_ms\",\n                \"setup_excluded_from_task_timing\",\n            ],\n            \"properties\": {\n                \"setup_record_sha256\": {\"$ref\": \"#/$defs/sha256\"},\n                \"setup_index_wall_time_ms\": {\"type\": \"integer\", \"minimum\": 0},\n                \"setup_excluded_from_task_timing\": {\"const\": True},\n            },\n        },\n        \"tool_evidence\": {\n            \"type\": \"object\",\n            \"additionalProperties\": False,\n            \"required\": [\n                \"tool_call_count\", \"trace_sha256\", \"policy_compliant\",\n                \"violation_codes\",\n            ],\n            \"properties\": {\n                \"tool_call_count\": {\"type\": \"integer\", \"minimum\": 0},\n                \"trace_sha256\": {\"$ref\": \"#/$defs/sha256\"},\n                \"policy_compliant\": {\"type\": \"boolean\"},\n                \"violation_codes\": {\n                    \"type\": \"array\",\n                    \"uniqueItems\": True,\n                    \"items\": {\"$ref\": \"#/$defs/safe_code\"},\n                },\n            },\n            \"description\": \"policy_compliant is true exactly when violation_codes is empty\",\n        },\n        \"retrieval_telemetry\": {\n            \"type\": \"object\",\n            \"additionalProperties\": False,\n            \"required\": [\n                \"retrieval_call_count\", \"entire_graph_call_count\",\n                \"controller_observed_latency_ms\", \"product_reported_total_latency_ms\",\n                \"entire_graph_all_index_cache_hits\",\n            ],\n            \"properties\": {\n                \"retrieval_call_count\": {\"type\": \"integer\", \"minimum\": 0},\n                \"entire_graph_call_count\": {\"type\": \"integer\", \"minimum\": 0},\n                \"controller_observed_latency_ms\": {\"type\": \"integer\", \"minimum\": 0},\n                \"product_reported_total_latency_ms\": {\n                    \"type\": [\"integer\", \"null\"], \"minimum\": 0,\n                },\n                \"entire_graph_all_index_cache_hits\": {\"type\": [\"boolean\", \"null\"]},\n            },\n            \"description\": (\n                \"entire_graph_call_count is at most retrieval_call_count; Graph product \"\n                \"latency and cache-hit values are non-null exactly when Graph calls are positive, \"\n                \"and all observed Graph calls must hit the prepared index\"\n            ),\n        },\n        \"transcript_sha256\": {\"$ref\": \"#/$defs/sha256\"},\n        \"stderr_sha256\": {\"$ref\": \"#/$defs/sha256\"},\n        \"return_code\": {\"type\": [\"integer\", \"null\"]},\n        \"timed_out\": {\"type\": \"boolean\"},\n    },\n    \"allOf\": [\n        {\n            \"if\": {\"properties\": {\"terminal_status\": {\"const\": \"success\"}}},\n            \"then\": {\n                \"properties\": {\n                    \"failure_code\": {\"type\": \"null\"},\n                    \"final_answer\": {\"$ref\": \"#/$defs/final_answer\"},\n                    \"return_code\": {\"const\": 0},\n                    \"timed_out\": {\"const\": False},\n                },\n            },\n        },\n        {\n            \"if\": {\"properties\": {\"terminal_status\": {\"const\": \"failure\"}}},\n            \"then\": {\n                \"properties\": {\n                    \"failure_code\": {\"$ref\": \"#/$defs/safe_code\"},\n                    \"final_answer\": {\"type\": \"null\"},\n                },\n            },\n        },\n        {\n            \"if\": {\"properties\": {\"timed_out\": {\"const\": True}}},\n            \"then\": {\n                \"properties\": {\n                    \"terminal_status\": {\"const\": \"failure\"},\n                    \"return_code\": {\"type\": \"null\"},\n                },\n            },\n        },\n    ],\n}\n\nPRICE_FIELDS = (\n    \"input_tokens_usd_per_million\",\n    \"output_tokens_usd_per_million\",\n    \"cache_creation_input_tokens_usd_per_million\",\n    \"cache_read_input_tokens_usd_per_million\",\n)\n\nTIMING_POLICY = {\n    \"setup_excluded_from_task_timing\": True,\n    \"all_product_setup_completed_before_paid_process\": True,\n    \"task_timer_starts_after_checkout_and_index_validation\": True,\n    \"task_timer_stops_after_model_process_completion\": True,\n    \"setup_wall_time_reported_separately\": True,\n    \"paired_attempts_execute_without_concurrent_setup\": True,\n}\n\nGRAPH_PHASE_TELEMETRY_FIELD_DEFINITIONS = {\n    \"search\": {\n        \"index_cache_hit\": {\n            \"json_path\": \"stats.index_cache_hit\",\n            \"type\": \"boolean\",\n            \"definition\": \"whether the exact committed-tree provider index was reused\",\n        },\n        \"preselect_latency_ms\": {\n            \"json_path\": \"stats.preselect_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"repository file discovery and query-dependent preselection\",\n        },\n        \"index_latency_ms\": {\n            \"json_path\": \"stats.index_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"load or construction of the selected provider index\",\n        },\n        \"query_latency_ms\": {\n            \"json_path\": \"stats.query_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"retrieval and ranking after the provider index is available\",\n        },\n        \"total_latency_ms\": {\n            \"json_path\": \"stats.total_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"end-to-end Graph retrieval latency including preselection, index, and query phases\",\n        },\n    },\n    \"neighbors\": {\n        \"index_cache_hit\": {\n            \"json_path\": \"index_cache_hit\",\n            \"type\": \"boolean\",\n            \"definition\": \"whether the exact committed-tree provider snapshot was reused\",\n        },\n        \"index_latency_ms\": {\n            \"json_path\": \"index_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"load or construction of the provider snapshot\",\n        },\n        \"query_latency_ms\": {\n            \"json_path\": \"query_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"focus matching, adjacency selection, ordering, and bounded path construction\",\n        },\n        \"total_latency_ms\": {\n            \"json_path\": \"total_latency_ms\",\n            \"type\": \"integer\",\n            \"unit\": \"milliseconds\",\n            \"definition\": \"end-to-end Graph retrieval latency including index and neighbor-query phases\",\n        },\n    },\n    \"measurement_rules\": {\n        \"phase_values_are_product_reported\": True,\n        \"setup_index_time_is_not_a_task_phase\": True,\n        \"controller_task_wall_time_is_reported_separately\": True,\n        \"cache_hit_is_required_for_timed_graph_retrieval\": True,\n    },\n}\n\nALLOWED_TOOL_POLICY = {\n    \"policy_version\": \"read_only_issue_analysis_tools_v1\",\n    \"native_tools\": [\"Read\", \"Grep\", \"Glob\"],\n    \"general_bash_allowed\": False,\n    \"read_only_shell_allowlist\": [],\n    \"permission_mode\": \"dontAsk\",\n    \"forced_retrieval_sequence\": False,\n    \"ordinary_targeted_file_reads_allowed\": True,\n    \"repository_claude_md_allowed\": True,\n    \"user_home_memory_allowed\": False,\n    \"network_allowed\": False,\n    \"repository_writes_allowed\": False,\n    \"language_runtime_execution_allowed\": False,\n    \"explicitly_forbidden_executables\": [\n        \"bash\", \"sh\", \"zsh\", \"python\", \"python3\", \"node\", \"ruby\", \"perl\",\n        \"curl\", \"wget\", \"ssh\", \"scp\",\n    ],\n    \"explicitly_forbidden_git_operations\": [\n        \"clone\", \"fetch\", \"pull\", \"push\", \"log\", \"show\", \"blame\", \"rev-list\",\n        \"cat-file\", \"ls-tree\",\n    ],\n}\n\n# Deliberately imported only after the constants consumed by the scorer are\n# initialized. This keeps direct runner imports and scorer-first imports safe.\nimport score_agentic_issue_analysis_smoke as scorer\n\n\nclass IssueAnalysisError(ValueError):\n    \"\"\"Raised when an unpaid freeze or execution binding fails closed.\"\"\"\n\n\ndef _document_sha256(value: Any) -> str:\n    return artifacts.sha256_bytes(artifacts.canonical_bytes(value))\n\n\ndef _paths_overlap(left: Path, right: Path) -> bool:\n    return left == right or left.is_relative_to(right) or right.is_relative_to(left)\n\n\ndef _is_sha256(value: Any) -> bool:\n    return isinstance(value, str) and re.fullmatch(r\"[0-9a-f]{64}\", value) is not None\n\n\ndef _assert_false_fields(document: dict[str, Any], fields: tuple[str, ...], label: str) -> None:\n    for field in fields:\n        if document.get(field) is not False:\n            raise IssueAnalysisError(f\"{label} must keep {field}=false\")\n\n\ndef _assert_claim_boundary(document: dict[str, Any], label: str) -> None:\n    claim = document.get(\"claim_boundary\")\n    if type(claim) is not dict or any(\n        claim.get(field) is not False\n        for field in (\n            \"code_repair_claim_allowed\",\n            \"broad_superiority_claim_allowed\",\n            \"confirmatory_claim_allowed\",\n        )\n    ):\n        raise IssueAnalysisError(f\"{label} claim boundary is not development-only\")\n\n\ndef _assert_producer_binding(document: dict[str, Any], label: str) -> None:\n    dependencies = document.get(\"producer_dependency_bindings\")\n    if (\n        not _is_sha256(document.get(\"generator_sha256\"))\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T17:43:21.114Z","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":1048422416,"cached_input_tokens":1033285632,"cache_write_input_tokens":0,"output_tokens":1550682,"reasoning_output_tokens":398682,"total_tokens":1049973098},"last_token_usage":{"input_tokens":142764,"cached_input_tokens":140032,"cache_write_input_tokens":0,"output_tokens":90,"reasoning_output_tokens":12,"total_tokens":142854},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":47.0,"window_minutes":10080,"resets_at":1784955710},"secondary":null,"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
