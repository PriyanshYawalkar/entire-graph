{"timestamp":"2026-07-18T16:37:29.724Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7617-0bfc-7ce0-a7f2-a1792cc6611e","call_id":"call_NHGMY9vgjaG7Oio69am1pj79","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"   420\t\n   421\t    for row in rows:\n   422\t        if type(row) is not dict:\n   423\t            raise SliceError(\"source metadata row is malformed\")\n   424\t        instance_id = artifacts.require_string(\n   425\t            row.get(\"instance_id\"), \"source instance identity\"\n   426\t        ).strip()\n   427\t        if not instance_id:\n   428\t            raise SliceError(\"source instance identity is empty\")\n   429\t        raw_repo = artifacts.require_string(\n   430\t            row.get(\"repo\"), \"source repository identity\"\n   431\t        )\n   432\t        if not raw_repo.strip():\n   433\t            raise SliceError(\"source repository identity is empty\")\n   434\t        canonical, normalized = canonical_public_repo(raw_repo)\n   435\t        language = artifacts.require_string(\n   436\t            row.get(\"language\"), \"source language\"\n   437\t        ).strip().casefold()\n   438\t        if not language:\n   439\t            raise SliceError(\"source language is empty\")\n   440\t\n   441\t        # This check occurs for every identity-bearing physical row, before\n   442\t        # eligibility or duplicate-instance handling.\n   443\t        identity_hash = exclusion_freezer.identity_hmac(canonical, key)\n   444\t        protected_match = identity_hash in protected\n   445\t\n   446\t        identity = (normalized, language)\n   447\t        previous = instances.get(instance_id)\n   448\t        if previous is not None:\n   449\t            if previous != identity:\n   450\t                raise SliceError(\"duplicate source instance identity metadata disagrees\")\n   451\t            duplicate_instance_rows += 1\n   452\t            continue\n   453\t        instances[instance_id] = identity\n   454\t\n   455\t        repository = repositories.setdefault(\n   456\t            normalized,\n   457\t            {\n   458\t                \"source_variants\": set(),\n   459\t                \"languages\": set(),\n   460\t                \"instance_ids\": set(),\n   461\t                \"protected_match\": protected_match,\n   462\t                \"explicit_match\": normalized in explicit,\n   463\t            },\n   464\t        )\n   465\t        if repository[\"protected_match\"] != protected_match:\n   466\t            raise SliceError(\"normalized source repository HMAC classification disagrees\")\n   467\t        # Preserve the selected source spelling byte-for-byte for the sealed\n   468\t        # materializer's projected Arrow filter.  Normalization is separate.\n   469\t        repository[\"source_variants\"].add(raw_repo)\n   470\t        repository[\"languages\"].add(language)\n   471\t        repository[\"instance_ids\"].add(instance_id)\n   472\t\n   473\t    candidates: list[dict[str, Any]] = []\n   474\t    protected_matches = 0\n   475\t    explicit_matches = 0\n   476\t    metadata_eligible = 0\n   477\t    for normalized, repository in repositories.items():\n   478\t        if len(repository[\"source_variants\"]) != 1:\n   479\t            raise SliceError(\n   480\t                \"normalized source repository has multiple byte-distinct spellings\"\n   481\t            )\n   482\t        languages = repository[\"languages\"]\n   483\t        eligible = (\n   484\t            len(repository[\"instance_ids\"]) >= MINIMUM_INSTANCES_PER_REPOSITORY\n   485\t            and len(languages) == 1\n   486\t        )\n   487\t        protected_match = bool(repository[\"protected_match\"])\n   488\t        explicit_match = bool(repository[\"explicit_match\"])\n   489\t        protected_matches += int(protected_match)\n   490\t        explicit_matches += int(explicit_match)\n   491\t        metadata_eligible += int(eligible)\n   492\t        if not eligible or protected_match or explicit_match:\n   493\t            continue\n   494\t        candidates.append(\n   495\t            {\n   496\t                \"repo\": min(\n   497\t                    repository[\"source_variants\"],\n   498\t                    key=lambda value: (value.casefold(), value),\n   499\t                ),\n   500\t                \"normalized_repo\": normalized,\n   501\t                \"language\": next(iter(languages)),\n   502\t            }\n   503\t        )\n   504\t\n   505\t    by_language: dict[str, list[dict[str, Any]]] = {}\n   506\t    for candidate in candidates:\n   507\t        by_language.setdefault(candidate[\"language\"], []).append(candidate)\n   508\t    ranked_languages = sorted(\n   509\t        by_language,\n   510\t        key=lambda language: (\n   511\t            selection_digest(\"language\", language, key),\n   512\t            language,\n   513\t        ),\n   514\t    )\n   515\t    if len(ranked_languages) < REPOSITORY_COUNT:\n   235\t    assert manifest[\"suite\"] == \"entire_graph_agentic_issue_analysis_smoke_v1\"\n   236\t    assert manifest[\"development_only\"] is True\n   237\t    assert manifest[\"claim_boundary\"] == {\n   238\t        \"issue_analysis_development_smoke_only\": True,\n   239\t        \"code_repair_claim_allowed\": False,\n   240\t        \"broad_superiority_claim_allowed\": False,\n   241\t        \"confirmatory_claim_allowed\": False,\n   242\t    }\n   243\t    assert manifest[\"selection_counts\"] == {\n   244\t        \"source_row_count\": len(rows),\n   245\t        \"source_unique_instance_count\": len(rows),\n   246\t        \"source_duplicate_instance_row_count\": 0,\n   247\t        \"source_repository_identity_count\": 10,\n   248\t        \"metadata_eligible_repository_count\": 7,\n   249\t        \"source_protected_union_match_count\": 2,\n   250\t        \"source_explicit_cohort_match_count\": 2,\n   251\t        \"eligible_nonmatching_repository_count\": 4,\n   252\t        \"eligible_nonmatching_language_count\": 4,\n   253\t        \"selected_repository_count\": 3,\n   254\t        \"selected_language_count\": 3,\n   255\t    }\n   256\t    assert all(manifest[field] is False for field in subject.FALSE_AUTHORITY_FIELDS)\n   257\t    assert all(manifest[field] is False for field in subject.ABSENT_DATA_FIELDS)\n   258\t    assert manifest[\"selection\"][\"model_or_paid_process_used\"] is False\n   259\t    assert manifest[\"selection\"][\"all_source_languages_eligible\"] is True\n   260\t    assert manifest[\"selection\"][\"mandatory_default_post_freeze_exclusions_applied\"] is True\n   261\t    assert all(\n   262\t        set(row) == {\"repo\", \"normalized_repo\", \"language\", \"selection_rank\"}\n   263\t        for row in manifest[\"repositories\"]\n   264\t    )\n   265\t\n   266\t    source_binding = manifest[\"source_bindings\"][\"swe_rebench_v2_metadata\"]\n   267\t    assert source_binding == {\n   268\t        \"dataset\": subject.SOURCE_DATASET,\n   269\t        \"dataset_revision\": subject.SOURCE_DATASET_REVISION,\n   270\t        \"dataset_metadata_sha256\": subject.SOURCE_DATASET_METADATA_SHA256,\n   405\t    rows.append(conflict)\n   406\t    paths = fixture_paths(tmp_path, monkeypatch, rows=rows)\n   407\t    with pytest.raises(subject.SliceError, match=\"metadata disagrees\"):\n   408\t        build(paths)\n   409\t\n   410\t\n   411\tdef test_multiple_byte_distinct_source_spellings_fail_closed(\n   412\t    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n   413\t):\n   414\t    rows = [\n   415\t        *source_rows(\"Owner/Repo\", \"Go\", count=3),\n   416\t        *source_rows(\n   417\t            \"https://github.com/owner/repo.git\",\n   418\t            \"Go\",\n   419\t            count=3,\n   420\t            prefix=\"owner/repo-alias\",\n   421\t        ),\n   422\t        *source_rows(\"owner/rust\", \"Rust\"),\n   423\t        *source_rows(\"owner/python\", \"Python\"),\n   424\t        *source_rows(\"owner/java\", \"Java\"),\n   425\t    ]\n   426\t    paths = fixture_paths(tmp_path, monkeypatch, rows=rows)\n   427\t    with pytest.raises(subject.SliceError, match=\"byte-distinct spellings\") as raised:\n   428\t        build(paths)\n   429\t    assert \"Owner/Repo\" not in str(raised.value)\n   430\t\n   431\t\n   432\tdef test_selected_repo_preserves_exact_source_spelling(\n   433\t    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n   434\t):\n   435\t    rows = [\n   436\t        *source_rows(\"Owner/GoRepo\", \"Go\"),\n   437\t        *source_rows(\"OWNER/RustRepo\", \"Rust\"),\n   438\t        *source_rows(\"owner/PythonRepo\", \"Python\"),\n   439\t    ]\n   440\t    paths = fixture_paths(tmp_path, monkeypatch, rows=rows)\n   441\t    manifest = build(paths)\n   442\t    source_spellings = {str(row[\"repo\"]) for row in rows}\n   443\t    assert {row[\"repo\"] for row in manifest[\"repositories\"]} == source_spellings\n   444\t    assert all(row[\"repo\"] != row[\"normalized_repo\"] for row in manifest[\"repositories\"])\n   445\t\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
