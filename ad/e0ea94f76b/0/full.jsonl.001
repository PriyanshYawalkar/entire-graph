{"timestamp":"2026-07-18T16:00:19.024Z","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":1002866769,"cached_input_tokens":988462848,"cache_write_input_tokens":0,"output_tokens":1444031,"reasoning_output_tokens":348573,"total_tokens":1004310800},"last_token_usage":{"input_tokens":193516,"cached_input_tokens":191232,"cache_write_input_tokens":0,"output_tokens":474,"reasoning_output_tokens":451,"total_tokens":193990},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":35.0,"window_minutes":10080,"resets_at":1784955710},"secondary":null,"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
