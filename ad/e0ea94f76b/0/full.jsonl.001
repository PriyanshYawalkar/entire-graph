{"timestamp":"2026-07-18T14:21:57.402Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5b8c055a1c81919d524f05c1234fe2","status":"completed","call_id":"call_HiiAXEqpHIqzeQHJH1PTpRX2","name":"exec","input":"const patch = \"*** Begin Patch\\n*** Update File: /private/tmp/brain-bench-graph-agentic-pilot/competitive-eval/tools/run_agentic_tasks_smoke.py\\n@@\\n def setup_treatment_index(\\n     repository: dict[str, Any], system: str, output: Path, *, graph: Path,\\n-    cbm: Path, runtime_path_prefix: str, timeout_seconds: int,\\n+    cbm: Path, runtime_path_prefix: str, timeout_seconds: int,\\n+    execution_config_sha256: str,\\n ) -> dict[str, Any]:\\n@@\\n         second_response = parse_setup_json(second, \\\"Entire Graph cache validation\\\")\\n         for response in (first_response, second_response):\\n+            counts = response.get(\\\"counts\\\")\\n             if (\\n+                response.get(\\\"format_version\\\") != 1\\n+                or response.get(\\\"provider\\\") != \\\"entire-graph\\\"\\n+                or not isinstance(response.get(\\\"provider_version\\\"), str)\\n+                or not response[\\\"provider_version\\\"]\\n                 response.get(\\\"commit\\\") != repository[\\\"commit\\\"]\\n                 or response.get(\\\"tree\\\") != repository[\\\"tree\\\"]\\n                 or response.get(\\\"profile\\\") != \\\"full\\\"\\n                 or Path(str(response.get(\\\"repo_root\\\") or \\\"\\\")).resolve() != checkout\\n+                or not isinstance(counts, dict)\\n+                or int(counts.get(\\\"files\\\") or 0) <= 0\\n+                or int(counts.get(\\\"parsed_files\\\") or 0) <= 0\\n+                or int(counts.get(\\\"symbols\\\") or 0) <= 0\\n+                or int(counts.get(\\\"partial_failures\\\") or 0) != 0\\n+                or counts.get(\\\"completeness_level\\\") != \\\"ok\\\"\\n             ):\\n-                raise SmokeError(\\\"Entire Graph preindex provenance does not match the frozen checkout\\\")\\n+                raise SmokeError(\\\"Entire Graph preindex is incomplete or does not match the frozen checkout\\\")\\n+        if first_response.get(\\\"provider_version\\\") != second_response.get(\\\"provider_version\\\"):\\n+            raise SmokeError(\\\"Entire Graph provider version changed during preindex validation\\\")\\n+        if first_response.get(\\\"index_cache_hit\\\") is not False:\\n+            raise SmokeError(\\\"Entire Graph fresh preindex unexpectedly reused prior cache state\\\")\\n         if second_response.get(\\\"index_cache_hit\\\") is not True:\\n             raise SmokeError(\\\"Entire Graph preindex validation did not hit the prepared cache\\\")\\n@@\\n         validation = {\\n             \\\"status\\\": \\\"indexed\\\", \\\"first_cache_hit\\\": first_response.get(\\\"index_cache_hit\\\"),\\n-            \\\"validation_cache_hit\\\": True, \\\"cache_inventory\\\": inventory,\\n+            \\\"validation_cache_hit\\\": True,\\n+            \\\"provider\\\": first_response[\\\"provider\\\"],\\n+            \\\"provider_version\\\": first_response[\\\"provider_version\\\"],\\n+            \\\"counts\\\": first_response[\\\"counts\\\"],\\n+            \\\"cache_inventory\\\": inventory,\\n         }\\n@@\\n-        if status_response.get(\\\"error\\\") or status_response.get(\\\"status\\\") in {\\\"degraded\\\", \\\"missing\\\", \\\"corrupt\\\"}:\\n+        if (\\n+            status_response.get(\\\"error\\\")\\n+            or status_response.get(\\\"status\\\") != \\\"indexed\\\"\\n+            or status_response.get(\\\"project\\\") != project\\n+            or int(status_response.get(\\\"nodes\\\") or 0) <= 0\\n+        ):\\n             raise SmokeError(f\\\"Codebase Memory index validation is not healthy: {status_response}\\\")\\n@@\\n         \\\"suite\\\": repository[\\\"suite\\\"], \\\"repository\\\": repository[\\\"repository\\\"],\\n         \\\"system\\\": system, \\\"commit\\\": repository[\\\"commit\\\"], \\\"tree\\\": repository[\\\"tree\\\"],\\n+        \\\"execution_config_sha256\\\": execution_config_sha256,\\n         \\\"setup_wall_time_ms\\\": setup_wall_time_ms, \\\"project\\\": project,\\n@@\\n def load_or_setup_treatment_index(\\n     repository: dict[str, Any], system: str, output: Path, *, graph: Path,\\n-    cbm: Path, runtime_path_prefix: str, timeout_seconds: int,\\n+    cbm: Path, runtime_path_prefix: str, timeout_seconds: int,\\n+    execution_config_sha256: str,\\n ) -> dict[str, Any]:\\n@@\\n             repository, system, output, graph=graph, cbm=cbm,\\n-            runtime_path_prefix=runtime_path_prefix, timeout_seconds=timeout_seconds,\\n+            runtime_path_prefix=runtime_path_prefix, timeout_seconds=timeout_seconds,\\n+            execution_config_sha256=execution_config_sha256,\\n         )\\n@@\\n         or setup.get(\\\"commit\\\") != repository[\\\"commit\\\"]\\n         or setup.get(\\\"tree\\\") != repository[\\\"tree\\\"]\\n+        or setup.get(\\\"execution_config_sha256\\\") != execution_config_sha256\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"019f756f-5147-7222-9084-187ed68d3651"}}}
