{"timestamp":"2026-07-18T16:08:04.263Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5ba4e4479c81919df5288c492db953","status":"completed","call_id":"call_2ofsSLUEdI1pmwg9vjuEI92k","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '1,760p' competitive-eval/tools/test_freeze_agentic_confirmatory_slice.py\",\n  workdir: \"/private/tmp/brain-bench-graph-agentic-pilot\",\n  yield_time_ms: 10000,\n  max_output_tokens: 50000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T16:08:04.450Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f75fc-1c61-78e1-a8ae-2b85b40d3d79","call_id":"call_2ofsSLUEdI1pmwg9vjuEI92k","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"from __future__ import annotations\n\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nimport freeze_agentic_confirmatory_slice as subject\n\n\ndef write_json(path: Path, document: object) -> str:\n    subject.artifacts.write_new_canonical_json(path, document)\n    return subject.artifacts.sha256_file(path)\n\n\ndef write_key(path: Path, value: bytes = b\"k\" * 32) -> Path:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_bytes(value)\n    path.chmod(0o600)\n    return path\n\n\ndef exclusion_document(key: bytes, repositories: list[str]) -> dict:\n    hashes = sorted(subject.exclusion_freezer.identity_hmac(repo, key) for repo in repositories)\n    return {\n        \"schema_version\": 1,\n        \"suite\": subject.graph_v8.SUITE,\n        \"stage\": \"frozen_graph_v8_repository_exclusions_before_catalog\",\n        \"policy_sha256\": \"a\" * 64,\n        \"catalog_construction_authorized\": False,\n        \"rank_production_authorized\": False,\n        \"identity_representation\": (\n            \"hmac_sha256_of_normalized_owner_slash_repository_utf8\"\n        ),\n        \"identity_hmac_key_sha256\": hashlib.sha256(key).hexdigest(),\n        \"generator_sha256\": \"b\" * 64,\n        \"producer_dependency_bindings\": {\n            \"artifact_contract_sha256\": subject.artifacts.sha256_file(\n                Path(subject.artifacts.__file__)\n            ),\n            \"normalization_source_sha256\": subject.artifacts.sha256_file(\n                Path(subject.graph_v8.__file__)\n            ),\n        },\n        \"source_bindings\": {\"synthetic\": {\"sha256\": \"c\" * 64}},\n        \"repository_count\": len(hashes),\n        \"repository_identity_hmac_sha256\": hashes,\n    }\n\n\ndef candidate(\n    repo: str | None,\n    language: str = \"Python\",\n    *,\n    eligible: bool = True,\n) -> dict:\n    row = {\n        \"core_repo_key\": (repo or \"unmapped\").replace(\"/\", \"__\"),\n        \"language\": language,\n        \"eligible\": eligible,\n        # Controller-only or outcome-adjacent fields must never be projected.\n        \"query\": f\"secret query for {repo}\",\n        \"qrels\": [{\"answer\": f\"secret answer for {repo}\"}],\n        \"score\": 0.75,\n        \"outcome\": \"secret outcome\",\n    }\n    if repo is not None:\n        row[\"repo\"] = repo\n    return row\n\n\ndef catalog(rows: list[dict]) -> dict:\n    return {\"schema_version\": 1, \"repositories\": rows}\n\n\ndef prior_spike(repositories: list[str]) -> dict:\n    return {\n        \"schema_version\": 1,\n        \"suite\": \"core_bench_level2_feasibility_spike\",\n        \"selection\": {\"repository_count\": len(repositories)},\n        \"repositories\": [\n            {\"repo\": repo, \"normalized_repo\": subject.graph_v8.normalize_repo(repo)}\n            for repo in repositories\n        ],\n        \"cases\": [{\"query\": \"must not be projected\", \"qrels\": [\"secret\"]}],\n    }\n\n\ndef cohort(repositories: list[str]) -> dict:\n    return {\n        \"schema_version\": 1,\n        \"suite\": \"synthetic_post_freeze_cohort\",\n        \"stage\": \"synthetic_public_repository_inventory\",\n        \"repository_count\": len(repositories),\n        \"repositories\": [\n            {\n                \"repository\": repo,\n                \"controller_expected\": {\"answer\": \"must remain controller-only\"},\n            }\n            for repo in repositories\n        ],\n        \"cases\": [{\"expected\": \"must not be projected\", \"score\": 1.0}],\n    }\n\n\ndef fixture_paths(\n    tmp_path: Path,\n    *,\n    rows: list[dict],\n    protected: list[str] = (),\n    prior: list[str] = (),\n    post: list[str] = (),\n) -> dict[str, object]:\n    key = b\"k\" * 32\n    catalog_path = tmp_path / \"candidate-catalog.json\"\n    prior_path = tmp_path / \"prior-spike.json\"\n    cohort_path = tmp_path / \"post-freeze.json\"\n    exclusions_path = tmp_path / \"exclusions.json\"\n    key_path = write_key(tmp_path / \"identity-key\", key)\n    return {\n        \"candidate_catalog_path\": catalog_path,\n        \"candidate_catalog_sha256\": write_json(catalog_path, catalog(rows)),\n        \"prior_spike_path\": prior_path,\n        \"prior_spike_sha256\": write_json(prior_path, prior_spike(list(prior))),\n        \"exclusions_path\": exclusions_path,\n        \"exclusions_sha256\": write_json(\n            exclusions_path, exclusion_document(key, list(protected))\n        ),\n        \"identity_key_path\": key_path,\n        \"supplemental_cohort_paths\": (cohort_path,),\n        \"include_default_post_freeze\": False,\n        \"cohort_path\": cohort_path,\n        \"cohort_sha256\": write_json(cohort_path, cohort(list(post))),\n    }\n\n\ndef build(paths: dict[str, object]) -> dict:\n    arguments = {\n        key: value\n        for key, value in paths.items()\n        if key not in {\"cohort_path\", \"cohort_sha256\"}\n    }\n    return subject.build_manifest(**arguments)\n\n\ndef base_rows() -> list[dict]:\n    return [\n        candidate(\"https://github.com/OWNER/PROTECTED.git\", \"Go\"),\n        candidate(\"owner/ineligible-protected\", \"Go\", eligible=False),\n        candidate(\"owner/prior\", \"Rust\"),\n        candidate(\"owner/post\", \"TypeScript\"),\n        candidate(\"owner/one\", \"Python\"),\n        candidate(\"owner/two\", \"Java\"),\n        candidate(\"owner/three\", \"C\"),\n        candidate(\"owner/four\", \"C++\"),\n        candidate(None, eligible=False),\n    ]\n\n\ndef test_freeze_is_identity_safe_deterministic_and_public_only(tmp_path: Path):\n    paths = fixture_paths(\n        tmp_path,\n        rows=base_rows(),\n        protected=[\"owner/protected\", \"owner/ineligible-protected\"],\n        prior=[\"owner/prior\"],\n        post=[\"owner/post\"],\n    )\n    manifest = build(paths)\n    available = {\"owner/one\", \"owner/two\", \"owner/three\", \"owner/four\"}\n    expected = sorted(\n        available, key=lambda repo: (subject.selection_digest(repo, b\"k\" * 32), repo)\n    )[:3]\n\n    assert [row[\"normalized_repo\"] for row in manifest[\"repositories\"]] == expected\n    assert manifest[\"repository_count\"] == subject.REPOSITORY_COUNT == 3\n    assert manifest[\"suite\"] == \"entire_graph_agentic_issue_analysis_smoke_v1\"\n    assert manifest[\"development_only\"] is True\n    assert manifest[\"claim_boundary\"] == {\n        \"issue_analysis_development_smoke_only\": True,\n        \"code_repair_claim_allowed\": False,\n        \"broad_superiority_claim_allowed\": False,\n        \"confirmatory_claim_allowed\": False,\n    }\n    assert manifest[\"selection_counts\"] == {\n        \"catalog_row_count\": 9,\n        \"catalog_rows_without_repository_identity\": 1,\n        \"catalog_repository_identity_count\": 8,\n        \"predefined_eligible_repository_count\": 7,\n        \"catalog_protected_union_match_count\": 2,\n        \"catalog_explicit_cohort_match_count\": 2,\n        \"eligible_nonmatching_repository_count\": 4,\n        \"selected_repository_count\": 3,\n    }\n    assert all(manifest[field] is False for field in subject.FALSE_AUTHORITY_FIELDS)\n    assert all(manifest[field] is False for field in subject.ABSENT_DATA_FIELDS)\n    assert manifest[\"selection\"][\"model_or_paid_process_used\"] is False\n    assert all(\n        set(row)\n        == {\"repo\", \"normalized_repo\", \"language\", \"selection_rank\"}\n        for row in manifest[\"repositories\"]\n    )\n\n    serialized = subject.artifacts.canonical_bytes(manifest).decode()\n    for forbidden in (\n        \"owner/protected\",\n        \"OWNER/PROTECTED\",\n        \"owner/ineligible-protected\",\n        \"owner/prior\",\n        \"owner/post\",\n        \"secret query\",\n        \"secret answer\",\n        \"secret outcome\",\n        \"must remain controller-only\",\n    ):\n        assert forbidden not in serialized\n    assert \"repository_identity_hmac_sha256\" not in serialized\n    assert \"selection_digest\" not in serialized\n    assert (\n        manifest[\"selection\"][\"mandatory_default_post_freeze_exclusions_applied\"]\n        is False\n    )\n\n\ndef test_selection_does_not_depend_on_catalog_order_or_outcome_fields(tmp_path: Path):\n    rows = [candidate(f\"owner/repo-{index}\", f\"language-{index}\") for index in range(7)]\n    first_paths = fixture_paths(tmp_path / \"first\", rows=rows)\n    second_rows = list(reversed(copy.deepcopy(rows)))\n    for index, row in enumerate(second_rows):\n        row[\"score\"] = index / 10\n        row[\"outcome\"] = f\"different-{index}\"\n        row[\"query\"] = f\"different-query-{index}\"\n    second_paths = fixture_paths(tmp_path / \"second\", rows=second_rows)\n    first = build(first_paths)\n    second = build(second_paths)\n    assert first[\"repositories\"] == second[\"repositories\"]\n\n\ndef test_every_identified_candidate_is_hmac_checked_even_when_ineligible(tmp_path: Path):\n    paths = fixture_paths(\n        tmp_path,\n        rows=[\n            candidate(\"owner/protected\", eligible=False),\n            *[candidate(f\"owner/repo-{index}\") for index in range(4)],\n        ],\n        protected=[\"OWNER/PROTECTED\"],\n    )\n    manifest = build(paths)\n    assert manifest[\"selection_counts\"][\"catalog_protected_union_match_count\"] == 1\n    assert manifest[\"selection_counts\"][\"predefined_eligible_repository_count\"] == 4\n\n\ndef test_insufficient_cohort_error_discloses_count_not_matching_identity(tmp_path: Path):\n    secret = \"owner/protected-secret\"\n    paths = fixture_paths(\n        tmp_path,\n        rows=[candidate(secret), candidate(\"owner/one\"), candidate(\"owner/two\")],\n        protected=[secret],\n    )\n    with pytest.raises(subject.SliceError) as raised:\n        build(paths)\n    assert \"2 available\" in str(raised.value)\n    assert secret not in str(raised.value)\n\n\n@pytest.mark.parametrize(\"failure\", [\"mode\", \"length\", \"content\", \"symlink\"])\ndef test_identity_key_uses_exact_v8_file_contract(tmp_path: Path, failure: str):\n    paths = fixture_paths(\n        tmp_path,\n        rows=[candidate(f\"owner/repo-{index}\") for index in range(4)],\n    )\n    key_path = paths[\"identity_key_path\"]\n    assert isinstance(key_path, Path)\n    if failure == \"mode\":\n        key_path.chmod(0o644)\n    elif failure == \"length\":\n        key_path.write_bytes(b\"short\")\n        key_path.chmod(0o600)\n    elif failure == \"content\":\n        key_path.write_bytes(b\"z\" * 32)\n        key_path.chmod(0o600)\n    else:\n        target = tmp_path / \"real-key\"\n        key_path.rename(target)\n        key_path.symlink_to(target)\n    with pytest.raises(ValueError, match=\"mandatory exclusion HMAC key mismatch\"):\n        build(paths)\n\n\ndef cli_arguments(paths: dict[str, object]) -> list[str]:\n    cohort_path = paths[\"cohort_path\"]\n    return [\n        \"--candidate-catalog\",\n        str(paths[\"candidate_catalog_path\"]),\n        \"--candidate-catalog-sha256\",\n        str(paths[\"candidate_catalog_sha256\"]),\n        \"--prior-spike\",\n        str(paths[\"prior_spike_path\"]),\n        \"--prior-spike-sha256\",\n        str(paths[\"prior_spike_sha256\"]),\n        \"--exclusions\",\n        str(paths[\"exclusions_path\"]),\n        \"--exclusions-sha256\",\n        str(paths[\"exclusions_sha256\"]),\n        \"--identity-key\",\n        str(paths[\"identity_key_path\"]),\n        \"--post-freeze-cohort\",\n        str(cohort_path),\n        \"--test-no-default-post-freeze-cohorts\",\n    ]\n\n\ndef test_cli_uses_atomic_no_overwrite_freeze_and_recomputing_validate(\n    tmp_path: Path, capsys: pytest.CaptureFixture[str]\n):\n    paths = fixture_paths(\n        tmp_path,\n        rows=[candidate(f\"owner/repo-{index}\") for index in range(5)],\n    )\n    output = tmp_path / \"slice.json\"\n    common = cli_arguments(paths)\n    assert subject.main([\"freeze\", *common, \"--output\", str(output)]) == 0\n    original = output.read_bytes()\n    document = json.loads(original)\n    assert original == subject.artifacts.canonical_bytes(document)\n    assert output.stat().st_mode & 0o777 == 0o600\n    assert subject.main([\"validate\", *common, \"--manifest\", str(output)]) == 0\n    validation = capsys.readouterr().out.splitlines()[-1]\n    assert json.loads(validation) == {\n        \"valid\": True,\n        \"repository_count\": 3,\n        \"protected_match_count\": 0,\n    }\n\n    assert subject.main([\"freeze\", *common, \"--output\", str(output)]) == 1\n    assert output.read_bytes() == original\n\n    tampered = copy.deepcopy(document)\n    tampered[\"paid_execution_authorized\"] = True\n    tampered_path = tmp_path / \"tampered.json\"\n    write_json(tampered_path, tampered)\n    assert subject.main(\n        [\"validate\", *common, \"--manifest\", str(tampered_path)]\n    ) == 1\n\n\ndef test_validate_fails_when_a_bound_input_changes(tmp_path: Path):\n    paths = fixture_paths(\n        tmp_path,\n        rows=[candidate(f\"owner/repo-{index}\") for index in range(5)],\n    )\n    output = tmp_path / \"slice.json\"\n    common = cli_arguments(paths)\n    assert subject.main([\"freeze\", *common, \"--output\", str(output)]) == 0\n    catalog_path = paths[\"candidate_catalog_path\"]\n    assert isinstance(catalog_path, Path)\n    catalog_path.write_bytes(catalog_path.read_bytes() + b\" \")\n    assert subject.main([\"validate\", *common, \"--manifest\", str(output)]) == 1\n\n\ndef test_catalog_rejects_duplicate_normalized_identities(tmp_path: Path):\n    paths = fixture_paths(\n        tmp_path,\n        rows=[\n            candidate(\"Owner/Repo\"),\n            candidate(\"https://github.com/owner/repo.git\"),\n            candidate(\"owner/one\"),\n            candidate(\"owner/two\"),\n        ],\n    )\n    with pytest.raises(subject.SliceError, match=\"duplicate repository identity\"):\n        build(paths)\n\n\ndef test_supplemental_cohort_schema_drift_fails_closed(tmp_path: Path):\n    paths = fixture_paths(\n        tmp_path,\n        rows=[candidate(f\"owner/repo-{index}\") for index in range(5)],\n    )\n    cohort_path = paths[\"cohort_path\"]\n    assert isinstance(cohort_path, Path)\n    cohort_path.unlink()\n    write_json(\n        cohort_path,\n        {\"schema_version\": 1, \"repositories\": [{\"expected\": \"not an identity\"}]},\n    )\n    with pytest.raises(subject.SliceError, match=\"repository identity is missing\"):\n        build(paths)\n\n\ndef test_json_loader_rejects_duplicate_keys(tmp_path: Path):\n    path = tmp_path / \"duplicate.json\"\n    path.write_text('{\"schema_version\":1,\"schema_version\":1}\\n', encoding=\"utf-8\")\n    with pytest.raises(subject.SliceError, match=\"duplicate object key\"):\n        subject.load_json(path)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
