{"timestamp":"2026-07-18T15:28:07.495Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_0bd6d73b974b1fab016a5b9b8781f0819195bf4f1373c61551","status":"completed","call_id":"call_yGPfw25HuyxMQsJQ5xOm0510","name":"exec","input":"const r = await tools.exec_command({cmd:\"sed -n '1,320p' competitive-eval/tools/construct_agentic_tasks_smoke.py && sed -n '1,260p' competitive-eval/tools/test_construct_agentic_tasks_smoke.py\",\"workdir\":\"/private/tmp/brain-bench-graph-agentic-pilot\",\"yield_time_ms\":10000,\"max_output_tokens\":26000});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
{"timestamp":"2026-07-18T15:28:07.697Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f75d7-8a11-7212-a502-8edc568f2784","call_id":"call_yGPfw25HuyxMQsJQ5xOm0510","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"#!/usr/bin/env python3\n\"\"\"Freeze a three-repository agentic smoke from retained authored Tasks.\n\nSelection deliberately uses task metadata only. It never reads score artifacts,\nrankings, or system outcomes, so the development smoke cannot select on a known\ncomparator result.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nfrom collections import defaultdict\nfrom pathlib import Path\nfrom typing import Any\n\nimport agentic_parity\nimport sem_v7_artifacts as artifacts\n\n\nROOT = Path(__file__).resolve().parents[2]\nTASKS = ROOT / \"competitive-eval\" / \"tasks\"\nDEFAULT_OUTPUT = ROOT / \"competitive-eval\" / \"agentic-tasks-smoke\" / \"manifest.json\"\nSUITE = \"entire_graph_agentic_mini_v1\"\nLANGUAGES = (\"Go\", \"TypeScript\", \"Python\")\nREQUIRED_TASK_TYPES = (\"definition_lookup\", \"call_graph_inbound_outbound\")\nSELECTED_CATEGORIES = (\n    \"symbol_discovery\",\n    \"code_snippet_retrieval\",\n    \"code_search\",\n    \"direct_callers_callees\",\n    \"transitive_call_path\",\n)\nEXCLUDED_REPOSITORIES = {\n    # Product-owned repositories are not repository-disjoint product evidence.\n    \"entireio/entire-graph\",\n    \"entireio/entire-sem\",\n    # The prior repair pilot is development evidence and must not pick this slice.\n    \"catchorg/catch2\",\n    \"microsoft/vscode\",\n    \"vitejs/vite\",\n}\n\n\nclass SmokeError(ValueError):\n    \"\"\"Raised when the retained Tasks corpus violates the smoke contract.\"\"\"\n\n\ndef task_path_label(path: Path, tasks_dir: Path) -> str:\n    resolved = path.resolve()\n    try:\n        return resolved.relative_to(ROOT.resolve()).as_posix()\n    except ValueError:\n        return f\"tasks/{resolved.relative_to(tasks_dir.resolve()).as_posix()}\"\n\n\ndef selection_digest(language: str, repository: str) -> str:\n    value = f\"{SUITE}\\0{language}\\0{repository.casefold()}\".encode()\n    return hashlib.sha256(value).hexdigest()\n\n\ndef load_candidates(tasks_dir: Path) -> dict[str, list[dict[str, Any]]]:\n    grouped: dict[tuple[str, str], dict[str, tuple[Path, dict[str, Any]]]] = defaultdict(dict)\n    for path in agentic_parity.iter_task_paths(tasks_dir):\n        task = agentic_parity.load_json(path)\n        language = task.get(\"language\")\n        task_type = task.get(\"task_type\")\n        repository = task.get(\"repo\")\n        if language not in LANGUAGES or task_type not in REQUIRED_TASK_TYPES:\n            continue\n        if not isinstance(repository, str) or not isinstance(task.get(\"commit\"), str):\n            raise SmokeError(f\"task identity is malformed: {path}\")\n        key = (language, repository)\n        if task_type in grouped[key]:\n            raise SmokeError(f\"duplicate {task_type} task for {repository}\")\n        grouped[key][task_type] = (path, task)\n\n    candidates: dict[str, list[dict[str, Any]]] = {language: [] for language in LANGUAGES}\n    for (language, repository), tasks in grouped.items():\n        if repository.casefold() in EXCLUDED_REPOSITORIES:\n            continue\n        if set(tasks) != set(REQUIRED_TASK_TYPES):\n            continue\n        commits = {task[\"commit\"] for _path, task in tasks.values()}\n        if len(commits) != 1:\n            raise SmokeError(f\"task commits disagree for {repository}\")\n        task_bindings = []\n        for task_type in REQUIRED_TASK_TYPES:\n            path, _task = tasks[task_type]\n            task_bindings.append(\n                {\n                    \"task_type\": task_type,\n                    \"path\": task_path_label(path, tasks_dir),\n                    \"sha256\": artifacts.sha256_file(path),\n                }\n            )\n        candidates[language].append(\n            {\n                \"repository\": repository,\n                \"language\": language,\n                \"commit\": commits.pop(),\n                \"selection_digest\": selection_digest(language, repository),\n                \"tasks\": task_bindings,\n            }\n        )\n    for language, rows in candidates.items():\n        rows.sort(key=lambda row: (row[\"selection_digest\"], row[\"repository\"].casefold()))\n        if not rows:\n            raise SmokeError(f\"no eligible retained Tasks repository for {language}\")\n    return candidates\n\n\ndef selected_cases(tasks_dir: Path, repositories: set[str]) -> list[dict[str, Any]]:\n    cases = agentic_parity.generate_cases(tasks_dir)\n    output = []\n    for repository in sorted(repositories, key=str.casefold):\n        rows = [case for case in cases if case[\"repo\"] == repository]\n        by_category: dict[str, list[dict[str, Any]]] = defaultdict(list)\n        for row in rows:\n            by_category[row[\"category\"]].append(row)\n        for category in SELECTED_CATEGORIES:\n            if not by_category[category]:\n                raise SmokeError(f\"{repository} has no generated {category} case\")\n        # One definition, snippet, code-search, and path case; both directions of\n        # direct relation lookup. This is six scored questions in five categories.\n        chosen = [\n            sorted(by_category[\"symbol_discovery\"], key=lambda row: row[\"id\"])[0],\n            sorted(by_category[\"code_snippet_retrieval\"], key=lambda row: row[\"id\"])[0],\n            sorted(by_category[\"code_search\"], key=lambda row: row[\"id\"])[0],\n            *sorted(by_category[\"direct_callers_callees\"], key=lambda row: row[\"id\"]),\n            sorted(by_category[\"transitive_call_path\"], key=lambda row: row[\"id\"])[0],\n        ]\n        if len(chosen) != 6:\n            raise SmokeError(f\"{repository} must contribute exactly six questions\")\n        output.extend(chosen)\n    return output\n\n\ndef construct(tasks_dir: Path) -> dict[str, Any]:\n    candidates = load_candidates(tasks_dir)\n    selected = [candidates[language][0] for language in LANGUAGES]\n    repositories = {row[\"repository\"] for row in selected}\n    cases = selected_cases(tasks_dir, repositories)\n    return {\n        \"schema_version\": 1,\n        \"suite\": SUITE,\n        \"stage\": \"frozen_three_repository_agentic_tasks_smoke\",\n        \"development_only\": True,\n        \"confirmatory_use_allowed\": False,\n        \"v7_authorizations_changed\": False,\n        \"v8_authorizations_changed\": False,\n        \"selection\": {\n            \"source\": \"retained_authored_tasks\",\n            \"outcome_data_consulted\": False,\n            \"languages\": list(LANGUAGES),\n            \"required_task_types\": list(REQUIRED_TASK_TYPES),\n            \"excluded_repositories\": sorted(EXCLUDED_REPOSITORIES),\n            \"rule\": \"minimum_sha256(suite NUL language NUL casefold(repository))\",\n            \"candidate_rankings\": candidates,\n        },\n        \"repository_count\": len(selected),\n        \"case_count\": len(cases),\n        \"category_count\": len(SELECTED_CATEGORIES),\n        \"systems\": [\"file-tools\", \"entire-graph\", \"cbm\"],\n        \"repositories\": selected,\n        \"cases\": cases,\n        \"claim_boundary\": {\n            \"purpose\": \"pipeline_and_product_development_smoke\",\n            \"broad_superiority_claim_allowed\": False,\n            \"repository_disjoint_confirmatory_claim_allowed\": False,\n            \"same_frozen_slice_required_for_product_reruns\": True,\n        },\n    }\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--tasks-dir\", type=Path, default=TASKS)\n    parser.add_argument(\"--output\", type=Path, default=DEFAULT_OUTPUT)\n    args = parser.parse_args()\n    manifest = construct(args.tasks_dir)\n    args.output.parent.mkdir(parents=True, exist_ok=True)\n    args.output.write_bytes(artifacts.canonical_bytes(manifest))\n    print(args.output)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport construct_agentic_tasks_smoke as smoke\n\n\ndef write_task(root: Path, language: str, repository: str, task_type: str) -> None:\n    path = root / language.casefold() / f\"{repository.replace('/', '-')}-{task_type}.json\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    task = {\n        \"repo\": repository,\n        \"language\": language,\n        \"commit\": hashlib.sha1(repository.encode()).hexdigest(),\n        \"task_type\": task_type,\n    }\n    if task_type == \"definition_lookup\":\n        task[\"expectations\"] = [{\"name\": \"Target\", \"file_path\": \"target.ext\"}]\n    else:\n        task.update(\n            {\n                \"focus\": \"Target\",\n                \"expected_inbound\": [{\"name\": \"Caller\", \"file_path\": \"caller.ext\"}],\n                \"expected_outbound\": [{\"name\": \"Callee\", \"file_path\": \"callee.ext\"}],\n            }\n        )\n    path.write_text(json.dumps(task), encoding=\"utf-8\")\n\n\ndef corpus(tmp_path: Path) -> Path:\n    for language in smoke.LANGUAGES:\n        for index in range(3):\n            repository = f\"owner-{language.casefold()}/repo-{index}\"\n            for task_type in smoke.REQUIRED_TASK_TYPES:\n                write_task(tmp_path, language, repository, task_type)\n    return tmp_path\n\n\ndef test_selection_is_metadata_only_and_deterministic(tmp_path: Path):\n    tasks = corpus(tmp_path)\n    first = smoke.load_candidates(tasks)\n    second = smoke.load_candidates(tasks)\n    assert first == second\n    for language, rows in first.items():\n        assert len(rows) == 3\n        assert rows == sorted(rows, key=lambda row: (row[\"selection_digest\"], row[\"repository\"].casefold()))\n        for row in rows:\n            assert set(row) == {\"repository\", \"language\", \"commit\", \"selection_digest\", \"tasks\"}\n            assert row[\"language\"] == language\n\n\ndef test_incomplete_and_product_owned_repositories_are_ineligible(tmp_path: Path):\n    corpus(tmp_path)\n    write_task(tmp_path, \"Go\", \"owner/incomplete\", \"definition_lookup\")\n    for task_type in smoke.REQUIRED_TASK_TYPES:\n        write_task(tmp_path, \"Go\", \"entireio/entire-graph\", task_type)\n        write_task(tmp_path, \"Go\", \"owner/eligible\", task_type)\n    candidates = smoke.load_candidates(tmp_path)\n    repositories = {row[\"repository\"] for row in candidates[\"Go\"]}\n    assert \"owner/eligible\" in repositories\n    assert \"owner/incomplete\" not in repositories\n    assert \"entireio/entire-graph\" not in repositories\n\n\ndef test_retained_corpus_freezes_expected_repositories_and_questions():\n    manifest = smoke.construct(smoke.TASKS)\n    assert [row[\"repository\"] for row in manifest[\"repositories\"]] == [\n        \"spf13/cobra\",\n        \"reduxjs/redux-toolkit\",\n        \"django/django\",\n    ]\n    assert manifest[\"repository_count\"] == 3\n    assert manifest[\"case_count\"] == 18\n    assert manifest[\"category_count\"] == 5\n    assert manifest[\"selection\"][\"outcome_data_consulted\"] is False\n    counts = {}\n    for case in manifest[\"cases\"]:\n        counts[case[\"repo\"]] = counts.get(case[\"repo\"], 0) + 1\n    assert set(counts.values()) == {6}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
