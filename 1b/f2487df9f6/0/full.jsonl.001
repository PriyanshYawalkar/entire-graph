result.StartLine || result.SnippetEndLine > result.EndLine || result.SnippetEndLine < result.SnippetStartLine {\\n\\t\\t\\treturn fmt.Errorf(\\\"invalid search result at rank %d\\\", result.Rank)\\n\\t\\t}\\n\\t}\\n\\treturn nil\\n}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"5dfd74e8-4c67-4fb7-a4c3-45f47a5e848d"}}}
