     if not any(\n+                f'--cache-dir \"{value}\"' in command\n+                or f\"--cache-dir '{value}'\" in command\n+                or f\"--cache-dir {value}\" in command\n+                or f\"--cache-dir={value}\" in command\n+                for value in accepted_cache_values\n+            ):\n+                violations.add(\"entire_graph_retrieval_wrong_cache\")\n+        for command in graph_search_commands:\n+            if \"--profile full\" not in command and \"--profile=full\" not in command:\n+                violations.add(\"entire_graph_search_wrong_profile\")\n+            if \"--index-all-files\" not in command:\n+                violations.add(\"entire_graph_search_not_query_independent\")\n+        for command in graph_neighbor_commands:\n+            if \"--profile full\" not in command and \"--profile=full\" not in command:\n+                violations.add(\"entire_graph_neighbors_wrong_profile\")\n+        for tool in executed:\n+            command = runtime.bash_command(tool)\n+            if command not in graph_retrieval_commands:\n+                continue\n+            result = tool.get(\"result\") if isinstance(tool.get(\"result\"), dict) else {}\n+            if \"Index: cache-hit\" not in str(result.get(\"content\") or \"\"):\n+                violations.add(\"entire_graph_retrieval_cache_miss\")\n+    if system == \"cbm\":\n+        cbm_tools = [\n+            tool for tool in executed\n+            if str(tool.get(\"name\") or \"\").startswith(\"mcp__codebase-memory-mcp\")\n+        ]\n+        retrieval_suffixes = {\n+            \"search_graph\", \"query_graph\", \"trace_path\", \"get_code_snippet\",\n+            \"get_architecture\", \"search_code\",\n+        }\n+        retrieval_tools = [\n+            tool for tool in cbm_tools\n+            if any(str(tool.get(\"name\") or \"\").endswith(suffix) for suffix in retrieval_suffixes)\n+        ]\n+        if any(\n+            str(tool.get(\"name\") or \"\").endswith((\"index_repository\", \"delete_project\"))\n+            for tool in cbm_tools\n+        ):\n+            violations.add(\"cbm_mutated_index_during_timed_task\")\n+        if not retrieval_tools:\n+            violations.add(\"missing_cbm_retrieval\")\n+        if cbm_project and any(\n+            (tool.get(\"input\") or {}).get(\"project\") != cbm_project\n+            for tool in retrieval_tools\n+        ):\n+            violations.add(\"cbm_retrieval_used_wrong_project\")\n     if system == \"file-tools\" and neighbor_calls:\n         violations.add(\"baseline_used_graph_product\")\n     audit[\"entire_graph_neighbor_calls\"] = neighbor_calls\n+    audit[\"entire_graph_retrieval_calls\"] = len(graph_retrieval_commands)\n     audit[\"violations\"] = sorted(violations)\n     audit[\"passed\"] = not violations\n     return audit\n@@ -456,20 +713,19 @@ def audit_smoke_treatment(\n def execute_one(\n     repository: dict[str, Any], system: str, output: Path, *, claude: Path,\n     graph: Path, cbm: Path, model: str, max_turns: int, max_budget_usd: float,\n-    timeout_seconds: int, runtime_path_prefix: str,\n+    timeout_seconds: int, runtime_path_prefix: str, setup: dict[str, Any],\n ) -> dict[str, Any]:\n     checkout = Path(repository[\"checkouts\"][system]).resolve(strict=True)\n     assert_pristine_checkout(checkout, repository)\n-    record_root = output / \"records\" / f\"repo-{repository['execution_index']:02d}\" / system\n-    record_root.mkdir(parents=True, exist_ok=True)\n-    cache, temp, home = record_root / \"cbm-cache\", record_root / \"agent-temp\", record_root / \"agent-home\"\n-    for path in (cache, temp, home / \".claude\"):\n+    record_root, graph_cache, cbm_cache, temp, home = treatment_paths(repository, system, output)\n+    for path in (cbm_cache, graph_cache, temp, home / \".claude\"):\n         path.mkdir(parents=True, exist_ok=True)\n     runtime.copy_claude_credentials(home / \".claude\" / \".credentials.json\")\n-    mcp = runtim