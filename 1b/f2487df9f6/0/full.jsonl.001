it\") != repository[\"commit\"]\n+        or setup.get(\"tree\") != repository[\"tree\"]\n+    ):\n+        raise SmokeError(\"recovery setup does not match the current execution binding\")\n+    attempt_start = artifacts.read_canonical_json(\n+        attempt_start_path, expected_type=dict,\n+    ).document\n+    attempt_start_sha = artifacts.sha256_file(attempt_start_path)\n+    if (\n+        attempt_start.get(\"measurement_protocol\") != MEASUREMENT_PROTOCOL\n+        or attempt_start.get(\"execution_config_sha256\") != execution_config_sha256\n+        or attempt_start.get(\"setup_record_sha256\") != setup_sha\n+        or attempt_start.get(\"repository\") != repository[\"repository\"]\n+        or attempt_start.get(\"system\") != system\n+        or attempt_start.get(\"commit\") != repository[\"commit\"]\n+        or attempt_start.get(\"tree\") != repository[\"tree\"]\n+    ):\n+        raise SmokeError(\"attempt-start commitment does not match the current execution binding\")\n+    if record_path.is_file():\n+        existing = artifacts.read_canonical_json(record_path, expected_type=dict).document\n+        if (\n+            existing.get(\"measurement_protocol\") != MEASUREMENT_PROTOCOL\n+            or existing.get(\"execution_config_sha256\") != execution_config_sha256\n+            or existing.get(\"setup_record_sha256\") != setup_sha\n+            or existing.get(\"attempt_start_sha256\") != attempt_start_sha\n+            or existing.get(\"repository\") != repository[\"repository\"]\n+            or existing.get(\"system\") != system\n+        ):\n+            raise SmokeError(\"existing attempt record does not match the current execution binding\")\n+        if not existing.get(\"treatment_audit\", {}).get(\"passed\"):\n+            raise SmokeError(\"existing attempt record contains a timed treatment protocol violation\")\n+        return existing\n     mcp = output / \"runtime\" / \"mcp\" / f\"repo-{repository['execution_index']:02d}-{system}.json\"\n+    readable_files = [claude, mcp]\n+    if system == \"entire-graph\":\n+        readable_files.append(graph)\n+    elif system == \"cbm\":\n+        readable_files.append(cbm)\n     _command, sandbox_sha = runtime.sandboxed_agent_command(\n@@ -917,3 +962,3 @@\n         source_repository=Path(repository[\"source_repository\"]),\n-        readable_files=[claude, graph, cbm, mcp],\n+        readable_files=readable_files,\n         readable_paths=[Path(row).parent for row in runtime_path_prefix.split(os.pathsep) if row],\n@@ -926,4 +971,11 @@\n         system, parsed[\"tools\"], graph, graph_cache=graph_cache,\n-        cbm_project=setup.get(\"project\"),\n+        cbm_project=setup.get(\"project\"), cbm_binary=cbm,\n     )\n+    if system == \"entire-graph\" and (\n+        cache_inventory(graph_cache) != setup.get(\"validation\", {}).get(\"cache_inventory\")\n+    ):\n+        audit[\"violations\"] = sorted(\n+            set(audit[\"violations\"]) | {\"entire_graph_cache_changed_during_task\"}\n+        )\n+        audit[\"passed\"] = False\n     result = parsed.get(\"result\") or {}\n@@ -938,3 +990,5 @@\n         \"setup_wall_time_ms\": setup[\"setup_wall_time_ms\"],\n-        \"setup_record_sha256\": artifacts.sha256_file(setup_path),\n+        \"setup_record_sha256\": setup_sha,\n+        \"execution_config_sha256\": execution_config_sha256,\n+        \"attempt_start_sha256\": attempt_start_sha,\n         \"measurement_protocol\": MEASUREMENT_PROTOCOL,\n@@ -958,2 +1012,4 @@\n     canonical_write(record_path, record)\n+    if not audit[\"passed\"]:\n+        raise SmokeError(\"recovered attempt contains a timed treatment protocol violation\")\n     return record\n","move_path":null}},"status":"completed"}}
